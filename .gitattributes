# Evidence streams preserve exact hashed bytes, including blank terminal lines.
evidence/**/*.raw -whitespace
evidence/**/native-tests.stdout -whitespace
evidence/**/unit-tests.stdout -whitespace
evidence/**/development-cli-tests.stdout -whitespace
evidence/**/rook2-tests.stdout -whitespace
evidence/**/rook2-dev-tests.stdout -whitespace
evidence/**/build.stdout -whitespace
evidence/**/build.stderr -whitespace
# Profiler reports are byte-preserved tool output, including padded fields.
evidence/callgrind-20261018-first/*.txt -whitespace
evidence/callgrind-20261018-first/*.callgrind -whitespace
evidence/callgrind-20261018-first/*.log -whitespace
evidence/clock-profile-20261018-first/*.txt -whitespace
evidence/callgrind-pgo-20261018/*.txt -whitespace
evidence/callgrind-pgo-20261018/*.callgrind -whitespace
evidence/callgrind-pgo-20261018/*.log -whitespace
evidence/eval-geometry-check-*/test.stdout -whitespace
evidence/activity-widths-oracle-*/test.stdout -whitespace
evidence/activity-specialization-oracle-*/test.stdout -whitespace
evidence/callgrind-eval-kernels-*/*.stdout -whitespace
evidence/callgrind-eval-kernels-*/*.callgrind -whitespace
evidence/callgrind-eval-kernels-*/*.log -whitespace
# LLVM text profiles use blank lines as record delimiters.
build/profiles/*.proftext text eol=lf linguist-generated=true whitespace=-blank-at-eof
