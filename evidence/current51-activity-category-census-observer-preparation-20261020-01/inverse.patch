-fn row_consistent(counts: &Counts, source_bin: usize) -> bool {
-    if !counts.consistent() { return false; }
-    let v = &counts.values;
-    let source_ok = match source_bin {
-        0 => v[SOURCES] == 0 && v[ENCOUNTERS] == 0,
-        1 => v[SOURCES] == v[GROUPS],
-        2 => v[GROUPS].checked_mul(2) == Some(v[SOURCES]),
-        3 => v[GROUPS].checked_mul(3).is_some_and(|minimum| v[SOURCES] >= minimum),
-        _ => false,
-    };
-    source_ok && v[GROUPS].checked_mul(64).is_some_and(|maximum| v[UNIQUE] <= maximum)
-}
