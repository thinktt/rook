-//! Provenance-owner witnesses; this module is a child of ordinary.
-//! These tests do not call the delta kernel with violated preconditions.
-use super::*;
-use crate::evaluator::Evaluator;
-
-const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
-
-fn legal(position: &Position, token: &str) -> Move {
-    let mut list = MoveList::new();
-    movegen::generate_legal(position, &mut list);
-    *list.as_slice().iter().find(|m| m.to_string() == token).unwrap()
-}
-
-#[test]
-fn delta_owner_raw_inputs_do_not_certify_map_or_child() {
-    let position = Position::from_fen(START).unwrap();
-    let mut evaluator = Evaluator::<true>::new(&position);
-    let parent = Node::root(position, &evaluator.root);
-    let movement = legal(&position, "e2e4");
-    let genuine = parent.child(&evaluator.root, movement);
-    let wrong_map = Influence { profiles: [[0; 64]; 2] };
-    assert_ne!(wrong_map, Influence::build(&position));
-    let raw = Predecessor::unlinked(&position, &wrong_map, false, Some(movement));
-    assert!(!raw.ordinary_child);
-    let mut current = CurrentInfluence::new(&genuine.position);
-    current.fill(&mut evaluator, raw);
-    assert_eq!(*current.trusted().influence, Influence::build(&genuine.position));
-    // Raw guard data is preserved, not repaired or silently replaced.
-    assert!(std::ptr::eq(raw.influence, &wrong_map));
-    assert_eq!(raw.influence.profiles, [[0; 64]; 2]);
-
-    let genuine_map = Influence::build(&position);
-    let unrelated = parent.child(&evaluator.root, legal(&position, "d2d4"));
-    assert_ne!(unrelated.position, genuine.position);
-    let raw = Predecessor::unlinked(&position, &genuine_map, false, Some(movement));
-    assert!(!raw.ordinary_child);
-    let mut current = CurrentInfluence::new(&unrelated.position);
-    current.fill(&mut evaluator, raw);
-    assert_eq!(*current.trusted().influence, Influence::build(&unrelated.position));
-    assert_eq!(evaluator.stats.influence_builds, 2);
-}
-
-#[test]
-fn delta_owner_fresh_entry_seeds_main_grandchild_and_same_child_retry() {
-    let position = Position::from_fen(START).unwrap();
-    let mut evaluator = Evaluator::<true>::new(&position);
-    let parent = Node::root(position, &evaluator.root);
-    let movement = legal(&position, "e2e4");
-    let child = parent.child(&evaluator.root, movement);
-    let wrong_map = Influence { profiles: [[0; 64]; 2] };
-    let incoming = Predecessor::unlinked(&position, &wrong_map, false, Some(movement));
-    let mut current = CurrentInfluence::new(&child.position);
-    assert_eq!(evaluator.stats.influence_builds, 0); // New performs no work.
-    current.fill(&mut evaluator, incoming);
-    let first_map = current.trusted().influence as *const Influence;
-    current.fill(&mut evaluator, incoming);
-    assert_eq!(first_map, current.trusted().influence as *const Influence);
-    assert!(std::ptr::eq(current.trusted().position, &child.position));
-    assert_eq!(evaluator.stats.influence_builds, 1);
-
-    let reply = legal(&child.position, "e7e5");
-    // Same-parent factory precondition: this exact Node supplies both the
-    // certified immutable position and the colocated actual main child.
-    let mut grandchild = child.child(&evaluator.root, reply);
-    let linked = Predecessor::main_child(current.trusted(), false, reply);
-    assert!(linked.ordinary_child);
-    let placement = grandchild.position;
-    let mut descendant = CurrentInfluence::new(&placement);
-    descendant.fill(&mut evaluator, linked);
-    let map = *descendant.trusted().influence;
-    assert_eq!(map, Influence::build(&grandchild.position));
-    descendant.fill(&mut evaluator, linked);
-    assert_eq!(evaluator.stats.influence_builds, 2);
-
-    // Actual full evaluation refreshes Retained while preserving Position.
-    let inherited = grandchild.retained;
-    let checked = movegen::in_check(&placement, placement.side);
-    evaluator.full(&mut grandchild, &map, checked);
-    assert_eq!(grandchild.position, placement);
-    assert_ne!(grandchild.retained, inherited);
-    assert_eq!(grandchild.retained.age, 0);
-    // A scout re-entry keeps that same child/predecessor but owns a new scratch
-    // event; it must not reconstruct/reset the refreshed child.
-    let refreshed = grandchild.retained;
-    let mut retry = CurrentInfluence::new(&placement);
-    retry.fill(&mut evaluator, linked);
-    assert_eq!(*retry.trusted().influence, map);
-    assert_eq!(grandchild.retained, refreshed);
-    assert_eq!(evaluator.stats.influence_builds, 3);
-}
