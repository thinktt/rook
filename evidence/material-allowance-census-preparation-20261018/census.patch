+/// The observer runs only on the original occupied ordinary-capture branch.
+pub(crate) fn frontier_estimate_observed<F: FnOnce(crate::types::Piece)>(
+    position: &Position,
+    root: &RootContext,
+    movement: Move,
+    checking: bool,
+    score: i32,
+    positional: i32,
+    progress: i32,
+    observer: F,
+) -> i32 {
     if movement.kind() != MoveKind::Ordinary || checking {
         return 10000;
     }
     if !position.board[movement.to().0 as usize].is_empty() {
+        observer(position.board[movement.to().0 as usize]);
         return score
             + quiescence_policy::allowance(root, position, &movement, positional, progress);
     }
