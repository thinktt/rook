+#[test]
+fn ordinary_delta_full_bytes_target_oracle_adversaries_and_legal_sample_work() {
+    let mut witnesses: Vec<(&str, Position, Move)> = vec![
+        ("all_collinear_rooks", setup(&[("h1",'K'),("h8",'k'),("a1",'R'),("b1",'R'),("c1",'Q')]), ordinary("c1","c2")),
+        ("all_collinear_diagonal", setup(&[("h1",'K'),("h8",'k'),("a1",'B'),("b2",'B'),("c3",'Q'),("d4",'Q')]), ordinary("d4","e4")),
+        ("queen_weak_no_restoration", setup(&[("h1",'K'),("h8",'k'),("a1",'R'),("a3",'Q'),("a5",'R'),("a7",'Q')]), ordinary("a3","b3")),
+        ("queen_arrival", setup(&[("h1",'K'),("h8",'k'),("a1",'R'),("b3",'Q'),("a5",'R'),("a7",'Q')]), ordinary("b3","a3")),
+        ("opposing_king_transparent_joined", setup(&[("h3",'K'),("c1",'k'),("a1",'R'),("e1",'Q')]), ordinary("e1","e2")),
+        ("own_king_blocks", setup(&[("c1",'K'),("h8",'k'),("a1",'R'),("e1",'Q')]), ordinary("e1","e2")),
+        ("forward_pawn_extra_occupied", setup(&[("h1",'K'),("h8",'k'),("a1",'B'),("c3",'P'),("d4",'n')]), ordinary("c3","c4")),
+        ("weak_pawn_extra_occupied", setup(&[("h1",'K'),("h8",'k'),("a1",'B'),("b2",'Q'),("c3",'B'),("d4",'P'),("e5",'n')]), ordinary("d4","d5")),
+        ("backward_pawn_no_extra", setup(&[("h1",'K'),("h8",'k'),("a7",'B'),("c1",'R'),("c5",'P')]), ordinary("c5","c6")),
+        ("same_key_from_and_to", setup(&[("h1",'K'),("h8",'k'),("c1",'R'),("c2",'P')]), ordinary("c2","c3")),
+        ("same_origin_two_directions", setup(&[("h2",'K'),("h8",'k'),("a1",'Q'),("a2",'N')]), ordinary("a2","c1")),
+        ("king_complete_contribution", setup(&[("d4",'K'),("h8",'k'),("a7",'b'),("c3",'N')]), ordinary("d4","e4")),
+        ("both_color_crossing_union", setup(&[("a2",'K'),("h8",'k'),("d4",'Q'),("d1",'R'),("a1",'B'),("d8",'r'),("h7",'b'),("e8",'q')]), ordinary("d4","e4")),
+        ("double_pawn_ep_side_effect", setup(&[("a1",'K'),("h8",'k'),("e2",'P'),("d4",'p')]), ordinary("e2","e4")),
+        ("moving_bishop_captures_rook", setup(&[("a1",'K'),("h8",'k'),("c1",'B'),("h6",'r')]), ordinary("c1","h6")),
+        ("opaque_blocker_all_origins", setup(&[("h1",'K'),("h8",'k'),("a1",'R'),("a2",'N'),("a4",'R'),("a6",'Q')]), ordinary("a6","b6")),
+    ];
+    for victim in ['p','n','b','r','q'] {
+        witnesses.push(("captured_complete_source", setup(&[("a1",'K'),("h8",'k'),("c3",'N'),("d5",victim)]), ordinary("c3","d5")));
+    }
+    let mut adversarial = 0;
+    for (_, parent, movement) in &witnesses {
+        for (position, mv) in [(*parent,*movement), reflect(parent,*movement)] {
+            transition(&position,mv); adversarial += 1;
+            transition(&reverse_groups(position),mv); adversarial += 1;
+        }
+    }
+    // Explicit physical carry boundaries, not expected runtime fixture answers.
+    let carry: [(Position, Move, u8, u8); 5] = [
+        (setup(&[("c3",'K'),("h8",'k'),("d8",'R'),("d6",'Q')]), ordinary("c3","b3"), 4, 3),
+        (setup(&[("a1",'K'),("h8",'k'),("d1",'Q'),("d8",'Q')]), ordinary("d1","e1"), 4, 2),
+        (setup(&[("a1",'K'),("h8",'k'),("d1",'R'),("d2",'R'),("d6",'R'),("d8",'R')]), ordinary("d2","e2"), 16, 12),
+        (setup(&[("a1",'K'),("h8",'k'),("b3",'N'),("b5",'N'),("c2",'N'),("c6",'N')]), ordinary("b3","a5"), 64, 48),
+        (setup(&[("a1",'K'),("h8",'k'),("b3",'N'),("b5",'N'),("c2",'N'),("c6",'N'),("e2",'N'),("e6",'N'),("f3",'N'),("f5",'N'),("c3",'P'),("e3",'P')]), ordinary("b3","a5"), 0, 240),
+    ];
+    for (parent,movement,before,after) in carry {
+        let (old,new,_,_) = transition(&parent,movement);
+        assert_eq!(old.code(Color::White,sq("d4")),before);
+        assert_eq!(new.code(Color::White,sq("d4")),after);
+        let (mirror,mv)=reflect(&parent,movement);
+        let (old,new,_,_)=transition(&mirror,mv);
+        assert_eq!(old.code(Color::Black,sq("d5")),before);
+        assert_eq!(new.code(Color::Black,sq("d5")),after);
+        adversarial += 2;
+    }
+
+    // Only this bounded, reproducible group is labelled legal sample economics.
+    // All candidate choices come from the existing complete legal generator.
+    let roots = [
+        "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+        "r3k2r/ppp2ppp/2npbn2/3Np3/2B1P3/2N2Q2/PPP2PPP/R3K2R w KQkq - 0 1",
+        "7k/1p3pp1/3r4/3Pp3/1R2P3/6K1/8/8 w - - 0 1",
+        "4k3/3p4/2n1b3/8/3P4/2N1B3/8/4K3 w - - 0 1",
+    ];
+    let mut rows=Vec::new();
+    let (mut writes_lower,mut writes_equal,mut writes_higher,mut zero_delta_writes)=(0,0,0,0);
+    let (mut rays_lower,mut rays_equal,mut rays_higher,mut zero_delta_rays)=(0,0,0,0);
+    let (mut fresh_writes,mut delta_writes,mut fresh_rays,mut delta_rays,mut copy_bytes)=(0u64,0u64,0u64,0u64,0u64);
+    let mut colors=[0usize;2]; let mut captures=0; let mut quiets=0;
+    for (root_index,fen) in roots.iter().enumerate() {
+        let mut parent=Position::from_fen(fen).unwrap();
+        assert!(!movegen::in_check(&parent,parent.side.opponent()));
+        let mut seed=0x6ad3_91f2_8e05_b7c1u64 ^ ((root_index as u64 + 1)*0x1020_3040);
+        for ply in 0..12 {
+            let mut legal=MoveList::new(); movegen::generate_legal(&parent,&mut legal);
+            if legal.len==0 { break; }
+            let ordinary:Vec<Move>=legal.as_slice().iter().copied().filter(|m|m.kind()==MoveKind::Ordinary).collect();
+            let mut selected=Vec::new();
+            if let Some(&m)=ordinary.iter().find(|m|!parent.board[m.to().0 as usize].is_empty()) { selected.push(m); }
+            if let Some(&m)=ordinary.iter().find(|m|parent.board[m.to().0 as usize].is_empty()) { selected.push(m); }
+            if !ordinary.is_empty() {
+                let m=ordinary[(next(&mut seed) as usize)%ordinary.len()];
+                if !selected.contains(&m) { selected.push(m); }
+            }
+            for movement in selected {
+                let (_,_,fresh,delta)=transition(&parent,movement);
+                let victim=parent.board[movement.to().0 as usize]; let captured=!victim.is_empty();
+                colors[parent.side.index()]+=1;
+                if captured {captures+=1;} else {quiets+=1;}
+                if delta.writes<fresh.writes {writes_lower+=1;} else if delta.writes==fresh.writes {writes_equal+=1;} else {writes_higher+=1;}
+                if delta.ray_calls<fresh.ray_calls {rays_lower+=1;} else if delta.ray_calls==fresh.ray_calls {rays_equal+=1;} else {rays_higher+=1;}
+                zero_delta_writes+=usize::from(delta.writes==0);zero_delta_rays+=usize::from(delta.ray_calls==0);
+                fresh_writes+=fresh.writes;delta_writes+=delta.writes;fresh_rays+=fresh.ray_calls;delta_rays+=delta.ray_calls;copy_bytes+=delta.scheduled_copy_bytes;
+                let material:usize=parent.counts.iter().flatten().map(|&n|n as usize).sum();
+                rows.push(format!("{{\"root\":{},\"ply\":{},\"move\":\"{}{}\",\"side\":{},\"mover_kind\":{},\"victim_kind\":{},\"pieces\":{},\"fresh\":{},\"delta\":{}}}",root_index,ply,movement.from(),movement.to(),parent.side.index(),parent.board[movement.from().0 as usize].kind().index(),if captured {victim.kind().index() as i32} else {-1},material,work_json(fresh),work_json(delta)));
+            }
+            // Walk every legal kind; nonordinary walk steps are never delta samples.
+            let choice=(next(&mut seed) as usize)%legal.len;
+            parent=parent.played_unchecked(legal.as_slice()[choice]);
+            parent.validate().unwrap();
+        }
+    }
+    assert!(rows.len()>=32 && rows.len()<=144 && colors.iter().all(|&n|n>0));
+    assert!(captures>0 && quiets>0);
+    println!("INFLUENCE_DELTA_KERNEL_SUMMARY {{\"scope\":\"conditional legal sample work, not production eligibility, CPU or traffic\",\"adversarial_transitions\":{},\"legal_pairs\":{},\"captures\":{},\"quiets\":{},\"white_pairs\":{},\"black_pairs\":{},\"writes_lower_equal_higher\":[{},{},{}],\"rays_lower_equal_higher\":[{},{},{}],\"zero_delta_writes\":{},\"zero_delta_rays\":{},\"fresh_writes\":{},\"delta_writes\":{},\"fresh_ray_calls\":{},\"delta_ray_calls\":{},\"scheduled_copy_bytes\":{},\"rows\":[{}]}}",adversarial,rows.len(),captures,quiets,colors[0],colors[1],writes_lower,writes_equal,writes_higher,rays_lower,rays_equal,rays_higher,zero_delta_writes,zero_delta_rays,fresh_writes,delta_writes,fresh_rays,delta_rays,copy_bytes,rows.join(","));
+}
