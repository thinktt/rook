+fn sq(name: &str) -> Square { Square::parse(name).unwrap() }
+fn ordinary(from: &str, to: &str) -> Move {
+    Move::new(sq(from), sq(to), MoveKind::Ordinary)
+}
+
+fn from_board(board: &[Piece; 64], side: Color) -> Position {
+    let mut ranks = Vec::new();
+    for rank in (0..8).rev() {
+        let mut text = String::new();
+        let mut empty = 0u8;
+        for file in 0..8 {
+            let piece = board[rank * 8 + file];
+            if piece.is_empty() { empty += 1; }
+            else {
+                if empty != 0 { text.push(char::from(b'0' + empty)); empty = 0; }
+                text.push(piece.fen_char());
+            }
+        }
+        if empty != 0 { text.push(char::from(b'0' + empty)); }
+        ranks.push(text);
+    }
+    Position::from_fen(&format!("{} {} - - 0 1", ranks.join("/"),
+        if side == Color::White { "w" } else { "b" })).unwrap()
+}
+fn setup(pieces: &[(&str, char)]) -> Position {
+    let mut board = [Piece::EMPTY; 64];
+    for &(name, letter) in pieces {
+        let at = sq(name).0 as usize;
+        assert!(board[at].is_empty(), "duplicate setup square {name}");
+        board[at] = Piece::from_fen(letter).unwrap();
+    }
+    from_board(&board, Color::White)
+}
+fn reflect(parent: &Position, movement: Move) -> (Position, Move) {
+    let mut board = [Piece::EMPTY; 64];
+    for (at, &piece) in parent.board.iter().enumerate() {
+        if !piece.is_empty() {
+            board[at ^ 56] = Piece::new(piece.color().opponent(), piece.kind());
+        }
+    }
+    (from_board(&board, parent.side.opponent()), Move::new(
+        Square(movement.from().0 ^ 56), Square(movement.to().0 ^ 56), MoveKind::Ordinary))
+}
+fn reverse_groups(mut parent: Position) -> Position {
+    for side in [Color::White, Color::Black] {
+        let mut start = 0;
+        for kind in PieceKind::ALL {
+            let end = start + parent.counts[side.index()][kind.index()] as usize;
+            parent.squares[side.index()][start..end].reverse();
+            start = end;
+        }
+    }
+    parent.validate().unwrap();
+    parent
+}
+
+// Target-centric: inspect each possible source and ONLY the cells strictly
+// between that source and this one target. No influence ray helper, direction
+// table, attack-bit query or fresh builder is called by this reference.
+fn target_reference(board: &[Piece; 64]) -> [[u8; 64]; 2] {
+    let mut result = [[0u8; 64]; 2];
+    for target in 0..64 {
+        let tf = (target % 8) as i32;
+        let tr = (target / 8) as i32;
+        for (source, &piece) in board.iter().enumerate() {
+            if source == target || piece.is_empty() { continue; }
+            let sf = (source % 8) as i32;
+            let sr = (source / 8) as i32;
+            let (dx, dy) = (tf - sf, tr - sr);
+            let side = piece.color();
+            let forward = if side == Color::White { 1 } else { -1 };
+            let direct = match piece.kind() {
+                PieceKind::Pawn if dx.abs() == 1 && dy == forward => Some(64),
+                PieceKind::Knight if dx.abs() * dy.abs() == 2 => Some(16),
+                PieceKind::King if dx.abs().max(dy.abs()) == 1 => Some(1),
+                _ => None,
+            };
+            let contribution = if let Some(value) = direct { Some(value) } else {
+                let diagonal = dx.abs() == dy.abs();
+                let orthogonal = dx == 0 || dy == 0;
+                let weight = match piece.kind() {
+                    PieceKind::Bishop if diagonal => Some(16),
+                    PieceKind::Rook if orthogonal => Some(4),
+                    PieceKind::Queen if diagonal || orthogonal => Some(2),
+                    _ => None,
+                };
+                weight.and_then(|mut value| {
+                    let distance = dx.abs().max(dy.abs());
+                    let (df, dr) = (dx.signum(), dy.signum());
+                    for step in 1..distance {
+                        let index = ((sr + dr * step) * 8 + sf + df * step) as usize;
+                        let obstacle = board[index];
+                        if obstacle.is_empty() { continue; }
+                        let friendly = obstacle.color() == side;
+                        match obstacle.kind() {
+                            PieceKind::King if !friendly => {},
+                            PieceKind::Queen if friendly => value = 1,
+                            PieceKind::Rook if friendly && orthogonal => {},
+                            PieceKind::Bishop if friendly && diagonal => {},
+                            PieceKind::Pawn if friendly && diagonal && dr == forward => {
+                                // The target itself is included without examining
+                                // its occupant; extra-square occupancy is immaterial.
+                                return (step + 1 == distance).then_some(value);
+                            },
+                            _ => return None,
+                        }
+                    }
+                    Some(value)
+                })
+            };
+            if let Some(weight) = contribution {
+                // Physical weights in Z/256Z, NOT adjusted-relation exclusion.
+                result[side.index()][target] = result[side.index()][target].wrapping_add(weight);
+            }
+        }
+    }
+    result
+}
+
+// Independent two-cell geometry admission for the deliberately broader sparse
+// witnesses. King safety/history reachability is NOT asserted for this group.
+fn ordinary_geometry(parent: &Position, movement: Move) {
+    assert_eq!(movement.kind(), MoveKind::Ordinary);
+    let from = movement.from(); let to = movement.to();
+    let mover = parent.board[from.0 as usize]; let victim = parent.board[to.0 as usize];
+    assert!(!mover.is_empty() && mover.color() == parent.side);
+    assert!(victim.is_empty() || (victim.color() != mover.color() && victim.kind() != PieceKind::King));
+    let dx = to.file() as i32 - from.file() as i32;
+    let dy = to.rank() as i32 - from.rank() as i32;
+    let clear = || {
+        let n = dx.abs().max(dy.abs());
+        (1..n).all(|i| parent.board[((from.rank() as i32 + dy.signum() * i) * 8
+            + from.file() as i32 + dx.signum() * i) as usize].is_empty())
+    };
+    let valid = match mover.kind() {
+        PieceKind::Pawn => {
+            let f = if mover.color() == Color::White { 1 } else { -1 };
+            let start = if mover.color() == Color::White { 1 } else { 6 };
+            to.rank() != 0 && to.rank() != 7 &&
+                ((dx == 0 && victim.is_empty() && (dy == f ||
+                    (dy == 2 * f && from.rank() == start && clear()))) ||
+                 (dx.abs() == 1 && dy == f && !victim.is_empty()))
+        },
+        PieceKind::Knight => dx.abs() * dy.abs() == 2,
+        PieceKind::King => dx.abs().max(dy.abs()) == 1,
+        PieceKind::Bishop => dx.abs() == dy.abs() && clear(),
+        PieceKind::Rook => (dx == 0 || dy == 0) && clear(),
+        PieceKind::Queen => (dx == 0 || dy == 0 || dx.abs() == dy.abs()) && clear(),
+    };
+    assert!(valid, "bad witness geometry: {from}{to}");
+}
+
+fn transition(parent: &Position, movement: Move) -> (Influence, Influence, DeltaWork, DeltaWork) {
+    parent.validate().unwrap();
+    ordinary_geometry(parent, movement);
+    let original = *parent;
+    let parent_map = Influence::build(parent);
+    assert_eq!(parent_map.profiles, target_reference(&parent.board));
+    let original_map = parent_map;
+    let context = RootContext::neutral(parent);
+    let node = Node::root(*parent, &context);
+    let original_node = node;
+    let child = node.child(&context, movement);
+    let original_child = child;
+    child.position.validate().unwrap();
+    // All reference/setup/transition work stays OUTSIDE either count region.
+    let expected = target_reference(&child.position.board);
+    count_work_begin();
+    let fresh = Influence::build(&child.position);
+    let fresh_work = count_work_end();
+    count_work_begin();
+    let derived = Influence::derive_ordinary(parent, &parent_map, &child.position, movement);
+    let delta_work = count_work_end();
+    assert_eq!(fresh.profiles, expected, "fresh oracle: {}{}", movement.from(), movement.to());
+    assert_eq!(derived.profiles, expected, "delta oracle: {}{}", movement.from(), movement.to());
+    assert_eq!(derived.profiles, fresh.profiles); // all128 bytes, both colors.
+    assert_eq!(*parent, original); assert_eq!(parent_map, original_map);
+    assert_eq!(node, original_node); assert_eq!(child, original_child);
+    assert_eq!(fresh_work.scheduled_copy_bytes, 0);
+    assert_eq!(delta_work.scheduled_copy_bytes, 128);
+    (parent_map, derived, fresh_work, delta_work)
+}
+
+fn work_json(work: DeltaWork) -> String {
+    format!("{{\"writes\":{},\"ray_calls\":{},\"direction_queries\":{},\"origins_considered\":{},\"scheduled_copy_bytes\":{}}}",
+        work.writes, work.ray_calls, work.direction_queries, work.origins_considered, work.scheduled_copy_bytes)
+}
+fn next(seed: &mut u64) -> u64 {
+    *seed ^= *seed << 13; *seed ^= *seed >> 7; *seed ^= *seed << 17; *seed
+}
