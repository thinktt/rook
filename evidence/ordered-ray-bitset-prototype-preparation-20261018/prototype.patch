+    #[inline]
+    pub(crate) fn sliding_ray_view(&self, side: Color) -> SlidingRayView {
+        let [a, b, c, black] = self.planes;
+        let occupied = a | b | c;
+        let own_color = if side == Color::Black { black } else { !black };
+        let enemy_color = if side == Color::Black { !black } else { black };
+        let own = occupied & own_color;
+        let enemy_kings = !a & b & c & enemy_color;
+        SlidingRayView { occupied, forbidden: own | enemy_kings }
     }
 
