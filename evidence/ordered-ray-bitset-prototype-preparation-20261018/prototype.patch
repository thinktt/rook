+    #[test]
+    fn sliding_ray_view_matches_coordinate_oracle_for_all_ray_occupancies_and_stop_tags() {
+        // Pure destination oracle deliberately uses offsets/mailbox, not MASKS,
+        // nearest-bit extraction or another ray-mask implementation.
+        fn coordinate(board: &[Piece; 64], source: Square, side: Color, direction: usize) -> Vec<Square> {
+            let (df, dr) = DIRECTIONS[direction];
+            let mut result = Vec::new();
+            let mut next = source.offset(df, dr);
+            while let Some(to) = next {
+                let piece = board[to.0 as usize];
+                if !piece.is_empty() && (piece.color() == side || piece.kind() == PieceKind::King) {
+                    break;
+                }
+                result.push(to);
+                if !piece.is_empty() { break; }
+                next = to.offset(df, dr);
+            }
+            result
+        }
+        for source in 0..64 {
+            let source = Square(source);
+            for direction in 0..8 {
+                let (df, dr) = DIRECTIONS[direction];
+                let mut squares = Vec::new();
+                let mut next = source.offset(df, dr);
+                while let Some(to) = next {
+                    squares.push(to);
+                    next = to.offset(df, dr);
+                }
+                for side in [Color::White, Color::Black] {
+                    // Every occupancy subset; every valid color/type for the
+                    // first blocker. Farther occupied tags also vary, but do
+                    // not affect the legal slider's geometric stopping point.
+                    for occupied in 0usize..(1usize << squares.len()) {
+                        for stop_side in [Color::White, Color::Black] {
+                            for stop_kind in PieceKind::ALL {
+                                let mut board = [Piece::EMPTY; 64];
+                                board[source.0 as usize] = Piece::new(side, PieceKind::Queen);
+                                let mut first = true;
+                                for (offset, square) in squares.iter().enumerate() {
+                                    if occupied & (1usize << offset) != 0 {
+                                        let piece = if first {
+                                            first = false;
+                                            Piece::new(stop_side, stop_kind)
+                                        } else {
+                                            Piece::new(if offset % 2 == 0 { side } else { side.opponent() },
+                                                PieceKind::ALL[offset % 6])
+                                        };
+                                        board[square.0 as usize] = piece;
+                                    }
+                                }
+                                let bits = AttackBits::from_board(&board);
+                                assert!(bits.matches_board(&board));
+                                let view = bits.sliding_ray_view(side);
+                                let expected = coordinate(&board, source, side, direction);
+                                let mut targets = view.targets(source, direction);
+                                let mut actual = Vec::new();
+                                while targets != 0 {
+                                    actual.push(SlidingRayView::take_nearest(&mut targets, direction));
+                                }
+                                assert_eq!(actual, expected,
+                                    "source={source} direction={direction} side={side:?} occupied={occupied} stop={stop_side:?}/{stop_kind:?}");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
 
