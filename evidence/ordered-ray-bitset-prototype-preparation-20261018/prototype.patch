 static MASKS: Masks = masks();
 
+/// Invocation-local legal-slider supply. No mutable tag planes escape.
+/// This is not evaluation Influence and treats both kings as blockers.
+#[derive(Clone, Copy)]
+pub(crate) struct SlidingRayView {
+    occupied: u64,
+    forbidden: u64,
+}
+
+impl SlidingRayView {
+    /// Geometric destinations, including a capturable first blocker only.
+    #[inline]
+    pub(crate) fn targets(&self, source: Square, direction: usize) -> u64 {
+        let ray = MASKS.rays[source.0 as usize][direction];
+        let blockers = self.occupied & ray;
+        let through_first = if blockers == 0 {
+            ray
+        } else {
+            let first = if MASKS.increasing[direction] {
+                blockers.trailing_zeros() as usize
+            } else {
+                (63 - blockers.leading_zeros()) as usize
+            };
+            // The blocker-origin ray omits its origin: keep that square,
+            // remove only farther squares, then exclude own pieces/kings.
+            ray & !MASKS.rays[first][direction]
+        };
+        through_first & !self.forbidden
+    }
+
+    /// Caller keeps the specified direction order and passes a nonempty mask.
+    /// Explicit extraction avoids an iterator or an order inferred from Color.
+    #[inline]
+    pub(crate) fn take_nearest(targets: &mut u64, direction: usize) -> Square {
+        debug_assert_ne!(*targets, 0);
+        let index = if MASKS.increasing[direction] {
+            targets.trailing_zeros()
+        } else {
+            63 - targets.leading_zeros()
+        };
+        *targets &= !(1u64 << index);
+        Square(index as u8)
+    }
+}
