+    #[test]
+    fn slider_bitset_order_keeps_source_chronology_and_actual_move_history() {
+        let position = Position::from_fen(
+            "7k/6pp/8/8/3Q3Q/2B3B1/1R3R2/K7 w - - 0 1").unwrap();
+        assert!(!in_check(&position, position.side));
+        compare_projection(&position, "slider chronology before");
+        let mut changed = position;
+        for kind in [PieceKind::Bishop, PieceKind::Rook, PieceKind::Queen] {
+            let sources = position.piece_squares(position.side, kind);
+            assert_eq!(sources.len(), 2);
+            let slots = sources.iter().map(|square| position.squares[position.side.index()]
+                .iter().position(|s| s == square).unwrap()).collect::<Vec<_>>();
+            changed.squares[position.side.index()].swap(slots[0], slots[1]);
+        }
+        assert_eq!(changed.board, position.board);
+        assert_eq!(changed.attack_view(), position.attack_view());
+        compare_projection(&changed, "slider chronology swapped");
+        for current in [&position, &changed] {
+            let mut generated = MoveList::new();
+            generate_legal(current, &mut generated);
+            for kind in [PieceKind::Bishop, PieceKind::Rook, PieceKind::Queen] {
+                let mut sources = generated.as_slice().iter()
+                    .filter(|m| current.board[m.from().0 as usize].kind() == kind)
+                    .map(|m| m.from()).collect::<Vec<_>>();
+                sources.dedup();
+                assert_eq!(sources.as_slice(), current.piece_squares(current.side, kind));
+            }
+        }
+        let mut history = Position::from_fen(START).unwrap();
+        for named in ["e2e4", "e7e5", "g1f3", "b8c6", "f1b5", "a7a6", "b5a4"] {
+            let mut generated = MoveList::new();
+            generate_legal(&history, &mut generated);
+            let movement = *generated.as_slice().iter().find(|m| m.to_string() == named).unwrap();
+            history = history.played_unchecked(movement);
+            assert!(history.attack_view().matches_board(&history.board));
+            compare_projection(&history, named);
+        }
+    }
