+fn sliding_pieces<const LIMIT: usize>(
+    position: &Position,
+    list: &mut MoveList,
+    safety: &GenerationSafety,
+    view: &crate::attacks::SlidingRayView,
+    kind: PieceKind,
+) {
+    #[cfg(test)]
+    if FORCE_PROJECTION.with(|forced| forced.get()) {
+        return coordinate_pieces::<LIMIT>(position, list, safety, kind);
+    }
+    let directions = match kind {
+        PieceKind::Bishop => 0..4,
+        PieceKind::Rook => 4..8,
+        PieceKind::Queen => 0..8,
+        _ => unreachable!(),
+    };
+    for &from in position.piece_squares(position.side, kind) {
+        for direction in directions.clone() {
+            let mut targets = view.targets(from, direction);
+            while targets != 0 {
+                let to = crate::attacks::SlidingRayView::take_nearest(&mut targets, direction);
+                add_if_safe(position, list, safety, Move::new(from, to, MoveKind::Ordinary));
+                if list.len >= LIMIT { return; }
+            }
+        }
+    }
+}
+
+// Keep the original coordinate producer independent of the proposed bitset
+// destination kernel. FORCE_PROJECTION also selects old mailbox safety.
+#[cfg(test)]
+fn coordinate_pieces<const LIMIT: usize>(
+    position: &Position,
+    list: &mut MoveList,
+    safety: &GenerationSafety,
+    kind: PieceKind,
+) {
+    let directions: &[(i8, i8)] = match kind {
+        PieceKind::Knight => &KNIGHT,
+        PieceKind::Bishop => &DIRECTIONS[..4],
+        PieceKind::Rook => &DIRECTIONS[4..],
+        PieceKind::Queen | PieceKind::King => &DIRECTIONS,
+        PieceKind::Pawn => unreachable!(),
+    };
+    let sliding = matches!(kind, PieceKind::Bishop | PieceKind::Rook | PieceKind::Queen);
+    for &from in position.piece_squares(position.side, kind) {
+        for &(df, dr) in directions {
+            let mut next = from.offset(df, dr);
+            while let Some(to) = next {
+                let victim = position.board[to.0 as usize];
+                if !victim.is_empty()
+                    && (victim.color() == position.side || victim.kind() == PieceKind::King)
+                {
+                    break;
+                }
+                add_if_safe(
+                    position,
+                    list,
+                    safety,
+                    Move::new(from, to, MoveKind::Ordinary),
+                );
+                if list.len >= LIMIT {
+                    return;
+                }
+                if !sliding || !victim.is_empty() {
+                    break;
+                }
+                next = to.offset(df, dr);
+            }
+        }
+    }
+}
