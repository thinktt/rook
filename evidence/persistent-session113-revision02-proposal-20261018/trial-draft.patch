+    #[test]
+    fn diagnostic_width_and_native_parameter_owner_preserve_unknowns_order_and_reset_exemption() {
+        let line=format!("cm_parm opk={} {}default cc=42 mycc=41 md=3 rnd=0",i32::MIN,"cc=1 ".repeat(220));
+        assert!(line.len()>1022&&line.len()<=2000);
+        let parsed=Setup::parse(&line,Mode::Public).unwrap();
+        let mut state=Session::<true>::default();let before=state.position();let origin=state.ledger.last();
+        parsed.apply(&mut state).unwrap();
+        assert_eq!((state.parameters.values[12],state.parameters.values[13]),(41,42));
+        assert_eq!(state.parameters.values[11],i32::MIN);
+        assert_eq!((state.parameters.values[27],state.parameters.values[24]),(3,0));
+        assert_eq!(state.position(),before);assert!(state.moves.is_empty());assert_eq!(state.ledger.last(),origin);
+        let long_name="Unknown_parameter_".to_owned()+&"x".repeat(1500);
+        let long=format!("cm_parm {long_name}=+0000000001");
+        assert!(long.split_ascii_whitespace().nth(1).unwrap().len()>1022&&long.len()<=2000);
+        let before=state.parameters.clone();
+        assert!(state.idle(&long).is_err()); // Unchanged ordinary-wire boundary.
+        Setup::parse(&long,Mode::Public).unwrap().apply(&mut state).unwrap();
+        assert_eq!(state.parameters,before); // Native unknown assignment has no effect.
+        let boundary=format!("force{}"," ".repeat(1995));
+        assert!(Setup::parse(&boundary,Mode::Public).is_ok());
+        assert!(Setup::parse(&(boundary+" "),Mode::Public).is_err());
+        assert!(Setup::parse("level +000 0005 -0",Mode::Public).is_ok());
+    }
+    #[test]
+    fn eager_storage_final_vectors_every_rnd_and_late_suffixes_have_distinct_boundaries() {
+        let good=explicit(Some(json!([".","post","?"])));
+        assert!(Public::parse(&json!({"searches":[good.clone()]}),Mode::Interrupted).is_ok());
+        for queued in [json!(["?","post"]),json!(["."]),json!([".",".",".",".","?"]),json!([false])] {
+            let mut bad=good.clone();bad["queued"]=queued;
+            assert!(Public::parse(&json!({"searches":[good.clone(),bad]}),Mode::Interrupted).is_err());
+        }
+        // Arbitrary stored values/unknown names are legal before overwrite or
+        // default. Each final vector is checked before any actual Session/search.
+        for token in ["md=-2147483648 cc=1001 sop=-1 tts=0 default md=3 rnd=0",
+            "md=21 cc=-1 cc=42 sop=101 sop=100 avd=101 avd=0 tts=0 tts=96 md=3 rnd=0",
+            "unknown_name=-2147483648 RND=2147483647 opk=-2147483648 md=3 rnd=0"] {
+            let mut q=good.clone();q["commands"][5]=json!(format!("cm_parm {token}"));
+            assert!(Public::parse(&json!({"searches":[q]}),Mode::Interrupted).is_ok());
+        }
+        for token in ["rnd=1 default md=3 rnd=0","opk=2147483648 md=3 rnd=0",
+            "1invalid=0 md=3 rnd=0","bad-name=0 md=3 rnd=0","unknown=-2147483649 md=3 rnd=0",
+            "md=21 rnd=0","cc=1001 md=3 rnd=0","sop=-1 md=3 rnd=0","tts=95 md=3 rnd=0",
+            "avd=101 md=3 rnd=0","cfd=-10001 md=3 rnd=0","ana=-1 md=3 rnd=0"] {
+            let mut bad=good.clone();bad["commands"][5]=json!(format!("cm_parm {token}"));
+            assert!(Public::parse(&json!({"searches":[good.clone(),bad]}),Mode::Interrupted).is_err());
+        }
+        let mut invalid=good.clone();invalid["commands"][5]=json!("cm_parm cc=1001 md=3 rnd=0");
+        let mut later_reset=good.clone();later_reset["commands"][5]=json!("cm_parm default md=3 rnd=0");
+        assert!(Public::parse(&json!({"searches":[invalid,later_reset]}),Mode::Interrupted).is_err());
+        // Public's final-rnd wording does not impose the other contracts'
+        // every-assignment rule on transient signed32 command storage.
+        for token in ["rnd=2147483647 md=999 rnd=0 md=3","rnd=-2147483648 default md=3 rnd=0"] {
+            let mut q=explicit(None);q["commands"][5]=json!(format!("cm_parm {token}"));
+            assert!(Public::parse(&json!({"searches":[q]}),Mode::Public).is_ok());
+        }
+        let mut q=explicit(None);q["commands"][5]=json!("cm_parm rnd=1 md=3");
+        assert!(Public::parse(&json!({"searches":[q]}),Mode::Public).is_err());
+        for token in ["rnd=-1 rnd=0 md=3","rnd=1001 default rnd=0 md=3"] {
+            let mut bad=explicit(None);bad["commands"][5]=json!(format!("cm_parm {token}"));
+            assert!(Public::parse(&json!({"systemSeconds":0,"searches":[explicit(None),bad]}),Mode::Clock).is_err());
+        }
+        let mut q=explicit(None);q["commands"][5]=json!("cm_parm unknown=7 rnd=1000 md=999 md=3");
+        let parsed=Public::parse(&json!({"systemSeconds":0,"searches":[q]}),Mode::Clock).unwrap();
+        assert_eq!((parsed.queries[0].expected.values[24],parsed.queries[0].expected.values[27]),(1000,3));
+        let mut q=explicit(None);q["commands"][5]=json!("cm_parm rnd=0 md=3 default");
+        assert!(Public::parse(&json!({"searches":[q]}),Mode::Public).is_err());
+        let mut q=explicit(None);q["commands"][5]=json!("cm_parm unknown_md=3 rnd=0");
+        assert!(Public::parse(&json!({"searches":[q]}),Mode::Public).is_err());
+    }
