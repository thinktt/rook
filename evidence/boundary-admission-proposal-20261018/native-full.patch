+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EvaluationBounds { pub lower:i32, pub upper:i32 }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EvaluationBoundReturn { Lower(i32), Upper(i32) }
+impl EvaluationBoundReturn {
+    #[inline]
+    pub fn score(self) -> i32 { match self { Self::Lower(score)|Self::Upper(score)=>score } }
+}
+impl EvaluationBounds {
+    #[inline]
+    pub fn cutoff(self, alpha:i32, beta:i32) -> Option<EvaluationBoundReturn> {
+        if self.lower >= beta { Some(EvaluationBoundReturn::Lower(self.lower)) }
+        else if self.upper <= alpha { Some(EvaluationBoundReturn::Upper(self.upper)) }
+        else { None }
+    }
+}
+/// These effective endpoints also initialize/clamp the later candidate search.
+#[inline]
+pub fn evaluation_bounds(ply:i32, target:i32, lower:i32, upper:i32) -> EvaluationBounds {
+    let (lower,upper) = if ply <= target/2 { (-10000,10000) } else { (lower,upper) };
+    EvaluationBounds { lower,upper }
