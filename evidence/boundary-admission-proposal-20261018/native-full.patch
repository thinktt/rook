+/// The caller charges entry before this ordered draw/clearing boundary.
+/// A mate leaf supplies upper=0 when reversal is unconditional.
+#[inline]
+pub fn early_draw(
+    history:&SearchHistory, ply:usize, checked:bool, analysis:i32, upper:i32, learning:&mut Learning,
+) -> bool {
+    if repetition_draw(history.repetition_count(checked),ply,analysis) { return true; }
+    learning.clear_next(ply);
+    upper <= 0 && history.short_reversal()
+}
+
+/// The ordinary caller supplies its original remaining depth and current ply.
+/// This gate runs before either ordinary or tactical entry charges a visit.
+#[inline]
+pub fn quiescence_handoff(depth: i32, ply: usize, maximum_depth: usize) -> bool {
+    depth <= 0 || ply == 63 || ply >= maximum_depth
+}
+
+/// Shared terminal score for a checked node without legal replies.
+#[inline]
+pub fn mate_score(ply: usize) -> i32 { ply as i32 - 10000 }
+
+/// SEARCH-MATE-LEAF component owner; this is not a full mate-search engine.
+/// The caller admits a reached target/final ply and charges its single entry.
+/// The legal-count dependency is requested only after all earlier returns.
+#[inline]
+pub fn mate_leaf<F: FnOnce() -> usize>(
+    history: &SearchHistory, ply: usize, checked: bool, analysis: i32,
+    learning: &mut Learning, legal_reply_count: F,
+) -> i32 {
+    if early_draw(history, ply, checked, analysis, 0, learning) { return 0; }
+    if ply == 63 || !checked { return 0; }
+    if legal_reply_count() == 0 { mate_score(ply) } else { 0 }
+}
