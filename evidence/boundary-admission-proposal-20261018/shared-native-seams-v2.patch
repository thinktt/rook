+    #[test]
+    fn effective_evaluation_bounds_use_absolute_floor_threshold_and_lower_priority_even_when_crossed() {
+        for (ply,target) in [(4,8),(4,9)] {
+            let bounds=evaluation_bounds(ply,target,10000,-10000);
+            assert_eq!((bounds.lower,bounds.upper),(-10000,10000));
+            assert_eq!(bounds.cutoff(-1,0),None);
+        }
+        let bounds=evaluation_bounds(5,9,10,-10);
+        assert_eq!(bounds.cutoff(-1,1),Some(EvaluationBoundReturn::Lower(10)));
+        assert_eq!(evaluation_bounds(5,9,0,100).cutoff(-1,0),Some(EvaluationBoundReturn::Lower(0)));
+        assert_eq!(evaluation_bounds(5,9,-100,0).cutoff(0,1),Some(EvaluationBoundReturn::Upper(0)));
+        assert_eq!(evaluation_bounds(5,9,-1,1).cutoff(-1,1),None);
+    }
