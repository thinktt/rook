+    #[test]
+    fn shared_early_draw_preserves_repetition_exception_clearing_and_null_reversal_order() {
+        let bare = || Position::from_fen("7k/8/8/8/8/8/8/K7 w - - 0 1").unwrap();
+        let mv = |from:&str,to:&str| Move::new(Square::parse(from).unwrap(),Square::parse(to).unwrap(),MoveKind::Ordinary);
+        let hint = mv("a1","b1");
+        // A twofold match across the pre-root boundary is admitted with ana!=0
+        // at ply1, clearing next preferences; ana0 returns before that clear.
+        let mut position = bare();position.primary=1;
+        let mut history = SearchHistory::new(&position);
+        for index in 1..=3 { position.primary=index+1;history.push(&position,None); }
+        history.mark_root();position.primary=1;position.halfmove=4;history.push(&position,None);
+        assert_eq!(history.repetition_count(false),2);
+        let mut learning = Learning::default();learning.killers[2]=[hint,Move::NONE];
+        assert!(early_draw(&history,1,false,0,1,&mut learning));
+        assert_eq!(learning.killers[2][0],hint);
+        assert!(!early_draw(&history,1,false,1,1,&mut learning));
+        assert_eq!(learning.killers[2],[Move::NONE;2]);
+        // Supplied endpoints can form a reversal independently of placement.
+        for (earlier,current,cycle) in [(Some(mv("g1","f3")),Some(mv("f3","g1")),true),
+            (None,Some(mv("f3","g1")),false),(Some(mv("g1","f3")),None,false),(None,None,false)]
+        {
+            let mut position=bare();let mut history=SearchHistory::new(&position);
+            history.push(&position,earlier);history.push(&position,None);
+            position.halfmove=3;history.push(&position,current);
+            assert_eq!(history.short_reversal(),cycle);
+            for upper in [-1,0,1] {
+                let mut learning=Learning::default();learning.killers[4]=[hint,Move::NONE];
+                learning.killers[64]=[hint,Move::NONE];
+                assert_eq!(early_draw(&history,3,false,0,upper,&mut learning),cycle && upper<=0);
+                assert_eq!(learning.killers[4],[Move::NONE;2]);
+                assert_eq!(learning.killers[64][0],hint);
+            }
+        }
+    }
