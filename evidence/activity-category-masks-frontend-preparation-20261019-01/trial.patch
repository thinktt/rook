+static ACTIVITY_RAY_MASKS: [[u64; 8]; 64] = activity_ray_masks();
+
+const fn activity_ray_masks() -> [[u64; 8]; 64] {
+    let mut masks = [[0u64; 8]; 64];
+    let mut source = 0;
+    while source < 64 {
+        let mut direction = 0;
+        while direction < 8 {
+            let (df, dr) = DIRECTIONS[direction];
+            let mut cursor = Square(source as u8);
+            while let Some(target) = cursor.offset(df, dr) {
+                masks[source][direction] |= 1u64 << target.0;
+                cursor = target;
+            }
+            direction += 1;
+        }
+        source += 1;
+    }
+    masks
+}
 
