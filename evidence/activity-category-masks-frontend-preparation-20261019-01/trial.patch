+#[inline]
+fn accumulate_batch_kind<const KIND: usize>(
+    position: &Position,
+    influence: &Influence,
+    view: &batch::Inputs,
+    class: &batch::ClassViews,
+    color: Color,
+    values: &'static DestinationValues,
+    marks: &mut Marks,
+    endgame: u16,
+    score: &mut i64,
+    queries: &mut u64,
+) {
+    let kind = PieceKind::ALL[KIND];
+    let mut weak = 0u64;
+    let mut strong = 0u64;
+    for &source in position.piece_squares(color, kind) {
+        let values = piece_destination_values::<KIND>(position, color, values);
+        let (mobility, direct) = batch_destinations::<KIND>(position, view, class, color, source, values);
+        weak |= direct & !class.direct.high;
+        strong |= direct & class.direct.high;
+        let (piece, work) = piece_score_kind::<KIND>(influence, color, source, mobility, endgame);
+        *score += piece;
+        *queries += work;
+    }
+    // OR-presence across this kind only; no mobility/query cross-source union.
+    for (mut targets, bit) in [(weak, 2 * (KIND - 1)), (strong, 2 * (KIND - 1) + 1)] {
+        while targets != 0 {
+            let target = targets.trailing_zeros() as usize;
+            marks[color.index()][target] |= 1u8 << bit;
+            targets &= targets - 1;
+        }
+    }
+}
+
+#[inline]
+fn category_value_sum(targets: u64, class: batch::Category, values: &[u8; 64]) -> i64 {
+    let mut result = 0i64;
+    // Sparse scans of the existing V row, not a dense bitplane dot product.
+    for category in 1..=3 {
+        let mut selected = targets & class.mask_for(category);
+        while selected != 0 {
+            let target = selected.trailing_zeros() as usize;
+            result += category as i64 * values[target] as i64;
+            selected &= selected - 1;
+        }
+    }
+    result
+}
+
+#[inline]
+fn activity_prefix(ray: u64, occupied: u64, increasing: bool) -> u64 {
+    let blockers = ray & occupied;
+    if blockers == 0 {
+        return ray;
+    }
+    let first = if increasing {
+        blockers & blockers.wrapping_neg()
+    } else {
+        1u64 << (63 - blockers.leading_zeros())
+    };
+    if increasing {
+        ray & (first | first.wrapping_sub(1))
+    } else {
+        ray & !first.wrapping_sub(1)
+    }
+}
