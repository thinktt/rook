 /// Weights are already owned by color; shelter remains the caller's composition.
 pub fn compute(
+    position: &Position,
+    influence: &Influence,
+    material_score: i32,
+    weights: [i32; 2],
+) -> Activity {
+    debug_assert!(weights.iter().all(|w| (0..=10_240).contains(w)));
+    // Presence follows the scalar source inventory, never inferred mailbox counts.
+    let present = [Color::White, Color::Black].map(|color| {
+        [PieceKind::Knight, PieceKind::Bishop, PieceKind::Rook, PieceKind::Queen]
+            .map(|kind| !position.piece_squares(color, kind).is_empty())
+    });
+    if !present.iter().flatten().any(|&value| value) {
+        return compute_scalar(position, influence, material_score, weights);
+    }
+    // Decode every mailbox tag without kind() before mixing any batch result.
+    // Malformed/unvisited tags retain the old scalar short-circuit/panic domain.
+    let Some(view) = batch::Inputs::new(position, influence) else {
+        return compute_scalar(position, influence, material_score, weights);
+    };
+    let phase = position.phase();
+    let mut marks = [[0u8; 64]; 2];
+    let mut raw_scores = [0i64; 2];
+    let mut relation_queries = 0;
+    for color in [Color::White, Color::Black] {
+        let [knights, bishops, rooks, queens] = present[color.index()];
+        let values = &DESTINATION_VALUES[color.index()];
+        if knights || bishops {
+            // The numerical direct minor class is shared, not geometry/scores.
+            let class = view.class_views(color, PieceKind::Knight, bishops);
+            if knights {
+                accumulate_batch_kind::<1>(position, influence, &view, &class, color,
+                    values, &mut marks, phase.endgame, &mut raw_scores[color.index()],
+                    &mut relation_queries);
+            }
+            if bishops {
+                accumulate_batch_kind::<2>(position, influence, &view, &class, color,
+                    values, &mut marks, phase.endgame, &mut raw_scores[color.index()],
+                    &mut relation_queries);
+            }
+        }
+        if rooks {
+            let class = view.class_views(color, PieceKind::Rook, true);
+            accumulate_batch_kind::<3>(position, influence, &view, &class, color,
+                values, &mut marks, phase.endgame, &mut raw_scores[color.index()],
+                &mut relation_queries);
+        }
+        if queens {
+            let class = view.class_views(color, PieceKind::Queen, false);
+            accumulate_batch_kind::<4>(position, influence, &view, &class, color,
+                values, &mut marks, phase.endgame, &mut raw_scores[color.index()],
+                &mut relation_queries);
+        }
+    }
+    finish_activity(position, material_score, weights, phase, raw_scores, &marks, relation_queries)
