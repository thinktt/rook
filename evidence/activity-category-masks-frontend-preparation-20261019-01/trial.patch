+/// Exact per-source C/T/R and every direct target, including category zero.
+/// Inputs owns only invocation-local planes of the actual mailbox/supplied map.
+fn batch_destinations<const KIND: usize>(
+    _position: &Position,
+    view: &batch::Inputs,
+    class: &batch::ClassViews,
+    color: Color,
+    source: Square,
+    values: &[u8; 64],
+) -> (Mobility, u64) {
+    let kind = PieceKind::ALL[KIND];
+    let board = &view.board;
+    let friendly = board.colors[color.index()];
+    let enemy = board.colors[color.opponent().index()];
+    let occupied = !board.empty;
+    let mut direct = 0u64;
+    let mut additional = 0u64;
+    let mut vertical_direct = 0u64;
+    let mut vertical_additional = 0u64;
+    if kind == PieceKind::Knight {
+        let targets = &KNIGHT_SOURCES[source.0 as usize];
+        for &target in &targets.squares[..targets.len as usize] {
+            debug_assert!(target < 64);
+            direct |= 1u64 << (target & 63);
+        }
+        direct &= !friendly;
+    } else {
+        let directions = match kind {
+            PieceKind::Bishop => 0..4,
+            PieceKind::Rook => 4..8,
+            PieceKind::Queen => 0..8,
+            _ => unreachable!("non-activity piece"),
+        };
+        for direction in directions {
+            let step = DIRECTIONS[direction];
+            let transparent = match kind {
+                PieceKind::Bishop => enemy | (friendly
+                    & (board.kinds[PieceKind::Knight.index()] | board.kinds[PieceKind::Rook.index()])),
+                PieceKind::Rook => {
+                    let mut allowed = (enemy & !board.kinds[PieceKind::Pawn.index()])
+                        | (friendly & board.kinds[PieceKind::Rook.index()]);
+                    let forward = if color == Color::White { 1 } else { -1 };
+                    if step.0 == 0 && step.1 == forward {
+                        allowed |= friendly & (board.kinds[PieceKind::Knight.index()]
+                            | board.kinds[PieceKind::Bishop.index()] | board.kinds[PieceKind::Queen.index()]);
+                    }
+                    allowed
+                }
+                PieceKind::Queen => 0,
+                _ => unreachable!("non-slider"),
+            };
+            let ray = ACTIVITY_RAY_MASKS[source.0 as usize][direction];
+            let increasing = step.0 as i16 + 8 * step.1 as i16 > 0;
+            let p = activity_prefix(ray, occupied, increasing);
+            let x = activity_prefix(ray, occupied & !transparent, increasing);
+            let d = p & !friendly;
+            let a = (x & !p) & !friendly;
+            // Rays are disjoint for one source. Different sources are never unioned here.
+            direct |= d;
+            additional |= a;
+            if kind == PieceKind::Rook && step.0 == 0 {
+                vertical_direct |= d;
+                vertical_additional |= a;
+            }
+        }
+    }
+    let categories = (direct & class.direct.low).count_ones() as i64
+        + 2 * (direct & class.direct.high).count_ones() as i64;
+    let mut total = category_value_sum(direct, class.direct, values);
+    if kind != PieceKind::Knight && kind != PieceKind::Queen {
+        total += category_value_sum(additional, class.additional, values);
+    }
+    if kind == PieceKind::Rook {
+        total += category_value_sum(vertical_direct, class.direct, values)
+            + category_value_sum(vertical_additional, class.additional, values);
+    }
+    (Mobility { categories, total, queries: additional.count_ones() as u64 }, direct)
 }
 
