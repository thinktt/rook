+#[inline]
+fn activity_prefix(ray: u64, occupied: u64, increasing: bool) -> u64 {
+    let blockers = ray & occupied;
+    if blockers == 0 {
+        return ray;
+    }
+    let first = if increasing {
+        blockers & blockers.wrapping_neg()
+    } else {
+        1u64 << (63 - blockers.leading_zeros())
+    };
+    if increasing {
+        ray & (first | first.wrapping_sub(1))
+    } else {
+        ray & !first.wrapping_sub(1)
+    }
 }
 
