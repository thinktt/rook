-        ("4k3/P7/8/8/8/8/8/4K3 w - - 0 1", "a7a8r"),
-        ("4k3/P7/8/8/8/8/8/4K3 w - - 0 1", "a7a8b"),
-        ("4k3/P7/8/8/8/8/8/4K3 w - - 0 1", "a7a8n"),
-        ("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "e1g1"),
-        ("4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1", "e5d6"),
