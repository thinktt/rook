 /// Plane b contains bit b of every target's wrapping byte. This is invocation-local.
 struct BitSums { planes: [u64; 8] }
 impl BitSums {
+    /// Fresh counter only: each target has at most one source per diagonal.
+    /// Keep both physical contributions where the two target masks overlap.
+    #[inline]
+    fn from_pawns(side: Color, pawns: u64) -> Self {
+        const FILE_A: u64 = 0x0101_0101_0101_0101;
+        const FILE_H: u64 = 0x8080_8080_8080_8080;
+        let (left, right) = if side == Color::White {
+            ((pawns & !FILE_A) << 7, (pawns & !FILE_H) << 9)
+        } else {
+            ((pawns & !FILE_A) >> 9, (pawns & !FILE_H) >> 7)
+        };
+        Self { planes: [0, 0, 0, 0, 0, 0, left ^ right, left & right] }
+    }
