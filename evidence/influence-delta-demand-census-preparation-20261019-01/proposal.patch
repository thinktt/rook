+/// Diagnostic-copy reporter; called only after the wire run has returned.
+/// A missing/partial report is a collector failure, never an engine decision.
+pub fn write_influence_demand_census(path: impl AsRef<std::path::Path>) -> std::io::Result<()> {
+    use std::io::Write;
+    let rows: [u64; 10] = std::array::from_fn(|index| {
+        FIRST_FILL_BY_ORIGIN[index].load(Ordering::Relaxed)
+    });
+    let eligible: u64 = (0..5).map(|origin| rows[origin * 2 + 1]).sum();
+    let unlinked: u64 = (0..5).map(|origin| rows[origin * 2]).sum();
+    let report = format!(
+        concat!(
+            "{{\"schema\":\"influence-delta-demand-census-v1\",",
+            "\"scope\":\"whole-native-process\",",
+            "\"fresh_build_entries\":{},\"update_entries\":{},",
+            "\"ordinary_first_fill_by_origin\":[",
+            "{{\"origin\":0,\"role\":\"raw\",\"unlinked\":{},\"eligible\":{}}},",
+            "{{\"origin\":1,\"role\":\"root\",\"unlinked\":{},\"eligible\":{}}},",
+            "{{\"origin\":2,\"role\":\"current-null\",\"unlinked\":{},\"eligible\":{}}},",
+            "{{\"origin\":3,\"role\":\"IIO\",\"unlinked\":{},\"eligible\":{}}},",
+            "{{\"origin\":4,\"role\":\"main\",\"unlinked\":{},\"eligible\":{}}}],",
+            "\"ready_hits\":{},\"ordinary_first_fill_total\":{},",
+            "\"ordinary_eligible_first_fill_total\":{},",
+            "\"ordinary_unlinked_first_fill_total\":{}}}\n",
+        ),
+        FRESH_BUILD_ENTRIES.load(Ordering::Relaxed), UPDATE_ENTRIES.load(Ordering::Relaxed),
+        rows[0], rows[1], rows[2], rows[3], rows[4], rows[5],
+        rows[6], rows[7], rows[8], rows[9], READY_HITS.load(Ordering::Relaxed),
+        eligible + unlinked, eligible, unlinked,
+    );
+    let mut output = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    output.write_all(report.as_bytes())
+}
