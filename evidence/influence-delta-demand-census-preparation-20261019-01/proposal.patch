+pub(crate) fn record_first_fill(origin: u8, eligible: bool) {
+    // Private Predecessor factories supply only the five declared roles.
+    let index = usize::from(origin) * 2 + usize::from(eligible);
+    FIRST_FILL_BY_ORIGIN[index].fetch_add(1, Ordering::Relaxed);
+}
+
+pub(crate) fn record_ready_hit() {
+    READY_HITS.fetch_add(1, Ordering::Relaxed);
+}
