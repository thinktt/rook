+static READY_HITS: AtomicU64 = AtomicU64::new(0);
+static FIRST_FILL_BY_ORIGIN: [AtomicU64; 10] = [
+    AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0),
