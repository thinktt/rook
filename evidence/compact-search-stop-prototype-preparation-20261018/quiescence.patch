+/// Recursive carrier only. The immutable segment budget remains in Search;
+/// public boundaries restore the configured limit, never the current counter.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum InternalStop {
+    NodeLimit,
+    WorkPoll,
+    InternalIterativeOrdering,
+    HostStop,
+    HostAbort,
+    HostIo(std::io::ErrorKind),
+}
+
+impl InternalStop {
+    pub(crate) fn from_public(stop: Stopped) -> Self {
+        match stop {
+            Stopped::NodeLimit(_) => Self::NodeLimit,
+            Stopped::WorkPoll => Self::WorkPoll,
+            Stopped::InternalIterativeOrdering => Self::InternalIterativeOrdering,
+            Stopped::HostStop => Self::HostStop,
+            Stopped::HostAbort => Self::HostAbort,
+            Stopped::HostIo(kind) => Self::HostIo(kind),
+        }
+    }
+
+    pub(crate) fn into_public(self, configured_limit: Option<u64>) -> Stopped {
+        match self {
+            Self::NodeLimit => Stopped::NodeLimit(
+                configured_limit.expect("internal NodeLimit requires a configured budget")),
+            Self::WorkPoll => Stopped::WorkPoll,
+            Self::InternalIterativeOrdering => Stopped::InternalIterativeOrdering,
+            Self::HostStop => Stopped::HostStop,
+            Self::HostAbort => Stopped::HostAbort,
+            Self::HostIo(kind) => Stopped::HostIo(kind),
+        }
+    }
+}
