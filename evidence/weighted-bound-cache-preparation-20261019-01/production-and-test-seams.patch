+    // Called only AFTER root binding, BEFORE the first ROOT_CACHE full call.
+    pub(crate) fn prepare_bound_cache(&mut self) {
+        if let Some(entries) = self.bound.as_mut() {
+            entries.fill(BoundEntry::EMPTY);
+        } else {
+            let mut entries = Vec::with_capacity(1024);
+            entries.resize_with(1024, || BoundEntry::EMPTY);
+            let entries: Box<[BoundEntry]> = entries.into_boxed_slice();
+            self.bound = Some(entries.try_into().ok().expect("fixed bound cache length"));
+        }
+        #[cfg(test)] { self.bound_events.epochs += 1; }
+    }
+    fn bound_index(position: &Position) -> usize {
+        ((position.primary ^ position.secondary.rotate_left(16)) & 1023) as usize
+    }
+    fn bound_get(&mut self, position: &Position) -> Option<BoundComponents> {
+        let key = position.attack_view();
+        debug_assert_ne!(key, crate::attacks::AttackBits::empty());
+        let entry = &self.bound.as_ref().expect("bound root not prepared")[Self::bound_index(position)];
+        let result = (entry.key == key).then_some(entry.value);
+        #[cfg(test)] {
+            self.bound_events.lookups += 1;
+            self.bound_events.hits += u64::from(result.is_some());
+        }
+        result
+    }
+    fn bound_insert(&mut self, position: &Position, value: BoundComponents) {
+        self.bound.as_mut().expect("bound root not prepared")[Self::bound_index(position)] =
+            BoundEntry { key: position.attack_view(), value };
+        #[cfg(test)] { self.bound_events.stores += 1; }
+    }
