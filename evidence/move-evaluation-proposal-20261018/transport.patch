+//! Forward native node transitions through explicitly selected full/fast work.
+use super::{array, evaluation_common::{self as common, Kind}, object, positions, text, Result};
+use rook2::{
+    evaluation::RootContext,
+    evaluator::{Evaluator, Node, Parameters},
+    movegen,
+    position::Position,
+    types::Color,
+};
+use serde_json::{json, Value};
+
+struct Step {
+    movement: Option<String>,
+    kind: Kind,
+}
+
+struct Request {
+    initial: Position,
+    initial_placement: String,
+    parameters: Parameters,
+    steps: Vec<Step>,
+}
+
+impl Request {
+    fn parse(input: &Value) -> Result<Self> {
+        object(input, &["fen", "percentages", "averageDepth", "cfd", "sop", "steps"])?;
+        let fen = text(&input["fen"])?;
+        let initial = positions::sequence_position(fen, true)?;
+        let initial_placement = fen.split(' ').next().unwrap().to_owned();
+        let parameters = common::parameters(input, true)?;
+        // Validate the full schema and every coordinate spelling before native
+        // evaluation. Legality/null admission depends on sequential actual state.
+        let steps = array(&input["steps"], 1, 256)?.iter().map(|value| {
+            object(value, &["move", "kind"])?;
+            let kind = Kind::parse(&value["kind"])?;
+            let movement = if value["move"].is_null() {
+                None
+            } else {
+                let spelling = text(&value["move"])?;
+                positions::coordinate(spelling)?;
+                Some(spelling.to_owned())
+            };
+            Ok(Step { movement, kind })
+        }).collect::<Result<Vec<_>>>()?;
+        Ok(Self { initial, initial_placement, parameters, steps })
+    }
+
+    fn observe(self) -> Result<Value> {
+        let mut evaluator = Evaluator::<true>::new(&self.initial);
+        evaluator.parameters = self.parameters;
+        evaluator.begin_search(&self.initial);
+        let mut node = Node::root(self.initial, &evaluator.root);
+        let mut initial = common::evaluate(&mut evaluator, &mut node, Kind::Full);
+        initial["state"] = positions::state(&node.position);
+        // Match the existing setup-move sequence's initial notation boundary.
+        initial["state"]["placement"] = json!(self.initial_placement);
+        initial["inherited"] = Value::Null;
+        let mut results = Vec::with_capacity(self.steps.len() + 1);
+        results.push(initial);
+        for step in self.steps {
+            node = transition(&node, &evaluator.root, step.movement.as_deref())?;
+            let inherited = common::retained_output(node.retained);
+            let mut output = common::evaluate(&mut evaluator, &mut node, step.kind);
+            output["state"] = positions::state(&node.position);
+            output["inherited"] = inherited;
+            results.push(output);
+        }
+        Ok(json!({"results":results}))
+    }
+}
+
+fn transition(node: &Node, root: &RootContext, spelling: Option<&str>) -> Result<Node> {
+    let child = if let Some(spelling) = spelling {
+        let movement = positions::legal_move(&node.position, spelling)?;
+        node.child(root, movement)
+    } else {
+        if [Color::White, Color::Black].into_iter()
+            .any(|side| movegen::in_check(&node.position, side))
+        {
+            return Err("null evaluation transition requires neither king in check".into());
+        }
+        node.null_child()
+    };
+    positions::bounded_material(&child.position)?;
+    Ok(child)
+}
+
+pub(super) fn dispatch(input: &Value) -> Result<Value> {
+    Request::parse(input)?.observe()
+}
