     #[test]
+    fn cache_probe_invokes_fresh_builder_only_on_full_identity_miss() {
+        let mut cache = PawnCache::new();
+        assert!(cache.select_with_builder(0, || panic!("zero identity must reuse")).reused);
+        let mut builds = 0;
+        assert!(!cache.select_with_builder(1, || {
+            builds += 1;
+            PawnStructure::EMPTY
+        }).reused);
+        assert!(cache.select_with_builder(1, || panic!("identity hit must reuse")).reused);
+        assert!(!cache.select_with_builder(2, || {
+            builds += 1;
+            PawnStructure::EMPTY
+        }).reused);
+        assert!(cache.select_with_builder(1, || panic!("other group must preserve hit")).reused);
+        assert!(!cache.select_with_builder(129, || {
+            builds += 1;
+            PawnStructure::EMPTY
+        }).reused);
+        assert!(!cache.select_with_builder(1, || {
+            builds += 1;
+            PawnStructure::EMPTY
+        }).reused);
+        assert_eq!(builds, 4);
+        cache.clear();
+        assert!(cache.select_with_builder(0, || panic!("clear restores zero reuse")).reused);
+    }
