+// All normalized bytes have an exact uncapped digit sum in 0..=11.
+const PROFILE_SUMS: [u8; 256] = {
+    let mut sums = [0; 256];
+    let mut code = 0;
+    while code < sums.len() {
+        let value = code as u8;
+        sums[code] = (value & 1)
+            + ((value >> 1) & 1)
+            + ((value >> 2) & 3)
+            + ((value >> 4) & 3)
+            + (value >> 6);
+        code += 1;
+    }
+    sums
+};
+
 /// Sum normalized digit counts without the relation multiplicity cap of four.
 #[inline]
 pub const fn profile_sum(code: u8) -> u8 {
-    (code & 1) + ((code >> 1) & 1) + ((code >> 2) & 3) + ((code >> 4) & 3) + (code >> 6)
+    PROFILE_SUMS[code as usize]
 }
 
