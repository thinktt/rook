+#[test]
+fn experiment52_actual_legal_walks_full_activity_and_supplied_map_authority() {
+    for fen in ["rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+        "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+        "7k/P7/8/3pP3/8/8/8/K7 w - d6 0 1"] {
+        let mut position=Position::from_fen(fen).unwrap();
+        for step in 0..12usize {
+            position.validate().unwrap();
+            for map in [Influence::build(&position),patterned(step as u32),Influence{profiles:[[255;64];2]}] {
+                compare(&position,&map,217,[10240,8192]);
+            }
+            let mut moves=crate::movegen::MoveList::new();crate::movegen::generate_legal(&position,&mut moves);
+            if moves.as_slice().is_empty() { break; }
+            let movement=moves.as_slice()[(step*17+3)%moves.as_slice().len()];
+            position=position.played_unchecked(movement);
+        }
+    }
+    let position=placed(&[("a1",'K'),("h8",'k'),("d4",'R'),("d5",'Q')]);
+    let zero=compare(&position,&Influence{profiles:[[0;64];2]},0,[1024,1024]);
+    let attacked=compare(&position,&Influence{profiles:[[0;64],[64;64]]},0,[1024,1024]);
+    assert_ne!(zero,attacked,"true route actually honors supplied map bytes, not a rebuilt map");
+}
