+        &[("a1",'K'),("h8",'k'),("d4",'R'),("e4",'Q'),("g4",'p')],
+        &[("a1",'K'),("h8",'k'),("d4",'R'),("c4",'R'),("a4",'r'),("d6",'r'),("d7",'p')],
+        &[("h1",'K'),("h8",'k'),("a1",'Q'),("c3",'q')],
+        &[("a1",'K'),("h8",'k'),("h1",'B'),("a8",'N')],
+        &[("h1",'K'),("h8",'k'),("d4",'N'),("c6",'B'),("e6",'r')],
+    ];
+    for pieces in cases { for symmetry in 0..8 { for flip in [false,true] {
+        let position=transformed(pieces,symmetry,flip);
+        let chronological=reverse_chronology(&position);
+        for map in [Influence::build(&position),patterned(0),patterned(7),Influence{profiles:[[255;64];2]}] {
+            let expected=compare(&position,&map,-217,[9173,10240]);
+            assert_eq!(compare(&chronological,&map,-217,[9173,10240]),expected);
+        }
+    } } }
+}
