+fn reverse_chronology(position: &Position) -> Position {
+    let mut result = *position;
+    for side in 0..2 {
+        let mut begin = 0;
+        for count in result.counts[side] {
+            let end = begin + usize::from(count);
+            result.squares[side][begin..end].reverse(); begin = end;
+        }
+    }
+    result.validate().unwrap(); result
+}
+fn transformed(pieces: &[(&str,char)], symmetry: usize, flip: bool) -> Position {
+    let mut cells = [' ';64];
+    for &(name,piece) in pieces {
+        let square=sq(name); let mut file=usize::from(square.file()); let mut rank=usize::from(square.rank());
+        if symmetry & 1 != 0 { file=7-file; }
+        if symmetry & 2 != 0 { rank=7-rank; }
+        if symmetry & 4 != 0 { std::mem::swap(&mut file,&mut rank); }
+        let piece=if flip { if piece.is_ascii_uppercase() { piece.to_ascii_lowercase() }
+            else { piece.to_ascii_uppercase() } } else { piece };
+        assert_eq!(cells[8*rank+file],' '); cells[8*rank+file]=piece;
+    }
+    let result=from_cells(cells); result.validate().unwrap(); result
+}
