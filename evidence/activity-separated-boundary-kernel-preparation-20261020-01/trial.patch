+// Invocation-local masks only; the referenced Position stays immutable.
+struct SliderGeometry {
+    occupied: u64,
+    friendly: u64,
+    opaque: u64,
+    forward_opaque: u64,
+}
+impl SliderGeometry {
+    fn new<const KIND: usize>(planes: &[u64; 4], color: Color) -> Self {
+        let occupied = planes[0] | planes[1] | planes[2];
+        let own = if color == Color::Black { planes[3] } else { !planes[3] };
+        let friendly = occupied & own;
+        let enemy = occupied & !own;
+        let pawns = planes[0] & !planes[1] & !planes[2];
+        let knights = !planes[0] & planes[1] & !planes[2];
+        let bishops = planes[0] & planes[1] & !planes[2];
+        let rooks = !planes[0] & !planes[1] & planes[2];
+        let queens = planes[0] & !planes[1] & planes[2];
+        let transparent = match KIND {
+            2 => enemy | (friendly & (knights | rooks)),
+            3 => (enemy & !pawns) | (friendly & rooks),
+            4 => 0,
+            _ => unreachable!("not an activity slider"),
+        };
+        let forward = if KIND == 3 {
+            transparent | (friendly & (knights | bishops | queens))
+        } else {
+            transparent
+        };
+        Self { occupied, friendly, opaque: occupied & !transparent,
+            forward_opaque: occupied & !forward }
+    }
+
+    fn destinations<const KIND: usize>(
+        &self, source: Square, direction: usize, color: Color,
+    ) -> (u64, u64, bool) {
+        let (rays, increasing) = crate::attacks::influence_rays(source);
+        let ray = rays[direction];
+        let increasing = increasing[direction];
+        let direct = through(ray, nearest(ray & self.occupied, increasing), increasing);
+        if KIND == 4 {
+            return (direct & !self.friendly, 0, increasing);
+        }
+        let forward = if color == Color::White { 4 } else { 5 };
+        let opaque = if KIND == 3 && direction == forward {
+            self.forward_opaque
+        } else {
+            self.opaque
+        };
+        let visited = through(ray, nearest(ray & opaque, increasing), increasing);
+        (direct & !self.friendly, (visited & !direct) & !self.friendly, increasing)
+    }
