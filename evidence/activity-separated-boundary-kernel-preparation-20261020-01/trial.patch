+#[test]
+fn experiment52_no_slider_true_custom_maps_and_lazy_inventory() {
+    for placement in ["7k/8/8/8/8/8/8/K7", "7k/5p2/8/8/8/8/2P5/K7",
+        "7k/5p2/3n4/8/8/2N5/2P5/K7"] {
+        let position=Position::from_fen(&format!("{placement} w - - 0 1")).unwrap();
+        for map in [patterned(5),Influence{profiles:[[0;64];2]},Influence{profiles:[[255;64];2]}] {
+            compare(&position,&map,217,[10240,8192]);
+        }
+    }
+    let mut inactive=placed(&[("h1",'K'),("h8",'k'),("d2",'P'),("e7",'p')]);
+    // Not active inventory: both no-slider routes must retain lazy mailbox behavior.
+    inactive.board[sq("c4").0 as usize]=Piece(7);
+    let map=patterned(9);
+    let expected=legacy_activity(&inactive,&map,0,[1024,1024]);
+    assert_eq!(compute_for_search(&inactive,&map,0,[1024,1024],true),expected);
+    assert_eq!(compute_for_search(&inactive,&map,0,[1024,1024],false),expected);
+    assert_eq!(compute(&inactive,&map,0,[1024,1024]),expected);
+}
