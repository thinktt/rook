+fn public_outcome(position: &Position,map: &Influence,route: u8) -> Result<Activity,()> {
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(||match route {
+        0=>legacy_activity(position,map,217,[9173,10240]),
+        1=>compute(position,map,217,[9173,10240]),
+        _=>compute_for_search(position,map,217,[9173,10240],false),
+    })).map_err(|_|())
+}
+#[test]
+fn experiment52_public_false_stale_raw_alias_and_lazy_panic_parity() {
+    // Direct mailbox mutation intentionally leaves private planes stale. All256 raw bytes:
+    // valid aliases, friendly short circuits, and reserved tags compare scalar outcomes.
+    for (source,target,piece) in [("d4","c6",'N'),("d4","e5",'B'),("d4","d5",'R'),("d4","e4",'Q')] {
+        let base=placed(&[("h1",'K'),("h8",'k'),(source,piece)]);
+        for raw in 0..=255u16 {
+            let mut stale=base;stale.board[sq(target).0 as usize]=Piece(raw as u8);
+            let map=patterned(raw as u32);
+            let expected=public_outcome(&stale,&map,0);
+            assert_eq!(public_outcome(&stale,&map,1),expected,"public raw={raw}");
+            assert_eq!(public_outcome(&stale,&map,2),expected,"false raw={raw}");
+        }
+    }
+    let mut unvisited=placed(&[("h1",'K'),("h8",'k'),("d2",'P')]);
+    unvisited.board[sq("a4").0 as usize]=Piece(7);
+    assert!(public_outcome(&unvisited,&patterned(0),0).is_ok());
+    assert_eq!(public_outcome(&unvisited,&patterned(0),1),public_outcome(&unvisited,&patterned(0),0));
+    assert_eq!(public_outcome(&unvisited,&patterned(0),2),public_outcome(&unvisited,&patterned(0),0));
+    let mut visited=placed(&[("h1",'K'),("h8",'k'),("d4",'R')]);
+    visited.board[sq("d5").0 as usize]=Piece(15); // Enemy invalid kind at an actual visited destination.
+    assert!(public_outcome(&visited,&patterned(0),0).is_err());
+    assert_eq!(public_outcome(&visited,&patterned(0),1),public_outcome(&visited,&patterned(0),0));
+    assert_eq!(public_outcome(&visited,&patterned(0),2),public_outcome(&visited,&patterned(0),0));
+}
