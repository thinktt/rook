+fn compare(position: &Position, map: &Influence, material: i32, weights: [i32; 2]) -> Activity {
+    let expected = legacy_activity(position, map, material, weights);
+    assert_eq!(activity_ref(position, map, material, weights), expected,
+        "independent coordinate/radix full numerical composition");
+    let position_before = *position;
+    let map_before = map.profiles;
+    for actual in [compute(position, map, material, weights),
+        compute_for_search(position, map, material, weights, false),
+        compute_for_search(position, map, material, weights, true)] {
+        assert_eq!(actual, expected, "complete Activity, including per-source R");
+        assert_eq!(crate::shelter::compute(position, map, actual.pressure, material, [9173,10240]),
+            crate::shelter::compute(position, map, expected.pressure, material, [9173,10240]),
+            "actual produced Activity pressure reaches shelter");
+    }
+    assert_eq!(*position, position_before);
+    assert_eq!(map.profiles, map_before);
+    expected
