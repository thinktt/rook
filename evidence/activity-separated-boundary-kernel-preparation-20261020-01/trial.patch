+    let seventh = if KIND == PieceKind::Rook.index() {
+        let king = position.piece_squares(color.opponent(), PieceKind::King)[0];
+        let rank = relative_rank(color, king);
+        rank == 7 || (rank == 6 && king.file() >= 6)
+    } else {
+        false
+    };
+    &values[usize::from(seventh)]
