+            "rootSide":"white","sideToMove":"white","averageDepth":0,
+            "percentages":{"own":percentages.clone(),"opponent":percentages},
+            "pawnOrder":{"white":["a2","b2","c2","d2","e2","f2","g2","h2"],
+                "black":["a7","b7","c7","d7","e7","f7","g7","h7"]}});
+        if final_score {
