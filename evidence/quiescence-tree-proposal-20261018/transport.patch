+    #[test]
+    fn whole_fixed_schema_is_checked_before_replay_and_ignored_settings_are_not_skipped() {
+        let mut input = promotion();
+        input["moves"] = json!(["a1a8"]); // well-formed but illegal at this position
+        input["rootMove"]["kind"] = json!(false);
+        match Request::parse(&input) {
+            Err(error)=>assert_eq!(error,"expected string"),
+            Ok(_)=>panic!("root descriptor schema must precede replay"),
+        }
+        for field in ["myk","opk","rnd","tts"] {
+            let mut input = promotion();
+            input["personalityParameters"][field] = json!(1);
+            assert!(Request::parse(&input).is_err());
+        }
+        for field in ["score","phase","pawnOrder","trace"] {
+            let mut input = promotion();input[field]=json!(0);
+            assert!(Request::parse(&input).is_err());
+        }
+        let mut input = promotion();input["controls"]["pondering"]=json!(true);
+        assert!(Request::parse(&input).is_err());
+        let mut input = promotion();input["controls"]["iterationDepth"]=json!(2);
+        assert!(Request::parse(&input).is_err());
+        let mut input = promotion();input["moves"]=json!(["é2e4"]);
+        assert!(Request::parse(&input).is_err());
+        let mut input = promotion();input["moves"]=json!(vec!["a1b1";256]);
+        assert!(Request::parse(&input).is_err());
+    }
+
+    #[test]
+    fn first_child_must_reach_actual_nonempty_ordering_even_when_native_search_returns() {
+        let input = request("7k/8/8/8/8/8/8/K7 w - - 0 1",&[],"a1b1","ordinary");
+        assert!(Request::parse(&input).is_ok());
+        assert!(dispatch(&input).unwrap_err().contains("first-list"));
+        // A one-node completed tree can still meet the boundary: a nonempty
