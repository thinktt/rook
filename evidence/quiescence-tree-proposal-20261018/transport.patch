+        assert!(Request::parse(&request("7k/8/5KQ1/8/8/8/8/8 w - - 0 1",&[],"g6g7","ordinary")).is_err());
+        let mut input = promotion();
+        input["rootMove"]["kind"] = json!("enPassant");
+        assert!(Request::parse(&input).is_err());
+        let mut input = promotion();
+        input["rootMove"]["move"] = json!("c7c8q");
