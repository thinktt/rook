+    #[test]
+    fn tree_setup_admits_wider_piece_populations_and_normalizes_before_ep_admission() {
+        let broad = request("7k/6pp/8/8/8/QQQQQQQQ/QQ6/K7 w - - 0 1",&[],"a1b1","ordinary");
+        let parsed = Request::parse(&broad).unwrap();
+        assert_eq!(parsed.root.counts[0][PieceKind::Queen.index()],10);
+        let normalized = request("7k/8/8/8/8/8/8/K7 w KQ e6 255 1",&[],"a1b1","ordinary");
+        let parsed = Request::parse(&normalized).unwrap();
+        assert_eq!(parsed.root.rights,0);
+        assert_eq!(parsed.root.ep,NO_SQUARE);
+        let ep = request("7k/8/8/3pP3/8/8/8/K7 w - d6 0 1",&[],"e5d6","enPassant");
+        assert!(Request::parse(&ep).is_ok());
+    }
