+    #[test]
+    fn tree_rejects_attacked_nonmoving_king_bad_retained_ep_and_wrong_selected_kind() {
+        for fen in ["7k/8/8/8/8/8/7R/7K w - - 0 1",
+            "7k/8/8/3nP3/8/8/8/K7 w - d6 0 1",
