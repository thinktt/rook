+    #[test]
+    fn public_history_and_selected_castle_define_one_fresh_fixed_root_boundary() {
+        let input = request("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+            &["e2e4","e7e5","g1f3","b8c6","f1b5","a7a6","b5a4","g8f6","e1g1","f8e7","f1e1","b7b5","a4b3","d7d6","c2c3"],"e8g8","castle");
+        let out = dispatch(&input).unwrap();
+        assert_eq!(out["nodes"],1);
+        let first = &out["trace"][0];
+        assert_eq!(first["ply"],1);
+        assert_eq!(first["target"],1);
+        assert_eq!(first["window"],json!({"lower":-10000,"upper":10000}));
+        assert_eq!(first["move"],input["rootMove"]);
+        assert_eq!(first["position"]["castling"],"-");
+        assert_eq!(first["position"]["halfmoveClock"],1);
+        assert_eq!(out["evaluations"][0]["parentRetained"]["evaluationAge"],0);
+        assert_eq!(out["evaluations"][0]["arrival"]["evaluationAge"],1);
+        assert_eq!(out["work"]["chargedRelationQueries"],6);
+    }
