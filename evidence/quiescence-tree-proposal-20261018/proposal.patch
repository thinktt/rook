+            } else { assert_eq!(stage.after.age,0); }
+            current.current = stage.after;
+            current.stages.push(stage);
+        }
+        fn ordered(&mut self) { self.ordered.push(*self.stack.last().unwrap()); }
+        fn leave(&mut self, index:usize, departure:Retained, _:i32, _: &[Move], work:Work) {
+            assert_eq!(self.stack.pop(),Some(index));
+            assert_eq!(departure,self.nodes[index].current);
+            assert!(work.charged_search_units > self.nodes[index].entry_work.charged_search_units);
+            self.nodes[index].leave_work = work;
+            self.leaves += 1;
+        }
+    }
+
+    fn observed_input<const D:bool>(fen:&str, token:&str) -> (Quiescence<D>,Node,SearchHistory,Entry,Retained) {
+        let position = Position::from_fen(fen).unwrap();
+        let mut search = Quiescence::new(&position);
+        let root = search.prepare_root(position);
+        let mut legal = MoveList::new();
+        movegen::generate_legal(&position,&mut legal);
+        let movement = *legal.as_slice().iter().find(|m| m.to_string()==token).unwrap();
+        let child = root.child(&search.evaluator.root,movement);
+        let mut history = SearchHistory::new(&position);
+        history.push(&child.position,Some(movement));
+        let entry = Entry { ply:1,target:1,iteration_depth:1,lower:-10000,upper:10000,
+            analysis:0,capture_exception:policy::capture_exception(&position,&movement) };
+        (search,child,history,entry,root.retained)
+    }
+
+    #[test]
+    fn observed_recursion_matches_plain_state_work_pv_and_shared_pawn_followup() {
+        fn check<const D:bool>() {
+            for (fen,token) in [
+                ("r3k3/1Pr5/8/8/8/8/8/4K3 b - - 0 1","c7c8"),
+                ("1N2k3/4r3/8/8/8/8/8/K3R3 w - - 0 1","b8d7"),
+                ("1r5k/7p/6Q1/8/8/3B4/8/K7 b - - 0 1","b8b6"),
+                ("1r5k/6pp/6Q1/8/8/3B4/8/K7 b - - 0 1","b8b7"),
+                ("4k3/8/8/8/3p4/8/4P3/4K3 w - - 0 1","e2e4"),
+                ("7k/8/5KQ1/8/8/8/8/8 w - - 0 1","g6g7"),
+            ] {
+                let (mut plain,mut a,mut ah,entry,_) = observed_input::<D>(fen,token);
+                let (mut traced,mut b,mut bh,_,parent) = observed_input::<D>(fen,token);
+                let mut trace = TestTrace::default();
+                let x = plain.search_subtree(&mut a,&mut ah,entry,Limits::default()).unwrap();
+                let y = traced.search_subtree_observed(&mut b,&mut bh,entry,Limits::default(),&parent,&mut trace).unwrap();
+                assert_eq!((x.score,&x.pv,x.work,x.stats,x.evaluations),(y.score,&y.pv,y.work,y.stats,y.evaluations));
+                assert_eq!(a,b);
+                assert_eq!(ah.search_ply(),1);
+                assert_eq!(ah.search_path(),bh.search_path());
+                assert!(trace.stack.is_empty());
+                assert_eq!(trace.leaves,trace.nodes.len());
+                assert_eq!(trace.nodes.len() as u64,y.stats.nodes);
+                let charges:u64 = trace.nodes.iter().flat_map(|n| &n.stages)
+                    .map(|s| s.evaluation.relation_queries).sum();
+                assert_eq!(charges,y.work.charged_relation_queries);
+                assert_eq!(trace.nodes[0].leave_work,y.work);
+                assert_eq!(trace.nodes[0].parent,None);
+                assert_eq!(trace.nodes[0].arrival.age,1);
+                // A subsequent full evaluation consumes the cache actually left by
+                // each recursive visit sequence, rather than a rolled-back copy.
+                let map = crate::influence::Influence::build(&a.position);
+                let checked = movegen::in_check(&a.position,a.position.side);
+                let mut ap = Node::root(a.position,&plain.evaluator.root);
+                let mut bp = Node::root(b.position,&traced.evaluator.root);
+                let mut ax = None;
+                let mut bx = None;
+                let av = plain.evaluator.full_detailed_observed(&mut ap,&map,checked,|v| ax=Some(v.pawn_entry_reused));
+                let bv = traced.evaluator.full_detailed_observed(&mut bp,&map,checked,|v| bx=Some(v.pawn_entry_reused));
+                assert_eq!((av,ap,ax),(bv,bp,bx));
+            }
+        }
+        check::<true>();
+        check::<false>();
+    }
+
+    #[test]
+    fn observation_wraps_draw_static_mate_and_terminal_returns_without_extra_stages() {
+        // A repetition admission return has an entry charge, no evaluator,
+        // and preserves next-ply killers exactly as the ordinary body does.
+        let (mut search,mut node,mut history,entry,parent) = observed_input::<true>(
+            "7k/8/8/8/8/8/8/K7 w - - 101 1","a1b1");
+        search.learning.killers[2] = [movement("a1","a2"),Move::NONE];
+        let mut trace = TestTrace::default();
+        let out = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((out.score,trace.leaves,trace.nodes[0].stages.len()),(0,1,0));
+        assert_eq!(search.learning.killers[2][0],movement("a1","a2"));
+        assert!(trace.ordered.is_empty());
+        // A wide material position with a very low beta returns from static
+        // selection before ordering; all actual fast/full calls remain visible.
+        let (mut search,mut node,mut history,mut entry,parent) = observed_input::<true>(
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","e2e4");
+        entry.upper = -9999;
+        let mut trace = TestTrace::default();
+        let _ = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((trace.leaves,trace.nodes[0].stages.len()),(1,1));
+        assert_eq!(trace.nodes[0].stages[0].kind,crate::evaluator::StageKind::Fast);
+        assert!(trace.ordered.is_empty());
+        // Native API permits checked entry even though the standalone tree
+        // diagnostic excludes its first child; no-reply mate has no stages.
+        let (mut search,mut node,mut history,entry,parent) = observed_input::<true>(
+            "7k/8/5KQ1/8/8/8/8/8 w - - 0 1","g6g7");
+        let mut trace = TestTrace::default();
+        let out = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((out.score,trace.leaves,trace.nodes[0].stages.len()),(-9999,1,0));
+        assert!(trace.ordered.is_empty());
+        // Terminal fast observes a single native call and keeps the aged pair.
+        let position = Position::from_fen("7k/8/8/8/8/8/8/K7 w - - 0 1").unwrap();
+        let mut search = Quiescence::<true>::new(&position);
+        let mut node = search.prepare_root(position);
+        let mut history = SearchHistory::new(&position);
+        for _ in 0..62 { node=node.null_child();history.push(&node.position,None); }
+        let parent = node.retained;
+        node=node.null_child();
+        history.push(&node.position,None);
+        let saved = node.retained;
+        let mut trace = TestTrace::default();
+        let entry = Entry { ply:63,target:63,iteration_depth:1,lower:-10000,upper:10000,analysis:0,capture_exception:false };
+        let _ = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((trace.leaves,trace.nodes[0].stages.len()),(1,1));
+        assert_eq!(trace.nodes[0].stages[0].kind,crate::evaluator::StageKind::Fast);
+        assert_eq!(node.retained,saved);
+        assert!(trace.ordered.is_empty());
+    }
+
+    #[test]
+    fn observed_resource_error_restores_history_and_does_not_invent_returns() {
+        let (mut search,mut node,mut history,entry,parent) = observed_input::<true>(
+            "r3k3/1Pr5/8/8/8/8/8/4K3 b - - 0 1","c7c8");
+        let mut trace = TestTrace::default();
+        let stopped = search.search_subtree_observed(&mut node,&mut history,entry,
+            Limits { nodes:Some(2) },&parent,&mut trace);
+        assert!(matches!(stopped,Err(Stopped::NodeLimit(2))));
+        assert_eq!(history.search_ply(),1);
+        assert_eq!(search.stats.nodes,2);
+        assert_eq!(trace.nodes.len(),2);
+        assert!(trace.leaves < trace.nodes.len());
+        // The external owner discards this incomplete sink instead of emitting
+        // a partial nested trace or treating a stop as a search score.
+        assert!(!trace.stack.is_empty());
+    }
