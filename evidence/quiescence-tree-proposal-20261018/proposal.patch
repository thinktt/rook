+    fn request(fen:&str, moves:&[&str], selected:&str, kind:&str) -> Value {
+        let parameters:serde_json::Map<String,Value> = FIXED.iter()
+            .map(|(name,value)|(name.to_string(),json!(value))).collect();
+        json!({"fen":fen,"moves":moves,"personalityParameters":parameters,
+            "rootMove":{"move":selected,"kind":kind},"controls":{"iterationDepth":1,
+            "rootPass":"first-unrestricted","learnedState":"fresh-ordinary-search","pondering":false}})
+    }
+    fn promotion() -> Value {
