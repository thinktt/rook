+        for _ in 0..62 { node=node.null_child();history.push(&node.position,None); }
+        let parent = node.retained;
+        node=node.null_child();
+        history.push(&node.position,None);
+        let saved = node.retained;
+        let mut trace = TestTrace::default();
+        let entry = Entry { ply:63,target:63,iteration_depth:1,lower:-10000,upper:10000,analysis:0,capture_exception:false };
+        let _ = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((trace.leaves,trace.nodes[0].stages.len()),(1,1));
+        assert_eq!(trace.nodes[0].stages[0].kind,crate::evaluator::StageKind::Fast);
+        assert_eq!(node.retained,saved);
+        assert!(trace.ordered.is_empty());
+    }
