+/// Cold observation stays outside Search/Node state and uses static dispatch.
+/// Methods and all snapshot arguments are guarded by ENABLED in the recursion.
+pub trait Observer {
+    const ENABLED: bool;
+    type Parent: Default;
+    type Frame: Default;
+    fn parent(retained: &Retained) -> Self::Parent;
+    fn enter(&mut self, position: &Position, entry: Entry, movement: Option<Move>,
+        parent: Self::Parent, arrival: Retained, checked: bool, work: Work) -> Self::Frame;
+    fn stage(&mut self, stage: EvaluationStage);
+    fn ordered(&mut self);
+    fn leave(&mut self, frame: Self::Frame, departure: Retained,
+        score: i32, pv: &[Move], work: Work);
+}
+
+struct NoTrace;
+impl Observer for NoTrace {
+    const ENABLED: bool = false;
+    type Parent = ();
+    type Frame = ();
+    fn parent(_: &Retained) {}
+    fn enter(&mut self, _: &Position, _: Entry, _: Option<Move>, _: (),
+        _: Retained, _: bool, _: Work) {}
+    fn stage(&mut self, _: EvaluationStage) {}
+    fn ordered(&mut self) {}
+    fn leave(&mut self, _: (), _: Retained, _: i32, _: &[Move], _: Work) {}
+}
