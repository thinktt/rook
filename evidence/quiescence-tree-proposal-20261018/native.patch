+    fn observed_input<const D:bool>(fen:&str, token:&str) -> (Quiescence<D>,Node,SearchHistory,Entry,Retained) {
+        let position = Position::from_fen(fen).unwrap();
+        let mut search = Quiescence::new(&position);
+        let root = search.prepare_root(position);
+        let mut legal = MoveList::new();
+        movegen::generate_legal(&position,&mut legal);
+        let movement = *legal.as_slice().iter().find(|m| m.to_string()==token).unwrap();
+        let child = root.child(&search.evaluator.root,movement);
+        let mut history = SearchHistory::new(&position);
+        history.push(&child.position,Some(movement));
+        let entry = Entry { ply:1,target:1,iteration_depth:1,lower:-10000,upper:10000,
+            analysis:0,capture_exception:policy::capture_exception(&position,&movement) };
+        (search,child,history,entry,root.retained)
+    }
