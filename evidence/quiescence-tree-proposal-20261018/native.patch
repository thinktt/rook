+    #[derive(Default)]
+    struct ObservedNode {
+        parent: Option<usize>, arrival: Retained, current: Retained,
+        stages: Vec<EvaluationStage>, entry_work: Work, leave_work: Work,
+    }
+    #[derive(Default)]
+    struct TestTrace { nodes: Vec<ObservedNode>, stack: Vec<usize>, ordered: Vec<usize>, leaves: usize }
+    impl Observer for TestTrace {
+        const ENABLED: bool = true;
+        type Parent = Retained;
+        type Frame = usize;
+        fn parent(retained: &Retained) -> Retained { *retained }
+        fn enter(&mut self, _: &Position, _: Entry, _: Option<Move>, parent: Retained,
+            arrival: Retained, _: bool, work: Work) -> usize
+        {
+            let parent_index = self.stack.last().copied();
+            if let Some(index) = parent_index { assert_eq!(parent,self.nodes[index].current); }
+            assert_eq!(arrival.positional,parent.positional);
+            assert_eq!(arrival.pawn_progress,parent.pawn_progress);
+            assert_eq!(arrival.age,parent.age.wrapping_add(1));
+            let index = self.nodes.len();
+            assert_eq!(work.charged_search_units,index as u64);
+            self.nodes.push(ObservedNode { parent:parent_index,arrival,current:arrival,
+                entry_work:work,..ObservedNode::default() });
+            self.stack.push(index);
+            index
+        }
+        fn stage(&mut self, stage: EvaluationStage) {
+            let current = &mut self.nodes[*self.stack.last().unwrap()];
+            assert_eq!(stage.before,current.current);
+            if stage.kind == crate::evaluator::StageKind::Fast {
+                assert_eq!(stage.before,stage.after);
+                assert_eq!(stage.evaluation.relation_queries,0);
+            } else { assert_eq!(stage.after.age,0); }
+            current.current = stage.after;
+            current.stages.push(stage);
+        }
+        fn ordered(&mut self) { self.ordered.push(*self.stack.last().unwrap()); }
+        fn leave(&mut self, index:usize, departure:Retained, _:i32, _: &[Move], work:Work) {
+            assert_eq!(self.stack.pop(),Some(index));
+            assert_eq!(departure,self.nodes[index].current);
+            assert!(work.charged_search_units > self.nodes[index].entry_work.charged_search_units);
+            self.nodes[index].leave_work = work;
+            self.leaves += 1;
+        }
+    }
