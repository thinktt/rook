+            let parsed=Request::parse(&q).unwrap();assert_eq!(parsed.history.pre_root_len(),1);
+            assert_eq!(parsed.root.side,rook2::types::Color::Black);
+        }
+        for fen in ["4k3/8/8/8/1b6/P7/2P4P/4K3 w - - 0 1",
+            "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1"] {
+            let mut q=request();q["fen"]=json!(fen);assert!(Request::parse(&q).is_err());
+        }
