+//! Exact generic numeric admission over the immediate native IIO-entry fence.
+use super::{actual_timed, array, boolean, integer, object, positions, text, unsigned32, Result};
+use rook2::{engine::Search, history::SearchHistory, movegen::{self, MoveList},
+    parameters::{Parameters, NAMES}, position::Position, quiescence::Limits,
+    timed::Controls};
+use serde_json::Value;
+
+struct Request { root:Position, history:SearchHistory, parameters:Parameters, seed:u32 }
+impl Request {
+    fn parse(input:&Value)->Result<Self> {
+        object(input,&["fen","moves","personalityParameters","seed","allowance","controls"])?;
+        let fen=text(&input["fen"])?;
+        object(&input["personalityParameters"],&NAMES)?;
+        let mut values=[0;30];
+        for (index,name) in NAMES.iter().enumerate() {
+            let (low,high)=match *name {
+                "myk"|"opk"|"ana"=>(0,0), "avd"=>(-100,100),
+                "cfd"=>(-10000,10000), "sop"=>(0,100), "sel"=>(0,64),
+                "rnd"=>(0,1000), "md"=>(6,99), "tts"=>(4194304,67108864),
+                _=>(0,1000),
+            };
+            values[index]=integer(&input["personalityParameters"][*name],low,high)?;
+        }
+        let seed=unsigned32(&input["seed"])?;
+        object(&input["allowance"],&["averageCs","maximumCs"])?;
+        integer(&input["allowance"]["averageCs"],1,1)?;
+        integer(&input["allowance"]["maximumCs"],1,1)?;
+        let controls=&input["controls"];
+        object(controls,&["completion","learnedState","pondering","analysis","seedSource","workOrigin"])?;
+        for (key,expected) in [("completion","natural-work-clock"),("learnedState","fresh-ordinary-search"),
+            ("seedSource","explicit"),("workOrigin","after-root-preparation")] {
+            if text(&controls[key])?!=expected { return Err(format!("unsupported generic timed {key}")); }
+        }
+        if boolean(&controls["pondering"])?||boolean(&controls["analysis"])? {
+            return Err("generic timed pondering/analysis must both be false".into());
+        }
+        let supplied=array(&input["moves"],0,255)?.iter().map(|value|{
+            let token=text(value)?;positions::coordinate(token)?;Ok(token)
+        }).collect::<Result<Vec<_>>>()?;
+        // Complete transport syntax precedes setup and actual legal replay.
+        // No seeded fixed vector, initial nonmoving-check or orthodox EP guard
+        // is imported: only the released reached-root conditions apply here.
+        let mut root=Position::from_fen(fen)?;
+        let mut history=SearchHistory::new(&root);
+        for token in supplied {
+            let mut legal=MoveList::new();movegen::generate_legal(&root,&mut legal);
+            let movement=legal.as_slice().iter().copied().find(|m|m.to_string()==token)
+                .ok_or_else(||format!("illegal generic timed history move: {token}"))?;
+            root=root.played_unchecked(movement);
+            history.push(&root,Some(movement));
+        }
+        history.mark_root();
+        if movegen::in_check(&root,root.side) { return Err("generic timed reached root is in check".into()); }
+        let mut legal=MoveList::new();movegen::generate_legal(&root,&mut legal);
+        if !(1..=256).contains(&legal.len) { return Err("generic timed root count is outside1..256".into()); }
+        Ok(Self{root,history,parameters:Parameters{values},seed})
+    }
+    fn observe(mut self)->Result<Value> {
+        let mut search=Search::<true>::new(&self.root);
+        self.parameters.bind(&mut search).map_err(|error|format!("parameter binding: {error:?}"))?;
+        let outcome=search.run_work_timed_without_iio(self.root,&mut self.history,
+            Controls{average_cs:1,maximum_cs:1,origin:0,seed:self.seed,
+                randomness:self.parameters.values[24] as u32,maximum_entered_iterations:6},
+            Limits{nodes:Some(8192)})
+            .map_err(|error|format!("generic timed search did not reach its admitted stop: {error:?}"))?;
+        if self.history.search_ply()!=0 { return Err("native generic timed history did not unwind".into()); }
+        // Immediate native rejection is primary; terminal zero-entry admission
+        // remains independent rather than treating any partial Outcome as success.
+        actual_timed::validate_natural(&outcome)?;
+        if outcome.seed!=self.seed||outcome.initial_candidates.len()>256 {
+            return Err("generic timed native seed/root domain changed".into());
+        }
+        actual_timed::project_natural(self.root,&outcome,search.evaluator.draw_preference,
+            search.config.selectivity)
+    }
+}
+pub(super) fn dispatch(input:&Value)->Result<Value> { Request::parse(input)?.observe() }
+
