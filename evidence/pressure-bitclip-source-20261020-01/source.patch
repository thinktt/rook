+    // Construct canonical coherent tags/lists directly, including geometric
+    // pawn blockers on edge ranks; those cases are not FEN-admission claims.
+    fn from_board(board: [Piece; 64]) -> Position {
+        let mut position = Position::from_fen("7k/8/8/8/8/8/8/K7 w - - 0 1").unwrap();
+        position.board = board;
+        position.counts = [[0; 6]; 2];
+        position.squares = [[Square(64); 16]; 2];
+        for color in [Color::White, Color::Black] {
+            let mut index = 0;
+            for kind in PieceKind::ALL {
+                for square in 0..64 {
+                    if board[square] == Piece::new(color, kind) {
+                        position.counts[color.index()][kind.index()] += 1;
+                        position.squares[color.index()][index] = Square(square as u8);
+                        index += 1;
+                    }
+                }
+            }
+        }
+        position.recompute_derived();
+        position
+    }
+
+    fn kings(defender: Color, source: Square) -> [Piece; 64] {
+        let mut board = [Piece::EMPTY; 64];
+        board[source.0 as usize] = Piece::new(defender, PieceKind::King);
+        board[(usize::from(source.0) + 32) % 64] = Piece::new(defender.opponent(), PieceKind::King);
+        board
+    }
+
+    fn admit_queen(board: &mut [Piece; 64], attacker: Color, excluded_ray: u64) {
+        let square = (0..64).find(|&s| board[s].is_empty() && excluded_ray & (1u64 << s) == 0).unwrap();
+        board[square] = Piece::new(attacker, PieceKind::Queen);
+    }
+
+    fn compare_pressure(position: &Position, defender: Color, salt: u8) {
+        let marks = std::array::from_fn(|c| std::array::from_fn(|s|
+            (s as u8).wrapping_mul(37).wrapping_add(salt).rotate_left(c as u32)));
+        assert_eq!(king_pressure_clipped(position, defender, &marks),
+                   king_pressure(position, defender, &marks));
+    }
+
+    #[test]
+    fn experiment61_clipped_pressure_matches_scalar_origins_blockers() {
+        for defender in [Color::White, Color::Black] {
+            for origin in 0..64 {
+                let source = Square(origin);
+                let empty_rays = from_board(kings(defender, source));
+                compare_pressure(&empty_rays, defender, 255);
+                for step in DIRECTIONS {
+                    let mut ray_mask = 0u64;
+                    let mut ray_cursor = source;
+                    while let Some(square) = ray_cursor.offset(step.0, step.1) {
+                        ray_mask |= 1u64 << square.0;
+                        ray_cursor = square;
+                    }
+                    let mut cursor = source;
+                    while let Some(target) = cursor.offset(step.0, step.1) {
+                        for color in [Color::White, Color::Black] {
+                            for kind in PieceKind::ALL {
+                                if kind == PieceKind::King && color == defender { continue; }
+                                let mut board = kings(defender, source);
+                                // Keep the sole opposing king off this ray unless
+                                // it is the tested first blocker itself.
+                                for piece in &mut board {
+                                    if *piece == Piece::new(defender.opponent(), PieceKind::King) {
+                                        *piece = Piece::EMPTY;
+                                    }
+                                }
+                                if kind != PieceKind::King {
+                                    let spare = (0..64).find(|&s| board[s].is_empty()
+                                        && ray_mask & (1u64 << s) == 0).unwrap();
+                                    board[spare] = Piece::new(defender.opponent(), PieceKind::King);
+                                }
+                                board[target.0 as usize] = Piece::new(color, kind);
+                                // A second opaque occupant must not affect the prefix.
+                                if let Some(behind) = target.offset(step.0, step.1) {
+                                    if board[behind.0 as usize].is_empty() {
+                                        board[behind.0 as usize] = Piece::new(color.opponent(), PieceKind::Knight);
+                                    }
+                                }
+                                admit_queen(&mut board, defender.opponent(), ray_mask);
+                                let position = from_board(board);
+                                for salt in [0, 3, 0xcc, 0xf0, 255] {
+                                    compare_pressure(&position, defender, salt);
+                                }
+                            }
+                        }
+                        cursor = target;
+                    }
+                }
+            }
+        }
+    }
