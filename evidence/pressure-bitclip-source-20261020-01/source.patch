+// The old scalar king_pressure is the public fallback and independent oracle.
+// The permission imports canonical, coherent placement planes, not map validity.
+fn king_pressure_clipped(position: &Position, defender: Color, marks: &Marks) -> i32 {
+    let source = position.piece_squares(defender, PieceKind::King)[0];
+    let attacker = defender.opponent();
+    let counts = position.counts[attacker.index()];
+    let orthogonal = counts[PieceKind::Rook.index()] != 0
+        || counts[PieceKind::Queen.index()] != 0;
+    let diagonal = counts[PieceKind::Bishop.index()] != 0
+        || counts[PieceKind::Queen.index()] != 0;
+    let mut pressure = 0;
+    if orthogonal || diagonal {
+        let planes = position.attack_planes();
+        let occupied = planes[0] | planes[1] | planes[2];
+        let attackers = occupied & if attacker == Color::Black { planes[3] } else { !planes[3] };
+        let (rays, increasing) = crate::attacks::influence_rays(source);
+        if orthogonal {
+            let mut targets = 0u64;
+            for direction in 4..8 {
+                targets |= pressure_ray_prefix(rays[direction], increasing[direction],
+                    occupied, attackers, direction);
+            }
+            while targets != 0 {
+                let target = targets.trailing_zeros() as usize;
+                targets &= targets - 1;
+                pressure += pressure_value(marks[attacker.index()][target] & 0xf0);
+            }
+        }
+        if diagonal {
+            let mut targets = 0u64;
+            for direction in 0..4 {
+                targets |= pressure_ray_prefix(rays[direction], increasing[direction],
+                    occupied, attackers, direction);
+            }
+            while targets != 0 {
+                let target = targets.trailing_zeros() as usize;
+                targets &= targets - 1;
+                pressure += pressure_value(marks[attacker.index()][target] & 0xcc);
+            }
+        }
+    }
+    if counts[PieceKind::Knight.index()] != 0 {
+        for step in KNIGHT {
+            if let Some(target) = source.offset(step.0, step.1) {
+                let piece = position.board[target.0 as usize];
+                if piece.is_empty() || piece.color() == defender {
+                    pressure += pressure_value(marks[attacker.index()][target.0 as usize] & 3);
+                }
+            }
+        }
+    }
+    (pressure - 12).max(0)
+}
+
+#[inline]
+fn pressure_ray_prefix(ray: u64, increasing: bool, occupied: u64,
+                       attackers: u64, direction: usize) -> u64 {
+    let blockers = ray & occupied;
+    if blockers == 0 {
+        return ray;
+    }
+    let index = if increasing { blockers.trailing_zeros() }
+                else { 63 - blockers.leading_zeros() };
+    let blocker = 1u64 << index;
+    let (outward, _) = crate::attacks::influence_rays(Square(index as u8));
+    let prefix = ray & !outward[direction];
+    if attackers & blocker != 0 { prefix & !blocker } else { prefix }
+}
