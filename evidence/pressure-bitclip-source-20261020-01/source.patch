+    #[test]
+    fn experiment61_full_private_geometry_preserves_maps_retained_and_observers() {
+        for fen in [
+            "7k/8/8/8/8/8/8/K7 w - - 0 1",
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1",
+            "r3k2r/ppp2ppp/2n1bn2/3qp3/3PP3/2N1BN2/PPP2PPP/R2QK2R w KQkq - 0 1",
+        ] {
+            let position = Position::from_fen(fen).unwrap();
+            for byte in [0u8, 1, 3, 16, 64, 0xcc, 0xf0, 255] {
+                let map = Influence { profiles: std::array::from_fn(|c|
+                    std::array::from_fn(|s| byte.wrapping_add((s as u8).wrapping_mul(29)).rotate_left(c as u32))) };
+                for checked in [false, true] {
+                    let mut scalar = Evaluator::<true>::new(&position);
+                    let mut clipped = Evaluator::<true>::new(&position);
+                    scalar.parameters.own[7] = 1000;
+                    scalar.parameters.opponent[7] = 25;
+                    clipped.parameters = scalar.parameters.clone();
+                    scalar.begin_search(&position);
+                    clipped.begin_search(&position);
+                    let mut a = Node::root(position, &scalar.root);
+                    let mut b = a;
+                    for _ in 0..2 {
+                        let expected = scalar.full(&mut a, &map, checked);
+                        let actual = clipped.full_for_search(&mut b, &map, checked, true);
+                        assert_eq!(actual, expected);
+                        assert_eq!(a.retained, b.retained);
+                        assert_eq!(stats(&scalar), stats(&clipped));
+                    }
+                    let mut seen = None;
+                    let observed = clipped.full_observed(&mut b, &map, checked, |parts| seen = Some(parts));
+                    assert_eq!(observed, scalar.full(&mut a, &map, checked));
+                    assert!(seen.is_some());
+                    assert_eq!(a.retained, b.retained);
+                }
+            }
+        }
+        // Stale public planes never authorize clipping. Repaired fingerprints
+        // are copied over without replacing the deliberately stale planes.
+        let mut stale = Position::from_fen("7k/8/8/8/7R/8/8/K7 w - - 0 1").unwrap();
+        let from = Square::parse("h4").unwrap();
+        let to = Square::parse("g4").unwrap();
+        stale.board[from.0 as usize] = Piece::EMPTY;
+        stale.board[to.0 as usize] = Piece::new(Color::White, PieceKind::Rook);
+        for square in &mut stale.squares[0] { if *square == from { *square = to; } }
+        let mut repaired = stale;
+        repaired.recompute_derived();
+        stale.primary = repaired.primary;
+        stale.secondary = repaired.secondary;
+        stale.pawn = repaired.pawn;
+        stale.starting_units = repaired.starting_units;
+        assert_ne!(stale.attack_planes(), repaired.attack_planes());
+        let map = Influence { profiles: [[255; 64]; 2] };
+        let mut public = Evaluator::<true>::new(&stale);
+        let mut observed = Evaluator::<true>::new(&stale);
+        let mut a = Node::root(stale, &public.root);
+        let mut b = a;
+        assert_eq!(public.full(&mut a, &map, false),
+                   observed.full_observed(&mut b, &map, false, |_| {}));
+        assert_eq!(a.retained, b.retained);
+    }
