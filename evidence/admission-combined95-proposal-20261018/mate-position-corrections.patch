+
+    #[test]
+    fn mate_position_partial_rights_preserve_native_wings_with_asymmetric_obstruction() {
+        for (fen, expected_castle) in [
+            ("3k4/8/8/8/8/8/8/RN2K2R w K -", "e1g1"),
+            ("3k4/8/8/8/8/8/8/R3K1NR w Q -", "e1c1"),
+            ("rn2k2r/8/8/8/8/8/8/3K4 b k -", "e8g8"),
+            ("r3k1nr/8/8/8/8/8/8/3K4 b q -", "e8c8"),
+        ] {
+            let parsed=MatePosition::parse(&json!({"fen":fen,"searchPly":1})).unwrap();
+            // These supported flags survive native setup; compare the full
+            // real inventory so swapping a wing cannot hide behind equal counts.
+            let reference=Position::from_fen(&format!("{fen} 0 1")).unwrap();
+            assert_eq!(parsed.position.rights, reference.rights);
+            let mut actual=MoveList::new();movegen::generate_legal(&parsed.position,&mut actual);
+            let mut expected=MoveList::new();movegen::generate_legal(&reference,&mut expected);
+            assert_eq!(actual.as_slice(),expected.as_slice());
+            let castles:Vec<_>=actual.as_slice().iter()
+                .filter(|movement|movement.kind()==rook2::types::MoveKind::Castle)
+                .map(ToString::to_string).collect();
+            assert_eq!(castles,vec![expected_castle.to_owned()]);
+            assert_eq!(parsed.observe()["legalReplies"],expected.len);
+        }
+    }
+}
