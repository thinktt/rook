+    fn reverse_child_oracle_groups(position: &mut Position) {
+        for color in [Color::White, Color::Black] {
+            let mut start = 0usize;
+            for kind in PieceKind::ALL {
+                let end = start + position.counts[color.index()][kind.index()] as usize;
+                position.squares[color.index()][start..end].reverse();
+                start = end;
+            }
+        }
+    }
