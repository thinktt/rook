+    #[test]
+    fn supplied_projection_children_match_entire_default_nodes_on_broad_pseudo_and_legal_sets() {
+        let fixed_root = Position::from_fen(
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+        ).unwrap();
+        let root = crate::evaluation::RootContext::neutral(&fixed_root);
+        let mut state = 0xad91_8b72_430e_6cf5;
+        let mut pseudo_count = 0usize;
+        let mut legal_count = 0usize;
+        let mut unsafe_count = 0usize;
+        let ages = [0, 1, 127, 254, 255];
+        for iteration in 0..10_000 {
+            let mut position = constructed(&mut state);
+            position.halfmove = [0, 99, 100, 254, 255][iteration % 5];
+            reverse_child_oracle_groups(&mut position);
+            let mut pseudo = MoveList::new();
+            crate::tactical::generate(&position, &mut pseudo);
+            // Compare every candidate before legality or Q policy filtering.
+            for &movement in pseudo.as_slice() {
+                let child = compare_projected_child(position, movement, &root, ages[iteration % 5]);
+                let king = child.position.piece_squares(position.side, PieceKind::King)[0];
+                unsafe_count += usize::from(child.position.attack_view().attacked(king, position.side.opponent()));
+                pseudo_count += 1;
+            }
+            if iteration < 500 {
+                let mut legal = MoveList::new();
+                movegen::generate_legal(&position, &mut legal);
+                for &movement in legal.as_slice() {
+                    compare_projected_child(position, movement, &root, ages[iteration % 5]);
+                    legal_count += 1;
+                }
+            }
+        }
+        assert!(pseudo_count > 0 && legal_count > 0);
+        assert!(unsafe_count > 0, "the child oracle must not become legal-only");
+    }
