+    fn compare_projected_child(
+        position: Position, movement: Move, root: &crate::evaluation::RootContext, age: u8,
+    ) -> crate::evaluator::Node {
+        use crate::evaluator::Node;
+        let mut parent = Node::root(position, root);
+        parent.retained.positional = -719;
+        parent.retained.pawn_progress = 283;
+        parent.retained.age = age;
+        let saved = parent;
+        let projected = position.attack_view().projected(&position, movement);
+        let expected = parent.child(root, movement);
+        let actual = parent.child_with_projection(root, movement, projected);
+        assert_eq!(actual, expected, "{movement} from {}", position.placement());
+        assert_eq!(parent, saved);
+        let mut rebuilt = actual.position;
+        rebuilt.recompute_derived();
+        assert_eq!(actual.position, rebuilt);
+        assert_eq!(actual.retained.nonking_squares, root.nonking_square_balance(&actual.position));
+        assert_eq!(actual.retained.positional, parent.retained.positional);
+        assert_eq!(actual.retained.pawn_progress, parent.retained.pawn_progress);
+        assert_eq!(actual.retained.age, age.wrapping_add(1));
+        actual
+    }
