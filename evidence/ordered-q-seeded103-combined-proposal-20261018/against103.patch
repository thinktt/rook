+            // KNIGHT_SOURCES, not numeric square order, emits f6 before d2.
+            ("8/8/5N2/8/4k3/8/8/K4N2 w - - 0 1", "f1d2", ["f6", "d2"], (true, true), false),
+            // An unsafe king capture still participates at its ray's position,
