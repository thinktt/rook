+        assert_eq!(
+            output["results"][1],
+            json!({"advancePressure":0,"occupiedPressure":0,"rookLine":0})
+        );
+        assert!(dispatch(
+            "evaluation.pawnPressure",
+            &json!({"queries":[
+            {"placement":"k7/p7/8/8/8/8/8/7K","pawnSquare":"a7"}]})
+        )
