+        assert!(adaptive(&json!({"queries":[bad]})).is_err());
+        let full = sequence(0, (0..64).map(|_| event("poll-check", 0, 1)).collect());
+        assert!(adaptive(&json!({"queries":vec![full;65]})).is_err());
+    }
+    #[test]
+    fn adaptive_skipped_reads_depth_jumps_and_modular_shifts_keep_native_state() {
+        let stages = [
+            "root-check",
+            "best-change",
+            "best-change",
+            "iteration-check",
+            "poll-check",
+        ];
+        let depths = [1, 3, 7, 7, 7];
+        let clocks = [0, 10, 30, 40, 500];
+        let make = |start: u32| {
+            sequence(
+                start,
+                stages
+                    .iter()
+                    .zip(depths)
+                    .zip(clocks)
+                    .map(|((&stage, depth), clock)| event(stage, start.wrapping_add(clock), depth))
+                    .collect(),
+            )
+        };
+        let output = adaptive(&json!({"queries":[make(0),make(u32::MAX-20)]})).unwrap();
+        assert_eq!(output["sequences"][0], output["sequences"][1]);
+        let after = &output["sequences"][0]["afterEach"];
+        assert_eq!(after[0]["clockReads"], 1);
+        assert_eq!(after[1]["clockReads"], 1);
+        assert_eq!(after[2]["changes"], json!([1, 1, 0]));
