+            "events":[{"placement":"7k/8/8/8/8/8/8/K7","side":"white","ply":1,"depth":0,
+                "move":{"move":"a1a2","kind":"ordinary"},"times":1},{"reset":true}]});
+        let result = cutoff_memory(&query).unwrap();
