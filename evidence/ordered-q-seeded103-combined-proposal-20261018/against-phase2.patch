+    #[test]
+    fn observation_wraps_draw_static_mate_and_terminal_returns_without_extra_stages() {
+        // A repetition admission return has an entry charge, no evaluator,
+        // and preserves next-ply killers exactly as the ordinary body does.
+        let (mut search,mut node,mut history,entry,parent) = observed_input::<true>(
+            "7k/8/8/8/8/8/8/K7 w - - 101 1","a1b1");
+        search.learning.killers[2] = [movement("a1","a2"),Move::NONE];
+        let mut trace = TestTrace::default();
+        let out = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((out.score,trace.leaves,trace.nodes[0].stages.len()),(0,1,0));
+        assert_eq!(search.learning.killers[2][0],movement("a1","a2"));
+        assert!(trace.ordered.is_empty());
+        // A wide material position with a very low beta returns from static
+        // selection before ordering; all actual fast/full calls remain visible.
+        let (mut search,mut node,mut history,mut entry,parent) = observed_input::<true>(
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","e2e4");
+        entry.upper = -9999;
+        let mut trace = TestTrace::default();
+        let _ = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((trace.leaves,trace.nodes[0].stages.len()),(1,1));
+        assert_eq!(trace.nodes[0].stages[0].kind,crate::evaluator::StageKind::Fast);
+        assert!(trace.ordered.is_empty());
+        // Native API permits checked entry even though the standalone tree
+        // diagnostic excludes its first child; no-reply mate has no stages.
+        let (mut search,mut node,mut history,entry,parent) = observed_input::<true>(
+            "7k/8/5KQ1/8/8/8/8/8 w - - 0 1","g6g7");
+        let mut trace = TestTrace::default();
+        let out = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((out.score,trace.leaves,trace.nodes[0].stages.len()),(-9999,1,0));
+        assert!(trace.ordered.is_empty());
+        // Terminal fast observes a single native call and keeps the aged pair.
+        let position = Position::from_fen("7k/8/8/8/8/8/8/K7 w - - 193 1").unwrap();
+        let mut search = Quiescence::<true>::new(&position);
+        let mut node = search.prepare_root(position);
+        let mut history = SearchHistory::new(&position);
+        for _ in 0..62 { node=node.null_child();history.push(&node.position,None); }
+        let parent = node.retained;
+        node=node.null_child();
+        history.push(&node.position,None);
+        let saved = node.retained;
+        let mut trace = TestTrace::default();
+        let entry = Entry { ply:63,target:63,iteration_depth:1,lower:-10000,upper:10000,analysis:0,capture_exception:false };
+        let _ = search.search_subtree_observed(&mut node,&mut history,entry,Limits::default(),&parent,&mut trace).unwrap();
+        assert_eq!((trace.leaves,trace.nodes[0].stages.len()),(1,1));
+        assert_eq!(trace.nodes[0].stages[0].kind,crate::evaluator::StageKind::Fast);
+        assert_eq!(node.retained,saved);
+        assert!(trace.ordered.is_empty());
+    }
