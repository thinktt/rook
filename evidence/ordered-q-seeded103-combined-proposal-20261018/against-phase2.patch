+//! Cold clock schemas; actual native adaptive, terminal and idle-session owners.
+use super::{array, boolean, integer, object, positions, text, unsigned32, Result};
+use rook2::{
+    parameters,
+    session::{Action, Session},
+    timing::{Adaptive, Stage, Terminal},
+};
+use serde_json::{json, Value};
+
+struct Event {
+    stage: Stage,
+    clock: u32,
+    depth: i32,
+    previous: i32,
+    best: i32,
+    second: i32,
+}
+struct Sequence {
+    average: u32,
+    maximum: u32,
+    checked: bool,
+    start: u32,
+    events: Vec<Event>,
+}
+
+impl Sequence {
+    fn parse(value: &Value) -> Result<Self> {
+        object(value, &["average", "maximum", "inCheck", "start", "events"])?;
+        let average = integer(&value["average"], 0, 1_000_000)? as u32;
+        let maximum = integer(&value["maximum"], 0, 1_000_000)? as u32;
+        if maximum < average {
+            return Err("maximum allowance must be at least average".into());
+        }
+        let checked = boolean(&value["inCheck"])?;
+        let start = unsigned32(&value["start"])?;
+        let mut previous_elapsed = 0;
+        let mut previous_depth = 1;
+        let mut events = Vec::new();
+        for event in array(&value["events"], 1, 64)? {
+            object(
+                event,
+                &[
+                    "stage",
+                    "clock",
+                    "depth",
+                    "previousScore",
+                    "bestScore",
+                    "secondScore",
+                ],
+            )?;
+            let stage = match text(&event["stage"])? {
+                "best-change" => Stage::BestChange,
+                "score-drop" => Stage::ScoreDrop,
+                "root-check" => Stage::Root,
+                "iteration-check" => Stage::Iteration,
+                "easy-iteration-check" => Stage::EasyIteration,
+                "poll-check" => Stage::Poll,
+                _ => return Err("unknown adaptive event stage".into()),
+            };
+            let clock = unsigned32(&event["clock"])?;
+            let elapsed = clock.wrapping_sub(start);
+            let depth = integer(&event["depth"], 1, 30)?;
+            if elapsed > i32::MAX as u32 || elapsed < previous_elapsed || depth < previous_depth {
+                return Err("adaptive elapsed/depth sequence is outside its ordered domain".into());
+            }
+            previous_elapsed = elapsed;
+            previous_depth = depth;
+            events.push(Event {
+                stage,
+                clock,
+                depth,
+                previous: integer(&event["previousScore"], -7900, 7900)?,
+                best: integer(&event["bestScore"], -7900, 7900)?,
+                second: integer(&event["secondScore"], -7900, 7900)?,
+            });
+        }
+        Ok(Self {
+            average,
+            maximum,
+            checked,
+            start,
+            events,
+        })
+    }
+
+    fn observe(self) -> Value {
+        let mut state = Adaptive::new(self.average, self.maximum, self.checked, self.start);
+        let snapshot = |state: &Adaptive, stop| {
+            json!({
+                "limits":state.limits, "stop":stop, "clockReads":state.clock_reads, "changes":state.changes
+            })
+        };
+        let initial = snapshot(&state, false);
+        let mut after = Vec::new();
+        for event in self.events {
+            let stop = state.apply(
+                event.stage,
+                event.depth,
+                event.previous,
+                event.best,
+                event.second,
+                || event.clock,
+            );
+            after.push(snapshot(&state, stop));
+            if stop {
+                break;
+            }
+        }
+        json!({"initial":initial,"afterEach":after})
+    }
+}
+
+fn adaptive(input: &Value) -> Result<Value> {
+    object(input, &["queries"])?;
+    let sequences = array(&input["queries"], 1, 256)?
+        .iter()
+        .map(Sequence::parse)
+        .collect::<Result<Vec<_>>>()?;
+    if sequences.iter().map(|s| s.events.len()).sum::<usize>() > 4096 {
+        return Err("adaptive request exceeds4096 supplied events".into());
+    }
+    Ok(json!({"sequences":sequences.into_iter().map(Sequence::observe).collect::<Vec<_>>()}))
+}
+
+fn terminal(input: &Value) -> Result<Value> {
+    object(input, &["queries"])?;
+    // This contract states no batching ceiling or nonempty restriction.
+    let queries = input["queries"]
+        .as_array()
+        .ok_or("expected queries array")?;
+    let mut parsed = Vec::new();
+    for query in queries {
+        object(
+            query,
+            &[
+                "rootPlacement",
+                "iterationDepth",
+                "selectivity",
+                "maximumDepth",
+                "analysisMode",
+                "averageCentiseconds",
+                "bestScore",
+                "secondBestScore",
+                "previousBestScore",
+                "startClock",
+                "currentClock",
+                "iterationLimitSeconds",
+            ],
+        )?;
+        let position = positions::placement(&query["rootPlacement"], false)?;
+        let limit = query["iterationLimitSeconds"]
+            .as_f64()
+            .ok_or("expected iteration allowance")?;
+        if !limit.is_finite() || limit < 0.0 {
+            return Err("iteration allowance must be finite and nonnegative".into());
+        }
+        parsed.push(Terminal {
+            depth: integer(&query["iterationDepth"], 1, 64)?,
+            selectivity: integer(&query["selectivity"], i32::MIN, i32::MAX)?,
+            root_endgame: position.phase().endgame,
+            maximum_depth: integer(&query["maximumDepth"], 1, 999)? as usize,
+            analysis: integer(&query["analysisMode"], 0, i32::MAX)?,
+            average_cs: integer(&query["averageCentiseconds"], 0, i32::MAX)? as u32,
+            best: integer(&query["bestScore"], -10000, 10000)?,
+            second: integer(&query["secondBestScore"], -10000, 10000)?,
+            previous: integer(&query["previousBestScore"], -10000, 10000)?,
+            start: unsigned32(&query["startClock"])?,
+            clock: unsigned32(&query["currentClock"])?,
+            iteration_limit: limit,
+        });
+    }
+    Ok(json!({"results":parsed.into_iter().map(|state| {
+        let reason = state.reason();
+        json!({"stop":reason.is_some(),"reason":reason,"elapsedCentiseconds":state.elapsed_cs(),
+               "rootEndgameWeight":state.root_endgame,"mateMargin":state.mate_margin()})
+    }).collect::<Vec<_>>()}))
+}
+
+fn validate_record(line: &str) -> Result<()> {
+    if line.len() > 1022
+        || !line.is_ascii()
+        || line.bytes().any(|b| {
+            b == 0
+                || b == b'\r'
+                || b == b'\n'
+                || (b.is_ascii_whitespace() && b != b' ' && b != b'\t')
+        })
+    {
+        return Err("setup command is outside ordinary record syntax".into());
+    }
+    let words: Vec<_> = line.split_ascii_whitespace().collect();
+    if words.len() > 40 {
+        return Err("too many ordinary record tokens".into());
+    }
+    if words.first() == Some(&"level") {
+        let args = &words[1..];
+        if args.is_empty() || args.len() % 3 != 0 || args.len() > 30 {
+            return Err("level requires one through ten stage triples".into());
+        }
+        // Ignored stages must still be syntactically valid triples. Native
+        // Session owns normalization, effective-stage truncation and replacement.
+        for triple in args.chunks_exact(3) {
+            parameters::integer(triple[0]).map_err(|e| format!("invalid moves: {e:?}"))?;
+            parameters::integer(triple[2]).map_err(|e| format!("invalid increment: {e:?}"))?;
+            if let Some((minutes, seconds)) = triple[1].split_once(':') {
+                parameters::integer(minutes).map_err(|e| format!("invalid minutes: {e:?}"))?;
+                parameters::integer(seconds).map_err(|e| format!("invalid seconds: {e:?}"))?;
+            } else {
+                parameters::integer(triple[1]).map_err(|e| format!("invalid base: {e:?}"))?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn setup(input: &Value) -> Result<Value> {
+    object(input, &["commands"])?;
+    let commands = input["commands"]
+        .as_array()
+        .ok_or("expected commands array")?
+        .iter()
+        .map(|value| {
+            let line = text(value)?;
+            validate_record(line)?;
+            Ok(line)
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let mut session = Session::<true>::default();
+    for line in commands {
+        let words: Vec<_> = line.split_ascii_whitespace().collect();
+        if words.first() == Some(&"time") && words.len() == 2 {
+            // Admission only: the bounded idle profile excludes wrapped
+            // adjustment arithmetic. The actual update is still Session::idle.
+            let remaining = parameters::integer(words[1])
+                .map_err(|e| format!("invalid remaining time: {e:?}"))?;
+            let index = (session.game_ply() as u64
+                + u64::from(session.states[0].side == session.clock_color))
+                / 2;
+            let seconds = session
+                .clock
+                .schedule
+                .seconds(index)
+                .map_err(|e| format!("schedule domain: {e:?}"))?;
+            let credit = seconds
+                .checked_mul(100)
+                .and_then(|x| i32::try_from(x).ok())
+                .ok_or("setup synchronization credit outside signed32 domain")?;
+            credit
+                .checked_sub(remaining)
+                .ok_or("setup adjustment outside signed32 domain")?;
+        }
+        match session
+            .idle(line)
+            .map_err(|e| format!("idle setup: {e:?}"))?
+        {
+            Action::Reply(lines)
+                if !lines.iter().any(|line| {
+                    line.starts_with("Illegal move:")
+                        || line.starts_with("Error (unknown command):")
+                }) => {}
+            Action::Reply(_) => return Err("setup command was not accepted".into()),
+            Action::Search | Action::Quit => return Err("setup sequence must remain idle".into()),
+        }
+    }
+    if !(0..=100).contains(&session.parameters.values[23]) {
+        return Err("consumed setup optimism outside0..100".into());
+    }
+    let allowance = session
+        .allowance()
+        .map_err(|e| format!("allowance domain: {e:?}"))?;
+    Ok(
+        json!({"gamePly":session.game_ply(),"adjustmentCs":session.clock.adjustment_cs,
+              "averageCs":allowance.average_cs,"maximumCs":allowance.maximum_cs,
+              "stages":session.clock.schedule.stages.iter().map(|s| json!({
+                  "moves":s.moves,"baseSeconds":s.base_seconds,"incrementSeconds":s.increment_seconds
+              })).collect::<Vec<_>>()}),
+    )
+}
+
+pub(super) fn dispatch(operation: &str, input: &Value) -> Result<Value> {
+    match operation {
+        "time.adaptiveSequence" => adaptive(input),
+        "search.iterationTerminalStop" => terminal(input),
+        "session.timeSetup" => setup(input),
+        _ => Err("unknown clock-boundary operation".into()),
+    }
+}
+
+#[cfg(test)]
