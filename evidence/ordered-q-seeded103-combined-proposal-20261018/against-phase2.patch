+        let output = dispatch(
+            "evaluation.pawnPiece",
+            &json!({"queries":[{"placement":"7k/8/8/8/8/8/8/K7"}]}),
+        )
+        .unwrap();
+        assert_eq!(
+            output["results"][0],
+            json!({"white":0,"black":0,"relationQueries":0})
+        );
+    }
+
+    #[test]
+    fn pressure_observes_unused_rook_line_and_derives_color_from_board() {
+        let output = dispatch(
+            "evaluation.pawnPressure",
+            &json!({"queries":[
+            {"placement":"3r3k/8/8/8/3P3r/2PR4/3N4/K7","pawnSquare":"d4"},
+            {"placement":"7k/8/8/8/8/8/P7/K7","pawnSquare":"a2"}]}),
+        )
+        .unwrap();
+        assert_eq!(output["results"][0]["rookLine"], 40);
