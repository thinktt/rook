+//! Cold typed recording over the actual recursive native tactical search.
+use super::{array, boolean, evaluation_common as common, integer, object, positions, text, Result};
+use rook2::{
+    evaluator::{EvaluationStage, Parameters, Retained, StageKind},
+    history::SearchHistory,
+    movegen,
+    position::{Position, NO_SQUARE},
+    quiescence::{Entry, Limits, Observer, Outcome, Quiescence, Work},
+    quiescence_policy,
+    types::{Color, Move, MoveKind, Piece, PieceKind},
+};
+use serde_json::{json, Value};
+
+const FIXED: [(&str, i32); 30] = [
+    ("myp",100),("myn",100),("myb",100),("myr",100),("myq",100),
+    ("mycc",100),("mymob",100),("myks",100),("mypp",100),("mypw",100),
+    ("opp",100),("opn",100),("opb",100),("opr",100),("opq",100),
+    ("opcc",100),("opmob",100),("opks",100),("oppp",100),("oppw",100),
+    ("sop",100),("ana",0),("avd",0),("cfd",0),("myk",0),("opk",0),
+    ("rnd",0),("md",99),("sel",14),("tts",67108864),
+];
+
+struct Request { root: Position, history: SearchHistory, movement: Move }
+
+impl Request {
+    fn parse(input: &Value) -> Result<Self> {
+        object(input, &["fen","moves","personalityParameters","rootMove","controls"])?;
+        let fen = text(&input["fen"])?;
+        let names: Vec<_> = FIXED.iter().map(|(name,_)| *name).collect();
+        object(&input["personalityParameters"], &names)?;
+        for (name, value) in FIXED {
+            integer(&input["personalityParameters"][name], value, value)?;
+        }
+        let controls = &input["controls"];
+        object(controls, &["iterationDepth","rootPass","learnedState","pondering"])?;
+        integer(&controls["iterationDepth"],1,1)?;
+        if text(&controls["rootPass"])? != "first-unrestricted"
+            || text(&controls["learnedState"])? != "fresh-ordinary-search"
+            || boolean(&controls["pondering"])?
+        { return Err("unsupported quiescence tree controls".into()); }
+        let supplied = array(&input["moves"],0,255)?.iter().map(|value| {
+            let spelling = text(value)?;
+            positions::coordinate(spelling)?;
+            Ok(spelling)
+        }).collect::<Result<Vec<_>>>()?;
+        object(&input["rootMove"], &["move","kind"])?;
+        let root_spelling = text(&input["rootMove"]["move"])?;
+        positions::coordinate(root_spelling)?;
+        let root_kind = text(&input["rootMove"]["kind"])?;
+        if !matches!(root_kind,"ordinary" | "castle" | "enPassant") {
+            return Err("invalid root move kind".into());
+        }
+        // POSITION-SETUP admission is wider than the separate bounded
+        // moveSequence diagnostic. Use its native parser without type caps.
+        let mut root = Position::from_fen(fen)?;
+        if movegen::in_check(&root,root.side.opponent()) {
+            return Err("initial nonmoving king is in check".into());
+        }
+        retained_ep(&root)?;
+        let mut history = SearchHistory::new(&root);
+        for spelling in supplied {
+            let movement = positions::legal_move(&root,spelling)?;
+            root = root.played_unchecked(movement);
+            history.push(&root,Some(movement));
+        }
+        history.mark_root();
+        let movement = positions::legal_move(&root,root_spelling)?;
+        if kind(movement) != root_kind { return Err("root move kind disagrees with legal move".into()); }
+        let child = root.played_unchecked(movement);
+        if movegen::in_check(&child,child.side) {
+            return Err("selected root child must not be in check".into());
+        }
+        Ok(Self { root, history, movement })
+    }
+
+    fn observe(mut self) -> Result<Value> {
+        let mut search = Quiescence::<true>::new(&self.root);
+        // These ignored fields still carry the exact validated fixed vector.
+        let mut parameters = Parameters::default();
+        parameters.own[5] = 0;
+        parameters.opponent[5] = 0;
+        search.evaluator.parameters = parameters;
+        let root = search.prepare_root(self.root);
+        let mut child = root.child(&search.evaluator.root,self.movement);
+        self.history.push(&child.position,Some(self.movement));
+        let entry = Entry { ply:1,target:1,iteration_depth:1,lower:-10000,upper:10000,
+            analysis:0,capture_exception:quiescence_policy::capture_exception(&self.root,&self.movement) };
+        let mut sink = Sink::default();
+        let outcome = search.search_subtree_observed(&mut child,&mut self.history,entry,
+            Limits { nodes:Some(4095) },&root.retained,&mut sink)
+            .map_err(|stop| format!("quiescence tree did not complete: {stop:?}"))?;
+        if !sink.first_ordered || outcome.pv.len() > 63 {
+            return Err("quiescence tree outside qualified first-list/PV boundary".into());
+        }
+        sink.output(outcome)
+    }
+}
+
+fn retained_ep(position: &Position) -> Result<()> {
+    if position.ep != NO_SQUARE {
+        let rank = if position.side == Color::White { 5 } else { 2 };
+        let victim = if position.side == Color::White { position.ep - 8 } else { position.ep + 8 };
+        if position.ep / 8 != rank || position.board[victim as usize]
+            != Piece::new(position.side.opponent(),PieceKind::Pawn)
+        { return Err("retained EP requires ordinary rank and opposing pawn victim".into()); }
+    }
+    Ok(())
+}
+
+fn kind(movement: Move) -> &'static str {
+    match movement.kind() {
+        MoveKind::Castle => "castle",
+        MoveKind::EnPassant => "enPassant",
+        _ => "ordinary",
+    }
+}
+fn movement(mv: Move) -> Value { json!({"move":mv.to_string(),"kind":kind(mv)}) }
+fn variation(pv: &[Move]) -> Vec<Value> { pv.iter().copied().map(movement).collect() }
+fn work(work: Work) -> Value {
+    json!({"searchCounterDelta":work.effective_search_count(),
+        "chargedSearchUnits":work.charged_search_units,"chargedRelationQueries":work.charged_relation_queries})
+}
+
+struct EvaluationRecord {
+    parent: Option<usize>, arrival: Retained, parent_retained: Retained,
+    stages: Vec<EvaluationStage>, departure: Retained,
+}
+enum Event {
+    Enter { node:usize,parent:Option<usize>,entry:Entry,movement:Option<Move>,
+        position:Position,checked:bool,work:Work },
+    Leave { node:usize,score:i32,pv:Vec<Move>,work:Work },
+}
+#[derive(Default)]
+struct Sink {
+    events: Vec<Event>, evaluations: Vec<EvaluationRecord>, stack: Vec<usize>, first_ordered:bool,
+}
+impl Observer for Sink {
+    const ENABLED: bool = true;
+    type Parent = Retained;
+    type Frame = usize;
+    fn parent(retained: &Retained) -> Retained { *retained }
+    fn enter(&mut self, position:&Position, entry:Entry, movement:Option<Move>,
+        parent_retained:Retained, arrival:Retained, checked:bool, work:Work) -> usize
+    {
+        let index = self.evaluations.len();
+        let parent = self.stack.last().map(|index| index+1);
+        self.events.push(Event::Enter { node:index+1,parent,entry,movement,
+            position:*position,checked,work });
+        self.evaluations.push(EvaluationRecord { parent,arrival,parent_retained,
+            stages:Vec::new(),departure:arrival });
+        self.stack.push(index);
+        index
+    }
+    fn stage(&mut self, stage:EvaluationStage) {
+        self.evaluations[*self.stack.last().unwrap()].stages.push(stage);
+    }
+    fn ordered(&mut self) {
+        if self.stack.len() == 1 && self.stack[0] == 0 { self.first_ordered = true; }
+    }
+    fn leave(&mut self, index:usize, departure:Retained, score:i32, pv:&[Move], work:Work) {
+        assert_eq!(self.stack.pop(),Some(index));
+        self.evaluations[index].departure = departure;
+        self.events.push(Event::Leave { node:index+1,score,pv:pv.to_vec(),work });
+    }
+}
+impl Sink {
+    fn output(self, outcome:Outcome) -> Result<Value> {
+        if !self.stack.is_empty() || self.evaluations.len() as u64 != outcome.stats.nodes {
+            return Err("incomplete native trace".into());
+        }
+        let mut trace = Vec::with_capacity(self.events.len());
+        for event in self.events {
+            trace.push(match event {
+                Event::Enter { node,parent,entry,movement:incoming,position,checked,work:sample } => {
+                    let incoming = incoming.ok_or("played tree node has no arrival move")?;
+                    json!({"event":"enter","node":node,"parent":parent,"ply":entry.ply,
+                        "target":entry.target,"window":{"lower":entry.lower,"upper":entry.upper},
+                        "move":movement(incoming),"position":{"placement":position.placement(),
+                        "sideToMove":if position.side==Color::White {"white"} else {"black"},
+                        "castling":positions::rights(&position),"enPassant":positions::ep(&position),
+                        "halfmoveClock":position.halfmove,"inCheck":checked},"work":work(sample)})
+                }
+                Event::Leave { node,score,pv,work:sample } => json!({"event":"leave","node":node,
+                    "score":score,"principalVariation":variation(&pv),"work":work(sample)}),
+            });
+        }
+        let evaluations: Vec<_> = self.evaluations.into_iter().enumerate().map(|(index,node)| {
+            let stages: Vec<_> = node.stages.into_iter().map(|stage| json!({
+                "kind":match stage.kind { StageKind::Full=>"full", StageKind::Fast=>"fast" },
+                "before":common::retained_output(stage.before),"after":common::retained_output(stage.after),
+                "score":stage.evaluation.score,"lowerBound":stage.evaluation.lower,
+                "upperBound":stage.evaluation.upper,"work":work(Work { charged_search_units:0,
+                    charged_relation_queries:stage.evaluation.relation_queries })
+            })).collect();
+            json!({"node":index+1,"parent":node.parent,"arrival":common::retained_output(node.arrival),
+                "parentRetained":common::retained_output(node.parent_retained),"stages":stages,
+                "departure":common::retained_output(node.departure)})
+        }).collect();
+        Ok(json!({"nodes":outcome.stats.nodes,"score":outcome.score,
+            "principalVariation":variation(&outcome.pv),"work":work(outcome.work),
+            "trace":trace,"evaluations":evaluations}))
+    }
+}
+
+pub(super) fn dispatch(input:&Value) -> Result<Value> { Request::parse(input)?.observe() }
+
+
