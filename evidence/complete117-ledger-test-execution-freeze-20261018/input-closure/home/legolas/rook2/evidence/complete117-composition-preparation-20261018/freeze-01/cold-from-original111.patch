+                let ordinary=ordinary(&root,&result.outcome)?;
+                if index==0 {first_ordinary=Some(ordinary);}
+                else if index==2&&first_ordinary.as_ref()!=Some(&ordinary) {
+                    return Err("restored A must reproduce its complete actual ordinary answer".into());
+                }
+            }
+            let events=semantic_events(&host.records);
+            let selected=move_event(&host.records)?;
+            if self.mode==Mode::Interrupted {
+                let aborted=result.outcome.stop.reason=="abort";
+                if aborted {
+                    if selected.is_some()||!state.force||state.moves.len()!=before_ply||state.position()!=root {
+                        return Err("native abort must preserve game and enter force without a move".into());
+                    }
+                } else if selected.is_none()||state.moves.len()!=before_ply+1 {
+                    return Err("native non-abort must apply exactly one selected move".into());
+                }
+                results.push(json!({"events":events}));
+            } else {
+                let selected=selected.ok_or("completed ordinary session has no selected move")?;
+                if state.moves.len()!=before_ply+1 {return Err("ordinary selected move was not applied".into());}
+                let mut posts=Vec::new();
+                for record in &host.records {
+                    if let Record::Post(p)=record {
+                        if p.fields.depth_token<1000||p.pv.trim().is_empty() {
+                            return Err("public search post outside released five-field report domain".into());
+                        }
+                        posts.push(post(p));
+                    }
+                }
+                if index==0 {first_move=Some(selected.to_string());}
+                if self.mode==Mode::Clock {results.push(json!({"seed":result.seed,"move":selected.to_string(),"posts":posts}));}
+                else {results.push(json!({"move":selected.to_string(),"posts":posts}));}
+            }
+        }
+        Ok(json!({"results":results}))
+    }
+}
+struct Recorder { pending:VecDeque<Command>,records:Vec<Record>,fixed:bool,seeds:Vec<u32> }
+impl Host for Recorder {
+    fn acquire_seed(&mut self,supplied:u32,entry:u32)->io::Result<u32> {
+        let seed=if self.fixed {supplied} else {
+            let seconds=SystemTime::now().duration_since(UNIX_EPOCH).map_err(io::Error::other)?.as_secs() as u32;
+            host::seed_from_seconds(seconds,entry)
+        };
+        self.seeds.push(seed);Ok(seed)
+    }
+    fn command(&mut self)->io::Result<Option<Command>> {Ok(self.pending.pop_front())}
+    fn publish(&mut self,record:Record)->io::Result<()> {self.records.push(record);Ok(())}
+}
+fn run(state:&mut Session<true>,seconds:Option<u32>,queued:Vec<Command>,limits:Limits,capacity:u8)->Result<(session::SearchResult,Recorder)> {
+    if state.moves.len()>=800 {return Err("ordinary search requires at most799 prior plies".into());}
+    let host=Recorder{pending:queued.into(),records:Vec::new(),fixed:seconds.is_some(),seeds:Vec::new()};
+    let (result,host)=state.go_live(host,seconds.unwrap_or(0),limits,capacity,false);
+    let result=result.map_err(|e|format!("native persistent search: {e:?}"))?;
+    if !host.pending.is_empty() {return Err("search did not reach every queued command's native poll".into());}
+    if host.seeds.as_slice()!=[result.seed] {return Err("ordinary search must acquire exactly one actual retained seed".into());}
+    Ok((result,host))
+}
+fn post(p:&Post)->Value {json!({"depthToken":p.fields.depth_token,"evaluation":p.fields.evaluation,
+    "searchId":p.fields.search_id,"pv":p.pv.trim().replace('0',"O"),"engineCentiseconds":p.fields.centiseconds})}
+fn semantic_events(records:&[Record])->Vec<Value> {
+    records.iter().filter_map(|record|match record {
+        Record::Post(p)=>{let mut v=post(p);v["type"]=json!("post");Some(v)},
+        Record::Status(s)=>Some(json!({"type":"status","engineCentiseconds":s.centiseconds,"searchId":s.search_id,
+            "depthToken":s.depth_token,"remaining":s.remaining,"total":s.total,"pv":s.pv.trim().replace('0',"O")})),
+        Record::Move(m)=>Some(json!({"type":"move","move":m.to_string()})),
+        Record::Aborting|Record::Result(_)=>None,
+    }).collect()
+}
+fn move_event(records:&[Record])->Result<Option<Move>> {
+    let mut selected=None;let mut after_move=false;
+    for record in records {match record {
+        Record::Move(m) if selected.is_none()=>{selected=Some(*m);after_move=true;},
+        Record::Result(_)=>{},Record::Aborting if selected.is_none()=>{},
+        Record::Post(_)|Record::Status(_) if !after_move=>{},
+        _=>return Err("native semantic event order/move multiplicity is invalid".into()),
+    }}
+    Ok(selected)
+}
+
+fn variation(pv:&[Move])->Vec<Value> {pv.iter().copied().map(moves::descriptor).collect()}
+fn work(sample:Work)->Value {json!({"searchCounterDelta":sample.effective_search_count(),
+    "chargedSearchUnits":sample.charged_search_units,"chargedRelationQueries":sample.charged_relation_queries})}
+fn legal_pv(mut root:Position,pv:&[Move])->Result<()> {
+    if pv.len()>63 {return Err("ordinary PV exceeds63 moves".into());}
+    for &movement in pv {
+        let mut legal=MoveList::new();movegen::generate_legal(&root,&mut legal);
+        if !legal.as_slice().contains(&movement) {return Err("native ordinary PV is not a legal typed continuation".into());}
+        root=root.played_unchecked(movement);
+    }
+    Ok(())
+}
+fn ordinary(root:&Position,out:&timed::Outcome)->Result<Value> {
+    let stats=&out.stats;
+    if movegen::in_check(root,root.side)||out.initial_candidates.is_empty()
+        ||out.stop.point!=Point::Iteration||out.stop.depth!=3||out.stop.pending.is_some()
+        ||out.iterations.len()!=3||out.stop.work.charged_search_units>=4096
+        ||stats.iio_initial_phases!=0||stats.iio_tail_phases!=0||stats.iio_passes!=0
+        ||stats.iio_nonzero_fresh_extensions!=0||stats.accumulated_extension_uses!=0 {
+        return Err("persistent ordinary result exceeds natural three-completion/no-poll/IIOzero domain".into());
+    }
+    let mut legal=MoveList::new();movegen::generate_legal(root,&mut legal);
+    if out.initial_candidates.as_slice()!=legal.as_slice() {
+        return Err("native initial candidates must be the complete actual root sequence".into());
+    }
+    let mut iterations=Vec::new();
+    for (index,iteration) in out.iterations.iter().enumerate() {
+        if usize::from(iteration.depth)!=index+1||!iteration.complete||iteration.steps.len()!=legal.len {
+            return Err("natural session search did not complete all root candidates".into());
+        }
+        let mut seen=Vec::new();let mut steps=Vec::new();
+        for step in &iteration.steps {
+            if !legal.as_slice().contains(&step.movement)||seen.contains(&step.movement)
+                ||step.passes.len()!=1||step.window[1]!=10000||step.work.charged_search_units>=4096 {
+                return Err("ordinary root visit outside complete unrestricted domain".into());
+            }
+            seen.push(step.movement);
+            legal_pv(root.played_unchecked(step.movement),&step.child_pv)?;legal_pv(*root,&step.pv)?;
+            if ![step.window[0],step.window[1],step.score,step.best,step.second].into_iter()
+                .all(|s|(-10000..=10000).contains(&s)) {
+                return Err("ordinary score/window exceeds released domain".into());
+            }
+            steps.push(json!({"move":moves::descriptor(step.movement),"window":{"lower":step.window[0],"upper":step.window[1]},
+                "score":step.score,"bestScore":step.best,"secondScore":step.second,
+                "childPrincipalVariation":variation(&step.child_pv),"principalVariation":variation(&step.pv),"work":work(step.work)}));
+        }
+        let last=iteration.steps.last().ok_or("empty actual ordinary iteration")?;
+        // This is a projection of actual completed step state, never a second
+        // score insertion/sort/controller or synthetic evaluator answer.
+        iterations.push(json!({"depth":iteration.depth,"candidates":variation(&seen),"steps":steps,
+            "score":last.best,"principalVariation":variation(&last.pv),"work":work(last.work)}));
+    }
+    let captured=out.result.as_ref().ok_or("natural ordinary session has no actual retained capture")?;
+    let last=out.iterations.last().unwrap().steps.last().unwrap();
+    if captured.depth!=3||captured.score!=last.best||captured.pv!=last.pv||last.work!=out.stop.work {
+        return Err("actual capture/final completed iteration/work do not close together".into());
+    }
+    legal_pv(*root,&captured.pv)?;
+    Ok(json!({"initialCandidates":variation(&out.initial_candidates),"iterations":iterations,
+        "result":{"score":captured.score,"principalVariation":variation(&captured.pv),"work":work(out.stop.work)}}))
+}
+fn fen(position:&Position,plies:usize,initial_side:Color)->String {
+    let side=if position.side==Color::White{"w"}else{"b"};
+    let fullmove=1+(plies+usize::from(initial_side==Color::Black))/2;
+    format!("{} {side} {} {} {} {fullmove}",position.placement(),positions::rights(position),positions::ep(position),position.halfmove)
+}
+fn snapshot(state:&Session<true>)->Value {
+    let first=&state.states[0];let current=state.position();
+    json!({"initialFen":fen(first,0,first.side),"currentFen":fen(&current,state.moves.len(),first.side),
+        "moves":state.moves.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        "sideToMove":if current.side==Color::White{"white"}else{"black"},
+        "mode":if state.force{"force"}else if state.engine_color==Color::White{"play-white"}else{"play-black"}})
+}
+struct Rich { parameters:Parameters,alternative:String }
+impl Rich {
+    fn parse(input:&Value)->Result<Self> {
+        object(input,&["initial","personalityParameters","schedule","actions","controls"])?;
+        object(&input["initial"],&["fen","moves"])?;
+        if text(&input["initial"]["fen"])?!=session::START||!array(&input["initial"]["moves"],0,0)?.is_empty() {
+            return Err("persistent ordinary initial state must be exact standard empty-history start".into());
+        }
+        object(&input["personalityParameters"],&NAMES)?;
+        let mut values=[0;30];
+        for (index,name) in NAMES.iter().enumerate() {values[index]=integer(&input["personalityParameters"][*name],i32::MIN,i32::MAX)?;}
+        if values!=NEUTRAL_MD3 {return Err("persistent ordinary requires the complete neutral md3/rnd0 vector".into());}
+        object(&input["schedule"],&["levelCommand","remainingTimeCs"])?;
+        if text(&input["schedule"]["levelCommand"])?!="level 0 5 0" {return Err("persistent schedule must be level 0 5 0".into());}
+        integer(&input["schedule"]["remainingTimeCs"],18100,18100)?;
+        let actions=array(&input["actions"],9,9)?;let kinds=["search","force","undo","move","search","force","undo","undo","search"];
+        let mut alternative=None;
+        for (action,kind) in actions.iter().zip(kinds) {
+            match kind {
+                "search"=>{object(action,&["kind","completedIterations"])?;integer(&action["completedIterations"],3,3)?;},
+                "move"=>{object(action,&["kind","move"])?;let m=text(&action["move"])?;positions::coordinate(m)?;alternative=Some(m.to_owned());},
+                _=>{object(action,&["kind"])?;},
+            }
+            if text(&action["kind"])?!=kind {return Err("persistent action order differs from the admitted topology".into());}
+        }
+        let controls=&input["controls"];
+        object(controls,&["arrival","completion","inheritedSettings","pondering","searchState","workOrigin"])?;
+        for (name,value) in [("arrival","wait-for-each-move-v1"),("completion","natural-md3"),
+            ("inheritedSettings","session-global-md3-rnd0-v1"),("searchState","fresh-each-go"),("workOrigin","after-root-preparation")] {
+            if text(&controls[name])?!=value {return Err(format!("unsupported persistent control {name}"));}
+        }
+        if boolean(&controls["pondering"])? {return Err("persistent ordinary pondering is outside domain".into());}
+        let alternative=alternative.unwrap();positions::legal_move(&Position::from_fen(session::START)?,&alternative)?;
+        Ok(Self{parameters:Parameters{values},alternative})
+    }
+    fn observe(self)->Result<Value> {
+        let mut state=Session::<true>::default();
+        let tokens=NAMES.iter().zip(self.parameters.values).map(|(name,value)|format!("{name}={value}")).collect();
+        Setup::Parameters(tokens).apply(&mut state)?;Setup::Level.apply(&mut state)?;Setup::Easy.apply(&mut state)?;
+        let initial=snapshot(&state);let mut actions=Vec::new();let mut searches=Vec::new();
+        let mut first_move=None;let mut first_answer=None;let mut first_root=None;
+        for (index,kind) in ["search","force","undo","move","search","force","undo","undo","search"].into_iter().enumerate() {
+            let before=snapshot(&state);let mut action=json!({"index":index,"kind":kind,"before":before});
+            match kind {
+                "search"=>{
+                    if state.parameters!=self.parameters||state.pondering {return Err("inherited native settings changed".into());}
+                    idle(&mut state,"time 18100")?;
+                    let root=snapshot(&state);let root_position=state.position();
+                    let (result,host)=run(&mut state,None,Vec::new(),Limits{nodes:Some(4095)},3)?;
+                    let answer=ordinary(&root_position,&result.outcome)?;
+                    let selected=move_event(&host.records)?.ok_or("persistent ordinary session did not play a move")?;
+                    if result.outcome.result.as_ref().and_then(|c|c.pv.first()).copied()!=Some(selected) {
+                        return Err("native played move differs from actual retained PV".into());
+                    }
+                    let ordinal=searches.len();
+                    if ordinal==0 {first_move=Some(selected.to_string());first_answer=Some(answer.clone());first_root=Some(root.clone());}
+                    else if ordinal==2&&(first_root.as_ref()!=Some(&root)||first_answer.as_ref()!=Some(&answer)) {
+                        return Err("A2 must reproduce A1's actual root and entire ordinary answer".into());
+                    }
+                    searches.push(json!({"index":ordinal,"root":root,"completedIterations":3,"ordinary":answer,
+                        "selectedMove":selected.to_string(),"after":snapshot(&state)}));
+                    action["searchIndex"]=json!(ordinal);
+                },
+                "force"=>Setup::Force.apply(&mut state)?,"undo"=>Setup::Undo.apply(&mut state)?,
+                "move"=>{
+                    if first_move.as_ref()==Some(&self.alternative) {return Err("B must differ from observed search A move".into());}
+                    Setup::Move(self.alternative.clone()).apply(&mut state)?;action["move"]=json!(self.alternative);
+                },
+                _=>unreachable!(),
+            }
+            action["after"]=snapshot(&state);actions.push(action);
+        }
+        Ok(json!({"initial":initial,"actions":actions,"searches":searches,"final":snapshot(&state)}))
+    }
+}
+pub(super) fn dispatch(operation:&str,input:&Value)->Result<Value> {
+    match operation {
+        "session.searches"=>Public::parse(input,Mode::Public)?.observe(),
+        "session.clockSeededSearches"=>Public::parse(input,Mode::Clock)?.observe(),
+        "session.interruptedSearches"=>Public::parse(input,Mode::Interrupted)?.observe(),
+        "session.ordinaryIterations"=>Rich::parse(input)?.observe(),
+        _=>Err("unknown persistent session operation".into()),
+    }
+}
