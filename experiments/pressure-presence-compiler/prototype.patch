+// Test-only transpose of supplied byte marks. No production path transposes
+// byte marks, and the independent reference consumer remains king_pressure.
+fn reduced_byte_marks(position: &Position, defender: Color, marks: &Marks) -> i32 {
+    let attacker = defender.opponent();
+    let king = position.piece_squares(defender, PieceKind::King)[0];
+    let counts = position.counts[attacker.index()];
+    let diagonal = if counts[2] != 0 || counts[4] != 0 {
+        slider_pressure_mask(position, attacker, king, &DIRECTIONS[..4])
+    } else { 0 };
+    let orthogonal = if counts[3] != 0 || counts[4] != 0 {
+        slider_pressure_mask(position, attacker, king, &DIRECTIONS[4..])
+    } else { 0 };
+    let knight = if counts[1] != 0 {
+        knight_pressure_mask(position, attacker, king)
+    } else { 0 };
+    let mut raw = 0;
+    for kind in 1..=4 {
+        let mut presence = [0; 2];
+        for target in 0..64 {
+            for label in 0..2 {
+                if marks[attacker.index()][target] & (1 << (2 * (kind - 1) + label)) != 0 {
+                    presence[label] |= 1u64 << target;
+                }
+            }
+        }
+        raw += match kind {
+            1 => presence_pressure::<1>(&presence, knight),
+            2 => presence_pressure::<2>(&presence, diagonal),
+            3 => presence_pressure::<3>(&presence, orthogonal),
+            4 => presence_pressure::<4>(&presence, diagonal | orthogonal),
+            _ => unreachable!(),
+        };
+    }
+    (raw - 12).max(0)
+}
