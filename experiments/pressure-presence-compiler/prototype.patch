+#[inline]
+fn slider_pressure_mask(
+    position: &Position,
+    attacker: Color,
+    king: Square,
+    directions: &[(i8, i8)],
+) -> u64 {
+    let mut visible = 0;
+    for &step in directions {
+        let mut cursor = king;
+        while let Some(target) = cursor.offset(step.0, step.1) {
+            let piece = position.board[target.0 as usize];
+            if !piece.is_empty() && piece.color() == attacker {
+                break;
+            }
+            visible |= 1u64 << target.0;
+            if !piece.is_empty() {
+                break;
+            }
+            cursor = target;
+        }
+    }
+    visible
+}
+
+#[inline]
+fn knight_pressure_mask(position: &Position, attacker: Color, king: Square) -> u64 {
+    let mut visible = 0;
+    for step in KNIGHT {
+        if let Some(target) = king.offset(step.0, step.1) {
+            let piece = position.board[target.0 as usize];
+            if piece.is_empty() || piece.color() == attacker.opponent() {
+                visible |= 1u64 << target.0;
+            }
+        }
+    }
+    visible
+}
