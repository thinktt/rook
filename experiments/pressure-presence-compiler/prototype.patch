+#[test]
+fn pressure_consumer_matches_old_bytes_with_family_gates_and_one_final_clamp() {
+    for placement in [
+        "7k/6q1/7r/8/3K4/8/6bn/8",
+        "7k/8/8/8/3K4/8/8/8",
+        "7k/8/8/8/3K4/8/7n/8",
+        "7k/8/8/8/3K4/8/7b/8",
+        "7k/8/8/8/3K4/8/7r/8",
+        "7k/8/8/8/3K4/8/7q/8",
+        "7r/8/3P4/8/3Kp3/8/8/k7",
+        "8/8/8/4k3/3K4/8/8/8",
+    ] {
+        let pos = position(placement);
+        for defender in [Color::White, Color::Black] {
+            for byte in 0u8..=255 {
+                let marks = [[byte; 64]; 2];
+                assert_eq!(reduced_byte_marks(&pos, defender, &marks),
+                    king_pressure(&pos, defender, &marks), "{placement} {defender:?} {byte}");
+            }
+            // Remove each label from each square while other marks remain,
+            // so the final clamp cannot hide ordinary weak-mark differences.
+            for target in 0..64 {
+                for bit in 0..8 {
+                    let mut marks = [[255; 64]; 2];
+                    marks[defender.opponent().index()][target] &= !(1 << bit);
+                    assert_eq!(reduced_byte_marks(&pos, defender, &marks),
+                        king_pressure(&pos, defender, &marks));
+                }
+            }
+        }
+    }
+    let pos = position("7k/6q1/7r/8/3K4/8/6bn/8");
+    let mut marks = [[0; 64]; 2];
+    marks[1][square("d5").0 as usize] = 0x0c; // B on an orthogonal square.
+    marks[1][square("c5").0 as usize] = 0x30; // R on a diagonal square.
+    marks[1][square("e6").0 as usize] = 0xc0; // Q on a knight square.
+    assert_eq!(reduced_byte_marks(&pos, Color::White, &marks), 0);
+    assert_eq!(king_pressure(&pos, Color::White, &marks), 0);
+    marks = [[0; 64]; 2];
+    marks[1][square("d5").0 as usize] = 0x10; // Weak R: 8.
+    marks[1][square("c5").0 as usize] = 0x04; // Weak B: 8.
+    assert_eq!(reduced_byte_marks(&pos, Color::White, &marks), 4);
+    assert_eq!(king_pressure(&pos, Color::White, &marks), 4);
+}
