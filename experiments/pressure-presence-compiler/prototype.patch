+#[test]
+fn complete_presence_activity_covers_every_attacker_kind_inventory() {
+    for attacker in [Color::White, Color::Black] {
+        for inventory in 0..16 {
+            let mut board = position("7k/8/8/8/8/8/8/K7").board;
+            for (bit, (kind, target)) in [
+                (PieceKind::Knight, "c3"), (PieceKind::Bishop, "d6"),
+                (PieceKind::Rook, "g4"), (PieceKind::Queen, "f5"),
+            ].into_iter().enumerate() {
+                if inventory & (1 << bit) != 0 {
+                    board[square(target).0 as usize] = Piece::new(attacker, kind);
+                }
+            }
+            let pos = from_board(&board);
+            check_activity(&pos, &Influence::build(&pos), 217, [1024; 2]);
+            check_activity(&pos, &Influence { profiles: [[0; 64]; 2] }, -100_000, [0, 10_240]);
+            check_activity(&pos, &Influence { profiles: [[255; 64]; 2] }, 100_000, [10_240, 7153]);
+        }
+    }
+}
