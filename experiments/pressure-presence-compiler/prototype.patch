+#[test]
+fn complete_presence_activity_matches_byte_oracle_on_random_supplied_maps() {
+    let mut random = 0x6a93_b7c2_40ed_815fu64;
+    for case in 0..256 {
+        let mut board = [Piece::EMPTY; 64];
+        for color in [Color::White, Color::Black] {
+            loop {
+                let target = (next_random(&mut random) & 63) as usize;
+                if board[target].is_empty() {
+                    board[target] = Piece::new(color, PieceKind::King);
+                    break;
+                }
+            }
+        }
+        // At most fifteen non-kings/color, three pawns and six knights:
+        // promoted inventories and adjacent kings remain admitted.
+        for n in 0..(case % 31) {
+            loop {
+                let target = (next_random(&mut random) & 63) as usize;
+                if !board[target].is_empty() {
+                    continue;
+                }
+                let color = if n % 2 == 0 { Color::White } else { Color::Black };
+                let mut kind = PieceKind::ALL[(n / 2 + case) % 5];
+                if kind == PieceKind::Pawn && !(8..56).contains(&target) {
+                    kind = PieceKind::Knight;
+                }
+                board[target] = Piece::new(color, kind);
+                break;
+            }
+        }
+        let mut pos = from_board(&board);
+        let material = (next_random(&mut random) % 200_001) as i32 - 100_000;
+        let weights = [(next_random(&mut random) % 10_241) as i32,
+            (next_random(&mut random) % 10_241) as i32];
+        check_activity(&pos, &Influence::build(&pos), material, weights);
+        let mut supplied = Influence { profiles: [[0; 64]; 2] };
+        for color in 0..2 {
+            for target in 0..64 {
+                supplied.profiles[color][target] = next_random(&mut random) as u8;
+            }
+        }
+        check_activity(&pos, &supplied, material, weights);
+        check_activity(&pos, &Influence { profiles: [[case as u8; 64]; 2] }, material, weights);
+        let first = compute(&pos, &supplied, material, weights);
+        for color in [Color::White, Color::Black] {
+            let mut start = 0;
+            for kind in PieceKind::ALL {
+                let len = pos.counts[color.index()][kind.index()] as usize;
+                pos.squares[color.index()][start..start + len].reverse();
+                start += len;
+            }
+        }
+        pos.validate().unwrap();
+        check_activity(&pos, &supplied, material, weights);
+        assert_eq!(first, compute(&pos, &supplied, material, weights));
+        // Interpose an unrelated invocation before checking fresh lifetime.
+        let other = position("7k/8/8/8/8/8/8/K7");
+        check_activity(&other, &supplied, -material, [0, 10_240]);
+        assert_eq!(first, compute(&pos, &supplied, material, weights));
+    }
+}
