+#[inline]
+fn presence_pressure<const KIND: usize>(presence: &Presence, visible: u64) -> i32 {
+    // SAFETY: SSE2 is baseline on the x86-64 target, as in influence/coherent.
+    // These intrinsics operate only on values, without pointer/alignment
+    // preconditions. Word shifts may cross a byte boundary, but the following
+    // 0x55/0x33/0x0f masks discard those bits. Each final byte is in 0..=8;
+    // SAD against zero therefore sums each independent eight-byte half.
+    unsafe {
+        let mut counts = _mm_set_epi64x(
+            (presence[1] & visible) as i64, (presence[0] & visible) as i64,
+        );
+        counts = _mm_sub_epi8(
+            counts, _mm_and_si128(_mm_srli_epi16::<1>(counts), _mm_set1_epi8(0x55)),
+        );
+        counts = _mm_add_epi8(
+            _mm_and_si128(counts, _mm_set1_epi8(0x33)),
+            _mm_and_si128(_mm_srli_epi16::<2>(counts), _mm_set1_epi8(0x33)),
+        );
+        counts = _mm_and_si128(
+            _mm_add_epi8(counts, _mm_srli_epi16::<4>(counts)), _mm_set1_epi8(0x0f),
+        );
+        let sums = _mm_sad_epu8(counts, _mm_setzero_si128());
+        let weak = _mm_cvtsi128_si64(sums) as i32;
+        let strong = _mm_cvtsi128_si64(_mm_srli_si128::<8>(sums)) as i32;
+        if KIND == PieceKind::Knight.index() {
+            16 * weak + 24 * strong
+        } else {
+            8 * weak + 16 * strong
+        }
+    }
+}
