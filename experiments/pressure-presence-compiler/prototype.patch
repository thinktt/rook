+//! Pressure-boundary differential controls. The byte producer below is the
+//! pre-prototype scalar loop; it does not call the presence producer/reducer.
+//! Shared classification/scoring helpers are unchanged by this experiment.
+use super::*;
+
+fn square(text: &str) -> Square {
+    Square::parse(text).unwrap()
+}
+
+fn position(placement: &str) -> Position {
+    Position::from_fen(&format!("{placement} w - - 0 1")).unwrap()
+}
+
+fn next_random(state: &mut u64) -> u64 {
+    *state ^= *state << 13;
+    *state ^= *state >> 7;
+    *state ^= *state << 17;
+    *state
+}
+
+fn from_board(board: &[Piece; 64]) -> Position {
+    let mut rows = Vec::new();
+    for rank in (0..8).rev() {
+        let mut row = String::new();
+        let mut empty = 0u8;
+        for file in 0..8 {
+            let piece = board[rank * 8 + file];
+            if piece.is_empty() {
+                empty += 1;
+            } else {
+                if empty != 0 {
+                    row.push(char::from(b'0' + empty));
+                    empty = 0;
+                }
+                row.push(piece.fen_char());
+            }
+        }
+        if empty != 0 {
+            row.push(char::from(b'0' + empty));
+        }
+        rows.push(row);
+    }
+    position(&rows.join("/"))
+}
+
+// Original byte-producing destination loop, retained independently of the
+// new destinations_kind and record_presence. Additional rays do not mark.
+fn byte_destinations<const KIND: usize>(
+    position: &Position,
+    influence: &Influence,
+    color: Color,
+    source: Square,
+    values: &[u8; 64],
+    marks: &mut Marks,
+) -> Mobility {
+    let kind = PieceKind::ALL[KIND];
+    let mut result = Mobility::default();
+    if kind == PieceKind::Knight {
+        let targets = &KNIGHT_SOURCES[source.0 as usize];
+        for &target in &targets.squares[..targets.len as usize] {
+            debug_assert!(target < 64);
+            let target = Square(target & 63);
+            let victim = position.board[target.0 as usize];
+            if !victim.is_empty() && victim.color() == color {
+                continue;
+            }
+            let category = direct_category(influence, color, kind, target, victim);
+            result.categories += category;
+            result.total += category * values[target.0 as usize] as i64;
+            mark(marks, color, kind, target, category);
+        }
+        return result;
+    }
+    let directions = match kind {
+        PieceKind::Bishop => 0..4,
+        PieceKind::Rook => 4..8,
+        PieceKind::Queen => 0..8,
+        _ => unreachable!("non-activity piece"),
+    };
+    for direction in directions {
+        let step = DIRECTIONS[direction];
+        let mut additional = false;
+        let ray = &ATTACK_RAYS.0[source.0 as usize][direction];
+        for &target in &ray.squares[..ray.len as usize] {
+            debug_assert!(target < 64);
+            let target = Square(target & 63);
+            let victim = position.board[target.0 as usize];
+            let friendly = !victim.is_empty() && victim.color() == color;
+            if !friendly {
+                let category = if additional {
+                    result.queries += 1;
+                    capture_priority(
+                        kind,
+                        victim,
+                        relation(
+                            influence.code(color, target),
+                            influence.code(color.opponent(), target),
+                            kind,
+                        ) as i64,
+                    )
+                } else {
+                    let category = direct_category(influence, color, kind, target, victim);
+                    result.categories += category;
+                    mark(marks, color, kind, target, category);
+                    category
+                };
+                let value = values[target.0 as usize];
+                let vertical = if kind == PieceKind::Rook && step.0 == 0 {
+                    2
+                } else {
+                    1
+                };
+                result.total += category * value as i64 * vertical;
+            }
+            if !victim.is_empty() {
+                if !transparent(color, kind, step, victim) {
+                    break;
+                }
+                additional = true;
+            }
+        }
+    }
+    result
+}
+
+fn byte_accumulate<const KIND: usize>(
+    position: &Position,
+    influence: &Influence,
+    color: Color,
+    marks: &mut Marks,
+    endgame: u16,
+    score: &mut i64,
+    queries: &mut u64,
+) {
+    for &source in position.piece_squares(color, PieceKind::ALL[KIND]) {
+        let values = piece_destination_values::<KIND>(
+            position, color, &DESTINATION_VALUES[color.index()],
+        );
+        let mobility = byte_destinations::<KIND>(position, influence, color, source, values, marks);
+        let (piece, work) = piece_score_kind::<KIND>(influence, color, source, mobility, endgame);
+        *score += piece;
+        *queries += work;
+    }
+}
+
+fn byte_compute(
+    position: &Position,
+    influence: &Influence,
+    material_score: i32,
+    weights: [i32; 2],
+) -> Activity {
+    let phase = position.phase();
+    let mut marks = [[0; 64]; 2];
+    let mut scores = [0i64; 2];
+    let mut relation_queries = 0;
+    for color in [Color::White, Color::Black] {
+        byte_accumulate::<1>(position, influence, color, &mut marks, phase.endgame,
+            &mut scores[color.index()], &mut relation_queries);
+        byte_accumulate::<2>(position, influence, color, &mut marks, phase.endgame,
+            &mut scores[color.index()], &mut relation_queries);
+        byte_accumulate::<3>(position, influence, color, &mut marks, phase.endgame,
+            &mut scores[color.index()], &mut relation_queries);
+        byte_accumulate::<4>(position, influence, color, &mut marks, phase.endgame,
+            &mut scores[color.index()], &mut relation_queries);
+    }
+    let pieces = scores.map(|score| (276 * score + 128).div_euclid(256) as i32);
+    Activity {
+        pieces,
+        pressure: [
+            king_pressure(position, Color::White, &marks),
+            king_pressure(position, Color::Black, &marks),
+        ],
+        weighted: weighted(pieces, material_score, weights, phase),
+        relation_queries,
+    }
+}
+
+fn check_activity(position: &Position, influence: &Influence, material: i32, weights: [i32; 2]) {
+    let expected = byte_compute(position, influence, material, weights);
+    let actual = compute(position, influence, material, weights);
+    assert_eq!(actual, expected);
+    assert_eq!(
+        crate::shelter::compute(position, influence, actual.pressure, material, weights),
+        crate::shelter::compute(position, influence, expected.pressure, material, weights),
+    );
+}
+
+fn check_pair(presence: Presence, visible: u64) {
+    let weak = (presence[0] & visible).count_ones() as i32;
+    let strong = (presence[1] & visible).count_ones() as i32;
+    assert_eq!(presence_pressure::<1>(&presence, visible), 16 * weak + 24 * strong);
+    let sliders = 8 * weak + 16 * strong;
+    assert_eq!(presence_pressure::<2>(&presence, visible), sliders);
+    assert_eq!(presence_pressure::<3>(&presence, visible), sliders);
+    assert_eq!(presence_pressure::<4>(&presence, visible), sliders);
+}
+
+#[test]
+fn packed_presence_reduction_matches_scalar_counts_and_lane_boundaries() {
+    for presence in [[0, 0], [u64::MAX, 0], [0, u64::MAX], [u64::MAX; 2],
+        [1, 1 << 63], [1 << 63, 1], [0x8080_8080_8080_8080, 0x0101_0101_0101_0101]] {
+        check_pair(presence, u64::MAX);
+        check_pair(presence, 0);
+    }
+    // Every byte pattern in every byte lane, with different opposite-half
+    // data and mask patterns, detects contamination across either boundary.
+    for lane in 0..8 {
+        for byte in 0u64..256 {
+            let presence = [byte << (8 * lane), (255 - byte) << (8 * (7 - lane))];
+            for visible in [u64::MAX, 0x5555_5555_5555_5555, 0xaaaa_aaaa_aaaa_aaaa] {
+                check_pair(presence, visible);
+            }
+        }
+    }
+    let mut random = 0x82ca_f951_1e37_64bdu64;
+    for _ in 0..4096 {
+        let presence = [next_random(&mut random), next_random(&mut random)];
+        check_pair(presence, next_random(&mut random));
+    }
+}
+
+#[test]
+fn presence_union_preserves_zero_coexisting_labels_and_same_kind_duplicates() {
+    let target = square("d5");
+    let mut presence = [0; 2];
+    record_presence(&mut presence, target, 0);
+    record_presence(&mut presence, target, 1);
+    record_presence(&mut presence, target, 2);
+    record_presence(&mut presence, target, 3);
+    record_presence(&mut presence, target, 2);
+    let bit = 1u64 << target.0;
+    assert_eq!(presence, [bit, bit]);
+    assert_eq!(presence_pressure::<1>(&presence, bit), 40);
+    assert_eq!(presence_pressure::<3>(&presence, bit), 24);
+
+    let pos = position("k7/8/8/8/8/r6r/8/3K4");
+    let influence = Influence { profiles: [[0; 64]; 2] };
+    let result = compute(&pos, &influence, 0, [1024; 2]);
+    // Strong rook marks at a1, d3 and h1; d3 is marked by both rooks.
+    assert_eq!(result.pressure, [36, 0]);
+    assert_eq!(result, byte_compute(&pos, &influence, 0, [1024; 2]));
+}
