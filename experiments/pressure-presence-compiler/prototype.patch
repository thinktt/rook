+#[test]
+fn presence_activity_uses_mailbox_and_supplied_bytes_with_stale_private_planes() {
+    let coherent = position("r3k2r/pp1n1p2/2b1q1p1/3pP3/2BN1P2/1Q3N2/PP4PP/R3K2R");
+    let mut stale = position("7k/8/8/8/8/8/8/K7");
+    let old_planes = stale.attack_view();
+    stale.board = coherent.board;
+    stale.squares = coherent.squares;
+    stale.counts = coherent.counts;
+    stale.starting_units = coherent.starting_units;
+    assert_eq!(stale.attack_view(), old_planes);
+    assert_ne!(stale.attack_view(), coherent.attack_view());
+    let mut supplied = Influence { profiles: [[0; 64]; 2] };
+    for color in 0..2 {
+        for target in 0..64 {
+            supplied.profiles[color][target] = (target * 73 + color * 151) as u8;
+        }
+    }
+    check_activity(&stale, &supplied, -100_000, [10_240, 7153]);
+    assert_eq!(compute(&stale, &supplied, -100_000, [10_240, 7153]),
+        compute(&coherent, &supplied, -100_000, [10_240, 7153]));
+    // Canonical low tags and color bits stay intact under all valid high
+    // aliases; mailbox geometry must not authenticate cached attack planes.
+    for high in 0..16 {
+        let mut alias = stale;
+        for piece in &mut alias.board {
+            if !piece.is_empty() {
+                piece.0 |= high << 4;
+            }
+        }
+        assert_eq!(compute(&alias, &supplied, 217, [1024; 2]),
+            byte_compute(&alias, &supplied, 217, [1024; 2]));
+    }
+}
