+                let mut pos = template;
+                pos.board = [Piece::EMPTY; 64];
+                pos.board[source as usize] = Piece::new(attacker.opponent(), PieceKind::King);
+                let all = targets.iter().fold(0u64, |mask, target| mask | (1u64 << target.0));
+                assert_eq!(slider_pressure_mask(&pos, attacker, king, &[step]), all);
+                for stop in 0..targets.len() {
+                    for color in [attacker, attacker.opponent()] {
+                        for kind in PieceKind::ALL {
+                            let mut blocked = pos;
+                            blocked.board[targets[stop].0 as usize] = Piece::new(color, kind);
+                            if stop + 1 < targets.len() {
+                                blocked.board[targets[stop + 1].0 as usize] =
+                                    Piece::new(attacker.opponent(), PieceKind::Queen);
+                            }
+                            let included = stop + usize::from(color != attacker);
+                            let expected = targets[..included].iter()
+                                .fold(0u64, |mask, target| mask | (1u64 << target.0));
+                            assert_eq!(slider_pressure_mask(&blocked, attacker, king, &[step]),
+                                expected, "king={king} step={step:?} stop={stop} piece={color:?}/{kind:?}");
+                        }
+                    }
+                }
+            }
+            let mut pos = template;
+            pos.board = [Piece::EMPTY; 64];
+            let targets: Vec<_> = KNIGHT.into_iter()
+                .filter_map(|step| king.offset(step.0, step.1)).collect();
+            let all = targets.iter().fold(0u64, |mask, target| mask | (1u64 << target.0));
+            assert_eq!(knight_pressure_mask(&pos, attacker, king), all);
+            for target in targets {
+                for color in [attacker, attacker.opponent()] {
+                    for kind in PieceKind::ALL {
+                        let mut blocked = pos;
+                        blocked.board[target.0 as usize] = Piece::new(color, kind);
+                        let expected = if color == attacker { all & !(1u64 << target.0) } else { all };
+                        assert_eq!(knight_pressure_mask(&blocked, attacker, king), expected);
+                    }
+                }
+            }
+        }
+    }
+}
