+// Test-only observation of actual stored records; not a release API/observer.
+#[cfg(test)]
+impl RememberedTable {
+    pub(crate) fn test_matching_records(&self,group:usize,identity:u32)
+        -> Vec<(i32,i32,Option<Move>,Bound,bool,bool)>
