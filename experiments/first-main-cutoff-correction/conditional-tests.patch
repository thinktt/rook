+            .filter(|r|r.matches(self.generation,identity))
+            .map(|r|(r.score as i32,r.depth as i32,
+                      (r.endpoints!=0).then_some(Move(r.endpoints)),r.bound(),
+                      r.flags&QUIET_CHECKED!=0,r.flags&MARKED_DEPTH!=0))
+            .collect()
+    }
