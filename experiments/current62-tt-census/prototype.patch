+        assert_eq!(table.probe(query(9, 5, 0)).score, None);
+        table.groups[0].records[3] = Record::from_store(entry(9, 1, 30), 0);
+        table.groups[0].records[1] = Record::from_store(entry(9, 10, 40), 1);
+        assert_eq!(table.probe(query(9, 5, 0)).score, Some(40));
+        table.groups[0].records[3] = Record::from_store(entry(9, 1, 30), 1);
+        table.groups[0].records[1] = Record::default();
+        table.groups[0].records[0] = Record::from_store(entry(9, 10, 40), 1);
+        let result = table.probe(query(9, 5, 0));
+        assert_eq!((result.score, result.marked_depth), (Some(40), Some(10)));
+        assert_eq!(table.probe(query(9, 1, 0)).score, Some(30));
+        let c = counts();
+        assert_eq!(c.probe_calls, 4);
+        assert_eq!((c.joint[0][1], c.joint[1][5], c.joint[2][3], c.joint[3][0]), (1,1,1,1));
+        assert_eq!(c.probe_filter[3], [1,1,2]);
+        assert_eq!(c.probe_filter[0], [2,0,1]);
+        assert_eq!(c.probe_filter[1], [1,0,1]);
+        assert_eq!(c.probe_filter[2], [1,0,0]);
+        assert_eq!(c.consider[3], [1,0,1]);
+        assert_eq!((c.returns_score, c.returns_no_score), (3,1));
