+    #[test]
+    fn tt_census_lifecycle_and_diagnostic_failure_do_not_own_table_values() {
+        let _local = LocalState::new();
+        let mut table = RememberedTable::with_groups(2);
+        let other = RememberedTable::from_tts(96).unwrap();
+        table.store(entry(1, 2, 42));
+        table.generation = 254;
+        table.clear(); table.clear();
+        assert_eq!(table.generation, 1);
+        assert_eq!(table.probe(query(1, 2, 0)).score, None);
+        assert_eq!(other.group_count(), 2);
+        let c = counts();
+        assert_eq!((c.allocations, c.groups, c.initialized), (2,4,4));
+        assert!(c.capacity >= c.groups);
+        assert_eq!((c.generation_clears, c.wrap_clears, c.wrap_groups), (1,1,2));
+        observe(|s| { s.c.store_calls = u64::MAX; add(&mut s.c.store_calls, 1, &mut s.overflow); });
+        { let _unfinished = begin_probe(0); }
+        STATE.with(|s| { let s = s.borrow(); assert!(s.overflow && s.invalid && s.active.is_none()); });
+        // Counter failure does not change the actual store/probe return owner.
+        table.store(entry(2, 3, 55));
+        assert_eq!(table.probe(query(2, 3, 0)).score, Some(55));
+    }
