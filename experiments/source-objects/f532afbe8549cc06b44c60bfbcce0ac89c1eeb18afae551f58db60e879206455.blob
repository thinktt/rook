+    // BEGIN experiment42 test sources (unrun at source freeze).
+    #[test]
+    fn borrowed_geometry_owned_roots_and_external_boundaries() {
+        let position = Position::from_fen(START).unwrap();
+        let mut search = engine::<true>(&position);
+        let mut history = SearchHistory::new(&position);
+        let before = crate::activity::borrowed_geometry_groups();
+        assert!(matches!(search.run_iterations(position, &mut history, 2, Limits { nodes: Some(0) }),
+            Err(Error::Stopped(Stopped::NodeLimit(0)))));
+        assert!(crate::activity::borrowed_geometry_groups() > before, "owned root uses true full before stop");
+        assert!(!search.geometry_permission());
+        assert_eq!(history.search_ply(), 0);
+        let completed = search.run_iterations(position, &mut history, 1, Limits::default()).unwrap();
+        assert!(!completed.pv.is_empty());
+        assert!(!search.geometry_permission());
+        assert_eq!(history.search_ply(), 0);
+        // Public root/sequence ingress must revoke an earlier owned permission.
+        search.bind_geometry_permission(&position);
+        assert!(search.geometry_permission());
+        let before = crate::activity::borrowed_geometry_groups();
+        let _root = search.prepare_root(position);
+        assert!(!search.geometry_permission());
+        assert_eq!(crate::activity::borrowed_geometry_groups(), before);
+        search.bind_geometry_permission(&position);
+        search.begin_sequence(Limits::default());
+        assert!(!search.geometry_permission());
+        let controls = crate::timed::Controls { average_cs: 100000, maximum_cs: 100000,
+            origin: 0, seed: 0, randomness: 0, maximum_entered_iterations: 2 };
+        let before = crate::activity::borrowed_geometry_groups();
+        let result = search.run_work_timed(position, &mut history, controls, Limits { nodes: Some(0) });
+        assert!(result.is_err());
+        assert!(crate::activity::borrowed_geometry_groups() > before);
+        assert!(!search.geometry_permission());
+        assert_eq!(history.search_ply(), 0);
+    }
+    // END experiment42 test sources.
+
 }
 
