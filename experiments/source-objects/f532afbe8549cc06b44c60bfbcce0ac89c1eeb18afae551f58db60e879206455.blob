+    // BEGIN experiment42 test sources (unrun at source freeze).
+    #[test]
+    fn borrowed_geometry_full_selector_public_observation_and_retained_equality() {
+        fn check<const D: bool>() {
+            let position = Position::from_fen(START).unwrap();
+            let map = Influence { profiles: std::array::from_fn(|c| std::array::from_fn(|i| (i * 31 + c * 89) as u8)) };
+            let mut a = Evaluator::<D>::new(&position);
+            let mut b = Evaluator::<D>::new(&position);
+            let mut x = Node::root(position, &a.root);
+            let mut y = x;
+            let before = crate::activity::borrowed_geometry_groups();
+            let owned = a.full_for_search(&mut x, &map, false, true);
+            assert_eq!(owned, b.full(&mut y, &map, false));
+            let mut rebuilt_evaluator = Evaluator::<D>::new(&position);
+            let mut rebuilt_node = Node::root(position, &rebuilt_evaluator.root);
+            let rebuilt = rebuilt_evaluator.full(&mut rebuilt_node, &Influence::build(&position), false);
+            assert!(owned != rebuilt || x.retained != rebuilt_node.retained,
+                "custom map must distinguish silently rebuilt influence");
+            assert!(crate::activity::borrowed_geometry_groups() > before);
+            assert_eq!(x, y);
+            assert_eq!(a.stats, b.stats);
+            x.retained.age = 7;
+            y = x;
+            let mut ma = Some(map);
+            let mut mb = ma;
+            let sa = a.select_noncheck_for_search(&mut x, -30000, 30000, true, &mut ma, true);
+            let sb = b.select_noncheck(&mut y, -30000, 30000, true, &mut mb);
+            assert_eq!(sa, sb);
+            assert_eq!(x, y);
+            assert_eq!(a.stats, b.stats);
+            assert_eq!(ma.unwrap().profiles, map.profiles);
+            assert_eq!(mb.unwrap().profiles, map.profiles);
+            let mut stale = position;
+            stale.board[16] = Piece::new(Color::Black, PieceKind::Queen);
+            assert!(stale.validate().is_err());
+            assert_ne!(stale.attack_planes(), crate::attacks::AttackBits::from_board(&stale.board).planes());
+            let mut a = Evaluator::<D>::new(&stale);
+            let mut b = Evaluator::<D>::new(&stale);
+            let mut x = Node::root(stale, &a.root);
+            let mut y = x;
+            let before = crate::activity::borrowed_geometry_groups();
+            let mut observations = 0;
+            let observed = a.full_observed(&mut x, &map, false, |_| observations += 1);
+            assert_eq!(observed, b.full(&mut y, &map, false));
+            assert_eq!((x, a.stats), (y, b.stats));
+            assert_eq!(observations, 1);
+            let mut supplied = Some(map);
+            let mut stages = Vec::new();
+            a.select_noncheck_stages_observed(&mut x, -30000, 30000, true, &mut supplied, |stage| stages.push(stage));
+            assert!(!stages.is_empty());
+            assert_eq!(borrowed_geometry_groups_for_test(), before);
+        }
+        fn borrowed_geometry_groups_for_test() -> u64 { crate::activity::borrowed_geometry_groups() }
+        check::<true>();
+        check::<false>();
+    }
+    // END experiment42 test sources.
+
