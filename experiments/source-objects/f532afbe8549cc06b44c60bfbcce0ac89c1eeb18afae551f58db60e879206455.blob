+    // BEGIN experiment42 test sources (unrun at source freeze).
+    #[test]
+    fn borrowed_geometry_visibility_and_categories_match_scalar() {
+        fn check<const K: usize>(position: &Position, map: &Influence, color: Color) {
+            let geometry = SliderGeometry::new::<K>(position.attack_planes(), color);
+            let values = std::array::from_fn(|i| (i % 23 + 1) as u8);
+            for index in 0..64 {
+                let source = Square(index);
+                for direction in if K == 2 { 0..4 } else if K == 3 { 4..8 } else { 0..8 } {
+                    let (mut direct, mut extra, increasing) = geometry.destinations::<K>(source, direction, color);
+                    let mut actual = Vec::new();
+                    while direct != 0 { actual.push((take_nearest(&mut direct, increasing), false)); }
+                    while extra != 0 { actual.push((take_nearest(&mut extra, increasing), true)); }
+                    // Independent coordinate walk; no mask/prefix helper or ray table.
+                    let mut expected = Vec::new();
+                    let mut cursor = source;
+                    let mut additional = false;
+                    let step = DIRECTIONS[direction];
+                    while let Some(target) = cursor.offset(step.0, step.1) {
+                        let victim = position.board[target.0 as usize];
+                        if victim.is_empty() || victim.color() != color {
+                            expected.push((target, additional));
+                        }
+                        if !victim.is_empty() {
+                            if !transparent(color, PieceKind::ALL[K], step, victim) { break; }
+                            additional = true;
+                        }
+                        cursor = target;
+                    }
+                    assert_eq!(actual, expected, "kind={K} color={color:?} source={source} direction={direction}");
+                }
+                let mut a = [[0; 64]; 2];
+                let mut b = a;
+                let actual = destinations_borrowed::<K>(position, map, color, source, &values, &mut a, &geometry);
+                let expected = destinations_kind::<K>(position, map, color, source, &values, &mut b);
+                assert_eq!((actual.categories, actual.total, actual.queries, a),
+                    (expected.categories, expected.total, expected.queries, b));
+            }
+        }
+        // Coherent placements; opposing kings remain admitted activity targets.
+        // Synthetic source squares exercise geometry independently of source lists.
+        for placement in ["7k/8/8/8/8/8/8/K7",
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR",
+            "7k/pp2rqp1/1n2bn2/2B1R3/1QN1q1r1/1P2N3/P2B4/K7",
+            "k7/R7/8/8/8/8/7r/7K"] {
+            let position = position(placement);
+            for salt in [0u8, 1, 73, 255] {
+                let map = Influence { profiles: std::array::from_fn(|c|
+                    std::array::from_fn(|i| (i as u8).wrapping_mul(37).wrapping_add(salt).wrapping_add(c as u8 * 11))) };
+                for color in [Color::White, Color::Black] {
+                    check::<2>(&position, &map, color);
+                    check::<3>(&position, &map, color);
+                    check::<4>(&position, &map, color);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn borrowed_geometry_complete_activity_custom_maps_and_public_fallback() {
+        for placement in ["rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR",
+            "7k/pp2rqp1/1n2bn2/2B1R3/1QN1q1r1/1P2N3/P2B4/K7",
+            "k7/R7/8/8/8/8/7r/7K"] {
+            let position = position(placement);
+            let maps = [Influence::build(&position), Influence { profiles: [[255; 64], [170; 64]] },
+                Influence { profiles: std::array::from_fn(|c| std::array::from_fn(|i| (i * 29 + c * 67) as u8)) }];
+            let mut custom_is_discriminating = false;
+            let before_owned = borrowed_geometry_groups();
+            for map in &maps {
+                custom_is_discriminating |= compute(&position, map, 123, [63, 177])
+                    != compute(&position, &maps[0], 123, [63, 177]);
+                for weights in [[0, 0], [63, 177], [200, 9]] {
+                    for material in [-7000, -17, 0, 7000] {
+                        assert_eq!(compute_for_search(&position, map, material, weights, true),
+                            compute(&position, map, material, weights));
+                    }
+                }
+            }
+            assert!(custom_is_discriminating, "custom-map witness must differ from rebuilt map");
+            assert!(borrowed_geometry_groups() > before_owned);
+            let mut stale = position;
+            stale.board[sq("a3").0 as usize] = Piece::new(Color::Black, PieceKind::Queen);
+            assert!(stale.validate().is_err());
+            assert_ne!(stale.attack_planes(), crate::attacks::AttackBits::from_board(&stale.board).planes());
+            let before = borrowed_geometry_groups();
+            assert_eq!(compute(&stale, &maps[1], 123, [63, 177]),
+                compute_impl::<false>(&stale, &maps[1], 123, [63, 177]));
+            assert_eq!(borrowed_geometry_groups(), before);
+        }
+        let empty_groups = position("7k/8/8/8/8/8/8/K7");
+        let before = borrowed_geometry_groups();
+        assert_eq!(compute_for_search(&empty_groups, &empty_influence(), 0, [100, 100], true),
+            compute(&empty_groups, &empty_influence(), 0, [100, 100]));
+        assert_eq!(borrowed_geometry_groups(), before, "no slider setup without a group");
+    }
+    // END experiment42 test sources.
+
+}
