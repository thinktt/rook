+/// Placement permission is supplied only by the existing guarded owned search.
+/// The caller's Influence bytes remain authoritative on either route.
+pub(crate) fn compute_for_search(
+    position: &Position, influence: &Influence, material_score: i32,
+    weights: [i32; 2], coherent_geometry: bool,
+) -> Activity {
+    if coherent_geometry {
+        compute_impl::<true>(position, influence, material_score, weights)
+    } else {
+        compute_impl::<false>(position, influence, material_score, weights)
+    }
+}
+
