//! Ordinary legal inventory in KingRE generation order.
//!
//! Legality projects placement for geometric safety. Chronology, fingerprints and evaluation
//! state are updated only when a caller actually plays an admitted move.

use crate::geometry::{ATTACK_RAYS, DIRECTIONS, KNIGHT, KNIGHT_SOURCES};
use crate::position::Position;
use crate::types::{Color, Move, MoveKind, Piece, PieceKind, Square};

pub const MOVE_CAPACITY: usize = 512;

#[derive(Clone)]
pub struct MoveList {
    pub moves: [Move; MOVE_CAPACITY],
    pub len: usize,
}

impl MoveList {
    pub const fn new() -> Self {
        Self {
            moves: [Move::NONE; MOVE_CAPACITY],
            len: 0,
        }
    }

    #[inline]
    pub fn as_slice(&self) -> &[Move] {
        &self.moves[..self.len]
    }

    #[inline]
    pub fn clear(&mut self) {
        self.len = 0;
    }

    #[inline]
    pub fn push(&mut self, mv: Move) {
        assert!(
            self.len < MOVE_CAPACITY,
            "ordinary candidate capacity exceeded"
        );
        self.moves[self.len] = mv;
        self.len += 1;
        crate::generation_census::emitted();
    }
}

impl Default for MoveList {
    fn default() -> Self {
        Self::new()
    }
}

const PROMOTIONS: [PieceKind; 4] = [
    PieceKind::Queen,
    PieceKind::Rook,
    PieceKind::Bishop,
    PieceKind::Knight,
];

#[derive(Clone, Copy)]
struct Checkers {
    squares: [Square; 2],
    len: usize,
}

impl Checkers {
    #[inline]
    fn add<const LIMIT: usize>(&mut self, square: Square) -> bool {
        self.squares[self.len] = square;
        self.len += 1;
        self.len == LIMIT
    }
}

#[inline]
fn has_piece(board: &[Piece; 64], square: Square, color: Color, kind: PieceKind) -> bool {
    board[square.0 as usize] == Piece::new(color, kind)
}

/// Pinned pieces still attack their geometric destinations.
#[inline]
fn find_attackers<const LIMIT: usize>(board: &[Piece; 64], square: Square, by: Color) -> Checkers {
    let mut result = Checkers {
        squares: [Square(0); 2],
        len: 0,
    };
    let pawn_back = if by == Color::White { -1 } else { 1 };
    for df in [-1, 1] {
        if let Some(from) = square.offset(df, pawn_back) {
            if has_piece(board, from, by, PieceKind::Pawn) && result.add::<LIMIT>(from) {
                return result;
            }
        }
    }
    let leaps = &KNIGHT_SOURCES[square.0 as usize];
    let knight = Piece::new(by, PieceKind::Knight);
    for &from in &leaps.squares[..leaps.len as usize] {
        debug_assert!(from < 64);
        if board[(from & 63) as usize] == knight && result.add::<LIMIT>(Square(from)) {
            return result;
        }
    }
    let queen = Piece::new(by, PieceKind::Queen);
    let king = Piece::new(by, PieceKind::King);
    for (direction, ray) in ATTACK_RAYS.0[square.0 as usize].iter().enumerate() {
        let slider = Piece::new(
            by,
            if direction < 4 {
                PieceKind::Bishop
            } else {
                PieceKind::Rook
            },
        );
        for (distance, &from) in ray.squares[..ray.len as usize].iter().enumerate() {
            debug_assert!(from < 64);
            let piece = board[(from & 63) as usize];
            if !piece.is_empty() {
                if (piece == queen || piece == slider || (distance == 0 && piece == king))
                    && result.add::<LIMIT>(Square(from))
                {
                    return result;
                }
                break;
            }
        }
    }
    result
}

#[inline]
pub fn attacked(board: &[Piece; 64], square: Square, by: Color) -> bool {
    find_attackers::<1>(board, square, by).len != 0
}

#[inline]
pub fn in_check(position: &Position, side: Color) -> bool {
    let king = position.piece_squares(side, PieceKind::King)[0];
    position.attack_view().attacked(king, side.opponent())
}

/// Semantic current-side classification, saturated at two checkers.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CheckClassification { None, Single, Double }

/// Read-only component observation using the retained native mailbox finder.
/// Complete generation supplies equivalent ordered identities from tag planes.
pub fn check_classification(position: &Position) -> CheckClassification {
    let king=position.piece_squares(position.side,PieceKind::King)[0];
    match find_attackers::<2>(&position.board,king,position.side.opponent()).len {
        0=>CheckClassification::None, 1=>CheckClassification::Single, _=>CheckClassification::Double,
    }
}

/// Project just the fields needed for geometric king safety, not a semantic
/// Position transition. The caller has checked destination and special geometry.
#[inline]
pub(crate) fn projected_board(position: &Position, mv: Move) -> [Piece; 64] {
    let mut board = position.board;
    let from = mv.from();
    let to = mv.to();
    let mover = board[from.0 as usize];
    board[from.0 as usize] = Piece::EMPTY;
    board[to.0 as usize] = mover;
    match mv.kind() {
        MoveKind::Ordinary => {}
        MoveKind::Promotion(kind) => {
            board[to.0 as usize] = Piece::new(position.side, kind);
        }
        MoveKind::EnPassant => {
            let behind = if position.side == Color::White {
                to.0 - 8
            } else {
                to.0 + 8
            };
            board[behind as usize] = Piece::EMPTY;
        }
        MoveKind::Castle => {
            let rank = from.rank() * 8;
            let (rook_from, rook_to) = if to.file() == 2 {
                (rank, rank + 3)
            } else {
                (rank + 7, rank + 5)
            };
            board[rook_to as usize] = board[rook_from as usize];
            board[rook_from as usize] = Piece::EMPTY;
        }
    }
    board
}

#[cfg(test)]
fn mailbox_legal_after(position: &Position, mv: Move, king: Square) -> bool {
    let board = projected_board(position, mv);
    let king = if position.board[mv.from().0 as usize].kind() == PieceKind::King {
        mv.to()
    } else {
        king
    };
    !attacked(&board, king, position.side.opponent())
}

#[inline]
fn legal_after_bits(
    position: &Position,
    mv: Move,
    king: Square,
    bits: crate::attacks::AttackBits,
) -> bool {
    let king = if position.board[mv.from().0 as usize].kind() == PieceKind::King {
        mv.to()
    } else {
        king
    };
    !bits
        .projected(position, mv)
        .attacked(king, position.side.opponent())
}

#[inline]
fn legal_after(position: &Position, mv: Move, king: Square) -> bool {
    #[cfg(test)]
    if FORCE_PROJECTION.with(|forced| forced.get()) {
        return mailbox_legal_after(position, mv, king);
    }
    legal_after_bits(position, mv, king, position.attack_view())
}

/// Q supplies its one projected tag-plane view. Preserve the mailbox owner's
/// exact first-two order: a moved-to third route does not enable the bypass.
pub(crate) fn check_routes_bits(
    projected: &crate::attacks::AttackBits,
    king: Square,
    by: Color,
    moved_to: Square,
) -> (bool, bool) {
    let (squares, len) = projected.ordered_attackers::<2>(king, by);
    (len != 0, len == 2 && squares.contains(&moved_to))
}

#[cfg(test)]
pub(crate) fn mailbox_ordered_attackers_for_test<const LIMIT: usize>(
    board: &[Piece; 64], square: Square, by: Color,
) -> ([Square; 2], usize) {
    let result = find_attackers::<LIMIT>(board, square, by);
    (result.squares, result.len)
}

/// The tactical caller supplies a projected board from an initially legal
/// position. A normal move can expose one route as well as its direct route.
/// EP may expose two other routes, which does not count as direct+discovered.
#[cfg(test)]
pub(crate) fn check_routes(
    board: &[Piece; 64],
    king: Square,
    by: Color,
    moved_to: Square,
) -> (bool, bool) {
    let routes = find_attackers::<2>(board, king, by);
    (
        routes.len != 0,
        routes.len == 2 && routes.squares.contains(&moved_to),
    )
}

#[inline]
fn add_if_legal(position: &Position, list: &mut MoveList, king: Square, mv: Move) {
    if crate::generation_census::special_current(legal_after(position, mv, king)) {
        list.push(mv);
    }
}

/// Valid only for this immutable position and this one generation call.
struct GenerationSafety {
    king: Square,
    checked: bool,
    pinned: u64,
    evasion_destinations: u64,
}

impl GenerationSafety {
    fn new(position: &Position, king: Square, checkers: Checkers) -> Self {
        let checked = checkers.len != 0;
        let mut evasion_destinations = 0;
        if checkers.len == 1 {
            let checker = checkers.squares[0];
            evasion_destinations = 1u64 << checker.0;
            let df = checker.file() as i8 - king.file() as i8;
            let dr = checker.rank() as i8 - king.rank() as i8;
            if df == 0 || dr == 0 || df.abs() == dr.abs() {
                let mut cursor = king.offset(df.signum(), dr.signum());
                while let Some(square) = cursor {
                    if square == checker {
                        break;
                    }
                    evasion_destinations |= 1u64 << square.0;
                    cursor = square.offset(df.signum(), dr.signum());
                }
            }
        }
        let mut pinned = 0;
        let enemy = position.side.opponent();
        if !checked
            && [PieceKind::Bishop, PieceKind::Rook, PieceKind::Queen]
                .iter()
                .any(|kind| position.counts[enemy.index()][kind.index()] != 0)
        {
            pinned = position.attack_view().absolute_pins(king, position.side);
            crate::generation_census::pin(pinned);
        }
        Self {
            king,
            checked,
            pinned,
            evasion_destinations,
        }
    }

    #[inline]
    fn accepts(&self, position: &Position, movement: Move) -> bool {
        crate::generation_census::trial();
        let mut census_route = 6;
        #[cfg(test)]
        if FORCE_PROJECTION.with(|forced| forced.get()) {
            return legal_after(position, movement, self.king);
        }
        if movement.from() != self.king
            && matches!(movement.kind(), MoveKind::Ordinary | MoveKind::Promotion(_))
        {
            if self.checked {
                census_route = 4;
                // With the king fixed, a two-square change must capture the
                // lone checker or fill a square on its current ray. No single
                // destination resolves two existing geometric routes. EP has
                // another removed square and is deliberately excluded here.
                if self.evasion_destinations & (1u64 << movement.to().0) == 0 {
                    crate::generation_census::route(3);
                    return false;
                }
                // A necessary evasion is not sufficient: keep full projection
                // for any source pin or other newly exposed attack.
            } else if self.pinned & (1u64 << movement.from().0) == 0 {
                // Only vacating a sole ray blocker can expose a new attack on
                // the safe stationary king. The destination stays occupied by
                // our piece, including captures and promotions.
                crate::generation_census::route(0);
                return true;
            } else {
                census_route = 1;
            }
        }
        crate::generation_census::projected(census_route, legal_after(position, movement, self.king))
    }
}

#[inline]
fn add_if_safe(
    position: &Position,
    list: &mut MoveList,
    safety: &GenerationSafety,
    movement: Move,
) {
    if safety.accepts(position, movement) {
        list.push(movement);
    }
}

fn en_passant_prefix<const LIMIT: usize>(position: &Position, list: &mut MoveList, king: Square) {
    if position.ep >= 64 {
        return;
    }
    let target = Square(position.ep);
    if !position.board[target.0 as usize].is_empty() {
        return;
    }
    let step = if position.side == Color::White { 1 } else { -1 };
    let Some(behind) = target.offset(0, -step) else {
        return;
    };
    let victim = position.board[behind.0 as usize];
    // Joined ingress accepts any opposing non-king piece behind the target.
    // Its exceptional king-victim command is an ingress outcome, not search.
    if victim.is_empty() || victim.color() == position.side || victim.kind() == PieceKind::King {
        return;
    }
    for df in [-1, 1] {
        if let Some(from) = target.offset(df, -step) {
            if has_piece(&position.board, from, position.side, PieceKind::Pawn) {
                crate::generation_census::set_special(0);
                add_if_legal(
                    position,
                    list,
                    king,
                    Move::new(from, target, MoveKind::EnPassant),
                );
                if list.len >= LIMIT {
                    return;
                }
            }
        }
    }
}

fn castles<const LIMIT: usize>(
    position: &Position,
    list: &mut MoveList,
    king: Square,
    checked: bool,
) {
    if checked {
        return;
    }
    let (rank, long_right, short_right) = if position.side == Color::White {
        (0, 1, 2)
    } else {
        (56, 4, 8)
    };
    let home = Square(rank + 4);
    if king != home || !has_piece(&position.board, home, position.side, PieceKind::King) {
        return;
    }
    for (right, rook, transit, target, empty) in [
        (
            long_right,
            rank,
            rank + 3,
            rank + 2,
            [rank + 1, rank + 2, rank + 3],
        ),
        (
            short_right,
            rank + 7,
            rank + 5,
            rank + 6,
            [rank + 5, rank + 6, rank + 6],
        ),
    ] {
        if position.rights & right == 0
            || !has_piece(
                &position.board,
                Square(rook),
                position.side,
                PieceKind::Rook,
            )
            || empty
                .into_iter()
                .any(|s| !position.board[s as usize].is_empty())
        {
            continue;
        }
        if !crate::generation_census::special(2, legal_after(
            position,
            Move::new(home, Square(transit), MoveKind::Ordinary),
            king,
        )) {
            continue;
        }
        crate::generation_census::set_special(4);
        add_if_legal(
            position,
            list,
            king,
            Move::new(home, Square(target), MoveKind::Castle),
        );
        if list.len >= LIMIT {
            return;
        }
    }
}

fn pawn_destination<const LIMIT: usize>(
    position: &Position,
    list: &mut MoveList,
    safety: &GenerationSafety,
    from: Square,
    to: Square,
) {
    if to.rank() == 0 || to.rank() == 7 {
        // Promotion type cannot alter whether an opposing piece attacks our
        // king: each choice has identical occupancy and color at the target.
        crate::generation_census::count(11);
        if safety.accepts(
            position,
            Move::new(from, to, MoveKind::Promotion(PieceKind::Queen)),
        ) {
            crate::generation_census::count(12);
            for kind in PROMOTIONS {
                list.push(Move::new(from, to, MoveKind::Promotion(kind)));
                crate::generation_census::count(13);
                if list.len >= LIMIT {
                    return;
                }
            }
        }
    } else {
        add_if_safe(
            position,
            list,
            safety,
            Move::new(from, to, MoveKind::Ordinary),
        );
    }
}

fn pawns<const LIMIT: usize>(position: &Position, list: &mut MoveList, safety: &GenerationSafety) {
    let step = if position.side == Color::White { 1 } else { -1 };
    let files = if position.side == Color::White {
        [1, -1]
    } else {
        [-1, 1]
    };
    let initial_rank = if position.side == Color::White { 1 } else { 6 };
    for &from in position.piece_squares(position.side, PieceKind::Pawn) {
        crate::generation_census::source(0);
        for df in files {
            if let Some(to) = from.offset(df, step) {
                crate::generation_census::pawn(0);
                let victim = position.board[to.0 as usize];
                if !victim.is_empty()
                    && victim.color() != position.side
                    && victim.kind() != PieceKind::King
                {
                    crate::generation_census::pawn(1);
                    pawn_destination::<LIMIT>(position, list, safety, from, to);
                    if list.len >= LIMIT {
                        return;
                    }
                }
            }
        }
        if let Some(to) = from.offset(0, step) {
            crate::generation_census::pawn(2);
            if position.board[to.0 as usize].is_empty() {
                crate::generation_census::pawn(3);
                pawn_destination::<LIMIT>(position, list, safety, from, to);
                if list.len >= LIMIT {
                    return;
                }
                if from.rank() == initial_rank {
                    let twice = from.offset(0, 2 * step).unwrap();
                    if position.board[twice.0 as usize].is_empty() {
                        crate::generation_census::pawn(4);
                        add_if_safe(
                            position,
                            list,
                            safety,
                            Move::new(from, twice, MoveKind::Ordinary),
                        );
                        if list.len >= LIMIT {
                            return;
                        }
                    }
                }
            }
        }
    }
}

fn pieces<const LIMIT: usize>(
    position: &Position,
    list: &mut MoveList,
    safety: &GenerationSafety,
    kind: PieceKind,
) {
    let directions: &[(i8, i8)] = match kind {
        PieceKind::Knight => &KNIGHT,
        PieceKind::Bishop => &DIRECTIONS[..4],
        PieceKind::Rook => &DIRECTIONS[4..],
        PieceKind::Queen | PieceKind::King => &DIRECTIONS,
        PieceKind::Pawn => unreachable!(),
    };
    let sliding = matches!(kind, PieceKind::Bishop | PieceKind::Rook | PieceKind::Queen);
    for &from in position.piece_squares(position.side, kind) {
        crate::generation_census::source(kind.index());
        for &(df, dr) in directions {
            let mut next = from.offset(df, dr);
            while let Some(to) = next {
                crate::generation_census::cursor(kind.index());
                let victim = position.board[to.0 as usize];
                if !victim.is_empty()
                    && (victim.color() == position.side || victim.kind() == PieceKind::King)
                {
                    crate::generation_census::blocker(kind.index());
                    break;
                }
                add_if_safe(
                    position,
                    list,
                    safety,
                    Move::new(from, to, MoveKind::Ordinary),
                );
                if list.len >= LIMIT {
                    return;
                }
                if !sliding || !victim.is_empty() {
                    break;
                }
                next = to.offset(df, dr);
            }
        }
    }
}

fn prefix_matching(
    list: &mut MoveList,
    next: &mut usize,
    end: usize,
    predicate: impl Fn(Move) -> bool,
) {
    let mut cursor = *next;
    while cursor < end {
        let mv = list.moves[cursor];
        if predicate(mv) {
            list.moves.copy_within(*next..cursor, *next + 1);
            list.moves[*next] = mv;
            *next += 1;
        }
        cursor += 1;
    }
}

fn single_check_pawn_prefix(
    list: &mut MoveList,
    start: usize,
    end: usize,
    king: Square,
    checker: Square,
    side: Color,
) {
    let mut next = start;
    let df = checker.file() as i8 - king.file() as i8;
    let dr = checker.rank() as i8 - king.rank() as i8;
    if df == 0 || dr == 0 || df.abs() == dr.abs() {
        let mut between = king.offset(df.signum(), dr.signum());
        while let Some(square) = between {
            if square == checker {
                break;
            }
            prefix_matching(list, &mut next, end, |mv| mv.to() == square);
            between = square.offset(df.signum(), dr.signum());
        }
    }
    for index in 0..8 {
        let file = if side == Color::White {
            index
        } else {
            7 - index
        };
        prefix_matching(list, &mut next, end, |mv| {
            mv.to() == checker && mv.from().file() == file
        });
    }
}

/// Complete legal root/non-root base order, including search-specific prefixes.
/// This does not apply ordinary learned/hash/capture ranking.
pub fn generate_legal(position: &Position, list: &mut MoveList) {
    generate_bounded::<MOVE_CAPACITY>(position, list);
}

/// Return min(2, legal reply count), stopping as soon as the predicate is known.
/// A result below two also leaves the complete reply list available to reuse.
pub(crate) fn legal_replies_up_to_two(position: &Position, list: &mut MoveList) -> usize {
    generate_bounded::<2>(position, list);
    list.len
}

fn generate_bounded<const LIMIT: usize>(position: &Position, list: &mut MoveList) {
    let mut census = crate::generation_census::CallGuard::enter::<LIMIT>();
    list.clear();
    let king = position.piece_squares(position.side, PieceKind::King)[0];
    let (squares, len) = position
        .attack_view()
        .ordered_attackers::<2>(king, position.side.opponent());
    let checkers = Checkers { squares, len };
    census.bind(len);
    en_passant_prefix::<LIMIT>(position, list, king);
    if list.len >= LIMIT {
        census.finish(Some(0), list.len);
        return;
    }
    castles::<LIMIT>(position, list, king, checkers.len != 0);
    if list.len >= LIMIT {
        census.finish(Some(1), list.len);
        return;
    }
    let safety = GenerationSafety::new(position, king, checkers);
    census.safety_started();
    // The capped predicate discards its witnesses once two replies exist.
    // Keep complete generation in its observable order, including the EP prefix.
    let king_early = LIMIT == 2 && checkers.len != 0;
    if king_early {
        pieces::<LIMIT>(position, list, &safety, PieceKind::King);
        if list.len >= LIMIT {
            census.finish(Some(2), list.len);
            return;
        }
    }
    let pawn_start = list.len;
    pawns::<LIMIT>(position, list, &safety);
    if list.len >= LIMIT {
        census.finish(Some(3), list.len);
        return;
    }
    if checkers.len == 1 {
        let pawn_end = list.len;
        crate::generation_census::count(6);
        single_check_pawn_prefix(
            list,
            pawn_start,
            pawn_end,
            king,
            checkers.squares[0],
            position.side,
        );
    }
    // Do not shortcut double check to king-only here: the broader joined EP
    // transition can remove a non-pawn checker and simultaneously block a ray.
    for kind in [
        PieceKind::Knight,
        PieceKind::Bishop,
        PieceKind::Rook,
        PieceKind::Queen,
        PieceKind::King,
    ] {
        if king_early && kind == PieceKind::King {
            continue;
        }
        pieces::<LIMIT>(position, list, &safety, kind);
        if list.len >= LIMIT {
            census.finish(Some(kind.index() + 3), list.len);
            return;
        }
    }
    census.finish(None, list.len);
}

#[cfg(test)]
thread_local! {
    // Independent old admission route over exactly the same pseudo-candidates.
    // Compiles out of production and is isolated between parallel test threads.
    static FORCE_PROJECTION: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
}

#[cfg(test)]
mod tests {
    use super::*;

    const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

    fn inventory(fen: &str) -> Vec<String> {
        let position = Position::from_fen(fen).unwrap();
        let mut moves = MoveList::new();
        generate_legal(&position, &mut moves);
        moves.as_slice().iter().map(ToString::to_string).collect()
    }

    fn compare_projection(position: &Position, context: &str) {
        let mut fast = MoveList::new();
        let mut old = MoveList::new();
        let mut capped = MoveList::new();
        generate_legal(position, &mut fast);
        legal_replies_up_to_two(position, &mut capped);
        FORCE_PROJECTION.with(|forced| forced.set(true));
        generate_legal(position, &mut old);
        FORCE_PROJECTION.with(|forced| forced.set(false));
        assert_eq!(
            fast.as_slice(),
            old.as_slice(),
            "ordered inventory: {context}"
        );
        assert_eq!(capped.len, old.len.min(2), "bounded count: {context}");
        if old.len < 2 {
            assert_eq!(
                capped.as_slice(),
                old.as_slice(),
                "bounded reuse: {context}"
            );
        }
    }

    fn compare_ordered_checker_identities(position: &Position, context: &str) {
        for target in 0..64 {
            for side in [Color::White, Color::Black] {
                let square = Square(target);
                let one = find_attackers::<1>(&position.board, square, side);
                let two = find_attackers::<2>(&position.board, square, side);
                assert_eq!(
                    position.attack_view().ordered_attackers::<1>(square, side),
                    (one.squares, one.len),
                    "one checker: {context}/{target}/{side:?}"
                );
                assert_eq!(
                    position.attack_view().ordered_attackers::<2>(square, side),
                    (two.squares, two.len),
                    "two checkers: {context}/{target}/{side:?}"
                );
            }
        }
    }

    #[test]
    fn ordered_bit_checker_identities_keep_knight_ray_king_and_capped_order() {
        for (fen, target, expected) in [
            ("7k/8/8/8/8/3P1P2/8/K7 w - - 0 1", "e4", &["d3", "f3"][..]),
            ("7k/8/5N2/8/8/8/3N4/K7 w - - 0 1", "e4", &["f6", "d2"][..]),
            ("8/8/6B1/8/4k3/3K4/8/8 w - - 0 1", "e4", &["g6", "d3"][..]),
            ("7k/8/6B1/5n2/8/8/8/K7 w - - 0 1", "e4", &[][..]),
            // Pawn, knight and rook attack e8. The rook is third, and must
            // remain absent from the exact first-two identity result.
            (
                "4k3/3P4/5N2/8/8/8/4R3/K7 w - - 0 1",
                "e8",
                &["d7", "f6"][..],
            ),
        ] {
            let position = Position::from_fen(fen).unwrap();
            compare_ordered_checker_identities(&position, fen);
            let (squares, len) = position
                .attack_view()
                .ordered_attackers::<2>(Square::parse(target).unwrap(), Color::White);
            let names: Vec<_> = squares[..len].iter().map(ToString::to_string).collect();
            assert_eq!(names, expected);
        }
    }

    #[test]
    fn semantic_check_classification_reports_none_single_and_saturated_double() {
        for (fen,expected) in [
            ("7k/8/8/8/8/8/8/K7 w - - 0 1",CheckClassification::None),
            ("r6k/8/8/8/8/8/8/K7 w - - 0 1",CheckClassification::Single),
            ("r5kb/8/8/8/8/8/8/K7 w - - 0 1",CheckClassification::Double),
        ] {
            let position=Position::from_fen(fen).unwrap();
            assert_eq!(check_classification(&position),expected);
            assert_eq!(in_check(&position,position.side),expected!=CheckClassification::None);
        }
    }

    #[test]
    fn generation_summary_matches_projection_on_joined_witnesses() {
        for (fen, movement, admitted) in [
            ("k7/8/8/4KPpr/8/8/8/8 w - g6 0 1", "f5g6", false),
            ("k7/8/8/4KPnr/8/8/8/8 w - g6 0 1", "f5g6", false),
            ("7k/8/8/8/8/8/3rP3/K7 w - d3 0 1", "e2d3", true),
            ("1b5k/8/8/2Pn4/5K2/8/8/8 w - d6 0 1", "c5d6", true),
            ("R3r2k/8/8/8/8/8/4N3/4K3 w - - 0 1", "e2c3", false),
            ("k3r3/8/8/8/8/8/4R3/4K3 w - - 0 1", "e2e8", true),
            ("k3r3/8/8/8/8/8/4R3/4K3 w - - 0 1", "e2e3", true),
            ("k3r3/8/8/8/8/8/4R3/4K3 w - - 0 1", "e2d2", false),
            ("1b5k/P7/8/8/8/8/7K/8 w - - 0 1", "a7b8q", true),
            ("1b5k/P7/8/8/8/8/7K/8 w - - 0 1", "a7a8q", false),
            ("4k3/8/8/8/4B3/8/8/K3R3 w - - 0 1", "e4f5", true),
            ("k7/8/8/8/8/8/8/2K5 b - - 0 1", "a8a7", true),
        ] {
            let position = Position::from_fen(fen).unwrap();
            compare_projection(&position, fen);
            assert_eq!(
                inventory(fen).iter().any(|mv| mv == movement),
                admitted,
                "witness {fen}: {movement}"
            );
        }
        for fen in [
            START,
            "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
            "4r1k1/8/8/8/1b6/8/8/4K3 w - - 0 1",
            "7k/6Q1/5K2/8/8/8/8/8 b - - 0 1",
        ] {
            let position = Position::from_fen(fen).unwrap();
            compare_projection(&position, fen);
            let mut moves = MoveList::new();
            generate_legal(&position, &mut moves);
            for &mv in moves.as_slice() {
                compare_projection(&position.played_unchecked(mv), &format!("{fen} / {mv}"));
            }
        }
    }

    #[test]
    fn generation_summary_matches_projection_on_constructed_setups() {
        // Construct admitted placements, including attacked nonmoving kings,
        // adjacent kings, promoted material, and geometrically pinned attackers.
        // This intentionally does not restrict coverage to legal game histories.
        let mut seed = 0x496d7032c6a40f71u64;
        let mut random = || {
            seed ^= seed << 13;
            seed ^= seed >> 7;
            seed ^= seed << 17;
            seed
        };
        for sample in 0..10_000 {
            let mut board = [Piece::EMPTY; 64];
            for side in [Color::White, Color::Black] {
                let mut count = [0u8; 6];
                for index in 0..1 + random() % 13 {
                    let kind = if index == 0 {
                        PieceKind::King
                    } else {
                        PieceKind::ALL[(random() % 5) as usize]
                    };
                    if kind == PieceKind::Pawn && count[0] == 8 {
                        continue;
                    }
                    let square = loop {
                        let square = (random() % 64) as usize;
                        if board[square].is_empty()
                            && (kind != PieceKind::Pawn || (8..56).contains(&square))
                        {
                            break square;
                        }
                    };
                    board[square] = Piece::new(side, kind);
                    count[kind.index()] += 1;
                }
            }
            let mut placement = String::new();
            for rank in (0..8).rev() {
                if rank != 7 {
                    placement.push('/');
                }
                let mut empty = 0u8;
                for file in 0..8 {
                    let piece = board[rank * 8 + file];
                    if piece.is_empty() {
                        empty += 1;
                    } else {
                        if empty != 0 {
                            placement.push((b'0' + empty) as char);
                            empty = 0;
                        }
                        placement.push(piece.fen_char());
                    }
                }
                if empty != 0 {
                    placement.push((b'0' + empty) as char);
                }
            }
            let side = if sample % 2 == 0 { 'w' } else { 'b' };
            let fen = format!("{placement} {side} - - 0 1");
            let position = Position::from_fen(&fen).unwrap();
            compare_ordered_checker_identities(&position, &fen);
            compare_projection(&position, &fen);
        }
    }

    fn perft(position: &Position, depth: u8) -> u64 {
        if depth == 0 {
            return 1;
        }
        let mut moves = MoveList::new();
        generate_legal(position, &mut moves);
        if depth == 1 {
            return moves.len as u64;
        }
        moves
            .as_slice()
            .iter()
            .map(|&mv| perft(&position.played_unchecked(mv), depth - 1))
            .sum()
    }

    #[test]
    fn capped_reply_predicate_matches_complete_inventories_and_reuses_small_sets() {
        fn walk(position: &Position, depth: usize) {
            let mut full = MoveList::new();
            let mut capped = MoveList::new();
            generate_legal(position, &mut full);
            assert_eq!(
                legal_replies_up_to_two(position, &mut capped),
                full.len.min(2)
            );
            if full.len < 2 {
                assert_eq!(capped.as_slice(), full.as_slice());
            }
            if depth > 0 {
                for &mv in full.as_slice() {
                    walk(&position.played_unchecked(mv), depth - 1);
                }
            }
        }
        for fen in [
            START,
            "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
            "7k/P7/8/8/8/8/7p/K7 w - - 0 1",
            "7k/8/8/3pP3/8/8/8/K7 w - d6 0 1",
            "7k/6Q1/5K2/8/8/8/8/8 b - - 0 1",
            "1b5k/8/8/2Pn4/5K2/8/8/8 w - d6 0 1",
        ] {
            walk(&Position::from_fen(fen).unwrap(), 2);
        }
    }

    #[test]
    fn capped_checked_replies_keep_fixed_zero_one_and_two_king_witnesses() {
        for (fen, full_count, capped_names) in [
            ("7k/6Q1/5K2/8/8/8/8/8 b - - 0 1", 0, &[][..]),
            ("7k/7R/6K1/8/8/8/8/8 b - - 0 1", 1, &["h8g8"][..]),
            // The knight and bishop can interpose, but two king escapes
            // alone prove the threshold without adopting the full base order.
            ("5n1k/8/8/5b2/8/8/8/K6R b - - 0 1", 5, &["h8g7", "h8g8"][..]),
        ] {
            let position = Position::from_fen(fen).unwrap();
            assert!(in_check(&position, position.side));
            compare_projection(&position, fen);
            let mut full = MoveList::new();
            let mut capped = MoveList::new();
            generate_legal(&position, &mut full);
            assert_eq!(full.len, full_count, "fixed legal count: {fen}");
            assert_eq!(legal_replies_up_to_two(&position, &mut capped), full_count.min(2));
            let names: Vec<String> = capped.as_slice().iter().map(ToString::to_string).collect();
            let expected: Vec<String> = capped_names.iter().map(ToString::to_string).collect();
            assert_eq!(names, expected, "fixed threshold witnesses: {fen}");
            assert!(capped.as_slice().iter().all(|movement| full.as_slice().contains(movement)));
            if full_count == 5 {
                assert_eq!(full.moves[0].to_string(), "f8h7");
                assert_ne!(capped.as_slice(), &full.as_slice()[..2]);
            }
        }
    }

    #[test]
    fn capped_checked_replies_keep_sole_nonking_and_joined_ep_evasions() {
        let fen = "7k/8/8/8/2b5/2p5/2R4r/K6r w - - 0 1";
        let position = Position::from_fen(fen).unwrap();
        assert!(in_check(&position, position.side));
        compare_projection(&position, fen);
        let mut capped = MoveList::new();
        assert_eq!(legal_replies_up_to_two(&position, &mut capped), 1);
        assert_eq!(capped.moves[0].to_string(), "c2c1");

        // Joined EP removes a knight checker and interposes on a bishop ray.
        // A double-check king-only shortcut would lose this legal prefix.
        let fen = "1b5k/8/8/2Pn4/5K2/8/8/8 w - d6 0 1";
        let position = Position::from_fen(fen).unwrap();
        let king = position.piece_squares(position.side, PieceKind::King)[0];
        assert_eq!(find_attackers::<2>(&position.board, king, position.side.opponent()).len, 2);
        compare_projection(&position, fen);
        let mut full = MoveList::new();
        generate_legal(&position, &mut full);
        assert!(full.len >= 2);
        assert_eq!(legal_replies_up_to_two(&position, &mut capped), 2);
        assert_eq!(capped.moves[0].to_string(), "c5d6");
        assert_eq!(capped.moves[0].kind(), MoveKind::EnPassant);
        assert!(capped.as_slice().iter().all(|movement| full.as_slice().contains(movement)));
    }

    #[test]
    fn check_route_classification_separates_discovered_and_simultaneous_checks() {
        for (fen, from, to, expected) in [
            (
                "4k3/8/8/8/4B3/8/8/K3R3 w - - 0 1",
                "e4",
                "f5",
                (true, false),
            ),
            ("4k3/8/8/8/4B3/8/8/K3R3 w - - 0 1", "e4", "b5", (true, true)),
            ("4k3/8/8/8/4B3/8/8/K7 w - - 0 1", "e4", "b5", (true, false)),
            ("4k3/8/8/8/4B3/8/8/K7 w - - 0 1", "e4", "f5", (false, false)),
        ] {
            let position = Position::from_fen(fen).unwrap();
            let to = Square::parse(to).unwrap();
            let mv = Move::new(Square::parse(from).unwrap(), to, MoveKind::Ordinary);
            let board = projected_board(&position, mv);
            assert_eq!(
                check_routes(&board, Square::parse("e8").unwrap(), Color::White, to),
                expected
            );
        }
    }

    #[test]
    fn initial_order_and_legal_tree() {
        let mut expected = Vec::new();
        for file in b'a'..=b'h' {
            expected.push(format!("{}2{}3", file as char, file as char));
            expected.push(format!("{}2{}4", file as char, file as char));
        }
        expected.extend(["b1c3", "b1a3", "g1h3", "g1f3"].map(str::to_owned));
        assert_eq!(inventory(START), expected);
        let position = Position::from_fen(START).unwrap();
        for (depth, count) in [(1, 20), (2, 400), (3, 8902), (4, 197281)] {
            assert_eq!(perft(&position, depth), count, "depth {depth}");
        }
    }

    #[test]
    fn castling_and_promotion_order() {
        let castles = inventory("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
        assert_eq!(&castles[..2], ["e1c1", "e1g1"]);
        let promotions = inventory("1r2k3/P7/8/8/8/8/8/4K3 w - - 0 1");
        assert_eq!(
            &promotions[..8],
            ["a7b8q", "a7b8r", "a7b8b", "a7b8n", "a7a8q", "a7a8r", "a7a8b", "a7a8n"]
        );
        let checked = inventory("4k3/8/8/8/8/8/8/r3K2R w K - 0 1");
        assert!(!checked.iter().any(|mv| mv == "e1g1"));
    }

    #[test]
    fn single_check_prefixes_match_released_examples() {
        // Generated inventories from the corresponding released candidate
        // production examples, before ordinary preference ordering.
        assert_eq!(
            inventory("4k3/8/8/1b6/P7/8/2PPK3/8 w - - 0 1"),
            ["d2d3", "c2c4", "a4b5", "e2f3", "e2d1", "e2e3", "e2e1", "e2f2"]
        );
        assert_eq!(
            inventory("k7/8/8/8/3n4/2P1PK2/8/8 w - - 0 1"),
            ["c3d4", "e3d4", "f3g4", "f3e4", "f3g2", "f3f4", "f3f2", "f3g3"]
        );
        assert_eq!(
            inventory("8/8/2p1pk2/3N4/8/8/8/K7 b - - 0 1"),
            ["e6d5", "c6d5", "f6g7", "f6e5", "f6g5", "f6f7", "f6f5", "f6g6"]
        );
        assert_eq!(
            inventory("4r1k1/8/8/8/1b6/8/8/4K3 w - - 0 1"),
            ["e1f2", "e1f1", "e1d1"]
        );
    }

    #[test]
    fn joined_en_passant_geometry_and_self_check() {
        let mut position = Position::from_fen("4k3/8/8/2PnP3/8/8/8/4K3 w - d6 0 1").unwrap();
        position.squares[Color::White.index()].swap(0, 1);
        let mut moves = MoveList::new();
        generate_legal(&position, &mut moves);
        assert_eq!(moves.moves[0].to_string(), "c5d6");
        assert_eq!(moves.moves[1].to_string(), "e5d6");
        assert_eq!(moves.moves[0].kind(), MoveKind::EnPassant);
        assert!(!inventory("k7/8/8/4KPpr/8/8/8/8 w - g6 0 1")
            .iter()
            .any(|mv| mv == "f5g6"));

        // The joined non-pawn victim rule makes a non-king evasion possible
        // here even though a knight and bishop both check the king.
        let double = Position::from_fen("1b5k/8/8/2Pn4/5K2/8/8/8 w - d6 0 1").unwrap();
        let king = double.piece_squares(Color::White, PieceKind::King)[0];
        assert_eq!(
            find_attackers::<2>(&double.board, king, Color::Black).len,
            2
        );
        generate_legal(&double, &mut moves);
        assert_eq!(moves.moves[0].to_string(), "c5d6");
        let child = double.played_unchecked(moves.moves[0]);
        assert!(!in_check(&child, Color::White));
    }

    #[test]
    fn pinned_attackers_remain_geometric_and_projected_moves_restore_parent() {
        let pinned = Position::from_fen("4k3/4n3/8/8/6K1/8/8/4Q3 w - - 0 1").unwrap();
        assert!(attacked(
            &pinned.board,
            Square::parse("f5").unwrap(),
            Color::Black
        ));
        assert!(!inventory("4k3/4n3/8/8/6K1/8/8/4Q3 w - - 0 1")
            .iter()
            .any(|mv| mv == "g4f5"));

        for fen in [
            START,
            "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
            "1r2k3/P7/8/8/8/8/8/4K3 w - - 0 1",
            "4k3/8/8/2PnP3/8/8/8/4K3 w - d6 0 1",
        ] {
            let position = Position::from_fen(fen).unwrap();
            let original = position.board;
            let king = position.piece_squares(position.side, PieceKind::King)[0];
            let mut moves = MoveList::new();
            generate_legal(&position, &mut moves);
            for &mv in moves.as_slice() {
                let child = position.played_unchecked(mv);
                assert_eq!(
                    legal_after(&position, mv, king),
                    !in_check(&child, position.side),
                    "{fen}: {mv}"
                );
                assert_eq!(position.board, original);
            }
        }

        for (fen, from, to, kind) in [
            (
                "k3r3/8/8/8/8/8/4R3/4K3 w - - 0 1",
                "e2",
                "f2",
                MoveKind::Ordinary,
            ),
            (
                "k7/8/8/4KPpr/8/8/8/8 w - g6 0 1",
                "f5",
                "g6",
                MoveKind::EnPassant,
            ),
        ] {
            let position = Position::from_fen(fen).unwrap();
            let king = position.piece_squares(position.side, PieceKind::King)[0];
            let mv = Move::new(
                Square::parse(from).unwrap(),
                Square::parse(to).unwrap(),
                kind,
            );
            let child = position.played_unchecked(mv);
            assert!(!legal_after(&position, mv, king), "{fen}: {mv}");
            assert!(in_check(&child, position.side), "{fen}: {mv}");
        }
    }
}
