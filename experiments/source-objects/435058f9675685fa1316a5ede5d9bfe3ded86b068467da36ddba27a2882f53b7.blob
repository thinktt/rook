//! PRIVATE count-only diagnostic derivative; never a production capability.
use std::cell::RefCell;
use std::fmt::Write as _;
use std::io::{self, Write as _};
use std::path::Path;

const COUNTERS: [&str; 15] = ["calls", "safety_new", "prefix_limit_before_safety",
    "pin_summary_calls", "pin_summary_zero", "pin_summary_nonzero",
    "single_check_pawn_prefix_calls", "threshold_returns", "exhausted_returns",
    "emitted_moves", "output_len_sum", "promotion_destination_trials",
    "promotion_destination_accepts", "promotion_choices_emitted", "projection_calls"];
const ROUTES: [&str; 9] = ["unchecked_unpinned_accept", "unchecked_pinned_projection_accept",
    "unchecked_pinned_projection_reject", "checked_offmask_reject",
    "checked_onmask_projection_accept", "checked_onmask_projection_reject",
    "king_projection_accept", "king_projection_reject", "unexpected_special_accepts_route"];
const SPECIAL: [&str; 6] = ["ep_projection_accept", "ep_projection_reject",
    "castle_transit_projection_accept", "castle_transit_projection_reject",
    "castle_final_projection_accept", "castle_final_projection_reject"];
const STAGES: [&str; 9] = ["ep", "castle", "early_king", "pawns", "knight", "bishop", "rook", "queen", "king"];
const PAWN: [&str; 5] = ["capture_offsets_inboard", "capture_victim_eligible",
    "single_forward_offsets_inboard", "single_forward_empty", "double_forward_empty"];
#[derive(Clone, Copy)]
struct Row {
    counts: [u64; 15], source_entered: [u64; 6], cursor: [u64; 6], blockers: [u64; 6],
    trials: [u64; 6], routes: [u64; 9], special: [u64; 6], stage: [u64; 9],
    histogram: [u64; 3], pawn: [u64; 5],
}
impl Row {
    const fn new() -> Self { Self { counts: [0;15], source_entered: [0;6], cursor: [0;6],
        blockers: [0;6], trials: [0;6], routes: [0;9], special: [0;6], stage: [0;9],
        histogram: [0;3], pawn: [0;5] } }
    fn valid(&self, index: usize) -> bool {
        let c = self.counts.map(u128::from);
        let sum = |values: &[u64]| values.iter().map(|&x| u128::from(x)).sum::<u128>();
        let accepted = u128::from(self.routes[0]) + u128::from(self.routes[1])
            + u128::from(self.routes[4]) + u128::from(self.routes[6]);
        c[0] == c[1] + c[2] && c[0] == c[7] + c[8]
            && c[3] == c[4] + c[5] && sum(&self.trials) == sum(&self.routes)
            && self.routes[8] == 0 && accepted >= c[12]
            && c[14] == u128::from(self.routes[1]) + u128::from(self.routes[2])
                + u128::from(self.routes[4]) + u128::from(self.routes[5])
                + u128::from(self.routes[6]) + u128::from(self.routes[7]) + sum(&self.special)
            && c[9] == accepted - c[12] + c[13]
                + u128::from(self.special[0]) + u128::from(self.special[4])
            && c[12] <= c[13] && c[13] <= 4 * c[12] && c[12] <= c[11]
            && c[9] == c[10] && c[7] == sum(&self.stage)
            && (index % 3 == 0 || c[3] == 0)
            && (index % 3 == 1 || c[6] == 0)
            && (if index < 3 { c[7] == 0 && sum(&self.histogram) == 0 } else {
                sum(&self.histogram) == c[0]
                    && c[10] == u128::from(self.histogram[1]) + 2 * u128::from(self.histogram[2])
                    && c[7] == u128::from(self.histogram[2])
                    && c[8] == u128::from(self.histogram[0]) + u128::from(self.histogram[1])
            })
    }
}
#[derive(Clone, Copy)]
struct Context { row: usize, kind: Option<usize>, special: usize }
struct State { rows: [Row; 6], current: Option<Context>, active: u64,
    overflow: bool, invalid: bool, reported: bool }
impl State { const fn new() -> Self { Self { rows: [Row::new();6], current: None,
    active: 0, overflow: false, invalid: false, reported: false } } }
thread_local! { static STATE: RefCell<State> = const { RefCell::new(State::new()) }; }
fn add(value: &mut u64, overflow: &mut bool, amount: u64) {
    if let Some(next) = value.checked_add(amount) { *value = next; } else { *overflow = true; }
}
fn event(f: impl FnOnce(&mut Row, &mut bool, Context)) {
    STATE.with(|cell| {
        let mut state = cell.borrow_mut();
        if let Some(context) = state.current {
            let state = &mut *state;
            f(&mut state.rows[context.row], &mut state.overflow, context);
        }
    });
}
pub(crate) struct CallGuard { previous: Option<Context>, row: Option<usize>,
    limit: usize, safety: bool, finished: bool }
impl CallGuard {
    pub(crate) fn enter<const LIMIT: usize>() -> Self {
        let previous = STATE.with(|cell| {
            let mut state = cell.borrow_mut();
            let previous = state.current.take();
            let state = &mut *state;
            add(&mut state.active, &mut state.overflow, 1);
            previous
        });
        Self { previous, row: None, limit: LIMIT, safety: false, finished: false }
    }
    pub(crate) fn bind(&mut self, checkers: usize) {
        STATE.with(|cell| {
            let mut state = cell.borrow_mut();
            if self.row.is_some() || checkers > 2 || !matches!(self.limit, 2 | 512) {
                state.invalid = true; return;
            }
            let row = if self.limit == 512 { checkers } else { 3 + checkers };
            self.row = Some(row);
            state.current = Some(Context { row, kind: None, special: 0 });
            let state = &mut *state;
            add(&mut state.rows[row].counts[0], &mut state.overflow, 1);
        });
    }
    pub(crate) fn safety_started(&mut self) {
        if self.safety { STATE.with(|s| s.borrow_mut().invalid = true); }
        self.safety = true; count(1);
    }
    pub(crate) fn finish(&mut self, stage: Option<usize>, len: usize) {
        STATE.with(|cell| {
            let mut state = cell.borrow_mut();
            if self.finished || self.row.is_none() { state.invalid = true; return; }
            let row = self.row.unwrap();
            if state.current.map(|x| x.row) != Some(row) { state.invalid = true; }
            if stage.is_some_and(|x| x >= 9) || len > self.limit
                || stage.is_some() != (len >= self.limit) { state.invalid = true; }
            let state = &mut *state;
            let data = &mut state.rows[row];
            if !self.safety { add(&mut data.counts[2], &mut state.overflow, 1); }
            if let Some(stage) = stage {
                add(&mut data.counts[7], &mut state.overflow, 1);
                if stage < 9 { add(&mut data.stage[stage], &mut state.overflow, 1); }
            } else { add(&mut data.counts[8], &mut state.overflow, 1); }
            add(&mut data.counts[10], &mut state.overflow, len as u64);
            if self.limit == 2 && len <= 2 { add(&mut data.histogram[len], &mut state.overflow, 1); }
            self.finished = true;
        });
    }
}
impl Drop for CallGuard {
    fn drop(&mut self) { STATE.with(|cell| {
        let mut state = cell.borrow_mut();
        if !self.finished { state.invalid = true; }
        if state.active == 0 { state.invalid = true; } else { state.active -= 1; }
        state.current = self.previous;
    }); }
}
pub(crate) fn count(index: usize) { event(|r,o,_| add(&mut r.counts[index],o,1)); }
pub(crate) fn source(kind: usize) {
    STATE.with(|cell| { let mut state = cell.borrow_mut();
        if let Some(mut context) = state.current {
            if kind >= 6 { state.invalid = true; return; }
            context.kind = Some(kind); state.current = Some(context);
            let state = &mut *state;
            add(&mut state.rows[context.row].source_entered[kind], &mut state.overflow, 1);
        }
    });
}
pub(crate) fn cursor(kind: usize) { event(|r,o,_| add(&mut r.cursor[kind],o,1)); }
pub(crate) fn blocker(kind: usize) { event(|r,o,_| add(&mut r.blockers[kind],o,1)); }
pub(crate) fn pawn(index: usize) { event(|r,o,_| add(&mut r.pawn[index],o,1)); }
pub(crate) fn trial() { event(|r,o,c| { if let Some(kind) = c.kind { add(&mut r.trials[kind],o,1); } }); }
pub(crate) fn route(index: usize) { event(|r,o,_| add(&mut r.routes[index],o,1)); }
pub(crate) fn projected(base: usize, accepted: bool) -> bool {
    event(|r,o,c| {
        let index = if base == 6 && c.kind != Some(5) { 8 } else { base + usize::from(!accepted) };
        add(&mut r.routes[index],o,1); add(&mut r.counts[14],o,1);
    });
    accepted
}
pub(crate) fn set_special(base: usize) { STATE.with(|s| {
    let mut s = s.borrow_mut(); if let Some(mut c) = s.current { c.special = base; s.current = Some(c); }
}); }
pub(crate) fn special_current(accepted: bool) -> bool {
    event(|r,o,c| { add(&mut r.special[c.special + usize::from(!accepted)],o,1); add(&mut r.counts[14],o,1); }); accepted
}
pub(crate) fn special(base: usize, accepted: bool) -> bool {
    event(|r,o,_| { add(&mut r.special[base + usize::from(!accepted)],o,1); add(&mut r.counts[14],o,1); }); accepted
}
pub(crate) fn pin(mask: u64) { event(|r,o,_| { add(&mut r.counts[3],o,1);
    add(&mut r.counts[if mask == 0 { 4 } else { 5 }],o,1); }); }
pub(crate) fn emitted() { count(9); }
fn named(out: &mut String, names: &[&str], values: &[u64]) {
    out.push('{'); for (index,(name,value)) in names.iter().zip(values).enumerate() {
        if index != 0 { out.push(','); } let _ = write!(out,"\"{name}\":{value}");
    } out.push('}');
}
fn array(out: &mut String, values: &[u64]) {
    out.push('['); for (index,value) in values.iter().enumerate() {
        if index != 0 { out.push(','); } let _ = write!(out,"{value}");
    } out.push(']');
}
/// Called once after the private ordinary CLI's run() returns; never hot I/O.
pub fn write_report(run_succeeded: bool) -> io::Result<()> {
    let path = std::env::var_os("ROOK2_GENERATION_SAFETY_CENSUS_PATH")
        .ok_or_else(|| io::Error::other("missing generation-safety census path"))?;
    let path = Path::new(&path);
    if !path.is_absolute() { return Err(io::Error::other("census path must be absolute")); }
    let report = STATE.with(|cell| {
        let mut state = cell.borrow_mut();
        if state.reported { return Err(io::Error::other("census already reported")); }
        state.reported = true;
        if state.active != 0 || state.current.is_some() || !run_succeeded { state.invalid = true; }
        if !state.rows.iter().enumerate().all(|(i,r)| r.valid(i)) { state.invalid = true; }
        let complete = !state.invalid && !state.overflow;
        let mut out = String::new();
        let _ = write!(out,"{{\"schema\":\"rook2-generation-safety-demand-v1\",\"pid\":{},\"complete\":{complete},\"overflow\":{},\"invalid\":{},\"calls_rows\":[",std::process::id(),state.overflow,state.invalid);
        for (i,row) in state.rows.iter().enumerate() {
            if i != 0 { out.push(','); }
            let limit = if i < 3 { "full512" } else { "limit2" };
            let checkers = ["0","1","2plus_saturated"][i % 3];
            let _ = write!(out,"{{\"limit\":\"{limit}\",\"checkers\":\"{checkers}\"");
            for (name,value) in COUNTERS.iter().zip(row.counts) { let _ = write!(out,",\"{name}\":{value}"); }
            for (name,values) in [("source_entered",&row.source_entered),("piece_cursor_destinations",&row.cursor),("piece_blocker_rejects",&row.blockers),("safety_trials_by_source",&row.trials)] {
                let _ = write!(out,",\"{name}\":"); array(&mut out,values);
            }
            for (name,names,values) in [("routes",&ROUTES[..],&row.routes[..]),("special_routes",&SPECIAL[..],&row.special[..]),("threshold_stage",&STAGES[..],&row.stage[..]),("pawn_geometry_counters",&PAWN[..],&row.pawn[..])] {
                let _ = write!(out,",\"{name}\":"); named(&mut out,names,values);
            }
            out.push_str(",\"bounded_final_count_histogram\":"); array(&mut out,&row.histogram); out.push('}');
        }
        out.push_str("]}\n");
        if out.len() > 65_536 { return Err(io::Error::other("census report exceeds64KiB")); }
        Ok(out)
    })?;
    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
    file.write_all(report.as_bytes())?; file.flush()
}
