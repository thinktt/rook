+#[inline]
+fn profile_sums_pair(own: u8, opponent: u8) -> (u8, u8) {
+    let x = u32::from(own) | (u32::from(opponent) << 16);
+    let pairs = (x & 0x00330033) + ((x >> 2) & 0x00330033);
+    let sum = (pairs & 0x000f000f) + ((pairs >> 4) & 0x000f000f);
+    let counts = sum - ((x >> 1) & 0x00010001);
+    (counts as u8, (counts >> 16) as u8)
+}
