+#[cfg(test)]
+pub(super) fn bitplanes_for_test(planes: [u64; 8]) -> [u8; 64] {
+    let mut sums = BitSums { planes };
+    let mut result = [0; 64];
+    sums.store(&mut result);
+    result
+}
+#[cfg(test)]
+pub(super) fn bits_sources_for_test(previous: [u8; 64], sources: &[(usize, u64, u64)]) -> [u8; 64] {
+    let mut sums = BitSums { planes: [0; 8] };
+    for (target, byte) in previous.into_iter().enumerate() {
+        for bit in 0..8 { sums.planes[bit] |= u64::from((byte >> bit) & 1) << target; }
+    }
+    for &(shift, normal, weak) in sources {
+        match shift {
+            0 => { assert_eq!(weak, 0); sums.add::<0>(normal); },
+            1 => sums.add_slider::<1>(normal, weak),
+            2 => sums.add_slider::<2>(normal, weak),
+            4 => sums.add_slider::<4>(normal, weak),
+            6 => { assert_eq!(weak, 0); sums.add::<6>(normal); },
+            _ => panic!("unsupported test contribution"),
+        }
+    }
+    let mut result = [0; 64];
+    sums.store(&mut result);
+    result
+}
+
+// Exactly 256 * 8 = 2048 immutable bytes. Little-endian byte lane i represents
+// bit i. The only consumers use x86-64 baseline SSE2; no feature dispatch.
+#[cfg(test)]
+const fn expansion_table() -> [u64; 256] {
+    let mut result = [0u64; 256];
+    let mut pattern = 0;
+    while pattern < 256 {
+        let mut lane = 0;
+        while lane < 8 {
+            result[pattern] |= (((pattern >> lane) & 1) as u64) << (8 * lane);
+            lane += 1;
+        }
+        pattern += 1;
+    }
+    result
+}
+#[cfg(test)]
+static EXPANSION: [u64; 256] = expansion_table();
