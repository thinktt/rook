import json,sys,os,hashlib
from pathlib import Path
from guard import HERE,load,sha,require_clearance,terminal
require_clearance();p=load(HERE/'plan.json');r=load(HERE/'control-reuse.json');S=Path(p['source_root']);C=Path(p['control_source']);sys.dont_write_bytecode=True;sys.path.insert(0,str(S/'tools'));from build import source_snapshot,tool_snapshot,cargo_configs
assert source_snapshot(S)==p['engine_source_sha256'] and source_snapshot(C)==p['control_source_sha256'];assert tool_snapshot(S)==tool_snapshot(C)==p['tool_source_sha256'];assert all(sha(Path(n))==h for n,h in r['metadata_sha256'].items());assert all(sha(Path(n))==h for n,h in p['input_sha256'].items());assert sha(Path(r['artifact']))==r['artifact_sha256'] and sha(Path(r['profile']))==r['profile_sha256']
E=HERE.parent;prefix='pgo-ordered-bit-checkers-phase1';use=load(E/(prefix+'-use-build-20261018/receipt.json'));inst=load(E/(prefix+'-instrumented-build-20261018/receipt.json'));train=load(E/(prefix+'-training-20261018/training.json'));tv=load(E/(prefix+'-training-20261018/verification.json'));control=load(E/(prefix+'-preparation-20261018/validation-summary.json'));g=load(E/'ordered-q-bitview-phase2-build-02-20261018/receipt.json');native=load(E/'ordered-q-bitview-phase2-validation-20261018/native-verification.json')
assert native['complete'] and native['inputs_stable'] and sum(x['passed'] for x in native['units'].values())==145
assert native['source_before']==native['source_after']==g['source_sha256_before']==g['source_sha256_after']==p['engine_source_sha256']
assert use['source_sha256_before']==use['source_sha256_after']==inst['source_sha256_before']==inst['source_sha256_after']==train['engine_source_sha256']==p['control_source_sha256'];assert use['tool_sha256_before']==use['tool_sha256_after']==inst['tool_sha256_before']==g['tool_sha256_before']==p['tool_source_sha256'];assert use['toolchain']==inst['toolchain']==g['toolchain']
assert sha(Path('/usr/bin/rustc').resolve())==use['toolchain']['rustc_executable_sha256'];assert sha(Path('/usr/bin/cargo').resolve())==use['toolchain']['cargo_executable_sha256']
for field in ['mode','target_triple','target_cpu','jobs','cargo_config_sha256_before']:assert use[field]==inst[field]==g[field],field
assert cargo_configs(S)==cargo_configs(C)==use['cargo_config_sha256_before'];assert use['rust_flags'][:2]==inst['rust_flags'][:2]==g['rust_flags']==p['base_flags'];assert tv['complete'] and tv['independent_remerge_byte_identical'] and train['complete'];assert train['input_sha256']==p['input_sha256'];assert train['profile_sha256']==tv['merged_profile_sha256']==r['profile_sha256'];assert sha(E/(prefix+'-training-20261018/training.json'))==tv['training_record_sha256'];assert use['pgo']['inputs_unchanged'] and use['pgo']['input_sha256_before']==use['pgo']['input_sha256_after'];assert use['pgo']['input_sha256_before']=={r['profile']:r['profile_sha256'],str(E/(prefix+'-training-20261018/training.json')):sha(E/(prefix+'-training-20261018/training.json'))}
for kind,name in [('use-build','tool-terminal.json'),('instrumented-build','tool-terminal.json'),('training','tool-terminal.json'),('training','verify-tool-terminal.json'),('use-check','tool-terminal.json'),('reconciliation','tool-terminal.json')]:terminal(E/(prefix+'-'+kind+'-20261018')/name)
changed=[n for n in sorted(p['engine_source_sha256']) if p['engine_source_sha256'][n]!=p['control_source_sha256'][n]];assert changed==['src/attacks.rs','src/movegen.rs','src/quiescence.rs'];assert load(E/'ordered-q-bitview-phase2-validation-20261018/independent-reconciliation.json')['pass']
for key in ['instrumented_build','raw','use_build','wire','reconciliation']:assert not Path(p[key]).exists(),key
for target in ['dev-generic-pgo-generate','dev-generic-pgo-use']:assert not(S/'target'/target).exists()
closure={'source43':p['engine_source_sha256'],'tools23':p['tool_source_sha256'],'control_source43':p['control_source_sha256'],'corpus':p['input_sha256'],'control_reuse_metadata':r['metadata_sha256']}
(HERE/'readiness.json').write_text(json.dumps({'complete':True,'same_control_artifact_reused':True,'control_artifact_sha256':r['artifact_sha256'],'control_profile_sha256':r['profile_sha256'],'same_compiler_settings':True,'changed_source_paths':changed,'control_profile_not_transferred':True,'closure':closure,'scope':'Own phase1 control reuse proved, candidate145 evidence exact; no engines/builds in this readiness stage'},indent=2)+'\n');print(json.dumps({'complete':True,'control_sha256':r['artifact_sha256'],'control_profile_sha256':r['profile_sha256'],'changed_source_paths':changed,'native145_reused':True,'source43_tools23':True}))
