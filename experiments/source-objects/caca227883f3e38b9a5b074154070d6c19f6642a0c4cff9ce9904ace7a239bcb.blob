+
+// Invocation-local masks only; the referenced Position stays immutable.
+struct SliderGeometry {
+    occupied: u64,
+    friendly: u64,
+    opaque: u64,
+    forward_opaque: u64,
+}
+impl SliderGeometry {
+    fn new<const KIND: usize>(planes: &[u64; 4], color: Color) -> Self {
+        let occupied = planes[0] | planes[1] | planes[2];
+        let own = if color == Color::Black { planes[3] } else { !planes[3] };
+        let friendly = occupied & own;
+        let enemy = occupied & !own;
+        let pawns = planes[0] & !planes[1] & !planes[2];
+        let knights = !planes[0] & planes[1] & !planes[2];
+        let bishops = planes[0] & planes[1] & !planes[2];
+        let rooks = !planes[0] & !planes[1] & planes[2];
+        let queens = planes[0] & !planes[1] & planes[2];
+        let transparent = match KIND {
+            2 => enemy | (friendly & (knights | rooks)),
+            3 => (enemy & !pawns) | (friendly & rooks),
+            4 => 0,
+            _ => unreachable!("not an activity slider"),
+        };
+        let forward = if KIND == 3 {
+            transparent | (friendly & (knights | bishops | queens))
+        } else {
+            transparent
+        };
+        Self { occupied, friendly, opaque: occupied & !transparent,
+            forward_opaque: occupied & !forward }
+    }
+
+    fn destinations<const KIND: usize>(
+        &self, source: Square, direction: usize, color: Color,
+    ) -> (u64, u64, bool) {
+        let (rays, increasing) = crate::attacks::influence_rays(source);
+        let ray = rays[direction];
+        let increasing = increasing[direction];
+        let direct = through(ray, nearest(ray & self.occupied, increasing), increasing);
+        if KIND == 4 {
+            return (direct & !self.friendly, 0, increasing);
+        }
+        let forward = if color == Color::White { 4 } else { 5 };
+        let opaque = if KIND == 3 && direction == forward {
+            self.forward_opaque
+        } else {
+            self.opaque
+        };
+        let visited = through(ray, nearest(ray & opaque, increasing), increasing);
+        (direct & !self.friendly, (visited & !direct) & !self.friendly, increasing)
+    }
+}
+#[inline]
+fn nearest(blockers: u64, increasing: bool) -> u64 {
+    if blockers == 0 { 0 }
+    else if increasing { blockers & blockers.wrapping_neg() }
+    else { 1u64 << (63 - blockers.leading_zeros()) }
+}
+#[inline]
+fn through(ray: u64, blocker: u64, increasing: bool) -> u64 {
+    if blocker == 0 { ray }
+    else if increasing { ray & (blocker | blocker.wrapping_sub(1)) }
+    else { ray & !blocker.wrapping_sub(1) }
+}
+#[inline]
+fn take_nearest(targets: &mut u64, increasing: bool) -> Square {
+    let index = if increasing { targets.trailing_zeros() } else { 63 - targets.leading_zeros() };
+    *targets &= !(1u64 << index);
+    Square(index as u8)
+}
+
+fn destinations_borrowed<const KIND: usize>(
+    position: &Position, influence: &Influence, color: Color, source: Square,
+    values: &[u8; 64], marks: &mut Marks, geometry: &SliderGeometry,
+) -> Mobility {
+    let kind = PieceKind::ALL[KIND];
+    let directions = match KIND { 2 => 0..4, 3 => 4..8, 4 => 0..8,
+        _ => unreachable!("not an activity slider") };
+    let mut result = Mobility::default();
+    for direction in directions {
+        let (mut direct, mut additional, increasing) = geometry.destinations::<KIND>(source, direction, color);
+        let vertical = if KIND == 3 && DIRECTIONS[direction].0 == 0 { 2 } else { 1 };
+        while direct != 0 {
+            let target = take_nearest(&mut direct, increasing);
+            let victim = position.board[target.0 as usize];
+            let category = direct_category(influence, color, kind, target, victim);
+            result.categories += category;
+            mark(marks, color, kind, target, category);
+            result.total += category * values[target.0 as usize] as i64 * vertical;
+        }
+        while additional != 0 {
+            let target = take_nearest(&mut additional, increasing);
+            let victim = position.board[target.0 as usize];
+            result.queries += 1;
+            let category = capture_priority(kind, victim,
+                relation(influence.code(color, target), influence.code(color.opponent(), target), kind) as i64);
+            result.total += category * values[target.0 as usize] as i64 * vertical;
+        }
+    }
+    result
 }
 
