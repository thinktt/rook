//! Fresh pawn structure and identity-based retained structural descriptors.
//!
//! Cached data stops at base support/doubled scores and candidate/weakness
//! classification. Current penalties, progress and ending work belong later.

use crate::influence::Influence;
use crate::position::Position;
use crate::types::{Color, Piece, PieceKind, Square};

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
#[repr(u8)]
pub enum Weakness {
    None,
    Isolated,
    BlockedBackward,
    ExposedBackward,
    ExposedLevel,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct PawnDescriptor {
    pub square: Square,
    pub candidate: bool,
    pub weakness: Weakness,
}

impl PawnDescriptor {
    const EMPTY: Self = Self {
        square: Square(64),
        candidate: false,
        weakness: Weakness::None,
    };
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct PawnStructure {
    pub base_score: [i32; 2],
    pub pawns: [[PawnDescriptor; 8]; 2],
    pub lengths: [u8; 2],
}

impl PawnStructure {
    pub const EMPTY: Self = Self {
        base_score: [0; 2],
        pawns: [[PawnDescriptor::EMPTY; 8]; 2],
        lengths: [0; 2],
    };

    #[inline]
    pub fn pawn_slice(&self, side: Color) -> &[PawnDescriptor] {
        &self.pawns[side.index()][..self.lengths[side.index()] as usize]
    }
}

impl Default for PawnStructure {
    fn default() -> Self {
        Self::EMPTY
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Selection {
    pub structure: PawnStructure,
    pub reused: bool,
}

#[derive(Clone, Copy)]
struct Retained {
    identity: u32,
    structure: PawnStructure,
}

impl Retained {
    const EMPTY: Self = Self {
        identity: 0,
        structure: PawnStructure::EMPTY,
    };
}

pub struct PawnCache {
    groups: [Retained; 128],
}

impl PawnCache {
    pub const fn new() -> Self {
        Self {
            groups: [Retained::EMPTY; 128],
        }
    }

    pub fn clear(&mut self) {
        self.groups.fill(Retained::EMPTY);
    }

    pub fn select(&mut self, position: &Position, influence: &Influence) -> Selection {
        let retained = &mut self.groups[(position.pawn % 128) as usize];
        if retained.identity == position.pawn {
            return Selection {
                structure: retained.structure,
                reused: true,
            };
        }
        let structure = fresh(position, influence, [1024; 2]);
        *retained = Retained {
            identity: position.pawn,
            structure,
        };
        Selection {
            structure,
            reused: false,
        }
    }
}

impl Default for PawnCache {
    fn default() -> Self {
        Self::new()
    }
}

/// Fresh descriptors in the position's semantic pawn chronology. The diagnostic
/// canonical file/rank order is a separate output-boundary transformation.
pub fn fresh(
    position: &Position,
    influence: &Influence,
    doubled_weights: [i32; 2],
) -> PawnStructure {
    fresh_with_order(
        position,
        influence,
        [
            position.piece_squares(Color::White, PieceKind::Pawn),
            position.piece_squares(Color::Black, PieceKind::Pawn),
        ],
        doubled_weights,
    )
}

/// `order` must name every current pawn once, for each color. A diagnostic
/// adapter validates supplied orders before calling this native builder.
pub fn fresh_with_order(
    position: &Position,
    influence: &Influence,
    order: [&[Square]; 2],
    doubled_weights: [i32; 2],
) -> PawnStructure {
    let mut files = [[0u8; 8]; 2];
    for side in [Color::White, Color::Black] {
        for &square in position.piece_squares(side, PieceKind::Pawn) {
            files[side.index()][square.file() as usize] |= 1 << square.rank();
        }
    }
    let mut result = PawnStructure::EMPTY;
    for side in [Color::White, Color::Black] {
        let index = side.index();
        let own = &files[index];
        let opponent = &files[side.opponent().index()];
        assert!(order[index].len() <= 8, "pawn descriptor capacity exceeded");
        debug_assert_eq!(
            order[index].len(),
            position.counts[index][PieceKind::Pawn.index()] as usize
        );
        result.lengths[index] = order[index].len() as u8;
        let mut support = 0;
        let mut doubled_penalty = 0;
        for (slot, &square) in order[index].iter().enumerate() {
            debug_assert_eq!(
                position.board[square.0 as usize],
                Piece::new(side, PieceKind::Pawn)
            );
            let file = square.file() as usize;
            let rank = square.rank();
            let rank_bit = 1u8 << rank;
            let near = rank_bit | (rank_bit << 1) | (rank_bit >> 1);
            let above = (0xffu16 << (rank + 1)) as u8;
            let below = ((1u16 << rank) - 1) as u8;
            let (ahead, behind, step) = if side == Color::White {
                (above, below, 1)
            } else {
                (below, above, -1)
            };
            let mut adjacent = 0u8;
            let mut occupied_files = 0;
            let mut neighbors = 0;
            let mut opposing_near_files = opponent[file];
            for adjacent_file in [file.checked_sub(1), (file + 1 < 8).then_some(file + 1)]
                .into_iter()
                .flatten()
            {
                let pawns = own[adjacent_file];
                adjacent |= pawns;
                occupied_files += i32::from(pawns != 0);
                neighbors += i32::from(pawns & near != 0) + i32::from(pawns & rank_bit != 0);
                opposing_near_files |= opponent[adjacent_file];
            }
            support += if neighbors == 0 {
                -3
            } else if neighbors > 1 {
                2
            } else {
                0
            };
            let friendly_ahead = own[file] & ahead != 0;
            if friendly_ahead {
                doubled_penalty += match occupied_files {
                    2 => 0,
                    1 => 13,
                    _ if file == 0 || file == 7 => 34,
                    _ => 19,
                };
            }
            let advance = square.offset(0, step).expect("pawn on a promotion rank");
            let attacked_advance = influence.code(side.opponent(), advance) >> 6 != 0;
            let all_adjacent_ahead = adjacent & !ahead == 0;
            let weakness = if adjacent == 0 {
                Weakness::Isolated
            } else if all_adjacent_ahead
                && position.board[advance.0 as usize]
                    == Piece::new(side.opponent(), PieceKind::Pawn)
            {
                Weakness::BlockedBackward
            } else if all_adjacent_ahead && attacked_advance {
                Weakness::ExposedBackward
            } else if adjacent & behind == 0 && attacked_advance {
                Weakness::ExposedLevel
            } else {
                Weakness::None
            };
            result.pawns[index][slot] = PawnDescriptor {
                square,
                candidate: !friendly_ahead && opposing_near_files & ahead == 0,
                weakness,
            };
        }
        // Mathematical floor is required for negative supplied coefficients.
        let penalty =
            (doubled_weights[index] as i64 * doubled_penalty as i64 + 512).div_euclid(1024);
        result.base_score[index] = (support as i64 - penalty) as i32;
    }
    result
}

#[cfg(test)]
mod tests {
    use super::*;

    fn position(placement: &str) -> Position {
        Position::from_fen(&format!("{placement} w - - 0 1")).unwrap()
    }

    fn descriptor(structure: &PawnStructure, side: Color, square: &str) -> PawnDescriptor {
        let square = Square::parse(square).unwrap();
        *structure
            .pawn_slice(side)
            .iter()
            .find(|p| p.square == square)
            .unwrap()
    }

    fn evaluated(placement: &str, weights: [i32; 2]) -> PawnStructure {
        let position = position(placement);
        fresh(&position, &Influence::build(&position), weights)
    }

    #[test]
    fn support_and_per_pawn_doubled_penalties_use_signed_floor() {
        let initial = evaluated("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR", [1024; 2]);
        assert_eq!(initial.base_score, [16, 16]);
        assert!(initial
            .pawns
            .iter()
            .flatten()
            .all(|p| !p.candidate && p.weakness == Weakness::None));

        let edge = "7k/8/8/8/8/P7/P7/K7";
        assert_eq!(evaluated(edge, [1024; 2]).base_score, [-40, 0]);
        // (-39*34+512)/1024 floors to -1; truncation would incorrectly give 0.
        assert_eq!(evaluated(edge, [-39, 513]).base_score, [-5, 0]);
        assert_eq!(
            evaluated("7k/8/8/8/8/1P6/1P6/K7", [1024; 2]).base_score,
            [-25, 0]
        );
        assert_eq!(
            evaluated("7k/8/8/8/P7/P7/P7/K7", [1024; 2]).base_score,
            [-77, 0]
        );

        // Multiple adjacent-file pawns satisfy existential support tests only
        // once per file; the rear two d-pawns each receive the one-file penalty.
        assert_eq!(
            evaluated("7k/8/8/3P4/3PP3/3P4/8/K7", [1024; 2]).base_score,
            [-22, 0]
        );
    }

    #[test]
    fn candidate_is_strictly_ahead_and_independent_of_weakness() {
        let structure = evaluated("7k/8/8/4p3/3P4/3Pp3/8/K7", [1024; 2]);
        assert!(!descriptor(&structure, Color::White, "d3").candidate); // Friendly d4 ahead.
        assert!(!descriptor(&structure, Color::White, "d4").candidate); // Opposing e5 ahead.
        assert!(descriptor(&structure, Color::Black, "e3").candidate); // White d3 level, d4 behind Black.
        assert_eq!(
            descriptor(&structure, Color::White, "d4").weakness,
            Weakness::Isolated
        );
        let level = evaluated("7k/8/8/8/3Pp3/8/8/K7", [1024; 2]);
        assert!(descriptor(&level, Color::White, "d4").candidate);
        assert!(descriptor(&level, Color::Black, "e4").candidate);
    }

    #[test]
    fn weakness_precedence_and_remote_behind_support() {
        for (placement, expected) in [
            ("7k/8/8/5p2/8/4P3/8/K7", Weakness::Isolated),
            ("7k/8/8/3p4/3Pp3/4P3/8/K7", Weakness::BlockedBackward),
            ("7k/8/8/5p2/3P4/4P3/8/K7", Weakness::ExposedBackward),
            ("7k/8/8/5p2/8/3PP3/8/K7", Weakness::ExposedLevel),
            ("7k/8/8/5p2/8/4P3/3P4/K7", Weakness::None),
        ] {
            let structure = evaluated(placement, [1024; 2]);
            assert_eq!(
                descriptor(&structure, Color::White, "e3").weakness,
                expected,
                "{placement}"
            );
        }
        // A neighbor more than one rank behind suppresses backward/level
        // weakness, while contributing no support to the e4 pawn.
        let structure = evaluated("7k/8/5p2/8/4P3/8/3P4/K7", [1024; 2]);
        assert_eq!(
            descriptor(&structure, Color::White, "e4").weakness,
            Weakness::None
        );
        assert_eq!(structure.base_score[0], -6);
    }

    #[test]
    fn normalized_minor_carry_can_expose_advance_without_any_enemy_pawn() {
        let three = position("7k/8/3n4/8/3P4/2n1P3/3n4/K7");
        let four = position("7k/8/3n4/2n5/3P4/2n1P3/3n4/K7");
        let advance = Square::parse("e4").unwrap();
        let i3 = Influence::build(&three);
        let i4 = Influence::build(&four);
        assert_eq!(i3.code(Color::Black, advance) >> 6, 0);
        assert_eq!(i4.code(Color::Black, advance) >> 6, 1);
        let f3 = fresh(&three, &i3, [1024; 2]);
        let f4 = fresh(&four, &i4, [1024; 2]);
        assert_eq!(descriptor(&f3, Color::White, "e3").weakness, Weakness::None);
        assert_eq!(
            descriptor(&f4, Color::White, "e3").weakness,
            Weakness::ExposedBackward
        );
        assert!(descriptor(&f4, Color::White, "e3").candidate);
        // Pawn-only identity hits retain prior classification despite the
        // non-pawn influence change, as required by retained structural reuse.
        assert_eq!(three.pawn, four.pawn);
        let mut cache = PawnCache::new();
        assert!(!cache.select(&three, &i3).reused);
        let reused = cache.select(&four, &i4);
        assert!(reused.reused);
        assert_eq!(reused.structure, f3);
    }

    #[test]
    fn supplied_order_and_retained_order_are_distinct_from_current_chronology() {
        let mut position = position("7k/8/8/8/6P1/3P4/8/K7");
        let influence = Influence::build(&position);
        let custom = [Square::parse("g4").unwrap(), Square::parse("d3").unwrap()];
        let structure = fresh_with_order(&position, &influence, [&custom, &[]], [1024; 2]);
        assert_eq!(structure.pawns[0][0].square, custom[0]);
        position.squares[0].swap(0, 1);
        let mut cache = PawnCache::new();
        let first = cache.select(&position, &influence);
        assert_eq!(first.structure, structure);
        position.squares[0].swap(0, 1);
        let retained = cache.select(&position, &influence);
        assert!(retained.reused);
        assert_eq!(retained.structure, first.structure);
        cache.clear();
        let fresh_order = cache.select(&position, &influence);
        assert!(!fresh_order.reused);
        assert_eq!(fresh_order.structure.pawns[0][0].square, custom[1]);
    }

    #[test]
    fn natural_group_collisions_replace_only_selected_group_and_clear_all() {
        // Released identity-retention contexts with a real group-zero conflict.
        let a = position("7k/8/8/8/6P1/3P4/8/K7");
        let b = position("7k/8/8/8/8/5P2/1P6/K7");
        let c = position("7k/8/6P1/8/8/3P4/8/K7");
        assert_eq!(a.pawn % 128, 0);
        assert_eq!(c.pawn % 128, 0);
        assert_eq!(b.pawn % 128, 1);
        assert_ne!(a.pawn, c.pawn);
        let (ia, ib, ic) = (
            Influence::build(&a),
            Influence::build(&b),
            Influence::build(&c),
        );
        let mut cache = PawnCache::new();
        assert!(!cache.select(&a, &ia).reused);
        assert!(!cache.select(&b, &ib).reused);
        assert!(cache.select(&a, &ia).reused);
        assert!(!cache.select(&c, &ic).reused);
        assert!(cache.select(&b, &ib).reused);
        assert!(!cache.select(&a, &ia).reused);
        cache.clear();
        assert!(!cache.select(&a, &ia).reused);
        assert!(!cache.select(&b, &ib).reused);
    }

    #[test]
    fn full_pawn_identity_collision_reuses_stale_descriptors_until_clear() {
        // Distinct published placements with the same actual full fingerprint.
        let a = position("7k/6P1/1p1pP3/4pP2/8/2p5/4P3/K7");
        let b = position("7k/8/2p4P/2p5/7P/1p6/p5PP/K7");
        assert_eq!(a.pawn, 3193864068);
        assert_eq!(a.pawn, b.pawn);
        let (ia, ib) = (Influence::build(&a), Influence::build(&b));
        let mut cache = PawnCache::new();
        let first = cache.select(&a, &ia);
        let collision = cache.select(&b, &ib);
        assert!(collision.reused);
        assert_eq!(collision.structure, first.structure);
        assert_ne!(collision.structure, fresh(&b, &ib, [1024; 2]));
        cache.clear();
        let replaced = cache.select(&b, &ib);
        assert!(!replaced.reused);
        assert_eq!(replaced.structure, fresh(&b, &ib, [1024; 2]));
    }

    #[test]
    fn pawnless_zero_identity_reuses_initial_empty_but_can_replace_group_zero() {
        let empty = position("7k/8/8/8/8/8/8/K7");
        let zero_group = position("7k/8/8/8/6P1/3P4/8/K7");
        let (ie, iz) = (Influence::build(&empty), Influence::build(&zero_group));
        let mut cache = PawnCache::new();
        assert_eq!(
            cache.select(&empty, &ie),
            Selection {
                structure: PawnStructure::EMPTY,
                reused: true
            }
        );
        assert!(!cache.select(&zero_group, &iz).reused);
        assert_eq!(
            cache.select(&empty, &ie),
            Selection {
                structure: PawnStructure::EMPTY,
                reused: false
            }
        );
        assert!(cache.select(&empty, &ie).reused);
        cache.clear();
        assert!(cache.select(&empty, &ie).reused);
        assert_eq!(std::mem::size_of::<PawnDescriptor>(), 3);
        assert_eq!(std::mem::size_of::<PawnStructure>(), 60);
        assert_eq!(std::mem::size_of::<PawnCache>(), 8192);
    }

    #[test]
    fn color_reflection_preserves_classifications_and_unnegated_base_scores() {
        fn reflect(position: &Position) -> Position {
            let mut placement = String::new();
            for rank in (0..8).rev() {
                if rank != 7 {
                    placement.push('/');
                }
                let mut empty = 0u8;
                for file in 0..8 {
                    let piece = position.board[((rank * 8 + file) ^ 56) as usize];
                    if piece.is_empty() {
                        empty += 1;
                        continue;
                    }
                    if empty != 0 {
                        placement.push((b'0' + empty) as char);
                        empty = 0;
                    }
                    placement.push(Piece::new(piece.color().opponent(), piece.kind()).fen_char());
                }
                if empty != 0 {
                    placement.push((b'0' + empty) as char);
                }
            }
            super::tests::position(&placement)
        }
        for placement in [
            "7k/8/8/8/8/P7/P7/K7",
            "7k/8/8/3p4/3Pp3/4P3/8/K7",
            "7k/8/8/5p2/3P4/4P3/8/K7",
            "7k/8/8/5p2/8/3PP3/8/K7",
            "7k/8/5p2/8/4P3/8/3P4/K7",
            "7k/8/3n4/2n5/3P4/2n1P3/3n4/K7",
        ] {
            let original = position(placement);
            let mirrored = reflect(&original);
            let a = fresh(&original, &Influence::build(&original), [-39, 513]);
            let b = fresh(&mirrored, &Influence::build(&mirrored), [513, -39]);
            for side in [Color::White, Color::Black] {
                let reflected_side = side.opponent();
                assert_eq!(
                    a.base_score[side.index()],
                    b.base_score[reflected_side.index()]
                );
                for &pawn in a.pawn_slice(side) {
                    let target = Square(pawn.square.0 ^ 56);
                    let other = b
                        .pawn_slice(reflected_side)
                        .iter()
                        .find(|p| p.square == target)
                        .unwrap();
                    assert_eq!(
                        (pawn.candidate, pawn.weakness),
                        (other.candidate, other.weakness)
                    );
                }
            }
        }
    }
}
