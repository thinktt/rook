-        let supplied=array(&input["searches"],1,16)?;
-        let mut rows=Vec::new();let mut schedules=Vec::new();
-        for query in supplied {
-            if mode==Mode::Interrupted {object(query,&["commands","allowanceCs","queued"])?;}
-            else {object(query,&["commands","allowanceCs"])?;}
-            let allowance=integer(&query["allowanceCs"],1,1_000_000)?;
-            let mut queued=Vec::new();
