-//! Persistent cold transports: one actual Session, native search/clock/output owners.
-use super::{array, boolean, integer, moves, object, positions, text, unsigned32, Result};
-use rook2::{host::{self, Command, Host, Record}, movegen::{self, MoveList},
-    output::Post, parameters::{self, Parameters, NAMES}, position::Position,
-    quiescence::{Limits, Work}, session::{self, Action, Session}, timed::{self, Point},
