-const NEUTRAL_MD3: [i32;30] = [100,100,100,100,100,100,100,100,100,100,0,0,
-    100,100,100,100,100,100,100,100,100,100,0,100,0,14,0,3,0,67108864];
-#[derive(Clone, Copy, PartialEq, Eq)]
-enum Mode { Public, Clock, Interrupted }
-#[derive(Clone)]
-enum Setup { New, Force, Easy, Post(bool), Undo, Level, Move(String), Setboard(String), Parameters(Vec<String>) }
-impl Setup {
-    fn parse(line:&str,mode:Mode)->Result<Self> {
-        if line.len()>2000 || !line.is_ascii() || line.bytes().any(|b|b==0||b==b'\r'||b==b'\n'
-            ||(b.is_ascii_whitespace()&&b!=b' '&&b!=b'\t')) {
-            return Err("setup must be a single ordinary ASCII record of at most2000 characters".into());
-        }
-        let words=line.split_ascii_whitespace().collect::<Vec<_>>();
-        match words.as_slice() {
-            ["new"]=>Ok(Self::New),["force"]=>Ok(Self::Force),["easy"]=>Ok(Self::Easy),
-            ["post"]=>Ok(Self::Post(true)),["nopost"] if mode==Mode::Interrupted=>Ok(Self::Post(false)),
-            ["undo"]=>Ok(Self::Undo),
-            ["level",a,b,c]=>{
-                let values=[a,b,c].into_iter().map(|v|parameters::integer(v))
-                    .collect::<std::result::Result<Vec<_>,_>>().map_err(|e|format!("level integer: {e:?}"))?;
-                if values!=[0,5,0] {return Err("setup level must be level 0 5 0".into());}
-                Ok(Self::Level)
-            },
-            ["setboard",fields @ ..] if fields.len()==6||(fields.len()==4&&mode!=Mode::Interrupted)=>{
-                let mut counters=[0,1];
-                if fields.len()==6 {for (i,minimum) in [(0,0),(1,1)] {
-                    if fields[4+i].is_empty()||!fields[4+i].bytes().all(|b|b.is_ascii_digit()) {
-                        return Err("invalid public FEN counter".into());
-                    }
-                    counters[i]=parameters::integer(fields[4+i]).map_err(|e|format!("FEN counter: {e:?}"))?;
-                    if counters[i]<minimum {return Err("invalid public FEN counter".into());}
-                }}
-                // Session searches inherit native ordinary FEN4/FEN6; interrupted
-                // setup explicitly requires FEN6. No search-adapter pawn/check gates.
-                Position::from_fen(&format!("{} {} {} {} 0 1",fields[0],fields[1],fields[2],fields[3]))?;
-                Ok(Self::Setboard(format!("{} {} {} {} {} {}",fields[0],fields[1],fields[2],fields[3],counters[0],counters[1])))
-            },
-            ["cm_parm",args @ ..] if !args.is_empty()=>{
-                let mut tokens=Vec::new();
-                for arg in args {
-                    if *arg=="default" { tokens.push("default".to_owned());continue; }
-                    let (name,value)=arg.split_once('=').ok_or("setup parameters require assignments or default")?;
-                    let v=parameters::integer(value).map_err(|e|format!("setup integer: {e:?}"))?;
-                    assignment_token(name,v,mode)?;
-                    tokens.push(format!("{name}={v}"));
-                }
-                Ok(Self::Parameters(tokens))
-            },
-            [movement]=>{ positions::coordinate(movement)?;Ok(Self::Move((*movement).to_owned())) },
-            _=>Err("command outside released persistent setup vocabulary".into()),
-        }
-    }
-    fn apply(&self,state:&mut Session<true>)->Result<()> {
-        match self {
-            Self::Setboard(fen)=>state.setboard(fen).map_err(|e|format!("native setboard: {e:?}")),
-            Self::Parameters(tokens)=>{
-                // This is exactly Session.idle's cm_parm state owner, without
-                // its separate ordinary-wire record/token ceilings. The eager
-                // diagnostic schema admits up to2000 characters, including one
-                // unknown assignment token wider than an entire wire record.
-                // No clock/search event exists between ordered parameter tokens.
-                state.parameters.command(&tokens.iter().map(String::as_str).collect::<Vec<_>>())
-                    .map(|_echo|()).map_err(|e|format!("native parameter command: {e:?}"))
-            },
-            Self::New=>idle(state,"new"),Self::Force=>idle(state,"force"),Self::Easy=>idle(state,"easy"),
-            Self::Post(true)=>idle(state,"post"),Self::Post(false)=>idle(state,"nopost"),
-            Self::Undo=>idle(state,"undo"),Self::Level=>idle(state,"level 0 5 0"),
-            Self::Move(m)=>idle(state,m),
-        }
-    }
-}
-fn assignment_token(name:&str,v:i32,mode:Mode)->Result<()> {
-    let mut bytes=name.bytes();
-    if !bytes.next().is_some_and(|b|b.is_ascii_alphabetic())
-        ||!bytes.all(|b|b.is_ascii_alphanumeric()||b==b'_') {
-        return Err("parameter name must start with an ASCII letter and continue with letters, digits or underscores".into());
-    }
-    // Command storage accepts every signed32 value and lexical unknown name.
-    // Only the clock/interrupted contracts restrict EVERY rnd assignment;
-    // public searches restrict final effective rnd, not overwritten storage.
-    if name=="rnd"&&(match mode {Mode::Public=>false,Mode::Clock=>!(0..=1000).contains(&v),Mode::Interrupted=>v!=0}) {
-        return Err("random-setting assignment outside the route's every-assignment domain".into());
-    }
-    Ok(())
-}
-fn effective_domain(parameters:&Parameters,mode:Mode,md_cap:i32)->Result<()> {
-    // Eager final-vector admission mirrors the native bind domain without
-    // constructing a search or mutating live state. The actual go still binds.
-    for (index,&v) in parameters.values.iter().enumerate() {
-        let valid=match index {
-            11=>true, // Stored opk is unconditionally inert, including admission.
-            0..=21=>(0..=1000).contains(&v),
-            22=>(-100..=100).contains(&v),23=>(0..=100).contains(&v),
-            24=>(0..=if mode==Mode::Clock{1000}else{0}).contains(&v),
-            25=>true,26=>(-10000..=10000).contains(&v),
-            27=>(1..=md_cap).contains(&v),28=>v>=0,29=>v>=96,
-            _=>unreachable!(),
-        };
-        if !valid {return Err(format!("final effective {} outside native/route search domain",NAMES[index]));}
-    }
-    Ok(())
-}
-fn idle(state:&mut Session<true>,line:&str)->Result<()> {
-    match state.idle(line).map_err(|e|format!("native idle command: {e:?}"))? {
-        Action::Reply(lines) if !lines.iter().any(|l|l.starts_with("Illegal move:")||l.starts_with("Error ("))=>Ok(()),
-        Action::Reply(_)=>Err("native rejected setup command or move".into()),
-        _=>Err("setup must not start an automatic search or terminate the session".into()),
-    }
-}
-struct Query { commands:Vec<Setup>,allowance:i32,queued:Vec<Command>,expected:Parameters }
-struct Public { mode:Mode,seconds:Option<u32>,queries:Vec<Query>,inherited:bool }
-fn inherited_topology(rows:&[Vec<Setup>])->bool {
-    matches!(rows, [_,second,third]
-        if matches!(second.as_slice(),[Setup::Force,Setup::Undo,Setup::Move(_)])
-        &&matches!(third.as_slice(),[Setup::Force,Setup::Undo,Setup::Undo]))
-}
-impl Public {
-    fn parse(input:&Value,mode:Mode)->Result<Self> {
