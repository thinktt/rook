-                for (i,v) in queue.iter().enumerate() {
-                    queued.push(match (text(v)?,i+1==queue.len()) {
-                        ("?",true)=>Command::Finish,("force",true)=>Command::Abort,
-                        (".",false)=>Command::Status,("post",false)=>Command::Post(true),
-                        ("nopost",false)=>Command::Post(false),
-                        _=>return Err("queued schedule must end in ? or force, preceded only by status/post toggles".into()),
-                    });
-                }
-            }
