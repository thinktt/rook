+                            if !agrees {stage.discard();s.metrics.fatal_reason=Some("accepted-local-oracle-mismatch");decision=Some(Decision::Fatal);}
+                            else {
+                                let commit_start=Instant::now();let touched=stage.touched_groups();let touched_bytes=stage.touched_bytes();
+                                if stage.commit(search.remembered.as_mut().unwrap()).is_err(){s.metrics.fatal_reason=Some("sparse-commit-failed");decision=Some(Decision::Fatal);}
+                                else {
+                                    search.learning=learning;*search.evaluator.research_pawns()=pawns;output.install(search,node,ply);
+                                    s.metrics.commits+=1;s.metrics.committed_nodes+=output.stats.nodes;s.metrics.committed_relations+=output.evaluations.relation_queries;
+                                    s.metrics.touched_groups+=touched as u64;s.metrics.touched_bytes+=touched_bytes as u64;
+                                    s.metrics.matching_depth[ply.min(63)]+=1;s.metrics.surviving_size[bin(output.stats.nodes)]+=1;
+                                    s.metrics.accepted_oracle_gross_ns+=reference.gross_ns;s.metrics.accepted_oracle_descendant_hooks_ns+=reference.descendant_hooks_ns;
+                                    let range=[candidate as u64,segment.end as u64,output.stats.nodes,output.evaluations.relation_queries,ply as u64,expected.unwrap() as u64];
+                                    s.metrics.committed_ranges.push(range);decision=Some(Decision::Accepted(output.score));
+                                    for item in &mut status[candidate..segment.end]{*item=2;}
+                                    let mut parent=segment.parent;while let Some(ancestor)=parent {status[ancestor]=3;parent=s.forest.segments[ancestor].parent;}
+
+                                }
+                                s.metrics.commit_ns+=commit_start.elapsed().as_nanos();
+                                if matches!(decision,Some(Decision::Accepted(_))) {let cursor_start=Instant::now();*cursor=reference.end;s.metrics.audit_entry_ns+=cursor_start.elapsed().as_nanos();}
+                            }
+                        }
+                    }
+                } else {entry_mismatch(&mut s.metrics,"epoch");s.metrics.unmatched_calls+=1;s.metrics.lookup_ns+=started.elapsed().as_nanos().saturating_sub(audit_entry_elapsed);}
+            }
+        }
+    }
+    s.mode=mode;
+    let hook=started.elapsed().as_nanos();s.forest.hook_ns+=hook;let hook_base=s.forest.hook_ns;
+    drop(borrowed);
+    decision.unwrap_or_else(||Decision::Run(Some(Token{context,id,oracle:expected,stats,evaluations,ply,started:Instant::now(),hook_base})))
+}
+
+pub(crate) fn exit<const D:bool,H:Host>(search:&mut Search<D,H>,node:&Node,token:Option<Token>,returned:Result<i32,Stopped>)->Result<i32,Stopped> {
+    let Some(token)=token else{return returned};let gross=token.started.elapsed().as_nanos();let hook_started=Instant::now();
+    let mut borrowed=token.context.0.borrow_mut();let s=&mut *borrowed;let descendant_hooks=s.forest.hook_ns-token.hook_base;
+    let mut mode=std::mem::replace(&mut s.mode,Mode::Record{sink:None,audit:false});let mut result=returned;
+    match &mut mode {
+        Mode::Record{sink,..}=>{
+            assert_eq!(s.stack.pop(),Some(token.id));
+            if let Some(id)=token.id {let end=s.forest.segments.len();let cursor=sink.as_ref().map_or(Cursor{event_index:0,attempted:0},Sink::cursor);
+                let output=returned.ok().map(|score|Output::capture(search,node,token.ply,score,token.stats,token.evaluations));
+                if output.as_ref().is_some_and(|o|o.stats.nodes>s.caps.max_recorded_nodes){mark_censored(s,"recorded-node-cap");}
+                let segment=&mut s.forest.segments[id];segment.end=end;segment.end_cursor=cursor;segment.gross_ns=gross;segment.descendant_hooks_ns=descendant_hooks;
+                if output.as_ref().is_some_and(|o|o.stats.nodes<=s.caps.max_recorded_nodes){assert_eq!(segment.key.node.position,node.position);segment.output=output;}
+            }
+        }
+        Mode::Recover{oracle,cursor,..}=>{
+            if s.metrics.fatal_reason.is_none() {
+                if let Some(id)=token.oracle {let audit_start=Instant::now();let reference=&oracle.segments[id];let output=returned.ok().map(|score|Output::capture(search,node,token.ply,score,token.stats,token.evaluations));
+                    if output.as_ref()!=reference.output.as_ref()||*cursor!=reference.end {s.metrics.fatal_reason=Some("canonical-call-oracle-mismatch");result=Err(Stopped::HierarchicalAudit);}
+                    s.metrics.audit_local_ns+=audit_start.elapsed().as_nanos();
+                }
+            } else {result=Err(Stopped::HierarchicalAudit);}
+        }
+    }
+    s.mode=mode;s.forest.hook_ns+=hook_started.elapsed().as_nanos();result
+}
