+impl Group {
+    /// One native replacement owner, shared by the table and sparse replay.
+    fn store(&mut self, store: Store, generation: u8) {
+        let record = Record::from_store(store, generation);
+        // Only retained slots participate in the identity match. Recent may
+        // duplicate an identity and is deliberately ignored during storage.
+        if let Some(index) = self.records[..RECENT].iter()
+            .position(|r| r.matches(generation, record.identity))
+        {
+            if record.depth < self.records[index].depth {
+                self.records[RECENT] = record;
+            } else {
+                self.records[index] = record;
+            }
+            return;
+        }
+        // An empty priority is less valuable than every valid signed depth.
+        if let Some(index) = self.records[..RECENT].iter()
+            .position(|r| r.generation != generation)
+        {
+            self.records[index] = record;
+            self.records[RECENT] = Record::default();
+            return;
+        }
+        let mut least = 0;
+        for index in 1..RECENT {
+            if self.records[index].depth < self.records[least].depth { least = index; }
+        }
+        if record.depth >= self.records[least].depth {
+            self.records[RECENT] = self.records[least];
+            self.records[least] = record;
+        } else {
+            self.records[RECENT] = record;
+        }
+    }
+
+    /// Metadata and successful mate-depth mutation retain their native order.
+    fn probe(&mut self, query: Query, required: i16, generation: u8) -> ProbeResult {
+        let mut result = ProbeResult::default();
+        let recent = &mut self.records[RECENT];
+        if recent.matches(generation, query.identity)
+            && recent.consider(query, required, &mut result)
+        {
+            return result;
+        }
+        for record in &mut self.records[..RECENT] {
+            if record.matches(generation, query.identity) {
+                record.consider(query, required, &mut result);
+                break;
+            }
+        }
+        result
+    }
+}
