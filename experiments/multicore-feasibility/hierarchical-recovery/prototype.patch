+mod sparse_tests {
+    use super::*;
+
+    fn query(group: usize, identity: u32, depth: i32) -> Query {
+        Query { group, identity, ply: 1, target: depth + 1, lower: 0, upper: 9000 }
+    }
+
+    fn entry(group: usize, identity: u32, depth: i32, score: i32) -> Store {
+        Store { query: query(group, identity, depth), score, move_hint: None,
+            quiet_mate_checked: false, mark_depth: true }
+    }
+
+    #[test]
+    fn native_replacements_and_mate_mutation_match_full_table() {
+        let mut base = RememberedTable::with_groups(7);
+        for store in [entry(0, 1, 1, 9000), entry(0, 2, 3, 20), entry(0, 3, 4, 30)] {
+            base.store(store);
+        }
+        let before = base.research_clone();
+        let mut oracle = base.research_clone();
+        let mut stage = SparseStage::new(2);
+        stage.begin(&base);
+        let mate = query(0, 1, 19);
+        let observed = stage.probe(&base, mate).unwrap();
+        assert_eq!(observed, oracle.probe(mate));
+        assert_eq!(observed.marked_depth, Some(1));
+        assert_eq!(stage.probe(&base, mate).unwrap(), oracle.probe(mate));
+        assert!(base.research_eq(&before), "mate-depth raise must remain staged");
+        // Includes recent-only insertion, duplicate retained identity, equal
+        // depth overwrite and retained displacement after the mate-depth raise.
+        for store in [entry(0, 4, 2, 40), entry(0, 2, 1, 21),
+            entry(0, 2, 3, 22), entry(0, 5, 6, 50), entry(1, 6, -1, 60)] {
+            stage.store(&base, store).unwrap();
+            oracle.store(store);
+            for identity in 1..=6 {
+                let q = query(store.query.group, identity, 1);
+                assert_eq!(stage.probe(&base, q).unwrap(), oracle.probe(q));
+            }
+        }
+        assert_eq!(stage.touched_groups(), 2);
+        assert_eq!(stage.touched_bytes(), 96);
+        assert_eq!(stage.commit(&mut base), Ok(2));
+        assert!(base.research_eq(&oracle));
+        assert_eq!(stage.commit(&mut base), Err(SparseStageError::Inactive));
+    }
+
+    #[test]
+    fn discard_reinitializes_from_current_base_and_preserves_untouched_groups() {
+        let mut base = RememberedTable::with_groups(5);
+        let mut stage = SparseStage::new(2);
+        stage.begin(&base);
+        stage.store(&base, entry(0, 1, 2, 10)).unwrap();
+        stage.discard();
+        base.store(entry(0, 2, 4, 20));
+        base.store(entry(4, 3, 8, 30));
+        let mut oracle = base.research_clone();
+        stage.begin(&base);
+        stage.store(&base, entry(0, 4, 3, 40)).unwrap();
+        oracle.store(entry(0, 4, 3, 40));
+        assert_eq!(stage.commit(&mut base), Ok(1));
+        assert!(base.research_eq(&oracle), "untouched canonical group must survive");
+    }
+
+    #[test]
+    fn group_cap_and_reset_poison_commit_without_partial_writes() {
+        let mut base = RememberedTable::with_groups(3);
+        let before = base.research_clone();
+        let mut stage = SparseStage::new(1);
+        stage.begin(&base);
+        stage.store(&base, entry(0, 1, 2, 10)).unwrap();
+        assert_eq!(stage.store(&base, entry(1, 2, 2, 20)), Err(SparseStageError::GroupLimit));
+        assert_eq!(stage.commit(&mut base), Err(SparseStageError::Inactive));
+        assert!(base.research_eq(&before));
+        stage.begin(&base);
+        stage.store(&base, entry(0, 1, 2, 10)).unwrap();
+        base.clear();
+        let after_reset = base.research_clone();
+        assert_eq!(stage.commit(&mut base), Err(SparseStageError::BaseChanged));
+        assert!(base.research_eq(&after_reset));
+        let mut zero = SparseStage::new(0);
+        zero.begin(&base);
+        assert_eq!(zero.probe(&base, query(0, 1, 2)), Err(SparseStageError::GroupLimit));
+        assert_eq!(zero.commit(&mut base), Err(SparseStageError::Inactive));
+    }
