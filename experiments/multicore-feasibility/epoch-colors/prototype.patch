+        let complete = thread::spawn(move || {
+            assert_output(worker.complete().unwrap(), &packet);
+            worker
+        });
+        entered_at(&shared, &shared.tests.consuming);
+        let (sent, received) = mpsc::channel();
+        let close = thread::spawn(move || { sent.send(scope.finish()).unwrap(); });
+        // Completion holds Control here; close cannot claim or retire its flight.
+        assert!(received.try_recv().is_err());
+        release_at(&shared, &shared.tests.consuming, false);
+        let mut worker = complete.join().unwrap();
+        close.join().unwrap();
+        assert!(received.recv().unwrap().is_ok());
+        assert!(worker.is_parked());
+        let scope = worker.start_active_scope().unwrap();
+        let mut next = self::packet();
+        next.material = -193;
+        next.mobility_weights = [0, 10240];
+        dispatch(&mut worker, &next);
+        assert_output(worker.complete().unwrap(), &next);
