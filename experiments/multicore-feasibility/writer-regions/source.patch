+    /// Cold opt-in startup projection of this actual production allocation.
+    /// No search/counter path calls this. TestHooks make cfg(test) Shared larger;
+    /// the external admission requires testBuild=false from the measured image.
+    pub(crate) fn layout_projection(&self) -> Result<String, String> {
+        use std::mem::{align_of, offset_of, size_of};
+        let control = control_lock(&self.shared);
+        if self.generation != 0 || control.scopes != 0 || control.closing
+            || !matches!(control.flight, Flight::None)
+            || terminal(&self.shared) || !all_state(&self.shared, PARKED)
+        {
+            return Err("colors layout projection requires initial parked helpers".into());
+        }
+        let cells = offset_of!(Shared, cells);
+        let input = cells + offset_of!(Cells, input);
+        let sides = cells + offset_of!(Cells, sides);
+        let regions = [
+            ("request", offset_of!(Shared, publication), size_of::<RequestRegion>(), align_of::<RequestRegion>()),
+            ("packet", input, size_of::<PacketRegion>(), align_of::<PacketRegion>()),
+            ("white", sides, size_of::<SideRegion>(), align_of::<SideRegion>()),
+            ("black", sides + size_of::<SideRegion>(), size_of::<SideRegion>(), align_of::<SideRegion>()),
+            ("lifecycle", offset_of!(Shared, lifecycle), size_of::<LifecycleRegion>(), align_of::<LifecycleRegion>()),
+            ("latch", offset_of!(Shared, latch), size_of::<LatchRegion>(), align_of::<LatchRegion>()),
+            ("wait", offset_of!(Shared, waits), size_of::<WaitRegion>(), align_of::<WaitRegion>()),
+            ("control", offset_of!(Shared, owner), size_of::<ControlRegion>(), align_of::<ControlRegion>()),
+        ];
+        let mut out = String::new();
+        write!(out, "{{\"schema\":\"rook2-writer-regions-layout-v1\",\"layoutDesign\":\"eight64\",\"testBuild\":{},\"parked\":true,\"shared\":{{\"size\":{},\"align\":{},\"addressMod64\":{}}},\"regions\":[",
+            cfg!(test), size_of::<Shared>(), align_of::<Shared>(),
+            (Arc::as_ptr(&self.shared) as usize) % 64).unwrap();
+        for (i, (name, offset, size, align)) in regions.iter().enumerate() {
+            if i != 0 { out.push(','); }
+            write!(out, "{{\"name\":\"{name}\",\"offset\":{offset},\"size\":{size},\"align\":{align}}}").unwrap();
+        }
+        out.push_str("],\"slots\":[");
+        for (i, name) in ["white", "black"].iter().enumerate() {
+            if i != 0 { out.push(','); }
+            let offset = sides + i * size_of::<SideRegion>();
+            write!(out, "{{\"name\":\"{name}\",\"offset\":{offset},\"size\":{},\"align\":{},\"outputOffset\":{},\"outputBytes\":{},\"doneOffset\":{},\"doneBytes\":{}}}",
+                size_of::<SideRegion>(), align_of::<SideRegion>(),
+                offset + offset_of!(SideRegion, output), size_of::<SideOutput>(),
+                offset + offset_of!(SideRegion, done), size_of::<AtomicU64>()).unwrap();
+        }
+        write!(out, "],\"types\":{{\"packetBytes\":{},\"sideOutputBytes\":{},\"controlMutexBytes\":{},\"lifecycleBytes\":{},\"waitBytes\":{},\"cellsBytes\":{}}}}}",
+            size_of::<Packet>(), size_of::<SideOutput>(), size_of::<Mutex<Control>>(),
+            size_of::<LifecycleRegion>(), size_of::<WaitRegion>(), size_of::<Cells>()).unwrap();
+        Ok(out)
+    }
