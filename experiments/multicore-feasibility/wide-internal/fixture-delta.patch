+pub struct Report {context:Context,complete:bool,canonical_nodes:u64,canonical_relations:u64,completed_depth:u8,passes:usize,wall_ns:u128,cpu_ns:u128,error:Option<String>}
+impl Report {
+    pub fn failed(&self)->bool {!self.complete||self.context.0.borrow().censored.is_some()||self.error.is_some()}
+    pub fn json(&self)->String {
+        let state=self.context.0.borrow();let mut parents=state.parents.iter().collect::<Vec<_>>();parents.sort_by_key(|p|p.ordinal);
+        let rows=parents.iter().map(|p|p.json()).collect::<Vec<_>>().join(",");
+        let error=self.error.as_ref().map_or("null".into(),|e|format!("\"{}\"",e.replace('"',"'").replace('\n'," ")));
+        let reason=state.censored.map_or("null".into(),|r|format!("\"{r}\""));
+        let out=format!("{{\"schema\":\"rook2-wide-capture-v1\",\"processId\":{},\"horizon\":8,\"complete\":{},\"censored\":{},\"censor_reason\":{},\"error\":{},\"fixed_completion\":true,\"no_host\":true,\"zero_randomness\":true,\"canonical_nodes\":{},\"canonical_relations\":{},\"ordinary_entries\":{},\"completed_depth\":{},\"root_passes\":{},\"retained_bytes\":{},\"peak_retained_bytes\":{},\"caps\":{{\"candidate_parents\":{},\"retained_bytes\":{},\"output_bytes\":{},\"lifetime_seconds\":{}}},\"wall_ns\":{},\"process_cpu_ns\":{},\"coverage\":{},\"parents\":[{}],\"scope\":\"One serial depth8 capture. Ordinals are1-based non-Q ordinary invocation entry after handoff and before hierarchy lookup/ordinary charge, including IIO/null/retry calls. Separate mate-kernel and Q entries are excluded. Inclusive next8 main sibling work uses fresh local counter deltas including native retries; sibling work is disjoint, overlapping parent opportunities are not additive. Binding is lossless exact known native input text, excluding whole-TT digest; failed candidates release binding but retain compact summaries. Hindsight fixture selection is external and never reuse permission. Capture performs no independent oracle and records no full search forest.\"}}",
+            std::process::id(),self.complete,state.censored.is_some(),reason,error,self.canonical_nodes,self.canonical_relations,state.ordinal,
+            self.completed_depth,self.passes,state.bytes(),state.peak_bytes,state.caps.candidate_parents,state.caps.retained_bytes,state.caps.output_bytes,state.caps.lifetime_seconds,
+            self.wall_ns,self.cpu_ns,state.coverage.json(),rows);
+        assert!(out.len()<=state.caps.output_bytes,"prospective output bound was insufficient");out
+    }
+}
+pub fn run(position:Position,history:SearchHistory,parameters:Parameters,config:Config)->Result<Report,String> {
+    if history.search_ply()!=0{return Err("capture requires root history boundary".into());}
+    let mut search=Search::<true>::new(&position);search.config=config;search.evaluator.parameters=parameters;
+    let context=Context::capture(Caps::default());search.wide_capture=Some(context.clone());let mut actual_history=history;
+    let started=Instant::now();let cpu=crate::internal_split::process_cpu();
+    let result=crate::internal_split::native_root(&mut search,position,&mut actual_history,8);
+    let cpu_ns=crate::internal_split::process_cpu()-cpu;let wall_ns=started.elapsed().as_nanos();search.wide_capture=None;
+    let complete=result.is_ok()&&actual_history.search_ply()==0;
+    let (completed_depth,passes,error)=match result {Ok(output)=>(output.completed_depth(),output.pass_count(),None),Err(error)=>(0,0,Some(error))};
+    Ok(Report {context,complete,canonical_nodes:search.stats.nodes,canonical_relations:search.evaluator.stats.relation_queries,
+        completed_depth,passes,wall_ns,cpu_ns,error})
+}
