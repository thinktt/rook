+//! Bounded serial capture for an explicitly hindsight-selected coarse fixture.
+//! Captured scores/work describe a benchmark; they never authorize replay.
+//! Ordinals count non-Q ordinary invocations, including IIO/null/retry calls,
+//! after the Q handoff gate and before hierarchy lookup or ordinary charging.
+use std::{cell::RefCell, collections::HashMap, fmt::Write, rc::Rc, time::Instant};
+use crate::{engine::{Config, Search}, evaluator::{EvalStats, Node, Parameters}, history::SearchHistory,
+    host::Host, ordinary::{Predecessor, Request}, ordinary_policy::Extensions,
+    position::Position, quiescence::{Stats, Stopped}, types::Move};
+
+#[derive(Clone, Copy, Debug)]
+pub struct Caps { pub candidate_parents: usize, pub retained_bytes: usize, pub output_bytes: usize, pub lifetime_seconds: u64 }
+impl Default for Caps {
+    fn default() -> Self { Self { candidate_parents: 131072, retained_bytes: 64*1024*1024,
+        output_bytes: 256*1024*1024, lifetime_seconds: 180 } }
+}
+
+/// A lossless owned descriptor, independent of expected child scores/work.
+/// External fixtures carry its bytes as hex. There is no whole-TT scan here;
+/// the selected-boundary TT audit belongs to the runtime driver's pre-interval.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct BoundaryBinding { pub(crate) descriptor: String }
+
+/// Token interning is injective: new tokens carry a decimal byte length and
+/// literal bytes, references carry their first-occurrence index. HashMap is
+/// lookup-only; iteration order cannot affect the representation.
+fn compact(text: &str) -> String {
+    let mut tokens = HashMap::<&str, usize>::new();
+    let mut result = String::new();
+    for token in text.split_inclusive(',') {
+        if let Some(index) = tokens.get(token) { write!(result, "R{index};").unwrap(); }
+        else { let index = tokens.len(); tokens.insert(token, index);
+            write!(result, "N{}:{token}", token.len()).unwrap(); }
+    }
+    result
+}
+fn hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len()*2);
+    for &byte in bytes { out.push(DIGITS[(byte>>4) as usize] as char); out.push(DIGITS[(byte&15) as usize] as char); }
+    out
+}
+
+pub(crate) fn boundary_binding<const A:bool,const D:bool,H:Host>(
+    search:&mut Search<D,H>, node:&Node, history:&SearchHistory, request:Request,
+    previous:Predecessor<'_>, current:Predecessor<'_>, best:i32, index:usize,
+    extensions:&Extensions, ordinal:u64,
+) -> BoundaryBinding {
+    let p=request.ply;
+    let order = search.candidates[p].as_slice();
+    assert!(index+8<=order.len());
+    let next: [(Move,u8,u8);8] = std::array::from_fn(|offset| {
+        let i=index+offset; let movement=order[i];
+        (movement,search.extension_flags[p][i],extensions.for_move(&node.position,movement))
+    });
+    let text=format!("wide-boundary-v1;ordinal={ordinal};allow_iio={A};node={node:?};history={history:?};request={request:?};previous={:?}/{:?}/{:?}/{:?};current={:?}/{:?}/{:?}/{:?};best={best};index={index};count={};order={order:?};flags={:?};next8={next:?};config={:?};geometry={};stats={:?};learning={:?};evaluator={};groups={}",
+        previous.position,previous.influence,previous.checked,previous.movement,
+        current.position,current.influence,current.checked,current.movement,
+        order.len(),&search.extension_flags[p][..order.len()],search.config,search.geometry_permission(),
+        search.stats,search.learning.research_snapshot(),search.evaluator.research_boundary_binding(),
+        search.remembered.as_ref().map_or(0,|table|table.group_count()));
+    BoundaryBinding { descriptor:compact(&text) }
+}
+
+#[derive(Clone, Debug)]
+struct ChildSummary {
+    index:usize, movement:Move, complete:bool, nodes:u64, relations:u64, full:u64, fast:u64, maps:u64,
+    requests:[Option<Request>;2], request_count:usize, best_before:i32, best_after:i32, score:i32,
+}
+impl ChildSummary {
+    fn json(&self)->String {
+        let requests=self.requests.iter().flatten().map(|r| format!("{{\"ply\":{},\"depth\":{},\"lower\":{},\"upper\":{},\"previous_extension\":{},\"iteration\":{},\"checked\":{}}}",
+            r.ply,r.depth,r.lower,r.upper,r.previous_extension,r.iteration,r.checked.map_or("null".into(),|v|v.to_string()))).collect::<Vec<_>>().join(",");
+        format!("{{\"index\":{},\"movement\":{},\"complete\":{},\"nodes\":{},\"relations\":{},\"full\":{},\"fast\":{},\"maps\":{},\"requests\":[{}],\"retries\":{},\"best_before\":{},\"best_after\":{},\"best_changed\":{},\"score\":{}}}",
+            self.index,self.movement.0,self.complete,self.nodes,self.relations,self.full,self.fast,self.maps,
+            requests,self.request_count.saturating_sub(1),self.best_before,self.best_after,self.best_after!=self.best_before,self.score)
+    }
+}
+struct Candidate {
+    ordinal:u64, request:Request, remaining:usize, best:i32, child0_nodes:u64,
+    binding:Option<BoundaryBinding>, children:[Option<ChildSummary>;8],
+}
+impl Candidate {
+    fn qualifies(&self)->bool {
+        self.children.iter().all(|child|child.as_ref().is_some_and(|c|c.complete&&c.nodes>=512))
+            && self.children.iter().flatten().map(|child|child.nodes).sum::<u64>()>=8192
+    }
+    fn binding_bytes(&self)->usize { self.binding.as_ref().map_or(0,|b|b.descriptor.capacity()) }
+    fn json(&self)->String {
+        let children=self.children.iter().flatten().map(ChildSummary::json).collect::<Vec<_>>().join(",");
+        let binding=self.binding.as_ref().map_or("null".into(),|b|format!("\"{}\"",hex(b.descriptor.as_bytes())));
+        format!("{{\"entry_ordinal\":{},\"ply\":{},\"iteration\":{},\"depth\":{},\"window\":[{},{}],\"remaining\":{},\"best\":{},\"child0_nodes\":{},\"binding_hex\":{},\"children\":[{}],\"qualifies\":{}}}",
+            self.ordinal,self.request.ply,self.request.iteration,self.request.depth,self.request.lower,self.request.upper,self.remaining,self.best,self.child0_nodes,binding,children,self.qualifies())
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Coverage {
+    post_child0:u64, finite_window:u64, depth_ge3:u64, width_ge8:u64, completed8:u64, qualified:u64,
+    max_remaining:usize, max_completed:usize, max_child_nodes:u64, max_sum8:u64,
+    completed_hist:[u64;9], minimum_child_nodes_hist:[u64;8], sum8_hist:[u64;8],
+}
+fn bin(work:u64)->usize { match work {0=>0,1..=127=>1,128..=511=>2,512..=1023=>3,1024..=2047=>4,2048..=4095=>5,4096..=8191=>6,_=>7} }
+impl Coverage {
+    fn json(&self)->String { format!("{{\"post_child0\":{},\"finite_window\":{},\"depth_ge3\":{},\"width_ge8\":{},\"completed8\":{},\"qualified\":{},\"max_remaining\":{},\"max_completed\":{},\"max_child_nodes\":{},\"max_sum8\":{},\"completed_hist\":{:?},\"minimum_child_nodes_hist\":{:?},\"sum8_hist\":{:?},\"work_bins\":[\"0\",\"1..127\",\"128..511\",\"512..1023\",\"1024..2047\",\"2048..4095\",\"4096..8191\",\"8192+\"]}}",
+        self.post_child0,self.finite_window,self.depth_ge3,self.width_ge8,self.completed8,self.qualified,
+        self.max_remaining,self.max_completed,self.max_child_nodes,self.max_sum8,self.completed_hist,self.minimum_child_nodes_hist,self.sum8_hist) }
+    fn boundary(&mut self,request:Request,remaining:usize)->bool {
+        self.post_child0+=1;
+        if !finite(request) {return false;} self.finite_window+=1;
+        if request.depth<3 {return false;} self.depth_ge3+=1;
+        self.max_remaining=self.max_remaining.max(remaining);
+        if remaining<8 {return false;} self.width_ge8+=1; true
+    }
+    fn close(&mut self,candidate:&Candidate) {
+        let completed=candidate.children.iter().flatten().filter(|child|child.complete).count();
+        self.completed_hist[completed]+=1;self.max_completed=self.max_completed.max(completed);
+        self.max_child_nodes=self.max_child_nodes.max(candidate.children.iter().flatten().map(|c|c.nodes).max().unwrap_or(0));
+        if completed==8 {
+            self.completed8+=1;
+            let minimum=candidate.children.iter().flatten().map(|c|c.nodes).min().unwrap();
+            let sum=candidate.children.iter().flatten().map(|c|c.nodes).sum();
+            self.minimum_child_nodes_hist[bin(minimum)]+=1;self.sum8_hist[bin(sum)]+=1;self.max_sum8=self.max_sum8.max(sum);
+        }
+        if candidate.qualifies(){self.qualified+=1;}
+    }
+}
+fn finite(request:Request)->bool { request.lower > -10000 && request.upper < 10000 && request.lower<request.upper }
+
+// Maximum decimal widths on the admitted64-bit target: usize/u64=20,
+// u16=5, u8=3, i32=11 and bool=5. A Request is at most153 JSON bytes.
+// One child including its two actual requests is at most635 bytes. Eight
+// children plus all parent scalar fields and an empty quoted binding use5368;
+// a null binding adds2, and the inter-row comma adds1. Round5371 up to5376.
+// A nonempty binding adds exactly2 hex bytes per descriptor byte, conservatively
+// charged from retained String capacity. Header allowance4096 covers fixed
+// schema/scope/coverage/cap fields, numeric maxima and native fixed error text.
+const PARENT_JSON_BYTES:usize=5376;
+const HEADER_JSON_BYTES:usize=4096;
+
+struct State {
+    capture:bool, caps:Caps, started:Instant, ordinal:u64, parents:Vec<Candidate>, binding_bytes:usize,
+    peak_bytes:usize, censored:Option<&'static str>, coverage:Coverage,
+}
+impl State {
+    fn bytes(&self)->usize {std::mem::size_of::<Self>()+self.parents.capacity()*std::mem::size_of::<Candidate>()+self.binding_bytes}
+    // Bound stdout before retaining a parent, including all eight request/work
+    // summaries even when the candidate is still in flight. Binding hex costs2x.
+    fn output_bound(&self,parents:usize,bindings:usize)->usize {HEADER_JSON_BYTES.saturating_add(parents.saturating_mul(PARENT_JSON_BYTES)).saturating_add(bindings.saturating_mul(2))}
+    fn censor(&mut self,reason:&'static str)->Stopped { self.censored.get_or_insert(reason);Stopped::HierarchicalAudit }
+}
+#[derive(Clone)]
+pub(crate) struct Context(Rc<RefCell<State>>);
+impl Context {
+    pub(crate) fn capture(caps:Caps)->Self { Self::new(true,caps) }
+    pub(crate) fn counter()->Self {Self::new(false,Caps::default())}
+    fn new(capture:bool,caps:Caps)->Self {Self(Rc::new(RefCell::new(State { capture,caps,started:Instant::now(),ordinal:0,parents:Vec::new(),binding_bytes:0,peak_bytes:std::mem::size_of::<State>(),censored:None,coverage:Coverage::default() })))}
+}
+pub(crate) fn enter(context:&Option<Context>)->Result<u64,Stopped> {
+    let Some(context)=context else{return Ok(0)};
+    let mut state=context.0.borrow_mut();
+    if state.censored.is_some(){return Err(Stopped::HierarchicalAudit);}
+    if state.capture && state.started.elapsed().as_secs()>=state.caps.lifetime_seconds {
+        return Err(state.censor("capture-lifetime-cap"));
+    }
+    state.ordinal=state.ordinal.checked_add(1).expect("ordinary entry ordinal overflow");Ok(state.ordinal)
+}
+
+pub(crate) struct Parent {context:Context,id:usize,start:usize}
+impl Drop for Parent {
+    fn drop(&mut self) {
+        let mut state=self.context.0.borrow_mut();
+        let mut coverage=state.coverage;coverage.close(&state.parents[self.id]);state.coverage=coverage;
+        if !state.parents[self.id].qualifies() {
+            let released=state.parents[self.id].binding_bytes();state.binding_bytes-=released;state.parents[self.id].binding=None;
+        }
+    }
+}
+pub(crate) fn boundary<const A:bool,const D:bool,H:Host>(
+    search:&mut Search<D,H>,node:&Node,history:&SearchHistory,request:Request,previous:Predecessor<'_>,
+    current:Predecessor<'_>,best:i32,index:usize,child0_nodes:u64,extensions:&Extensions,ordinal:u64,
+)->Result<Option<Parent>,Stopped> {
+    let Some(context)=search.wide_capture.clone() else{return Ok(None)};
+    let remaining=search.candidates[request.ply].len-index;
+    {let mut state=context.0.borrow_mut();if !state.capture{return Ok(None);}
+        if !state.coverage.boundary(request,remaining){return Ok(None);}
+        if state.parents.len()>=state.caps.candidate_parents {return Err(state.censor("capture-parent-cap"));}
+    }
+    assert!(D&&!H::ACTIVE&&search.timing.is_none()&&search.limits.nodes.is_none()&&search.control.is_none());
+    let binding=boundary_binding::<A,D,H>(search,node,history,request,previous,current,best,index,extensions,ordinal);
+    let mut state=context.0.borrow_mut();
+    let bytes=state.binding_bytes.saturating_add(binding.descriptor.capacity());
+    let len=state.parents.len()+1;
+    let capacity=state.parents.capacity().max(len);
+    if std::mem::size_of::<State>().saturating_add(capacity.saturating_mul(std::mem::size_of::<Candidate>())).saturating_add(bytes)>state.caps.retained_bytes {
+        return Err(state.censor("capture-summary-byte-cap"));
+    }
+    if state.output_bound(len,bytes)>state.caps.output_bytes {return Err(state.censor("capture-output-byte-cap"));}
+    let id=state.parents.len();
+    if id==state.parents.capacity(){state.parents.reserve_exact(1);}
+    state.parents.push(Candidate {ordinal,request,remaining,best,child0_nodes,binding:Some(binding),children:std::array::from_fn(|_|None)});
+    state.binding_bytes=bytes;state.peak_bytes=state.peak_bytes.max(state.bytes());
+    Ok(Some(Parent {context:context.clone(),id,start:index}))
+}
+
+pub(crate) struct Child {id:usize,offset:usize,index:usize,stats:Stats,evaluations:EvalStats,best:i32,requests:[Option<Request>;2],request_count:usize}
+pub(crate) fn begin_child<const D:bool,H:Host>(search:&Search<D,H>,parent:Option<&Parent>,index:usize,best:i32)->Option<Child> {
+    let parent=parent?;if index<parent.start||index>=parent.start+8{return None;}
+    Some(Child {id:parent.id,offset:index-parent.start,index,stats:search.stats,evaluations:search.evaluator.stats,best,requests:[None;2],request_count:0})
+}
+pub(crate) fn child_request(child:&mut Option<Child>,request:Request) {
+    if let Some(child)=child {assert!(child.request_count<2,"native main child has more than one retry");child.requests[child.request_count]=Some(request);child.request_count+=1;}
+}
+pub(crate) fn end_child<const D:bool,H:Host>(search:&Search<D,H>,parent:Option<&Parent>,child:Option<Child>,movement:Move,score:i32) {
+    let (Some(parent),Some(child))=(parent,child) else{return;};
+    let summary=ChildSummary {index:child.index,movement,complete:true,nodes:search.stats.nodes-child.stats.nodes,
+        relations:search.evaluator.stats.relation_queries-child.evaluations.relation_queries,
+        full:search.evaluator.stats.full-child.evaluations.full,fast:search.evaluator.stats.fast-child.evaluations.fast,
+        maps:search.evaluator.stats.influence_builds-child.evaluations.influence_builds,requests:child.requests,request_count:child.request_count,
+        best_before:child.best,best_after:child.best.max(score),score};
+    let mut state=parent.context.0.borrow_mut();assert!(state.parents[child.id].children[child.offset].is_none());
+    state.parents[child.id].children[child.offset]=Some(summary);
+    // A failed minimum cannot recover later. Keep summaries for coverage but
+    // release this exact binding promptly; no candidate summary is pruned.
+    let failed=state.parents[child.id].children.iter().flatten().any(|c|c.nodes<512)
+        || (child.offset==7&&!state.parents[child.id].qualifies());
+    if failed {let released=state.parents[child.id].binding_bytes();state.binding_bytes-=released;state.parents[child.id].binding=None;}
+}
