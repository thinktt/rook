+//! Private fixed-completion actual Search replicas. Public production search and
+//! evaluator-only calls retain their original entry points and behavior.
+
+use crate::engine::{Config, Search};
+use crate::evaluator::{FullAudit, Parameters};
+use crate::history::SearchHistory;
+use crate::ordinary::Outcome;
+use crate::position::Position;
+use crate::quiescence::Limits;
+use crate::replica_collective::{CollectiveControl, ReplicaLane};
+use std::any::Any;
+use std::sync::{Arc, Condvar, Mutex};
+use std::thread::{self, JoinHandle};
+use std::time::Instant;
+
+pub struct RunReport {
+    pub outcome: Outcome,
+    pub raw_returns: Vec<i32>,
+    pub search_wall_ns: u128,
+    pub join_ns: u128,
+    pub epochs: [u64; 3],
+    pub collective_storage_bytes: usize,
+    pub audit_checked_fulls: Option<usize>,
+    pub audit_final_state_equal: Option<bool>,
+    pub pawn_owner_equal: Option<bool>,
+    pub all_replicas_equal: bool,
+}
+
+/// Every lane receives independent search/TT/learning/history state with the
+/// original TT capacity. Audit records serial execution before replicas start;
+/// performance carries no trace or future FULL inputs.
+pub fn run(
+    root: Position, history: SearchHistory, parameters: Parameters, config: Config,
+    depth: u8, seed: u32, randomness: u32, audit: bool,
+    before_search: impl FnOnce() -> Result<(), String>,
+) -> Result<RunReport, String> {
+    run_with(root, history, parameters, config, depth, seed, randomness, audit,
+        before_search, Controls::default())
+}
+
+fn run_with(
+    root: Position, history: SearchHistory, parameters: Parameters, config: Config,
+    depth: u8, seed: u32, randomness: u32, audit: bool,
+    before_search: impl FnOnce() -> Result<(), String>, controls: Controls,
+) -> Result<RunReport, String> {
+    if !cfg!(panic = "unwind") { return Err("replica runner requires panic=unwind".into()); }
+    if !(1..=8).contains(&depth) || (audit && depth > 2) {
+        return Err("replica depth must be 1..=8, with audit depth at most 2".into());
+    }
+    if randomness > i32::MAX as u32 || history.search_ply() != 0 {
+        return Err("invalid replica randomness or root history boundary".into());
+    }
+    // The concrete join guard below remains live through every startup,
+    // callback and owner panic. AssertUnwindSafe covers this private fatal-only
+    // run: no partially mutated Search is reused after a caught failure.
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        if audit {
+            run_mode::<true>(root, history, parameters, config, depth, seed, randomness,
+                true, before_search, controls)
+        } else {
+            run_mode::<false>(root, history, parameters, config, depth, seed, randomness,
+                false, before_search, controls)
+        }
+    })) {
+        Ok(result) => result,
+        Err(payload) => Err(format!("replica runner panicked: {}", panic_text(payload))),
+    }
+}
+
+struct Completed<const D: bool> {
+    search: Search<D>,
+    history: SearchHistory,
+    outcome: Outcome,
+    raw: Vec<i32>,
+    epoch: u64,
+    checked: Option<usize>,
+}
+
+#[derive(Default)]
+struct StartupState { entered: [bool; 2], start: bool, aborted: bool }
+
+#[derive(Default)]
+struct StartupGate { state: Mutex<StartupState>, wake: Condvar }
+
+impl StartupGate {
+    fn enter_and_wait(&self, role: usize) -> Result<(), String> {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        state.entered[role - 1] = true;
+        self.wake.notify_all();
+        while !state.start && !state.aborted {
+            state = self.wake.wait(state).unwrap_or_else(|error| error.into_inner());
+        }
+        if state.aborted { Err("replica startup cancelled".into()) } else { Ok(()) }
+    }
+
+    fn wait_entered(&self) -> Result<(), String> {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        while !state.entered.iter().all(|entered| *entered) && !state.aborted {
+            state = self.wake.wait(state).unwrap_or_else(|error| error.into_inner());
+        }
+        if state.aborted { Err("replica entry failed before placement gate".into()) } else { Ok(()) }
+    }
+
+    fn start(&self) {
+        self.state.lock().unwrap_or_else(|error| error.into_inner()).start = true;
+        self.wake.notify_all();
+    }
+
+    fn abort(&self) {
+        self.state.lock().unwrap_or_else(|error| error.into_inner()).aborted = true;
+        self.wake.notify_all();
+    }
+}
+
+/// Concrete ownership of the two actual peers, including partial startup. Drop
+/// is only a failure path; normal join_all disarms it after taking EVERY handle.
+struct Peers<const D: bool> {
+    handles: [Option<JoinHandle<Result<Completed<D>, String>>>; 2],
+    control: CollectiveControl,
+    gate: Arc<StartupGate>,
+    armed: bool,
+}
+
+impl<const D: bool> Peers<D> {
+    fn join_all(&mut self) -> Result<[Completed<D>; 2], String> {
+        let mut results = Vec::with_capacity(2);
+        let mut failure = None;
+        for handle in &mut self.handles {
+            if let Some(handle) = handle.take() {
+                match handle.join() {
+                    Ok(Ok(result)) => results.push(result),
+                    Ok(Err(error)) => {
+                        self.control.cancel(error.clone()); self.gate.abort();
+                        if failure.is_none() { failure = Some(error); }
+                    }
+                    Err(payload) => {
+                        let error = format!("replica peer escaped catcher: {}", panic_text(payload));
+                        self.control.cancel(error.clone()); self.gate.abort();
+                        if failure.is_none() { failure = Some(error); }
+                    }
+                }
+            }
+        }
+        self.armed = false;
+        if let Some(error) = failure { return Err(error); }
+        let mut results = results.into_iter();
+        match (results.next(), results.next()) {
+            (Some(white), Some(black)) => Ok([white, black]),
+            _ => Err("replica runner lacks two actual joined peers".into()),
+        }
+    }
+}
+
+impl<const D: bool> Drop for Peers<D> {
+    fn drop(&mut self) {
+        if self.armed {
+            self.control.cancel("replica runner abandoned before all joins");
+            self.gate.abort();
+            for handle in &mut self.handles {
+                if let Some(handle) = handle.take() { let _ = handle.join(); }
+            }
+        }
+    }
+}
+
+fn search<const D: bool>(root: &Position, parameters: Parameters, config: Config,
+    lane: Option<ReplicaLane>, trace: Option<Arc<Vec<FullAudit>>>) -> Result<Search<D>, String> {
+    let mut search = Search::new(root);
+    search.config = config;
+    search.evaluator.parameters = parameters;
+    if let Some(lane) = lane { search.evaluator.replica_attach(lane)?; }
+    if let Some(trace) = trace { search.evaluator.replica_audit_compare(trace)?; }
+    Ok(search)
+}
+
+fn run_lane<const D: bool>(
+    mut search: Search<D>, mut history: SearchHistory, root: Position,
+    depth: u8, seed: u32, randomness: u32, audit: bool,
+    control: &CollectiveControl, gate: &StartupGate,
+) -> Result<Completed<D>, String> {
+    // Search/history live outside the catcher. An unexpected search panic is
+    // converted into cancellation before their final drop; mutated state is
+    // fatal and is never reused. Evaluator FULL already cancels before panic.
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut raw = Vec::new();
+        let outcome = search.run_seeded_iterations(root, &mut history, depth,
+            Limits::default(), seed, randomness, |score| raw.push(score))
+            .map_err(|error| format!("replica ordinary search failed: {error:?}"))?;
+        let checked = if audit { Some(search.evaluator.replica_audit_finish()?) } else { None };
+        let epoch = search.evaluator.replica_finish()?;
+        Ok::<_, String>((outcome, raw, checked, epoch))
+    }));
+    let result = match result {
+        Ok(result) => result,
+        Err(payload) => Err(format!("replica lane panicked: {}", panic_text(payload))),
+    };
+    match result {
+        Ok((outcome, raw, checked, epoch)) =>
+            Ok(Completed { search, history, outcome, raw, epoch, checked }),
+        Err(error) => {
+            search.evaluator.replica_cancel(&error);
+            control.cancel(error.clone()); gate.abort();
+            Err(error)
+        }
+    }
+}
+
+fn run_mode<const D: bool>(
+    root: Position, history: SearchHistory, parameters: Parameters, config: Config,
+    depth: u8, seed: u32, randomness: u32, audit: bool,
+    before_search: impl FnOnce() -> Result<(), String>, controls: Controls,
+) -> Result<RunReport, String> {
+    let (serial, trace) = if audit {
+        let mut serial_search = search::<D>(&root, parameters.clone(), config, None, None)?;
+        serial_search.evaluator.replica_audit_record()?;
+        let mut serial_history = history.clone();
+        let mut raw = Vec::new();
+        let outcome = serial_search.run_seeded_iterations(root, &mut serial_history, depth,
+            Limits::default(), seed, randomness, |score| raw.push(score))
+            .map_err(|error| format!("independent serial audit failed: {error:?}"))?;
+        let trace = Arc::new(serial_search.evaluator.replica_audit_take()?);
+        let serial = Completed { search: serial_search, history: serial_history,
+            outcome, raw, epoch: 0, checked: None };
+        (Some(serial), Some(trace))
+    } else { (None, None) };
+
+    let (control, [owner, white, black]) = CollectiveControl::new();
+    let gate = Arc::new(StartupGate::default());
+    let mut peers = Peers::<D> { handles: [None, None], control: control.clone(),
+        gate: Arc::clone(&gate), armed: true };
+    let owner_search = search::<D>(&root, parameters.clone(), config, Some(owner), trace.clone())?;
+    for (role, lane) in [(1, white), (2, black)] {
+        #[cfg(test)]
+        if controls.fail_spawn == Some(role) {
+            return Err(format!("controlled replica spawn failure at role {role}"));
+        }
+        let peer_control = control.clone();
+        let peer_gate = Arc::clone(&gate);
+        let peer_parameters = parameters.clone();
+        let peer_history = history.clone();
+        let peer_trace = trace.clone();
+        let peer_controls = controls.clone();
+        let handle = thread::Builder::new().name(format!("rook2-rep-{role}")).spawn(move || {
+            #[cfg(test)]
+            let _probe = ExitProbe::new(peer_controls.probe.clone());
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let search = search::<D>(&root, peer_parameters, config, Some(lane), peer_trace)?;
+                #[cfg(test)]
+                {
+                    if peer_controls.fail_entry == Some(role) { return Err("controlled replica entry failure".into()); }
+                    if peer_controls.panic_entry == Some(role) { panic!("controlled replica entry panic"); }
+                }
+                // Initialization and lane attachment precede this actual entry.
+                peer_gate.enter_and_wait(role)?;
+                #[cfg(test)]
+                let depth = if peer_controls.shorter_lane == Some(role) { 1 } else { depth };
+                #[cfg(not(test))]
+                let _ = peer_controls;
+                run_lane(search, peer_history, root, depth, seed, randomness, audit,
+                    &peer_control, &peer_gate)
+            }));
+            let result = match result {
+                Ok(result) => result,
+                Err(payload) => Err(format!("replica thread entry panicked: {}", panic_text(payload))),
+            };
+            if let Err(error) = &result { peer_control.cancel(error.clone()); peer_gate.abort(); }
+            result
+        }).map_err(|error| format!("cannot spawn replica role {role}: {error}"))?;
+        peers.handles[role - 1] = Some(handle);
+    }
+    gate.wait_entered()?;
+    before_search()?;
+    if control.cancelled() { return Err("replicas cancelled at placement gate".into()); }
+    let started = Instant::now();
+    gate.start();
+    let owner = run_lane(owner_search, history, root, depth, seed, randomness, audit, &control, &gate);
+    let joining = Instant::now();
+    let joined = peers.join_all();
+    let join_ns = joining.elapsed().as_nanos();
+    let search_wall_ns = started.elapsed().as_nanos();
+    // No owner outcome escapes until every actual peer has returned and joined.
+    let owner = owner?;
+    let [white, black] = joined?;
+    if control.cancelled() { return Err("replica collective cancelled during search".into()); }
+    for peer in [&white, &black] {
+        if !outcome_equal(&owner.outcome, &peer.outcome) || owner.raw != peer.raw {
+            return Err("actual replica outcomes or raw root returns diverged".into());
+        }
+    }
+    let epochs = control.final_epochs();
+    if epochs != [owner.epoch, white.epoch, black.epoch] || epochs.iter().any(|epoch| *epoch != owner.epoch) {
+        return Err("actual replica terminal epochs diverged".into());
+    }
+    let (audit_checked_fulls, audit_final_state_equal, pawn_owner_equal) = if let Some(serial) = serial {
+        let count = trace.as_ref().unwrap().len();
+        for replica in [&owner, &white, &black] {
+            if replica.checked != Some(count) || replica.epoch != count as u64
+                || !outcome_equal(&serial.outcome, &replica.outcome) || serial.raw != replica.raw
+                || !state_equal(&serial, replica) {
+                return Err("replica serial audit final state or FULL count diverged".into());
+            }
+        }
+        if !serial.search.evaluator.replica_pawns_equal(&owner.search.evaluator) {
+            return Err("authoritative owner pawn cache diverged from serial".into());
+        }
+        (Some(count), Some(true), Some(true))
+    } else { (None, None, None) };
+    Ok(RunReport { outcome: owner.outcome, raw_returns: owner.raw, search_wall_ns, join_ns,
+        epochs, collective_storage_bytes: control.storage_bytes(), audit_checked_fulls,
+        audit_final_state_equal, pawn_owner_equal, all_replicas_equal: true })
+}
+
+fn outcome_equal(a: &Outcome, b: &Outcome) -> bool {
+    a.initial_candidates == b.initial_candidates && a.score == b.score && a.pv == b.pv
+        && a.work == b.work && a.stats == b.stats && a.evaluations == b.evaluations
+        && a.iterations.len() == b.iterations.len()
+        && a.iterations.iter().zip(&b.iterations).all(|(a, b)|
+            a.depth == b.depth && a.candidates == b.candidates && a.steps == b.steps
+                && a.score == b.score && a.pv == b.pv && a.work == b.work)
+}
+
+fn state_equal<const D: bool>(a: &Completed<D>, b: &Completed<D>) -> bool {
+    a.history == b.history && a.search.stats == b.search.stats
+        && a.search.evaluator.stats == b.search.evaluator.stats
+        && a.search.learning.history == b.search.learning.history
+        && a.search.learning.killers == b.search.learning.killers
+        && a.search.learning.total == b.search.learning.total
+        && a.search.pv[1][..a.search.pv_len[1]] == b.search.pv[1][..b.search.pv_len[1]]
+        && match (&a.search.remembered, &b.search.remembered) {
+            (Some(a), Some(b)) => a.replica_eq(b), (None, None) => true, _ => false,
+        }
+}
+
+fn panic_text(payload: Box<dyn Any + Send>) -> String {
+    if let Some(text) = payload.downcast_ref::<&str>() { (*text).into() }
+    else if let Some(text) = payload.downcast_ref::<String>() { text.clone() }
+    else { "non-string panic".into() }
+}
+
+#[derive(Clone, Default)]
+struct Controls {
+    #[cfg(test)] fail_spawn: Option<usize>,
+    #[cfg(test)] fail_entry: Option<usize>,
+    #[cfg(test)] panic_entry: Option<usize>,
+    #[cfg(test)] shorter_lane: Option<usize>,
+    #[cfg(test)] probe: Option<Arc<Probe>>,
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct Probe { started: std::sync::atomic::AtomicUsize, exited: std::sync::atomic::AtomicUsize }
+
+#[cfg(test)]
+struct ExitProbe(Option<Arc<Probe>>);
+
+#[cfg(test)]
+impl ExitProbe {
+    fn new(probe: Option<Arc<Probe>>) -> Self {
+        if let Some(probe) = &probe { probe.started.fetch_add(1, std::sync::atomic::Ordering::SeqCst); }
+        Self(probe)
+    }
+}
+
+#[cfg(test)]
+impl Drop for ExitProbe {
+    fn drop(&mut self) {
+        if let Some(probe) = &self.0 { probe.exited.fetch_add(1, std::sync::atomic::Ordering::SeqCst); }
+    }
+}
+
+#[cfg(test)]
+mod runner_tests {
+    use super::*;
+    use std::sync::atomic::Ordering;
+    const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+
+    fn invoke(depth: u8, audit: bool, controls: Controls,
+        entry: impl FnOnce() -> Result<(), String>) -> Result<RunReport, String> {
+        let root = Position::from_fen(START).unwrap();
+        run_with(root, SearchHistory::new(&root), Parameters::default(),
+            Config { tts_bytes: 65_536, ..Config::default() }, depth, 17, 50, audit, entry, controls)
+    }
+
+    fn joined(probe: &Probe, expected: usize) {
+        assert_eq!(probe.started.load(Ordering::SeqCst), expected);
+        assert_eq!(probe.exited.load(Ordering::SeqCst), expected);
+    }
+
+    #[test]
+    fn seeded_depth_one_and_two_audits_match_independent_serial_state() {
+        for depth in [1, 2] {
+            let report = invoke(depth, true, Controls::default(), || Ok(())).unwrap();
+            assert!(report.all_replicas_equal && !report.raw_returns.is_empty());
+            assert_eq!(report.audit_final_state_equal, Some(true));
+            assert_eq!(report.pawn_owner_equal, Some(true));
+            assert_eq!(report.epochs, [report.audit_checked_fulls.unwrap() as u64; 3]);
+            assert!(report.epochs[0] > 0 && report.join_ns <= report.search_wall_ns);
+            assert!(report.collective_storage_bytes > 0);
+        }
+    }
+
+    #[test]
+    fn partial_spawn_and_entry_failure_or_panic_join_every_actual_peer() {
+        for role in [1, 2] {
+            for failure in 0..3 {
+                let probe = Arc::new(Probe::default());
+                let mut controls = Controls { probe: Some(Arc::clone(&probe)), ..Controls::default() };
+                match failure { 0 => controls.fail_spawn = Some(role),
+                    1 => controls.fail_entry = Some(role), _ => controls.panic_entry = Some(role) }
+                assert!(invoke(1, false, controls, || Ok(())).is_err());
+                joined(&probe, if failure == 0 { role - 1 } else { 2 });
+            }
+        }
+    }
+
+    #[test]
+    fn entry_callback_error_and_panic_cancel_and_join_both_waiting_peers() {
+        for panic in [false, true] {
+            let probe = Arc::new(Probe::default());
+            let controls = Controls { probe: Some(Arc::clone(&probe)), ..Controls::default() };
+            assert!(invoke(1, false, controls, || {
+                if panic { panic!("controlled placement callback panic"); }
+                Err("controlled placement callback error".into())
+            }).is_err());
+            joined(&probe, 2);
+        }
+    }
+
+    #[test]
+    fn actual_shorter_peer_completion_cancels_divergent_search_and_joins() {
+        let probe = Arc::new(Probe::default());
+        let controls = Controls { shorter_lane: Some(1), probe: Some(Arc::clone(&probe)), ..Controls::default() };
+        assert!(invoke(2, false, controls, || Ok(())).is_err());
+        joined(&probe, 2);
+    }
+}
