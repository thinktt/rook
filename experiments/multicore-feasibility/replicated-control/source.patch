+//! Finite source controls for private replicated actual-search evaluation.
+use super::*;
+use crate::engine::Search;
+use crate::history::SearchHistory;
+use crate::quiescence::Limits;
+use crate::replica_collective::CollectiveControl;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::thread;
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const ENDING: &str = "6k1/5pp1/6p1/3P4/8/2N5/5P2/6K1 w - - 0 40";
+const FIRST: &str = "7k/6P1/1p1pP3/4pP2/8/2p5/4P3/K7 w - - 0 1";
+const COLLISION: &str = "7k/8/2p4P/2p5/7P/1p6/p5PP/K7 w - - 0 1";
+const EMPTY: &str = "7k/8/8/8/8/8/8/K7 w - - 0 1";
+const GROUP_ZERO: &str = "7k/8/8/8/6P1/3P4/8/K7 w - - 0 1";
+
+fn position(fen: &str) -> Position { Position::from_fen(fen).unwrap() }
+
+/// Every spawned body is caught, cancels on panic, and is actually joined. No
+/// test relies on a missing lane eventually receiving a fabricated publication.
+fn lanes<T: Send, F: Fn(ReplicaLane) -> T + Sync>(run: F) -> Vec<T> {
+    let (control, writers) = CollectiveControl::new();
+    let values = thread::scope(|scope| {
+        let handles: Vec<_> = writers.into_iter().map(|lane| {
+            let run = &run;
+            let cancellation = control.clone();
+            scope.spawn(move || {
+                let result = catch_unwind(AssertUnwindSafe(|| run(lane)));
+                if result.is_err() { cancellation.cancel("focused evaluator lane panicked"); }
+                result
+            })
+        }).collect();
+        handles.into_iter().map(|handle| match handle.join() {
+            Ok(Ok(value)) => value,
+            _ => { control.cancel("focused evaluator join failed"); panic!("focused evaluator lane failed"); }
+        }).collect::<Vec<_>>()
+    });
+    assert!(!control.cancelled());
+    let epochs = control.final_epochs();
+    assert_eq!(epochs, [epochs[0]; 3]);
+    values
+}
+
+fn parameters() -> Parameters {
+    Parameters {
+        own: [133, 73, 151, 87, 200, 121, 19, 313, 207, 251, 49],
+        opponent: [91, 128, 67, 142, 80, 57, 183, 47, 333, 107, 229],
+        average_depth: 13, draw: -173, opponent_selectivity: 31,
+    }
+}
+
+fn full_sequence(evaluator: &mut Evaluator<true>) -> Vec<(Evaluation, Retained)> {
+    let mut output = Vec::new();
+    for root in [position(START), position("6k1/5pp1/6p1/3P4/8/2N5/5P2/6K1 b - - 0 40")] {
+        evaluator.parameters = parameters();
+        evaluator.begin_search(&root);
+        for (index, (fen, fresh)) in [
+            (EMPTY, false), (GROUP_ZERO, false), (GROUP_ZERO, false), (EMPTY, false),
+            (FIRST, false), (COLLISION, false), (COLLISION, true), (FIRST, false),
+        ].into_iter().enumerate() {
+            let current = position(fen);
+            let natural = Influence::build(&current);
+            let contrary = Influence { profiles: [[255; 64], [0; 64]] };
+            let map = if index % 2 == 0 { natural } else { contrary };
+            let mut node = Node::root(current, &evaluator.root);
+            node.retained.positional = 731;
+            node.retained.pawn_progress = -193;
+            node.retained.age = 17;
+            evaluator.replica_audit_set_nodes(index as u64);
+            let checked = index % 3 == 0;
+            let evaluation = if fresh {
+                evaluator.fresh_observed(&mut node, &map, checked, |_| {})
+            } else { evaluator.full(&mut node, &map, checked) };
+            output.push((evaluation, node.retained));
+        }
+    }
+    output
+}
+
+#[test]
+fn replicas_match_owner_cache_collisions_resets_fresh_and_authoritative_maps() {
+    assert_eq!(position(FIRST).pawn, position(COLLISION).pawn);
+    assert_eq!(position(GROUP_ZERO).pawn % 128, 0);
+    let root = position(START);
+    let mut serial = Evaluator::<true>::new(&root);
+    serial.replica_audit_record().unwrap();
+    let expected = full_sequence(&mut serial);
+    let trace = Arc::new(serial.replica_audit_take().unwrap());
+    assert_eq!(trace.len(), 16);
+    assert!(Arc::ptr_eq(&trace[0].input.root, &trace[1].input.root));
+    assert_ne!(trace[0].input.root, trace[8].input.root);
+    let values = lanes(|lane| {
+        let role = lane.role();
+        let mut evaluator = Evaluator::<true>::new(&root);
+        evaluator.replica_attach(lane).unwrap();
+        evaluator.replica_audit_compare(Arc::clone(&trace)).unwrap();
+        let actual = full_sequence(&mut evaluator);
+        assert_eq!(evaluator.replica_audit_finish().unwrap(), trace.len());
+        assert_eq!(evaluator.replica_finish().unwrap(), trace.len() as u64);
+        (role, actual, evaluator)
+    });
+    let empty_cache = Evaluator::<true>::new(&root);
+    for (role, actual, evaluator) in values {
+        assert_eq!(actual, expected);
+        assert_eq!(evaluator.stats, serial.stats);
+        if role == 0 { assert!(evaluator.replica_pawns_equal(&serial)); }
+        else { assert!(evaluator.replica_pawns_equal(&empty_cache)); }
+    }
+}
+
+fn compare_outcomes(actual: &crate::ordinary::Outcome, expected: &crate::ordinary::Outcome) {
+    assert_eq!(actual.initial_candidates, expected.initial_candidates);
+    assert_eq!((actual.score, &actual.pv, actual.work, actual.stats, actual.evaluations),
+        (expected.score, &expected.pv, expected.work, expected.stats, expected.evaluations));
+    assert_eq!(actual.iterations.len(), expected.iterations.len());
+    for (a, b) in actual.iterations.iter().zip(&expected.iterations) {
+        assert_eq!((a.depth, &a.candidates, &a.steps, a.score, &a.pv, a.work),
+            (b.depth, &b.candidates, &b.steps, b.score, &b.pv, b.work));
+    }
+}
+
+#[test]
+fn replicas_match_actual_seeded_search_depth_one_and_two_with_root_full_and_work_reset() {
+    for fen in [START, ENDING] {
+        for depth in [1, 2] {
+            let root = position(fen);
+            let mut serial = Search::<true>::new(&root);
+            serial.evaluator.parameters = parameters();
+            serial.evaluator.replica_audit_record().unwrap();
+            let mut history = SearchHistory::new(&root);
+            let mut expected_raw = Vec::new();
+            let expected = serial.run_seeded_iterations(root, &mut history, depth, Limits::default(),
+                0x1234_5678, 19, |score| expected_raw.push(score)).unwrap();
+            let trace = Arc::new(serial.evaluator.replica_audit_take().unwrap());
+            assert!(trace.len() > 1 && trace.len() <= FULL_AUDIT_CAP);
+            assert_eq!(trace[0].input.logical_n, 0);
+            assert_eq!(trace[0].input.stats.full, 0);
+            assert_eq!(trace[1].input.stats.full, 0); // Root work was reset before recursive search.
+            assert!(trace[1].input.logical_n > 0);
+            let values = lanes(|lane| {
+                let role = lane.role();
+                let mut search = Search::<true>::new(&root);
+                search.evaluator.parameters = parameters();
+                search.evaluator.replica_attach(lane).unwrap();
+                search.evaluator.replica_audit_compare(Arc::clone(&trace)).unwrap();
+                let mut history = SearchHistory::new(&root);
+                let mut raw = Vec::new();
+                let outcome = search.run_seeded_iterations(root, &mut history, depth, Limits::default(),
+                    0x1234_5678, 19, |score| raw.push(score)).unwrap();
+                assert_eq!(search.evaluator.replica_audit_finish().unwrap(), trace.len());
+                assert_eq!(search.evaluator.replica_finish().unwrap(), trace.len() as u64);
+                (role, outcome, raw, search)
+            });
+            for (role, actual, raw, search) in values {
+                compare_outcomes(&actual, &expected);
+                assert_eq!(raw, expected_raw);
+                assert_eq!(search.work(), serial.work());
+                if role == 0 { assert!(search.evaluator.replica_pawns_equal(&serial.evaluator)); }
+            }
+        }
+    }
+}
+
+fn one_full_trace(root: &Position) -> Vec<FullAudit> {
+    let mut evaluator = Evaluator::<true>::new(root);
+    evaluator.replica_audit_record().unwrap();
+    let mut node = Node::root(*root, &evaluator.root);
+    evaluator.full(&mut node, &Influence::build(root), false);
+    evaluator.replica_audit_take().unwrap()
+}
+
+#[test]
+fn replica_input_audit_mismatch_cancels_before_any_publication() {
+    let root = position(START);
+    let mut trace = one_full_trace(&root);
+    trace[0].input.influence.profiles[0][0] ^= 1;
+    let (control, [owner, white, black]) = CollectiveControl::new();
+    let mut evaluator = Evaluator::<true>::new(&root);
+    evaluator.replica_attach(owner).unwrap();
+    evaluator.replica_audit_compare(Arc::new(trace)).unwrap();
+    let mut node = Node::root(root, &evaluator.root);
+    assert!(catch_unwind(AssertUnwindSafe(|| evaluator.full(&mut node, &Influence::build(&root), false))).is_err());
+    assert!(control.cancelled());
+    assert_eq!(control.final_epochs(), [0; 3]);
+    drop((white, black));
+}
+
+#[test]
+fn replica_audit_rejects_output_mismatch_incomplete_trace_and_oversized_trace() {
+    let root = position(START);
+    let mut trace = one_full_trace(&root);
+    let original = trace.clone();
+    trace[0].evaluation.score ^= 1;
+    let mut evaluator = Evaluator::<true>::new(&root);
+    evaluator.replica_audit_compare(Arc::new(trace)).unwrap();
+    let mut node = Node::root(root, &evaluator.root);
+    assert!(catch_unwind(AssertUnwindSafe(|| evaluator.full(&mut node, &Influence::build(&root), false))).is_err());
+    let mut evaluator = Evaluator::<true>::new(&root);
+    evaluator.replica_audit_compare(Arc::new(original.clone())).unwrap();
+    assert!(evaluator.replica_audit_finish().is_err());
+    let mut evaluator = Evaluator::<true>::new(&root);
+    assert!(evaluator.replica_audit_compare(Arc::new(vec![original[0].clone(); FULL_AUDIT_CAP + 1])).is_err());
+}
+
+#[test]
+fn replica_attachment_rejects_nested_full_workers_and_second_lane() {
+    let root = position(START);
+    let (control, [owner, white, black]) = CollectiveControl::new();
+    let mut evaluator = Evaluator::<true>::new(&root);
+    evaluator.replica_attach(owner).unwrap();
+    assert!(evaluator.set_threads(1).is_err());
+    assert!(evaluator.set_threads(2).is_err());
+    assert!(evaluator.replica_attach(white).is_err());
+    evaluator.replica_cancel("focused attachment check complete");
+    assert!(control.cancelled());
+    drop(black);
+}
