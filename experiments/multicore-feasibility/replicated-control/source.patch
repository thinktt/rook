@@ -0,0 +1,449 @@
+//! Three unique scalar publishers for private fixed-completion search replicas.
+//! Every actual lane remains active; cancellation, rather than a deadline or a
+//! fabricated publication, releases failed/divergent gathers. No input is shared.
+
+use crate::activity::SideActivity;
+use crate::evaluator::Components;
+use std::cell::UnsafeCell;
+use std::hint::spin_loop;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct OwnerPart {
+    pub(crate) components: Components,
+    pub(crate) pawn_queries: u64,
+    pub(crate) pawn_reused: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct ColorPart {
+    pub(crate) activity: SideActivity,
+    pub(crate) shelter: i32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Contribution {
+    Owner(OwnerPart),
+    Color(ColorPart),
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Gathered {
+    pub(crate) owner: OwnerPart,
+    pub(crate) white: ColorPart,
+    pub(crate) black: ColorPart,
+}
+
+#[derive(Clone, Copy)]
+struct Slot {
+    generation: u64,
+    contribution: Contribution,
+}
+
+#[repr(align(64))]
+struct RoleSlots { parity: [UnsafeCell<Slot>; 2] }
+
+struct Slots { roles: [RoleSlots; 3] }
+
+// One prospective fixed layout, selected before data: different writers own
+// distinct publication/storage regions. Alignment is not a cache diagnosis.
+#[repr(align(64))]
+struct Publication { ready: AtomicU64, finished: AtomicBool }
+
+#[repr(align(64))]
+struct Cancellation(AtomicBool);
+
+// SAFETY: The constructor creates exactly one nonclonable ReplicaLane per role.
+// Only that lane's &mut exchange writes its two concrete initialized cells.
+// Publication g is Release, after all scalar reads from g-1 have ended. A lane
+// may write g only after its complete gather g-1 acquired ALL roles' releases
+// g-1, which retire all reads of g-2 before its parity cell is overwritten.
+//
+// Reader i acquires ready[j]>=g before copying slot[j][g%2]. Writer j can reach
+// g+1, but cannot overwrite that cell at g+2 until it acquires i's publication
+// g+1; i cannot publish g+1 before ending ALL reads of g. Thus the entire scalar
+// Copy read is protected, even if ready[j] is already g+1. Slot generation is
+// checked, epochs never wrap, and no cell reference escapes the read. Cancel,
+// finish, Control clones and Drop never write slots or invent ready epochs.
+// Shared storage lives through every actual lane's Arc, including cancellation
+// and unwind; the caller joins actual threads. No whole-group mutable borrow is
+// formed, and the protocol does not depend on a wall clock or another waiter.
+unsafe impl Sync for Slots {}
+
+struct Shared {
+    slots: Slots,
+    publications: [Publication; 3],
+    cancelled: Cancellation,
+    // Cold failure detail only. Successful exchange never locks a mutex.
+    reason: Mutex<Option<String>>,
+    #[cfg(test)]
+    before_read: [Mutex<TestGate>; 3],
+    #[cfg(test)]
+    gate_wake: std::sync::Condvar,
+}
+
+impl Shared {
+    fn cancel(&self, reason: impl Into<String>) {
+        if self.cancelled.0.load(Ordering::Acquire) { return; }
+        let mut saved = self.reason.lock().unwrap_or_else(|error| error.into_inner());
+        if saved.is_none() { *saved = Some(reason.into()); }
+        // The first stored reason precedes every observation of cancellation.
+        self.cancelled.0.store(true, Ordering::Release);
+    }
+
+    fn failure(&self) -> String {
+        self.reason.lock().unwrap_or_else(|error| error.into_inner()).clone()
+            .unwrap_or_else(|| "replica collective cancelled".into())
+    }
+}
+
+/// Clones can cancel and inspect necessary epochs, but cannot publish a slot.
+#[derive(Clone)]
+pub(crate) struct CollectiveControl {
+    shared: Arc<Shared>,
+}
+
+impl CollectiveControl {
+    pub(crate) fn new() -> (Self, [ReplicaLane; 3]) {
+        assert!(cfg!(panic = "unwind"), "replica collective requires panic=unwind");
+        let shared = Arc::new(Shared {
+            slots: Slots {
+                roles: std::array::from_fn(|role| RoleSlots { parity: std::array::from_fn(|_| UnsafeCell::new(Slot {
+                    generation: 0,
+                    contribution: if role == 0 { Contribution::Owner(OwnerPart::default()) }
+                        else { Contribution::Color(ColorPart::default()) },
+                })) }),
+            },
+            publications: std::array::from_fn(|_| Publication { ready: AtomicU64::new(0), finished: AtomicBool::new(false) }),
+            cancelled: Cancellation(AtomicBool::new(false)),
+            reason: Mutex::new(None),
+            #[cfg(test)]
+            before_read: std::array::from_fn(|_| Mutex::new(TestGate::default())),
+            #[cfg(test)]
+            gate_wake: std::sync::Condvar::new(),
+        });
+        let lanes = std::array::from_fn(|role| ReplicaLane {
+            shared: Arc::clone(&shared), role, generation: 0, finished: false,
+        });
+        (Self { shared }, lanes)
+    }
+
+    pub(crate) fn cancel(&self, reason: impl Into<String>) { self.shared.cancel(reason); }
+
+    pub(crate) fn cancelled(&self) -> bool { self.shared.cancelled.0.load(Ordering::Acquire) }
+
+    /// Cold native storage size; unit-test gates exist only in test builds.
+    pub(crate) fn storage_bytes(&self) -> usize { std::mem::size_of::<Shared>() }
+
+    /// Cold witness after all actual threads have been joined. These are actual
+    /// publications; failed gathers/finish never advance them.
+    pub(crate) fn final_epochs(&self) -> [u64; 3] {
+        self.shared.publications.each_ref().map(|publication| publication.ready.load(Ordering::Acquire))
+    }
+}
+
+/// Unique writer role: deliberately neither Clone nor Copy. Mutable methods
+/// serialize publications and make a returned Gathered completely owned.
+pub(crate) struct ReplicaLane {
+    shared: Arc<Shared>,
+    role: usize,
+    generation: u64,
+    finished: bool,
+}
+
+impl ReplicaLane {
+    pub(crate) fn role(&self) -> usize { self.role }
+
+    pub(crate) fn cancel(&self, reason: impl Into<String>) { self.shared.cancel(reason); }
+
+    pub(crate) fn exchange(&mut self, contribution: Contribution) -> Result<Gathered, String> {
+        if self.shared.cancelled.0.load(Ordering::Acquire) { return Err(self.shared.failure()); }
+        if self.finished { return self.fail("replica exchange after finish"); }
+        match (self.role, contribution) {
+            (0, Contribution::Owner(owner)) if owner.components.activity == 0
+                && owner.components.shelter == 0 && owner.components.tempo == 0 => {},
+            (1 | 2, Contribution::Color(_)) => {},
+            _ => return self.fail("replica contribution has invalid role or owner fields"),
+        }
+        let Some(generation) = self.generation.checked_add(1) else {
+            return self.fail("replica collective epoch exhausted");
+        };
+        // SAFETY: The unique writer completed every read of g-1 before this
+        // call; that gather acquired every g-1 release, retiring g-2 readers.
+        // At g=1/2 the parity cells are initialized and have no older readers.
+        unsafe {
+            self.shared.slots.roles[self.role].parity[(generation & 1) as usize].get()
+                .write(Slot { generation, contribution });
+        }
+        self.shared.publications[self.role].ready.store(generation, Ordering::Release);
+        for peer in 0..3 {
+            loop {
+                if self.shared.cancelled.0.load(Ordering::Acquire) { return Err(self.shared.failure()); }
+                if self.shared.publications[peer].ready.load(Ordering::Acquire) >= generation { break; }
+                if self.shared.publications[peer].finished.load(Ordering::Acquire) {
+                    // Finish follows its last ready release. Recheck after the
+                    // terminal Acquire to avoid diagnosing an older ready read.
+                    if self.shared.publications[peer].ready.load(Ordering::Acquire) < generation {
+                        return self.fail("replica finished before a required collective epoch");
+                    }
+                    break;
+                }
+                spin_loop();
+            }
+        }
+        #[cfg(test)]
+        pause_before_read(&self.shared, self.role);
+        if self.shared.cancelled.0.load(Ordering::Acquire) { return Err(self.shared.failure()); }
+        // SAFETY: Every matching-or-later ready Acquire publishes this exact
+        // parity generation. A peer cannot overwrite it at g+2 before our g+1
+        // publication, which follows the end of every read here. Copy values
+        // contain no references and no input/slot borrow survives this block.
+        let slots: [Slot; 3] = std::array::from_fn(|peer| unsafe {
+            self.shared.slots.roles[peer].parity[(generation & 1) as usize].get().read()
+        });
+        if slots.iter().any(|slot| slot.generation != generation) {
+            return self.fail("replica collective slot generation mismatch");
+        }
+        let [Contribution::Owner(owner), Contribution::Color(white), Contribution::Color(black)] =
+            slots.map(|slot| slot.contribution) else {
+                return self.fail("replica collective slot role mismatch");
+            };
+        self.generation = generation;
+        Ok(Gathered { owner, white, black })
+    }
+
+    pub(crate) fn finish(&mut self) -> Result<u64, String> {
+        if self.finished { return self.fail("replica lane finished twice"); }
+        // This is terminal metadata, not a successful publication. All of this
+        // lane's previous reads ended before the flag; no later cell access is
+        // possible through its API. Peers at this same epoch may still gather.
+        self.finished = true;
+        self.shared.publications[self.role].finished.store(true, Ordering::Release);
+        if self.shared.cancelled.0.load(Ordering::Acquire) { return Err(self.shared.failure()); }
+        if self.shared.publications.iter().any(|publication| publication.ready.load(Ordering::Acquire) > self.generation) {
+            return self.fail("replica terminal epoch diverged");
+        }
+        Ok(self.generation)
+    }
+
+    fn fail<T>(&self, reason: &str) -> Result<T, String> {
+        self.shared.cancel(reason);
+        Err(self.shared.failure())
+    }
+}
+
+impl Drop for ReplicaLane {
+    fn drop(&mut self) {
+        if !self.finished {
+            self.shared.cancel("replica lane dropped without finish");
+            self.shared.publications[self.role].finished.store(true, Ordering::Release);
+        }
+    }
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestGate { blocked: bool, entered: bool }
+
+#[cfg(test)]
+fn pause_before_read(shared: &Shared, role: usize) {
+    let mut gate = shared.before_read[role].lock().unwrap();
+    gate.entered = true;
+    shared.gate_wake.notify_all();
+    while gate.blocked { gate = shared.gate_wake.wait(gate).unwrap(); }
+}
+
+#[cfg(test)]
+mod protocol_tests {
+    use super::*;
+    use std::thread;
+
+    fn part(role: usize, generation: u64) -> Contribution {
+        if role == 0 {
+            Contribution::Owner(OwnerPart {
+                components: Components { material: generation as i32, squares: -(generation as i32), ..Components::default() },
+                pawn_queries: generation, pawn_reused: generation & 1 != 0,
+            })
+        } else {
+            Contribution::Color(ColorPart {
+                activity: SideActivity { piece: generation as i32 * role as i32,
+                    pressure: generation as i32 + role as i32, relation_queries: generation + role as u64 },
+                shelter: -(generation as i32) * role as i32,
+            })
+        }
+    }
+
+    fn expected(generation: u64) -> Gathered {
+        let Contribution::Owner(owner) = part(0, generation) else { unreachable!() };
+        let Contribution::Color(white) = part(1, generation) else { unreachable!() };
+        let Contribution::Color(black) = part(2, generation) else { unreachable!() };
+        Gathered { owner, white, black }
+    }
+
+    fn block(control: &CollectiveControl, role: usize) {
+        *control.shared.before_read[role].lock().unwrap() = TestGate { blocked: true, entered: false };
+    }
+
+    fn entered(control: &CollectiveControl, role: usize) {
+        let mut gate = control.shared.before_read[role].lock().unwrap();
+        while !gate.entered { gate = control.shared.gate_wake.wait(gate).unwrap(); }
+    }
+
+    fn release(control: &CollectiveControl, role: usize) {
+        control.shared.before_read[role].lock().unwrap().blocked = false;
+        control.shared.gate_wake.notify_all();
+    }
+
+    fn ready(control: &CollectiveControl, role: usize, generation: u64) {
+        while control.shared.publications[role].ready.load(Ordering::Acquire) < generation { thread::yield_now(); }
+    }
+
+    #[test]
+    fn unique_roles_gather_typed_values_and_owned_results_survive_reuse() {
+        let (control, lanes) = CollectiveControl::new();
+        assert_eq!(lanes.each_ref().map(ReplicaLane::role), [0, 1, 2]);
+        let threads = lanes.map(|mut lane| thread::spawn(move || {
+            let mut first = None;
+            for generation in 1..=17 {
+                let gathered = lane.exchange(part(lane.role(), generation)).unwrap();
+                assert_eq!(gathered, expected(generation));
+                if first.is_none() { first = Some(gathered); }
+            }
+            assert_eq!(first.unwrap(), expected(1));
+            assert_eq!(lane.finish().unwrap(), 17);
+        }));
+        for handle in threads { handle.join().unwrap(); }
+        assert!(!control.cancelled());
+        assert_eq!(control.final_epochs(), [17; 3]);
+    }
+
+    #[test]
+    fn fast_lanes_one_epoch_ahead_preserve_delayed_reader_parity() {
+        let (control, lanes) = CollectiveControl::new();
+        block(&control, 2);
+        let threads = lanes.map(|mut lane| thread::spawn(move || {
+            for generation in 1..=5 {
+                assert_eq!(lane.exchange(part(lane.role(), generation)).unwrap(), expected(generation));
+            }
+            lane.finish().unwrap();
+        }));
+        entered(&control, 2);
+        ready(&control, 0, 2);
+        ready(&control, 1, 2);
+        assert_eq!(control.final_epochs(), [2, 2, 1]);
+        release(&control, 2);
+        for handle in threads { handle.join().unwrap(); }
+        assert_eq!(control.final_epochs(), [5; 3]);
+        assert!(!control.cancelled());
+    }
+
+    #[test]
+    fn cancellation_while_waiting_never_fabricates_missing_publications() {
+        let (control, [mut owner, white, black]) = CollectiveControl::new();
+        let waiting = thread::spawn(move || owner.exchange(part(0, 1)));
+        ready(&control, 0, 1);
+        let clone = control.clone();
+        clone.cancel("controlled cancellation");
+        assert_eq!(waiting.join().unwrap().unwrap_err(), "controlled cancellation");
+        assert_eq!(control.final_epochs(), [1, 0, 0]);
+        drop((white, black));
+    }
+
+    #[test]
+    fn finished_peer_below_request_and_already_ahead_terminal_are_divergence() {
+        let (control, [mut owner, mut white, black]) = CollectiveControl::new();
+        assert_eq!(owner.finish().unwrap(), 0);
+        assert!(white.exchange(part(1, 1)).is_err());
+        assert!(control.cancelled());
+        assert_eq!(control.final_epochs(), [0, 1, 0]);
+        drop(black);
+
+        let (control, [mut owner, mut white, black]) = CollectiveControl::new();
+        let waiting = thread::spawn(move || white.exchange(part(1, 1)));
+        ready(&control, 1, 1);
+        assert!(owner.finish().is_err());
+        assert!(waiting.join().unwrap().is_err());
+        assert_eq!(control.final_epochs(), [0, 1, 0]);
+        drop(black);
+    }
+
+    #[test]
+    fn finished_peers_at_same_epoch_allow_last_actual_reader() {
+        let (control, [mut owner, mut white, mut black]) = CollectiveControl::new();
+        block(&control, 2);
+        let lagging = thread::spawn(move || {
+            let value = black.exchange(part(2, 1)).unwrap();
+            assert_eq!(black.finish().unwrap(), 1);
+            value
+        });
+        let owner = thread::spawn(move || {
+            assert_eq!(owner.exchange(part(0, 1)).unwrap(), expected(1));
+            owner.finish().unwrap()
+        });
+        let white = thread::spawn(move || {
+            assert_eq!(white.exchange(part(1, 1)).unwrap(), expected(1));
+            white.finish().unwrap()
+        });
+        entered(&control, 2);
+        assert_eq!(owner.join().unwrap(), 1);
+        assert_eq!(white.join().unwrap(), 1);
+        assert!(!control.cancelled());
+        release(&control, 2);
+        assert_eq!(lagging.join().unwrap(), expected(1));
+        assert_eq!(control.final_epochs(), [1; 3]);
+        assert!(!control.cancelled());
+    }
+
+    #[test]
+    fn unfinished_drop_cancels_all_waiters_without_terminal_ready() {
+        let (control, [mut owner, mut white, black]) = CollectiveControl::new();
+        let owner = thread::spawn(move || owner.exchange(part(0, 1)));
+        let white = thread::spawn(move || white.exchange(part(1, 1)));
+        ready(&control, 0, 1);
+        ready(&control, 1, 1);
+        drop(black);
+        assert!(owner.join().unwrap().is_err());
+        assert!(white.join().unwrap().is_err());
+        assert_eq!(control.final_epochs(), [1, 1, 0]);
+    }
+
+    #[test]
+    fn wrong_role_and_nonzero_owner_finish_fields_fail_before_publication() {
+        for invalid_role in 0..3 {
+            let (control, mut lanes) = CollectiveControl::new();
+            let invalid = if invalid_role == 0 { part(1, 1) } else { part(0, 1) };
+            assert!(lanes[invalid_role].exchange(invalid).is_err());
+            assert!(control.cancelled());
+            assert_eq!(control.final_epochs(), [0; 3]);
+        }
+        for field in 0..3 {
+            let (control, [mut owner, _white, _black]) = CollectiveControl::new();
+            let mut components = Components::default();
+            match field { 0 => components.activity = 1, 1 => components.shelter = 1, _ => components.tempo = 1 }
+            assert!(owner.exchange(Contribution::Owner(OwnerPart { components, ..OwnerPart::default() })).is_err());
+            assert_eq!(control.final_epochs(), [0; 3]);
+        }
+    }
+
+    #[test]
+    fn final_epoch_is_published_once_then_overflow_cancels_without_wrap() {
+        let (control, mut lanes) = CollectiveControl::new();
+        // A test-only boundary setup while all unique lanes are local, no
+        // threads/readers exist and both slots are initialized. No ready value
+        // is forged; the first and only actual publication below is MAX.
+        for lane in &mut lanes { lane.generation = u64::MAX - 1; }
+        let barrier = Arc::new(std::sync::Barrier::new(3));
+        let threads = lanes.map(|mut lane| {
+            let barrier = Arc::clone(&barrier);
+            thread::spawn(move || {
+                assert_eq!(lane.exchange(part(lane.role(), 1)).unwrap(), expected(1));
+                barrier.wait();
+                assert!(lane.exchange(part(lane.role(), 2)).is_err());
+            })
+        });
+        for handle in threads { handle.join().unwrap(); }
+        assert!(control.cancelled());
+        assert_eq!(control.final_epochs(), [u64::MAX; 3]);
+    }
+}
