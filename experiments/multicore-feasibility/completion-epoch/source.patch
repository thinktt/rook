+    #[test]
+    fn colors_completion_epoch_two_true_loaders_keep_both_wake_obligations() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = activate(&mut worker);
+        let packet = packet();
+        for side in 0..2 {
+            block(&worker.shared, side);
+            block_at(&worker.shared.tests.after_latch[side]);
+        }
+        block_at(&worker.shared.tests.after_registration);
+        let token = dispatch(&mut worker, &packet);
+        for side in 0..2 { entered(&worker.shared, side); }
+        let shared = Arc::clone(&worker.shared);
+        let waiter = thread::spawn(move || wait_completion(&shared, token.generation));
+        entered_at(&worker.shared, &worker.shared.tests.after_registration);
+        for side in 0..2 {
+            release(&worker.shared, side, false);
