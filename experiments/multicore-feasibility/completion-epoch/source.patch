+    #[test]
+    fn colors_completion_epoch_normal_load_before_and_around_registration_each_reader() {
+        for last in 0..2 {
+            for before_registration in [true, false] {
+                let mut worker = ColorsWorker::start().unwrap();
+                let scope = activate(&mut worker);
+                let packet = packet();
+                for side in 0..2 {
+                    block(&worker.shared, side);
+                    block_at(&worker.shared.tests.after_latch[side]);
+                }
+                let shared = Arc::clone(&worker.shared);
+                let registration = if before_registration {
+                    &shared.tests.before_registration
+                } else {
+                    &shared.tests.after_registration
+                };
+                block_at(registration);
+                let token = dispatch(&mut worker, &packet);
+                for side in 0..2 { entered(&worker.shared, side); }
+                let waiter_shared = Arc::clone(&shared);
+                let waiter = thread::spawn(move || wait_completion(&waiter_shared, token.generation));
+                entered_at(&worker.shared, registration);
+                for side in [1 - last, last] {
+                    release(&worker.shared, side, false);
+                    entered_at(&worker.shared, &worker.shared.tests.after_latch[side]);
+                    assert_eq!(worker.shared.cells.sides[side].done.load(Ordering::Acquire), token.generation);
+                    assert_eq!(worker.shared.tests.normal_notifications[side].load(Ordering::SeqCst), 0);
+                }
+                assert_eq!(worker.shared.latch.waiting.load(Ordering::SeqCst), !before_registration);
+                release_at(&worker.shared, registration, false);
+                waiter.join().unwrap().unwrap();
+                assert!(!worker.shared.latch.waiting.load(Ordering::SeqCst));
+                assert_output(worker.complete().unwrap(), &packet);
+                for side in 0..2 {
+                    release_at(&worker.shared, &worker.shared.tests.after_latch[side], false);
+                    if !before_registration { notified(&worker.shared, side, 1); }
+                }
+                worker.restore_activation(scope).unwrap();
+                for side in 0..2 {
+                    assert_eq!(worker.shared.tests.normal_notifications[side].load(Ordering::SeqCst),
+                        usize::from(!before_registration));
+                }
+                no_flight(&worker);
+                worker.shutdown().unwrap();
+            }
+        }
+    }
