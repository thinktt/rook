+    #[test]
+    fn colors_completion_epoch_owed_normal_wake_survives_exit_and_new_generation() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = activate(&mut worker);
+        let packet = packet();
+        for side in 0..2 {
+            block(&worker.shared, side);
+            block_at(&worker.shared.tests.after_latch[side]);
+        }
+        block_at(&worker.shared.tests.after_registration);
+        let first = dispatch(&mut worker, &packet);
+        for side in 0..2 { entered(&worker.shared, side); }
+        let shared = Arc::clone(&worker.shared);
+        let waiter = thread::spawn(move || wait_completion(&shared, first.generation));
+        entered_at(&worker.shared, &worker.shared.tests.after_registration);
+        for side in 0..2 {
+            release(&worker.shared, side, false);
+            entered_at(&worker.shared, &worker.shared.tests.after_latch[side]);
+        }
+        release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+        waiter.join().unwrap().unwrap();
+        assert!(!worker.shared.latch.waiting.load(Ordering::SeqCst));
+        assert_output(worker.complete().unwrap(), &packet);
+        no_flight(&worker);
+        // Drain the other old wake so only reader zero's saved true load can
+        // wake the next pending epoch. It has no remaining payload access.
+        release_at(&worker.shared, &worker.shared.tests.after_latch[1], false);
+        notified(&worker.shared, 1, 1);
+        assert_eq!(worker.shared.tests.normal_notifications[0].load(Ordering::SeqCst), 0);
+        for side in 0..2 { block(&worker.shared, side); }
+        block_at(&worker.shared.tests.after_registration);
+        let mut next = self::packet();
+        next.material = -193;
+        next.mobility_weights = [0, 10240];
+        let second = dispatch(&mut worker, &next);
+        assert_eq!(second.generation, first.generation + 1);
+        let shared = Arc::clone(&worker.shared);
+        let (sent, received) = mpsc::channel();
+        let waiter = thread::spawn(move || {
+            let result = wait_completion(&shared, second.generation);
+            sent.send(()).unwrap();
+            result
+        });
+        entered_at(&worker.shared, &worker.shared.tests.after_registration);
+        assert!(worker.shared.latch.waiting.load(Ordering::SeqCst));
+        for side in 0..2 {
+            assert_eq!(worker.shared.cells.sides[side].done.load(Ordering::Acquire), first.generation);
+        }
+        release_at(&worker.shared, &worker.shared.tests.after_latch[0], false);
+        release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+        notified(&worker.shared, 0, 1);
+        registered(&worker.shared, 3);
+        assert!(received.try_recv().is_err());
+        assert!(matches!(worker.owner.flight,
+            Flight::Published(metadata) if metadata.generation == second.generation));
+        for side in 0..2 {
+            entered(&worker.shared, side);
+            assert_eq!(worker.shared.cells.sides[side].done.load(Ordering::Acquire), first.generation);
+            release(&worker.shared, side, false);
+        }
+        waiter.join().unwrap().unwrap();
+        received.recv().unwrap();
+        assert_output(worker.complete().unwrap(), &next);
+        worker.restore_activation(scope).unwrap();
+        no_flight(&worker);
+        worker.shutdown().unwrap();
+    }
