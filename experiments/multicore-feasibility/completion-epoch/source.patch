+    #[test]
+    fn colors_completion_epoch_terminal_exchange_preserves_owed_normal_wake() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = activate(&mut worker);
+        for side in 0..2 { block(&worker.shared, side); }
+        block_at(&worker.shared.tests.after_registration);
+        block_at(&worker.shared.tests.after_latch[0]);
+        let token = dispatch(&mut worker, &packet());
+        for side in 0..2 { entered(&worker.shared, side); }
+        let shared = Arc::clone(&worker.shared);
+        let waiter = thread::spawn(move || wait_completion(&shared, token.generation));
+        entered_at(&worker.shared, &worker.shared.tests.after_registration);
+        release(&worker.shared, 0, false);
+        entered_at(&worker.shared, &worker.shared.tests.after_latch[0]);
+        assert!(worker.shared.latch.waiting.load(Ordering::SeqCst));
+        release(&worker.shared, 1, true);
+        wait_state(&worker.shared, 1, FAILED);
+        let failure = worker.failure();
+        assert!(terminal(&worker.shared));
+        while worker.shared.latch.waiting.load(Ordering::SeqCst) { thread::yield_now(); }
+        assert_eq!(worker.shared.tests.normal_notifications[0].load(Ordering::SeqCst), 0);
+        release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+        assert!(waiter.join().unwrap().is_err());
+        assert_eq!(worker.complete().err().unwrap(), failure);
+        assert_eq!(worker.shared.cells.sides[0].done.load(Ordering::Acquire), token.generation);
+        assert_eq!(worker.shared.cells.sides[1].done.load(Ordering::Acquire), 0);
+        assert!(matches!(worker.owner.flight,
+            Flight::Published(metadata) if metadata.generation == token.generation));
+        let shared = Arc::clone(&worker.shared);
+        let (sent, received) = mpsc::channel();
+        let close = thread::spawn(move || {
+            sent.send(worker.restore_activation(scope)).unwrap();
+            worker
+        });
+        closing(&shared);
+        assert!(received.try_recv().is_err());
+        assert_eq!(shared.cells.sides[1].done.load(Ordering::Acquire), 0);
+        assert!(!shared.latch.waiting.load(Ordering::SeqCst));
+        release_at(&shared, &shared.tests.after_latch[0], false);
+        notified(&shared, 0, 1);
+        let mut worker = close.join().unwrap();
+        assert!(received.recv().unwrap().is_err());
+        assert!(worker.owner.drained);
+        assert_eq!(worker.activation_depth(), 0);
+        assert!(worker.threads.iter().all(Option::is_none));
+        assert_eq!(worker.shared.cells.sides[1].done.load(Ordering::Acquire), 0);
+        no_flight(&worker);
+        assert!(worker.shutdown().is_err());
+    }
