+#[test]
+fn q_inventory_checked_reused_and_terminal_ply_keep_original_exclusions() {
+    for replies in [false, true] {
+        let (mut search, mut node, mut history) = input(MATE, true, 3);
+        if replies { movegen::generate_legal(&node.position, &mut search.candidates[1]); }
+        let (value, events, queries) = call(&mut search, &mut node, &mut history,
+            entry(), Some(1), Some(true), replies, false);
+        assert_eq!(value, Ok(-9999));
+        assert_eq!((queries, search.evaluator.stats.full, search.evaluator.stats.fast), (0, 0, 0));
+        assert_eq!(search.stats.reused_reply_lists, u64::from(replies));
+        assert!(events.is_empty());
+    }
+    // Even an unchecked entry carrying reused-list admission cannot prepare.
+    let (mut search, mut node, mut history) = input(PROMOTION, true, 3);
+    let (_, events, queries) = call(&mut search, &mut node, &mut history,
+        entry(), Some(1), Some(false), true, false);
+    assert_eq!((queries, search.evaluator.stats.full), (0, 1));
+    assert!(events.iter().all(|event| !event.prepared));
+    let (mut search, mut node, _) = input(START, true, 3);
+    let mut history = SearchHistory::new(&node.position);
+    // Halfmove0 boundaries isolate terminal-ply dispatch from repetition return.
+    for _ in 0..63 { history.push(&node.position, None); }
+    let (_, events, queries) = call(&mut search, &mut node, &mut history,
+        Entry { ply: 63, target: 63, ..entry() }, Some(1), Some(false), false, false);
+    assert_eq!((queries, search.evaluator.stats.full, search.evaluator.stats.fast), (0, 0, 1));
+    assert!(events.is_empty());
+}
