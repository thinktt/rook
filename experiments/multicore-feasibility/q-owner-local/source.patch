+#[test]
+fn public_selection_stage_observers_and_fresh_full_have_no_q_readiness_queries() {
+    let current = position(START);
+    let mut serial = configured::<true>(&current, 1, false);
+    let mut worker = configured::<true>(&current, 3, true);
+    worker.set_owner_local_inventory(true).unwrap();
+    let probes = readiness_probe_count();
+    with_forced_readiness(false, || {
+        for kind in 0..4 {
+            let mut a = Node::root(current, &serial.root);
+            let mut b = a;
+            let (mut am, mut bm) = (None, None);
+            let (mut av, mut bv) = (Vec::new(), Vec::new());
+            let expected = match kind {
+                0 => serial.select_noncheck(&mut a, -10000, 10000, false, &mut am),
+                1 => serial.select_noncheck_for_search(&mut a, -10000, 10000, false, &mut am, true),
+                2 => serial.select_noncheck_stages_observed(&mut a, -10000, 10000, false, &mut am, |stage| av.push(stage)),
+                _ => serial.select_noncheck_detailed_observed(&mut a, -10000, 10000, false, &mut am, |_| {}, |_| {}),
+            };
+            let actual = match kind {
+                0 => worker.select_noncheck(&mut b, -10000, 10000, false, &mut bm),
+                1 => worker.select_noncheck_for_search(&mut b, -10000, 10000, false, &mut bm, true),
+                2 => worker.select_noncheck_stages_observed(&mut b, -10000, 10000, false, &mut bm, |stage| bv.push(stage)),
+                _ => worker.select_noncheck_detailed_observed(&mut b, -10000, 10000, false, &mut bm, |_| {}, |_| {}),
+            };
+            assert_eq!((actual, b, bm, bv, worker.stats), (expected, a, am, av, serial.stats));
+        }
+        let map = Influence { profiles: [[255; 64], [0; 64]] };
+        for fresh in [false, true] {
+            let mut a = Node::root(current, &serial.root);
+            let mut b = a;
+            let (mut ad, mut bd) = (None, None);
+            let expected = if fresh { serial.fresh_detailed_observed(&mut a, &map, false, |value| ad=Some(value)) }
+                else { serial.full_detailed_observed(&mut a, &map, false, |value| ad=Some(value)) };
+            let actual = if fresh { worker.fresh_detailed_observed(&mut b, &map, false, |value| bd=Some(value)) }
+                else { worker.full_detailed_observed(&mut b, &map, false, |value| bd=Some(value)) };
+            assert_eq!((actual,b,bd,worker.stats),(expected,a,ad,serial.stats));
+        }
+    });
+    assert_eq!(readiness_probe_count(), probes);
+}
