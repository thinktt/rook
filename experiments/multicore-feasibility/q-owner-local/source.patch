+#[test]
+fn q_inventory_fast_only_and_lower_budgets_never_query_or_prepare() {
+    let (mut off, mut a, mut ah) = input(START, false, 3);
+    let (mut on, mut b, mut bh) = input(START, true, 3);
+    let score = off.evaluator.fast(&a, false).score;
+    let fast_only = Entry { lower: score + 250, upper: score + 251, ..entry() };
+    let (expected, _, _) = call(&mut off, &mut a, &mut ah, fast_only, Some(1), Some(false), false, false);
+    let (actual, events, queries) = call(&mut on, &mut b, &mut bh, fast_only, Some(1), Some(false), false, false);
+    assert_eq!(actual, expected);
+    equal_owner(&on, &off, &b, &a);
+    assert_eq!((queries, on.evaluator.stats.full, on.evaluator.stats.influence_builds), (0, 0, 0));
+    assert!(!events[0].initially_full && !events[0].refreshed);
+    assert!(events.iter().all(|event| !event.prepared));
+    for budget in [1, 2] {
+        let (mut search, mut node, mut history) = input(PROMOTION, true, budget);
+        let (_, events, queries) = call(&mut search, &mut node, &mut history,
+            entry(), Some(1), Some(false), false, false);
+        assert_eq!((queries, search.evaluator.stats.full), (0, 1));
+        assert!(events.iter().all(|event| !event.prepared));
+    }
+}
