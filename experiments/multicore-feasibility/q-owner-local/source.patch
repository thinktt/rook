+#[test]
+fn q_inventory_public_root_subtree_and_observed_routes_never_query_or_prepare() {
+    let (mut search, mut node, mut history) = input(PROMOTION, true, 3);
+    let before = readiness_probe_count();
+    let (value, events) = trace(|| with_forced_readiness(false, || search.search_subtree(
+        &mut node, &mut history, entry(), Limits { nodes: Some(1) })));
+    assert_eq!(value.err(), Some(Stopped::NodeLimit(1)));
+    assert_eq!(readiness_probe_count(), before);
+    assert!(events.iter().all(|event| !event.prepared));
+    let before = readiness_probe_count();
+    search.prepare_root(Position::from_fen(PROMOTION).unwrap());
+    assert_eq!(readiness_probe_count(), before);
+    let (mut search, mut node, mut history) = input(PROMOTION, true, 3);
+    search.begin_owned_sequence(Limits { nodes: Some(1) });
+    let scope = search.evaluator.full_worker_scope();
+    let before = readiness_probe_count();
+    let mut observer = Stages::default();
+    let (result, events) = trace(|| with_forced_readiness(false, || search.visit_q_impl(
+        &mut node, &mut history, entry(), Some(false), false, (), &mut observer)));
+    assert_eq!(result, Err(Stopped::NodeLimit(1)));
+    assert_eq!(observer.full, 1);
+    assert_eq!(readiness_probe_count(), before);
+    assert!(events.iter().all(|event| !event.prepared));
+    assert_eq!(history.search_ply(), 1);
+    Evaluator::<true>::finish_full_worker_scope(scope);
+}
