+//! Private Q selector/producer controls. Checked fixtures below test only the
+//! conditional producer domain, never admission through unchecked-Q selection.
+use super::*;
+use crate::colors_worker::{readiness_probe_count, with_forced_readiness};
+use crate::movegen::{self, MoveList};
+use crate::tactical;
+use std::cell::{Cell, RefCell};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const MIDDLE: &str = "r3k2r/ppp2ppp/2npbn2/3qp3/3PP3/2N1BN2/PPP2PPP/R2Q1RK1 b kq - 0 10";
+const ENDING: &str = "6k1/5pp1/6p1/3P4/8/2N5/5P2/6K1 w - - 0 40";
+const PROMOTION: &str = "1r2k3/P7/8/8/8/8/8/4K3 w - - 0 1";
+const JOINED_EP: &str = "7k/8/8/3rP3/8/8/8/K7 w - d6 0 1";
+const EMPTY: &str = "7k/8/8/8/8/8/8/K7 w - - 0 1";
+
+fn position(fen: &str) -> Position { Position::from_fen(fen).unwrap() }
+
+fn configured<const D: bool>(root: &Position, budget: usize, enabled: bool) -> Evaluator<D> {
+    let mut evaluator = Evaluator::new(root);
+    evaluator.set_q_owner_local_inventory(enabled).unwrap();
+    evaluator.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+    evaluator
+}
+
+fn asymmetric() -> Parameters {
+    Parameters {
+        own: [133, 73, 151, 87, 200, 121, 19, 313, 207, 251, 49],
+        opponent: [91, 128, 67, 142, 80, 57, 183, 47, 333, 107, 229],
+        average_depth: 13, draw: -173, opponent_selectivity: 31,
+    }
+}
+
+fn sentinel() -> MoveList {
+    let mut list = MoveList::new();
+    list.push(Move::NONE);
+    list
+}
+
+#[test]
+fn sparse_q_full_prepares_exact_tactical_inventory_and_preserves_native_state() {
+    fn verify<const D: bool>() {
+        for root in [position(START), position(MIDDLE)] {
+            let mut serial = configured::<D>(&root, 1, false);
+            let mut worker = configured::<D>(&root, 3, true);
+            serial.parameters = asymmetric(); worker.parameters = asymmetric();
+            serial.begin_search(&root); worker.begin_search(&root);
+            for fen in [ENDING, PROMOTION, JOINED_EP, EMPTY] {
+                let current = position(fen);
+                assert!(!movegen::in_check(&current, current.side));
+                let mut expected_list = MoveList::new();
+                tactical::generate_for_search(&current, &mut expected_list, true);
+                for supplied in [None, Some(Influence { profiles: [[255; 64], [0; 64]] })] {
+                    let mut a = Node::root(current, &serial.root);
+                    a.retained.positional = 731; a.retained.pawn_progress = -193; a.retained.age = 17;
+                    let mut b = a;
+                    let (mut am, mut bm) = (supplied, supplied);
+                    let expected = serial.select_noncheck_for_search(&mut a, -10000, 10000, false, &mut am, true);
+                    let before = worker.stats;
+                    let probes = readiness_probe_count();
+                    let mut list = sentinel();
+                    let (actual, prepared) = with_forced_readiness(false, || worker.select_noncheck_q_inventory(
+                        &mut b, -10000, 10000, false, &mut bm, true, true, &mut list,
+                    ));
+                    assert_eq!(readiness_probe_count(), probes + 1);
+                    assert!(prepared && actual.initially_full && !actual.refreshed);
+                    assert_eq!(actual.fast_score, None);
+                    assert_eq!(worker.stats.full - before.full, u64::from(D));
+                    assert_eq!(worker.stats.fast, before.fast);
+                    assert_eq!((actual, b, bm, worker.stats), (expected, a, am, serial.stats));
+                    assert_eq!(list.as_slice(), expected_list.as_slice(), "{fen}");
+                    if let Some(map) = supplied { assert_eq!(bm, Some(map)); }
+                }
+            }
+        }
+    }
+    verify::<true>(); verify::<false>();
+}
+
+#[test]
+fn q_refresh_runs_fast_then_one_full_with_supplied_map_root_weights_and_exact_r() {
+    fn verify<const D: bool>() {
+        for root in [position(START), position(MIDDLE)] {
+            let current = position(START);
+            let mut serial = configured::<D>(&root, 1, false);
+            let mut worker = configured::<D>(&root, 3, true);
+            serial.parameters = asymmetric(); worker.parameters = asymmetric();
+            serial.begin_search(&root); worker.begin_search(&root);
+            for map in [Influence::build(&current), Influence { profiles: [[255; 64], [0; 64]] }] {
+                let mut a = Node::root(current, &serial.root);
+                a.retained.positional = -731; a.retained.pawn_progress = 193; a.retained.age = 17;
+                let mut b = a;
+                let (mut am, mut bm) = (Some(map), Some(map));
+                let stages = RefCell::new(Vec::new());
+                let full = Cell::new(None);
+                let fast = Cell::new(None);
+                let expected = serial.select_noncheck_detailed_observed(
+                    &mut a, -10000, 10000, false, &mut am,
+                    |value| { stages.borrow_mut().push("full"); full.set(Some(value)); },
+                    |value| { stages.borrow_mut().push("fast"); fast.set(Some(value)); },
+                );
+                let before = worker.stats;
+                let probes = readiness_probe_count();
+                let mut list = sentinel();
+                let (actual, prepared) = with_forced_readiness(false, || worker.select_noncheck_q_inventory(
+                    &mut b, -10000, 10000, false, &mut bm, true, true, &mut list,
+                ));
+                assert_eq!(readiness_probe_count(), probes + 1);
+                assert!(prepared && !actual.initially_full && actual.refreshed);
+                assert_eq!(*stages.borrow(), vec!["fast", "full"]);
+                assert_eq!(actual.fast_score, Some(fast.get().unwrap().finished.score));
+                assert_eq!(actual.evaluation.score, full.get().unwrap().finished.score);
+                assert_eq!(worker.stats.full - before.full, u64::from(D));
+                assert_eq!(worker.stats.fast - before.fast, u64::from(D));
+                assert_eq!(worker.stats.influence_builds, before.influence_builds);
+                assert_eq!(worker.stats.relation_queries - before.relation_queries, actual.evaluation.relation_queries);
+                assert_eq!((actual, b, bm, worker.stats), (expected, a, am, serial.stats));
+                assert_eq!(bm, Some(map));
+                let mut expected_list = MoveList::new();
+                tactical::generate_for_search(&current, &mut expected_list, true);
+                assert_eq!(list.as_slice(), expected_list.as_slice());
+            }
+        }
+    }
+    verify::<true>(); verify::<false>();
+}
