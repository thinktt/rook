+#[test]
+fn q_strict_fast_only_edges_are_lazy_and_capture_exception_keeps_original_refresh() {
+    let current = position(START);
+    for (alpha, beta, exception, refresh) in [(250,251,false,false),(-251,-250,false,false),(250,251,true,true)] {
+        let mut serial = configured::<true>(&current, 1, false);
+        let mut worker = configured::<true>(&current, 3, true);
+        let mut a = Node::root(current, &serial.root);
+        let mut b = a;
+        let score = serial.fast(&a, false).score;
+        assert_eq!(worker.fast(&b, false).score, score);
+        let before = worker.stats;
+        let retained = b.retained;
+        let (mut am, mut bm) = (None, None);
+        let expected = serial.select_noncheck_for_search(&mut a, score+alpha, score+beta, exception, &mut am, true);
+        let probes = readiness_probe_count();
+        let mut list = sentinel();
+        let (actual, prepared) = with_forced_readiness(false, || worker.select_noncheck_q_inventory(
+            &mut b, score+alpha, score+beta, exception, &mut bm, true, true, &mut list,
+        ));
+        assert_eq!(readiness_probe_count(), probes + usize::from(refresh));
+        assert_eq!(prepared, refresh);
+        assert_eq!(actual.refreshed, refresh);
+        assert_eq!((actual, b, bm, worker.stats), (expected, a, am, serial.stats));
+        if !refresh {
+            assert!(bm.is_none());
+            assert_eq!(list.as_slice(), &[Move::NONE]);
+            assert_eq!(b.retained, retained);
+            assert_eq!(worker.stats.influence_builds, before.influence_builds);
+            assert_eq!(worker.stats.relation_queries, before.relation_queries);
+            assert_eq!(actual.evaluation.relation_queries, 0);
+            assert_eq!(worker.stats.full, before.full);
+        }
+    }
+}
