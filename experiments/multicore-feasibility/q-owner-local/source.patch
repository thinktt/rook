+#[test]
+fn q_inventory_ready_arm_and_fresh_activation_preserve_stop_order_state_and_work() {
+    let (mut off, mut a, mut ah) = input(PROMOTION, false, 3);
+    let (mut on, mut b, mut bh) = input(PROMOTION, true, 3);
+    let (expected, _, _) = call(&mut off, &mut a, &mut ah,
+        entry(), Some(1), Some(false), false, false);
+    let (actual, events, queries) = call(&mut on, &mut b, &mut bh,
+        entry(), Some(1), Some(false), false, false);
+    assert_eq!(actual, Err(Stopped::NodeLimit(1)));
+    assert_eq!(actual, expected);
+    equal_owner(&on, &off, &b, &a);
+    assert_eq!(on.candidates[1].as_slice(), off.candidates[1].as_slice());
+    assert_eq!((queries, on.stats.nodes, on.stats.children), (1, 1, 1));
+    assert!(events[0].prepared && events[1].prepared);
+    let unsorted = direct(&b.position);
+    assert_eq!(unsorted.as_slice().iter().map(ToString::to_string).collect::<Vec<_>>(),
+        vec!["a7a8q".to_string(), "a7b8q".to_string()]);
+    assert_eq!(on.candidates[1].moves[0].to_string(), "a7b8q");
+    // Reuse the actual owner/node/history. This activation must start false;
+    // a ready hint cannot inherit the previous activation's prepared row.
+    let (expected, _, _) = call(&mut off, &mut a, &mut ah,
+        entry(), Some(1), Some(false), false, true);
+    let (actual, events, queries) = call(&mut on, &mut b, &mut bh,
+        entry(), Some(1), Some(false), false, true);
+    assert_eq!(actual, expected);
+    equal_owner(&on, &off, &b, &a);
+    assert_eq!(on.candidates[1].as_slice(), off.candidates[1].as_slice());
+    assert_eq!(queries, 1);
+    assert!(events.iter().all(|event| !event.prepared));
+    assert_eq!(events[1].moves, unsorted.as_slice());
+}
