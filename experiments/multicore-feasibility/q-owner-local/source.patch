+//! Actual Q caller controls; all snapshots/probes are absent from production.
+use super::*;
+use crate::colors_worker::{readiness_probe_count, with_forced_readiness};
+use std::cell::RefCell;
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const PROMOTION: &str = "1r5k/P7/8/8/8/8/8/7K w - - 0 1";
+const JOINED_EP: &str = "7k/8/8/3Pr3/8/8/8/K7 w - e6 0 1";
+const MATE: &str = "7k/6Q1/5K2/8/8/8/8/8 b - - 0 1";
+
+#[derive(Clone, Debug)]
+struct Event {
+    demand: bool,
+    prepared: bool,
+    moves: Vec<Move>,
+    initially_full: bool,
+    refreshed: bool,
+    generated_before: u64,
+}
+thread_local! {
+    static TRACE: RefCell<Option<Vec<Event>>> = const { RefCell::new(None) };
+}
+
+pub(super) fn record_selection(ply: usize, prepared: bool, list: &MoveList,
+    initially_full: bool, refreshed: bool)
+{
+    if ply != 1 { return; }
+    TRACE.with(|cell| {
+        if let Some(events) = cell.borrow_mut().as_mut() {
+            events.push(Event { demand: false, prepared,
+                moves: if prepared { list.as_slice().to_vec() } else { Vec::new() },
+                initially_full, refreshed, generated_before: 0 });
+        }
+    });
+}
+
+pub(super) fn record_demand(ply: usize, prepared: bool, list: &MoveList,
+    generated_before: u64)
+{
+    if ply != 1 { return; }
+    TRACE.with(|cell| {
+        if let Some(events) = cell.borrow_mut().as_mut() {
+            events.push(Event { demand: true, prepared, moves: list.as_slice().to_vec(),
+                initially_full: false, refreshed: false, generated_before });
+        }
+    });
+}
+
+fn trace<R>(f: impl FnOnce() -> R) -> (R, Vec<Event>) {
+    struct Clear;
+    impl Drop for Clear {
+        fn drop(&mut self) { TRACE.with(|cell| { cell.borrow_mut().take(); }); }
+    }
+    TRACE.with(|cell| {
+        assert!(cell.borrow().is_none());
+        *cell.borrow_mut() = Some(Vec::new());
+    });
+    let _clear = Clear;
+    let value = f();
+    let events = TRACE.with(|cell| cell.borrow_mut().take().unwrap());
+    (value, events)
+}
+
+fn input(fen: &str, enabled: bool, budget: usize)
+    -> (Quiescence<true>, Node, SearchHistory)
+{
+    let position = Position::from_fen(fen).unwrap();
+    position.validate().unwrap();
+    let previous = position.null_child();
+    let mut search = Quiescence::<true>::new(&position);
+    search.config.tts_bytes = 65536;
+    search.evaluator.set_threads(budget).unwrap();
+    assert_eq!(search.evaluator.configured_threads(), budget);
+    search.evaluator.set_owner_local_inventory(true).unwrap();
+    search.evaluator.set_q_owner_local_inventory(enabled).unwrap();
+    search.bind_geometry_permission(&position);
+    let (node, _) = search.prepare_root_with_influence(position);
+    let mut history = SearchHistory::new(&previous);
+    history.push(&position, None);
+    (search, node, history)
+}
+
+fn entry() -> Entry {
+    Entry { ply: 1, target: 1, iteration_depth: 1, lower: -10000, upper: 10000,
+        analysis: 0, capture_exception: false }
+}
+
+fn call(search: &mut Quiescence<true>, node: &mut Node, history: &mut SearchHistory,
+    entry: Entry, limit: Option<u64>, checked: Option<bool>, replies: bool, ready: bool)
+    -> (Result<i32, Stopped>, Vec<Event>, usize)
+{
+    search.begin_owned_sequence(Limits { nodes: limit });
+    let scope = search.evaluator.full_worker_scope();
+    let before = readiness_probe_count();
+    let (value, events) = trace(|| with_forced_readiness(ready, ||
+        search.visit_q(node, history, entry, checked, replies)));
+    let probes = readiness_probe_count() - before;
+    assert_eq!(history.search_ply(), entry.ply);
+    Evaluator::<true>::finish_full_worker_scope(scope);
+    (value, events, probes)
+}
+
+fn equal_owner(a: &Quiescence<true>, b: &Quiescence<true>, na: &Node, nb: &Node) {
+    assert_eq!(na, nb);
+    assert_eq!(a.work(), b.work());
+    assert_eq!(a.stats, b.stats);
+    assert_eq!(a.evaluator.stats, b.evaluator.stats);
+    assert_eq!(a.learning.history, b.learning.history);
+    assert_eq!(a.learning.killers, b.learning.killers);
+    assert_eq!(a.learning.total, b.learning.total);
+    assert_eq!(&a.pv[1][..a.pv_len[1]], &b.pv[1][..b.pv_len[1]]);
+}
+
+fn direct(position: &Position) -> MoveList {
+    let mut list = MoveList::new();
+    tactical::generate_for_search(position, &mut list, true);
+    list
+}
