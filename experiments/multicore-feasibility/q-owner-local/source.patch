+#[derive(Default)]
+struct Stages { full: usize }
+impl Observer for Stages {
+    const ENABLED: bool = true;
+    type Parent = ();
+    type Frame = ();
+    fn parent(_: &Retained) {}
+    fn enter(&mut self, _: &Position, _: Entry, _: Option<Move>, _: (), _: Retained,
+        _: bool, _: Work) {}
+    fn stage(&mut self, stage: EvaluationStage) {
+        self.full += usize::from(stage.kind == crate::evaluator::StageKind::Full);
+    }
+    fn ordered(&mut self) {}
+    fn leave(&mut self, _: (), _: Retained, _: i32, _: &[Move], _: Work) {}
+}
