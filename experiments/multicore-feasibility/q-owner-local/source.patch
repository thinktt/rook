+#[test]
+fn q_ready_and_excluded_flag_allow_coherence_or_mode_paths_leave_row_untouched() {
+    let current = position(ENDING);
+    let map = Influence { profiles: [[255; 64], [0; 64]] };
+    for (budget, enabled, coherent, allow, ready, queries) in [
+        (3,true,true,true,true,1), (1,true,true,true,false,0), (2,true,true,true,false,0),
+        (3,false,true,true,false,0), (3,true,false,true,false,0), (3,true,true,false,false,0),
+    ] {
+        let mut serial = configured::<true>(&current, 1, false);
+        let mut worker = configured::<true>(&current, budget, enabled);
+        worker.set_owner_local_inventory(true).unwrap(); // Ordinary-on must not enable Q.
+        let mut a = Node::root(current, &serial.root);
+        let mut b = a;
+        let (mut am, mut bm) = (Some(map), Some(map));
+        let expected = serial.select_noncheck(&mut a, -10000, 10000, false, &mut am);
+        let mut list = sentinel();
+        let probes = readiness_probe_count();
+        let (actual, prepared) = with_forced_readiness(ready, || worker.select_noncheck_q_inventory(
+            &mut b, -10000, 10000, false, &mut bm, coherent, allow, &mut list,
+        ));
+        assert_eq!(readiness_probe_count(), probes + queries);
+        assert!(!prepared);
+        assert_eq!(list.as_slice(), &[Move::NONE]);
+        assert_eq!((actual, b, bm, worker.stats), (expected, a, am, serial.stats));
+    }
+}
