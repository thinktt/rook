+#[test]
+fn q_inventory_static_return_discards_actual_preparation_without_generation_charge() {
+    let (mut off, mut a, mut ah) = input(PROMOTION, false, 3);
+    let (mut on, mut b, mut bh) = input(PROMOTION, true, 3);
+    let narrow = Entry { upper: -9999, ..entry() };
+    let (expected, _, _) = call(&mut off, &mut a, &mut ah, narrow, None, Some(false), false, false);
+    let (actual, events, queries) = call(&mut on, &mut b, &mut bh, narrow, None, Some(false), false, false);
+    assert!(actual.is_ok());
+    assert_eq!(actual, expected);
+    equal_owner(&on, &off, &b, &a);
+    assert_eq!((on.stats.nodes, on.stats.generated, on.stats.children), (1, 0, 0));
+    assert_eq!(queries, 1);
+    assert_eq!(events.len(), 1);
+    assert!(!events[0].demand && events[0].prepared && !events[0].moves.is_empty());
+}
