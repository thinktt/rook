+#[test]
+fn q_inventory_actual_sparse_refresh_and_special_rows_match_original_unsorted_demand() {
+    for (fen, sparse) in [(PROMOTION, true), (JOINED_EP, true), (START, false)] {
+        let (mut off, mut a, mut ah) = input(fen, false, 3);
+        let (mut on, mut b, mut bh) = input(fen, true, 3);
+        assert!(!movegen::in_check(&a.position, a.position.side));
+        let native = direct(&a.position);
+        let (expected, off_events, off_queries) = call(&mut off, &mut a, &mut ah,
+            entry(), Some(1), Some(false), false, false);
+        let (actual, events, queries) = call(&mut on, &mut b, &mut bh,
+            entry(), Some(1), Some(false), false, false);
+        assert_eq!(actual, expected);
+        equal_owner(&on, &off, &b, &a);
+        assert_eq!(on.candidates[1].as_slice(), off.candidates[1].as_slice());
+        assert_eq!((off_queries, queries), (0, 1));
+        assert_eq!((events.len(), off_events.len()), (2, 2));
+        assert!(!events[0].demand && events[0].prepared);
+        assert_eq!((events[0].initially_full, events[0].refreshed), (sparse, !sparse));
+        assert!(events[1].demand && events[1].prepared);
+        assert_eq!(events[0].moves, native.as_slice());
+        assert_eq!(events[1].moves, native.as_slice());
+        assert_eq!(events[1].moves, off_events[1].moves);
+        assert_eq!(events[1].generated_before, 0);
+        assert_eq!(on.stats.generated, native.len as u64);
+        if fen == PROMOTION {
+            assert!(native.as_slice().iter().all(|m| matches!(m.kind(), MoveKind::Promotion(_))));
+        } else if fen == JOINED_EP {
+            assert_eq!(native.len, 1);
+            assert_eq!(native.moves[0].kind(), MoveKind::EnPassant);
+        } else {
+            assert_eq!(native.len, 0);
+        }
+    }
+}
