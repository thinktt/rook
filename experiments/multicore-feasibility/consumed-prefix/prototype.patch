+/// Counts duplicates explicitly and allocates no heap storage. The complete
+/// native sort remains the order owner; this only certifies its inventory.
+fn same_multiset(a: &[Move], b: &[Move]) -> bool {
+    if a.len() != b.len() || a.len() > MOVE_CAPACITY { return false; }
+    let mut used = [false; MOVE_CAPACITY];
+    for movement in a {
+        let Some(index) = b.iter().enumerate().position(|(index, other)|
+            !used[index] && movement == other) else { return false; };
+        used[index] = true;
+    }
+    true
+}
