+        write!(out,",\"annotation_ns\":{},\"difference_audit_ns\":{},\"pairs\":[",self.annotation_ns,self.difference_audit_ns).unwrap();
+        for (i,p) in self.pairs.iter().enumerate(){if i>0{out.push(',');}write!(out,"{{\"turn\":{},\"execution_order\":[\"{}\",\"{}\"],\"same_input_state\":{},\"same_input_epoch\":{},\"same_input_history\":{},\"shared_data_identical\":{},\"shared_forest_id\":{},\"shared_oracle_id\":{},\"comparison_clone_ns\":{},\"comparison_clone_bytes\":{},\"input_compare_ns\":{},\"annotation_ns\":{},\"consumers\":{},\"variants\":[",p.turn,p.execution_order[0],p.execution_order[1],p.same_input_state,p.same_input_epoch,p.same_input_history,p.shared_data_identical,p.shared_forest_id,p.shared_oracle_id,p.comparison_clone_ns,p.comparison_clone_bytes,p.input_compare_ns,p.annotation_ns,p.consumers.json()).unwrap();
+            for (j,v) in p.variants.iter().enumerate(){if j>0{out.push(',');}write!(out,"{{\"policy\":\"{}\",\"core\":{}}}",v.policy,v.core.json()).unwrap();}write!(out,"],\"common_snapshot_bytes\":{},\"common_timings\":{},\"differences\":{}}}",p.common_snapshot_bytes,p.common_timings.json(),p.differences.json()).unwrap();}
+        out.push_str("],\"mode_totals\":[");
+        for (i,policy) in ["complete-order","consumed-prefix"].iter().enumerate(){if i>0{out.push(',');}let(mut n,mut r,mut cn,mut cr,mut fnodes,mut fr)=(0,0,0,0,0,0);let mut costs=Costs::default();for p in &self.pairs{for v in &p.variants{if v.policy==*policy{let c=&v.core;n+=c.canonical_nodes;r+=c.canonical_relations;cn+=c.committed_nodes;cr+=c.committed_relations;fnodes+=c.fallback_nodes;fr+=c.fallback_relations;costs.add(&c.timings);}}}write!(out,"{{\"policy\":\"{}\",\"canonical_nodes\":{},\"canonical_relations\":{},\"committed_nodes\":{},\"committed_relations\":{},\"fallback_nodes\":{},\"fallback_relations\":{},\"timings\":{}}}",policy,n,r,cn,cr,fnodes,fr,costs.json()).unwrap();}
+        out.push_str("],\"scope\":\"Serial paired semantic-certificate experiment; no speedup claim. Common speculative forest and independent canonical oracle are shared immutable Rc data, not repeated executions. Per-mode input Search/history copies are comparison-only audit costs, not real executor snapshots. common_timings records shared physical phases once; each standalone policy would pay those shared executor phases, and consumed-prefix additionally pays annotation_ns. Arm Costs contain only mode-specific execution/audits. Prefix derives owned examined credit after all immediate charged callees, includes frontier-skipped positions, and falls back to complete inventory when proof is unavailable. k==len is full consumption, never a suffix witness. Consumer eligible N/R sums are nested record-population sums, not disjoint work. Rejected-sort observation capture and first rejected MAIN sort classification are audit-only, does not establish later certificate validity. Gross new maximal ranges use canonical oracle subtree identities and may contain old accepted descendants; newly_covered removes old canonical coverage and net_committed is signed total difference. Oracle gross costs include hooks, not clean CPU saved. Output/counter audits plus root-final shared-state equality retain the known transient-overwritten-write assurance limit. Old flat0/36 and closed hierarchical artifacts remain unchanged.\"}");out
