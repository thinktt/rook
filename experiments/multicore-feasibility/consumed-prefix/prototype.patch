+    #[test]
+    fn complete_prefix_ranges_survive_later_overflow_and_zero_cap_is_censored() {
+        let sink = Sink::new(2);
+        let start = sink.cursor();
+        sink.record(Event::LearningClearNext { ply: 1 });
+        let child_end = sink.cursor();
+        sink.record(Event::LearningClearNext { ply: 2 });
+        sink.record(Event::LearningClearNext { ply: 3 });
+        let ancestor_end = sink.cursor();
+        let log = sink.take();
+        assert!(log.overflowed);
+        assert_eq!(log.range(start, child_end), Some(0..1));
+        assert_eq!(log.range(start, ancestor_end), None);
+        assert_eq!(log.range(ancestor_end, ancestor_end), None);
+        let base = RememberedTable::with_groups(2);
+        let mut stage = SparseStage::new(1);
+        stage.begin(&base);
+        let mut learning = Learning::default();
+        learning.killers[2][0] = Move(17);
+        let mut pawns = PawnCache::new();
+        let result = log.replay_range(&root(), log.range(start, child_end).unwrap(),
+            &base, &mut stage, &mut learning, &mut pawns);
+        assert!(result.accepted());
+        assert_eq!(result.counts.learning_clears, 1);
+        assert_eq!(learning.killers[2], [Move::NONE; 2]);
+        let zero = Sink::new(0);
+        let start = zero.cursor();
+        zero.record(Event::LearningClearNext { ply: 0 });
+        let end = zero.cursor();
+        assert_eq!(zero.take().range(start, end), None);
+    }
+
+    #[test]
+    fn byte_cap_prices_capacity_and_payload_and_seals_retained_prefix() {
+        let capacity_bytes = std::mem::size_of::<Log>() + 8 * std::mem::size_of::<Event>();
+        let sink = Sink::bounded(8, capacity_bytes);
+        let start = sink.cursor();
+        sink.record(Event::LearningClearNext { ply: 0 });
+        let first_end = sink.cursor();
+        let position = Position::from_fen("4k3/8/8/8/8/8/8/4K3 w - - 0 1").unwrap();
+        sink.record(Event::OrderQ { position, input: vec![Move(17); 16],
+            expected: vec![Move(17); 16] });
+        // This payload-free event would fit, but loss already sealed the prefix.
+        sink.record(Event::LearningClearNext { ply: 1 });
+        let end = sink.cursor();
+        let log = sink.take();
+        assert!(log.overflowed && log.byte_overflowed && !log.event_overflowed);
+        assert_eq!(log.events.len(), 1);
+        assert_eq!(log.attempted, 3);
+        assert!(log.estimated_bytes() <= capacity_bytes);
+        assert_eq!(log.range(start, first_end), Some(0..1));
+        assert_eq!(log.range(start, end), None);
+        sink.record(Event::LearningClearNext { ply: 0 });
+        assert_eq!(sink.take().events.len(), 1, "take retains the same byte limit");
+        let insufficient_capacity = Sink::bounded(8,
+            std::mem::size_of::<Log>() + std::mem::size_of::<Event>());
+        insufficient_capacity.record(Event::LearningClearNext { ply: 0 });
+        let capped = insufficient_capacity.take();
+        assert!(capped.byte_overflowed);
+        assert_eq!(capped.events.len(), 0, "unused Event capacity is charged too");
+    }
