+        // A finalized missing child output/range invalidates ancestor coverage too.
+        for id in (0..segments.len()).rev(){let complete=segments[id].coverage_complete&&segments[id].output.is_some()&&segments[id].range.is_some();if !complete{if let Some(parent)=segments[id].direct_parent{segments[parent].coverage_complete=false;}}}
