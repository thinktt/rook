+    pub max_segments:usize,pub max_recorded_nodes:u64,pub max_forest_bytes:usize,pub max_touched_groups:usize,pub oracle_trace_cap:usize}
+impl Default for Caps {fn default()->Self {Self{max_depth:6,max_tail_candidates:8,queue_depth:2,log_events:524288,
+    max_segments:131072,max_recorded_nodes:262144,max_forest_bytes:536870912,max_touched_groups:131072,oracle_trace_cap:131072}}}
