+fn stat_delta(a:Stats,b:Stats)->Stats {stats_fields!(difference,a,b)}
+fn stat_add(a:Stats,b:Stats)->Stats {stats_fields!(addition,a,b)}
+fn eval_delta(a:EvalStats,b:EvalStats)->EvalStats {difference!(a,b;full,fast,influence_builds,pawn_reuses,pawn_replacements,relation_queries)}
+fn eval_add(a:EvalStats,b:EvalStats)->EvalStats {addition!(a,b;full,fast,influence_builds,pawn_reuses,pawn_replacements,relation_queries)}
