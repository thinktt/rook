+//! Paired certificate discriminator. Numerical search and matching are unchanged.
+use std::fmt::Write;
+use crate::{hierarchical_recovery::{self as h,Costs,Candidate,ConsumerSummary},position::Position,history::SearchHistory,evaluator::Parameters,engine::Config};
+
+#[derive(Clone,Debug)]
+pub struct Variant {pub policy:&'static str,pub core:Candidate}
+#[derive(Clone,Debug,Default)]
+pub struct Differences {pub gross_new_maximal_nodes:u64,pub gross_new_maximal_relations:u64,pub gross_new_maximal_ranges:u64,pub net_committed_nodes:i128,pub net_committed_relations:i128,pub newly_covered_nodes:u64,pub newly_covered_relations:u64,pub gross_new_oracle_gross_ns:u128,pub gross_new_oracle_hooks_ns:u128,pub net_oracle_gross_ns:i128,pub net_oracle_hooks_ns:i128}
+impl Differences {
+    pub(crate) fn between(complete:&h::Metrics,prefix:&h::Metrics)->Self {
+        let mut d=Self{net_committed_nodes:prefix.committed_nodes as i128-complete.committed_nodes as i128,net_committed_relations:prefix.committed_relations as i128-complete.committed_relations as i128,net_oracle_gross_ns:prefix.accepted_oracle_gross_ns as i128-complete.accepted_oracle_gross_ns as i128,net_oracle_hooks_ns:prefix.accepted_oracle_descendant_hooks_ns as i128-complete.accepted_oracle_descendant_hooks_ns as i128,..Self::default()};
+        for (i,p) in prefix.committed_ranges.iter().enumerate(){let (start,end)=(p[5],p[5]+p[2]);
+            if !complete.committed_ranges.iter().any(|c|c[5]==start&&c[2]==p[2]){d.gross_new_maximal_ranges+=1;d.gross_new_maximal_nodes+=p[2];d.gross_new_maximal_relations+=p[3];d.gross_new_oracle_gross_ns+=prefix.committed_range_oracle_costs[i][0];d.gross_new_oracle_hooks_ns+=prefix.committed_range_oracle_costs[i][1];}
+            if complete.committed_ranges.iter().any(|c|c[5]<=start&&c[5]+c[2]>=end){continue;}
+            let mut n=p[2];let mut r=p[3];for c in &complete.committed_ranges {if start<=c[5]&&c[5]+c[2]<=end{n=n.checked_sub(c[2]).expect("disjoint canonical node coverage");r=r.checked_sub(c[3]).expect("disjoint canonical relation coverage");}else{assert!(c[5]+c[2]<=start||end<=c[5],"oracle subtree ranges must be laminar");}}
+            d.newly_covered_nodes+=n;d.newly_covered_relations+=r;
+        }d
+    }
