+    fn install<const D:bool,H:Host>(&self,search:&mut Search<D,H>,node:&mut Node,ply:usize) {search.stats=stat_add(search.stats,self.stats);search.evaluator.stats=eval_add(search.evaluator.stats,self.evaluations);node.retained=self.retained;search.pv[ply][..self.pv_len].copy_from_slice(&self.pv[..self.pv_len]);search.pv_len[ply]=self.pv_len;}
