+        let mut out=self.common.json();let at=out.find(",\"candidates\":").unwrap();out.truncate(at);
+        for key in ["committed_nodes","committed_relations","fallback_nodes","fallback_relations"]{out=out.replacen(&format!(",\"{key}\":0"),"",1);}
