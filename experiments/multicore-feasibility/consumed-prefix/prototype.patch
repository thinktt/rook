+
+impl ReplayTable for SparseReplay<'_> {
+    fn probe(&mut self, query: Query) -> Result<ProbeResult, RejectionKind> {
+        self.stage.probe(self.base, query).map_err(stage_rejection)
+    }
+    fn store(&mut self, store: Store) -> Result<(), RejectionKind> {
+        self.stage.store(self.base, store).map_err(stage_rejection)
