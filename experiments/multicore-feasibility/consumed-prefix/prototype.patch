+#[derive(Clone,Debug)]
+pub struct Pair {pub turn:usize,pub execution_order:[&'static str;2],pub same_input_state:bool,pub same_input_epoch:bool,pub same_input_history:bool,pub shared_data_identical:bool,pub shared_forest_id:usize,pub shared_oracle_id:usize,pub comparison_clone_ns:u128,pub comparison_clone_bytes:usize,pub input_compare_ns:u128,pub annotation_ns:u128,pub consumers:ConsumerSummary,pub common_snapshot_bytes:usize,pub common_timings:Costs,pub variants:Vec<Variant>,pub differences:Differences}
