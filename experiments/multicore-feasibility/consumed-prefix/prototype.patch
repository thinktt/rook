+                Call::Ordinary(o)=>{
+                    if !segment.coverage_complete {"incomplete-child-coverage"}
+                    else if let (Some(output),Some(range))=(&segment.output,&segment.range) {
+                        if output.stats.nodes.checked_sub(segment.child_nodes)!=Some(1){"owned-node-credit"}
+                        else if let Some(k)=output.stats.examined.checked_sub(segment.child_examined) {
+                            let mut owned=None;let mut count=0;
+                            for at in range.clone(){if let Event::OrderMain{position,ply,..}=&log.events[at]{if *ply==o.ply&&*position==segment.key.node.position{owned=Some(at);count+=1;}}}
+                            if count!=1 {"owned-sort-count"} else {
+                                match &mut log.events[owned.unwrap()] {
+                                    Event::OrderMain{input,expected,proven_prefix,..}=>{
+                                        if input.len()!=expected.len(){"inventory-length"}
+                                        else if k==0||k>input.len() as u64 {"prefix-bounds"}
+                                        else {*proven_prefix=Some(k as usize);segment.consumer=Some((k as usize,input.len()));result.eligible+=1;
+                                            if k as usize==input.len(){result.fully_consumed+=1;}else{result.proper_prefix+=1;}
+                                            result.eligible_nodes+=output.stats.nodes;result.eligible_relations+=output.evaluations.relation_queries;
+                                            result.prefix_length_bins[bin(k)]+=1;result.inventory_length_bins[bin(input.len() as u64)]+=1;"eligible"}
+                                    },_=>unreachable!(),
+                                }
+                            }
+                        } else {"examined-credit"}
+                    } else {"missing-output-range"}
+                }
+            };result.note(reason);
+        }
+        result
+    }
