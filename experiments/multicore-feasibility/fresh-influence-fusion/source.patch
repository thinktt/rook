+#[cfg(test)]
+mod row_tests {
+    use super::*;
+
+    fn compare(position: &Position, row: &mut [u8; 64]) {
+        position.validate().unwrap();
+        let scalar = Influence::build(position);
+        assert_eq!(build(position), scalar);
+        for side in [Color::White, Color::Black] {
+            build_row(position, side, row);
+            assert_eq!(*row, scalar.profiles[side.index()]);
+        }
+    }
+
+    #[test]
+    fn native_rows_match_scalar_with_mixed_routes_and_reused_destination() {
+        let mut row = [0xa5; 64];
+        for fen in [
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+            "7k/8/8/8/8/8/4P3/K7 w - - 0 1",
+            "7k/8/3n4/2B5/3R4/8/8/K7 w - - 0 1",
+            "r3k2r/pp1n1p2/2b1q1p1/3pP3/2BN1P2/1Q3N2/PP4PP/R3K2R w KQkq - 0 1",
+            "6k1/8/8/8/Q1Q1Q3/8/8/K7 w - - 0 1",
+        ] {
+            compare(&Position::from_fen(fen).unwrap(), &mut row);
+        }
+    }
+
+    #[test]
+    fn native_row_wrapping_and_source_multiplicity_survive_extraction() {
+        let mut row = [255; 64];
+        for (fen, expected) in [
+            ("7k/8/3N1N2/2N3N1/8/2NP1PN1/3N1N2/K7 w - - 0 1", 0),
+            ("B6k/8/3N1N2/2N3N1/8/2NP1PN1/3N1N2/K7 w - - 0 1", 16),
+        ] {
+            let position = Position::from_fen(fen).unwrap();
+            compare(&position, &mut row);
+            build_row(&position, Color::White, &mut row);
+            assert_eq!(row[crate::types::Square::parse("e4").unwrap().0 as usize], expected);
+            let mut chronology = position;
+            for side in 0..2 {
+                let mut begin = 0;
+                for count in chronology.counts[side] {
+                    let end = begin + usize::from(count);
+                    chronology.squares[side][begin..end].reverse();
+                    begin = end;
+                }
+            }
+            compare(&chronology, &mut row);
+            assert_eq!(build(&chronology), build(&position));
+        }
+    }
