+    }
+
+    #[test]
+    fn fresh_unpublished_failure_and_undelivered_shutdown_do_not_invent_done() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = worker.start_active_scope().unwrap();
+        let packet = packet();
+        worker.shared.tests.fail_before_publish.store(true, Ordering::SeqCst);
+        assert!(worker.dispatch_fresh(&packet.position, packet.material,
+            packet.mobility_weights, packet.shelter_weights).is_err());
+        assert_eq!(worker.shared.request.load(Ordering::Acquire), 0);
+        assert_eq!(worker.fusion_epochs(), [0, 0]);
+        no_flight(&worker.shared);
+        block_at(&worker.shared.tests.row_input[1]);
+        let token = fresh_dispatch(&mut worker, &packet);
+        entered_at(&worker.shared, &worker.shared.tests.row_input[1]);
+        wait_row(&worker.shared, 0, token.generation);
+        let shared = Arc::clone(&worker.shared);
+        let (sent, received) = mpsc::channel();
+        let shutdown = thread::spawn(move || {
+            worker.shutdown().unwrap();
+            sent.send(()).unwrap();
+            worker
+        });
+        wait_state(&shared, 0, STOPPED);
+        assert!(received.try_recv().is_err());
+        assert_eq!(shared.readers[1].done.load(Ordering::Acquire), 0);
+        release_at(&shared, &shared.tests.row_input[1], false);
+        let worker = shutdown.join().unwrap();
+        assert!(worker.threads.iter().all(Option::is_none));
+        assert!(all_terminal(&shared));
+        assert_eq!(shared.readers[0].done.load(Ordering::Acquire), 0);
+        assert_eq!(shared.readers[1].done.load(Ordering::Acquire), 0);
+        no_flight(&shared);
+        scope.finish().unwrap();
+    }
+
