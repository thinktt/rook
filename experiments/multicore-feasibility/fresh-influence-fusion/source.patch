+    let r=rows(e);assert_eq!(r[0],r[1]);assert!(r[0]>0);r[0]
+}
+fn same_owner(a:&Search<true>,b:&Search<true>) {
+    assert_eq!(a.work(),b.work());assert_eq!(a.stats,b.stats);
