+fn evaluator(position: &Position, fused: bool, budget: usize) -> Evaluator<true> {
+    let mut e = Evaluator::new(position);
+    e.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+    e.set_fresh_influence_fusion(fused);
+    e
+}
+fn rows(e: &Evaluator<true>) -> [u64;2] {
+    e.colors_worker.as_ref().map_or([0,0], |w|w.fusion_epochs())
