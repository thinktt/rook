+fn fixed_iterations_and_node_stop_preserve_output_learning_work_and_reuse() {
+    for limit in [None,Some(1)] {
+        let p=Position::from_fen(START).unwrap();let (mut a,mut b)=(search(&p,false),search(&p,true));
+        let (mut ah,mut bh)=(SearchHistory::new(&p),SearchHistory::new(&p));
