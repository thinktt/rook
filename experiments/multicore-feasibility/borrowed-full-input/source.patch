+    /// Cleanup never returns while this installation can retain caller borrows.
+    /// It runs in the sole coordinator, including during owner-work unwind.
+    fn drain_epoch(&mut self, generation: u64) {
+        loop {
+            let mut control = control_lock(&self.shared);
+            match control.flight {
+                Flight::None => {
+                    if input_empty(&self.shared) { return; }
+                    // No published flight: only our unpublished installation
+                    // may still have a descriptor. No request admitted a reader.
+                    let installed = unsafe { (*self.shared.cells.input.get()).generation };
+                    if installed == generation
+                        && self.shared.request.load(Ordering::Acquire) != generation
+                    {
+                        clear_input(&self.shared);
+                        return;
+                    }
+                    // Impossible ownership mismatch: join rather than erase
+                    // some other descriptor while its lifetime is uncertain.
+                    drop(control);
+                    let _ = self.shutdown();
+                    return;
+                }
+                Flight::Published(metadata) if metadata.generation == generation => {
+                    if terminal(&self.shared) {
+                        drop(control);
+                        let _ = self.shutdown();
+                        return;
+                    }
+                    if both_done(&self.shared, generation) {
+                        // Discard scalar outputs without reading them. Our
+                        // flight still owns Control, so final close cannot race.
+                        retire_flight(&self.shared, &mut control);
+                        return;
+                    }
+                    drop(control);
+                    // This wait is sequential with complete's wait: never a
+                    // second waiter and never holding Control/Sleep together.
+                    if wait_completion(&self.shared, generation).is_err() {
+                        let _ = self.shutdown();
+                        return;
+                    }
+                }
+                Flight::Discarding(metadata) if metadata.generation == generation => {
+                    // Final close owns this flight. Do not steal its claim even
+                    // if both done arrive: await its actual parked/exited drain.
+                    if terminal(&self.shared) {
+                        drop(control);
+                        let _ = self.shutdown();
+                        return;
+                    }
+                    control = wait_control(&self.shared, control);
+                    drop(control);
+                }
+                _ => {
+                    drop(control);
+                    let _ = self.shutdown();
+                    return;
+                }
+            }
+        }
+    }
