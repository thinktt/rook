+//! Focused actual Evaluator/Search controls for scoped input transports.
+use super::*;
+use crate::engine::Search;
+use crate::history::SearchHistory;
+use crate::quiescence::Limits;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const MIDDLE: &str = "r3k2r/ppp2ppp/2npbn2/3qp3/3PP3/2N1BN2/PPP2PPP/R2Q1RK1 b kq - 0 10";
+const ENDING: &str = "6k1/5pp1/6p1/3P4/8/2N5/5P2/6K1 w - - 0 40";
+const EMPTY: &str = "7k/8/8/8/8/8/8/K7 w - - 0 1";
+const FIRST: &str = "7k/6P1/1p1pP3/4pP2/8/2p5/4P3/K7 w - - 0 1";
+const COLLISION: &str = "7k/8/2p4P/2p5/7P/1p6/p5PP/K7 w - - 0 1";
+const GROUP_ZERO: &str = "7k/8/8/8/6P1/3P4/8/K7 w - - 0 1";
+
+fn position(fen: &str) -> Position { Position::from_fen(fen).unwrap() }
+
+fn evaluator<const D: bool>(root: &Position, budget: usize, borrowed: bool) -> Evaluator<D> {
+    let mut evaluator = Evaluator::new(root);
+    evaluator.set_borrowed_inputs(borrowed).unwrap();
+    evaluator.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+    evaluator
+}
+
+fn asymmetric() -> Parameters {
+    Parameters {
+        own: [133, 73, 151, 87, 200, 121, 19, 313, 207, 251, 49],
+        opponent: [91, 128, 67, 142, 80, 57, 183, 47, 333, 107, 229],
+        average_depth: 13, draw: -173, opponent_selectivity: 31,
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct Observed { evaluation: Evaluation, node: Node, details: FullDetails }
+
+fn observe<const D: bool>(
+    evaluator: &mut Evaluator<D>, mut node: Node, map: &Influence, checked: bool, fresh: bool,
+) -> Observed {
+    let before = evaluator.stats;
+    let mut details = None;
+    let evaluation = if fresh {
+        evaluator.fresh_detailed_observed(&mut node, map, checked, |value| details = Some(value))
+    } else {
+        evaluator.full_detailed_observed(&mut node, map, checked, |value| details = Some(value))
+    };
+    assert_eq!(evaluator.stats.relation_queries - before.relation_queries, evaluation.relation_queries);
+    assert_eq!(evaluator.stats.full - before.full, u64::from(D));
+    let details = details.unwrap();
+    assert_eq!(details.base, details.components.base());
+    assert_eq!(node.retained.positional, details.components.positional());
+    assert_eq!(node.retained.pawn_progress, details.components.pawn_progress);
+    assert_eq!(node.retained.age, 0);
+    Observed { evaluation, node, details }
+}
+
+#[test]
+fn borrowed_detailed_full_and_fresh_match_inline_and_owned_with_root_weights_and_supplied_maps() {
+    fn verify<const D: bool>() {
+        let root = position(START);
+        let mut serial = evaluator::<D>(&root, 1, false);
+        let mut owned = evaluator::<D>(&root, 3, false);
+        let mut borrowed = evaluator::<D>(&root, 3, true);
+        let mut zero = Parameters::default();
+        zero.own[6..].fill(0);
+        zero.opponent[6..].fill(0);
+        for fen in [START, MIDDLE, ENDING] {
+            let current = position(fen);
+            for parameters in [Parameters::default(), asymmetric(), zero.clone()] {
+                for evaluator in [&mut serial, &mut owned, &mut borrowed] {
+                    evaluator.parameters = parameters.clone();
+                    evaluator.begin_search(&current);
+                }
+                for map in [Influence::build(&current), Influence { profiles: [[255; 64], [0; 64]] }] {
+                    let before = (current, map);
+                    for checked in [false, true] {
+                        let mut node = Node::root(current, &serial.root);
+                        node.retained.positional = 731;
+                        node.retained.pawn_progress = -193;
+                        node.retained.age = 17;
+                        for fresh in [false, false, true, false] {
+                            let expected = observe(&mut serial, node, &map, checked, fresh);
+                            assert_eq!(observe(&mut owned, node, &map, checked, fresh), expected);
+                            assert_eq!(observe(&mut borrowed, node, &map, checked, fresh), expected);
+                            assert_eq!(owned.stats, serial.stats);
+                            assert_eq!(borrowed.stats, serial.stats);
+                        }
+                    }
+                    assert_eq!((current, map), before);
+                }
+            }
+        }
+        assert!(borrowed.colors_worker.as_ref().unwrap().is_parked());
+        let report = borrowed.finish_colors_report().unwrap();
+        assert!(report.contains("\"scopedInput\":{") && report.contains("\"mode\":\"borrowed\""));
+        assert!(report.contains("\"retired\":true"));
+    }
+    verify::<true>();
+    verify::<false>();
+}
+
+#[test]
+fn borrowed_cache_collision_zero_replacement_and_fresh_bypass_match_serial() {
+    let root = position(START);
+    assert_eq!(position(FIRST).pawn, position(COLLISION).pawn);
+    assert_eq!(position(GROUP_ZERO).pawn % 128, 0);
+    let mut serial = evaluator::<true>(&root, 1, false);
+    let mut borrowed = evaluator::<true>(&root, 3, true);
+    for reset in [false, true] {
+        if reset { serial.begin_search(&root); borrowed.begin_search(&root); }
+        for (fen, fresh) in [
+            (EMPTY, false), (GROUP_ZERO, false), (GROUP_ZERO, false), (EMPTY, false),
+            (FIRST, false), (COLLISION, false), (COLLISION, true), (FIRST, false),
+        ] {
+            let current = position(fen);
+            let map = Influence::build(&current);
+            let node = Node::root(current, &serial.root);
+            assert_eq!(observe(&mut borrowed, node, &map, false, fresh), observe(&mut serial, node, &map, false, fresh));
+            assert_eq!(borrowed.stats, serial.stats);
+        }
+        let first = position(FIRST);
+        let map = Influence::build(&first);
+        let a = borrowed.pawns.select(&first, &map);
+        let b = serial.pawns.select(&first, &map);
+        assert!(a.reused && b.reused);
+        assert_eq!(a.structure, b.structure);
+    }
+}
+
+#[test]
+fn borrowed_callback_unwind_after_epoch_allows_input_mutation_and_outer_scope_reuse() {
+    let root = position(START);
+    let mut serial = evaluator::<true>(&root, 1, false);
+    let mut borrowed = evaluator::<true>(&root, 3, true);
+    let outer = borrowed.full_worker_scope();
+    let mut map = Influence::build(&root);
+    let mut a = Node::root(root, &serial.root);
+    let mut b = a;
+    assert!(catch_unwind(AssertUnwindSafe(|| serial.full_observed(&mut a, &map, false, |_| panic!("serial callback")))).is_err());
+    assert!(catch_unwind(AssertUnwindSafe(|| borrowed.full_observed(&mut b, &map, false, |_| panic!("borrowed callback")))).is_err());
+    assert_eq!(a, b);
+    assert_eq!(borrowed.stats, serial.stats);
+    // The same address may change only after the enclosing call has returned /
+    // unwound. The outer search activation deliberately remains active here.
+    map.profiles = [[255; 64], [0; 64]];
+    a = Node::root(position(ENDING), &serial.root);
+    b = a;
+    assert_eq!(observe(&mut borrowed, b, &map, false, true), observe(&mut serial, a, &map, false, true));
+    Evaluator::<true>::finish_full_worker_scope(outer);
+    assert!(borrowed.colors_worker.as_ref().unwrap().is_parked());
+    let report = borrowed.finish_colors_report().unwrap();
+    assert!(report.contains("\"retired\":true") && report.contains("\"done\":[2,2]"));
+}
+
+fn compare_search(actual: &crate::ordinary::Outcome, expected: &crate::ordinary::Outcome) {
+    assert_eq!(actual.initial_candidates, expected.initial_candidates);
+    assert_eq!((actual.score, &actual.pv, actual.work, actual.stats, actual.evaluations),
+        (expected.score, &expected.pv, expected.work, expected.stats, expected.evaluations));
+    assert_eq!(actual.iterations.len(), expected.iterations.len());
+    for (a, b) in actual.iterations.iter().zip(&expected.iterations) {
+        assert_eq!((a.depth, &a.candidates, &a.steps, a.score, &a.pv, a.work),
+            (b.depth, &b.candidates, &b.steps, b.score, &b.pv, b.work));
+    }
+}
