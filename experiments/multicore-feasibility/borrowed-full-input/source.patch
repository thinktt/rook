+#[test]
+fn borrowed_actual_root_and_seeded_search_depth_one_two_match_serial_and_owned() {
+    for fen in [START, ENDING] {
+        for depth in [1, 2] {
+            let root = position(fen);
+            let mut serial = Search::<true>::new(&root);
+            serial.evaluator.parameters = asymmetric();
+            let mut raw = Vec::new();
+            let expected = serial.run_seeded_iterations(root, &mut SearchHistory::new(&root), depth,
+                Limits::default(), 0x1234_5678, 19, |score| raw.push(score)).unwrap();
+            for borrowed in [false, true] {
+                let mut search = Search::<true>::new(&root);
+                search.evaluator = evaluator(&root, 3, borrowed);
+                search.evaluator.parameters = asymmetric();
+                let mut actual_raw = Vec::new();
+                let actual = search.run_seeded_iterations(root, &mut SearchHistory::new(&root), depth,
+                    Limits::default(), 0x1234_5678, 19, |score| actual_raw.push(score)).unwrap();
+                compare_search(&actual, &expected);
+                assert_eq!(actual_raw, raw);
+                assert_eq!(search.work(), serial.work());
+                assert!(search.evaluator.colors_worker.as_ref().unwrap().is_parked());
+            }
+        }
+    }
+}
+
+#[test]
+fn borrowed_configuration_flag_preserves_budget_fallback_and_applies_to_later_color_worker() {
+    let root = position(START);
+    for borrowed in [false, true] {
+        for (requested, available, configured) in [(1, 1, 1), (2, 1, 1), (2, 3, 2), (3, 1, 1), (3, 2, 2), (3, 3, 3)] {
+            let mut evaluator = Evaluator::<true>::new(&root);
+            evaluator.set_borrowed_inputs(borrowed).unwrap();
+            evaluator.set_threads_with_affinity(requested, || Ok(available)).unwrap();
+            assert_eq!((evaluator.requested_threads(), evaluator.configured_threads()), (requested, configured));
+            let mut node = Node::root(root, &evaluator.root);
+            evaluator.full(&mut node, &Influence::build(&root), false);
+            let report = evaluator.finish_colors_report().unwrap();
+            if configured == 3 {
+                let mode = if borrowed { "\"mode\":\"borrowed\"" } else { "\"mode\":\"owned\"" };
+                assert!(report.contains(mode) && report.contains("\"request\":1") && report.contains("\"done\":[1,1]"));
+                assert!(report.contains("\"retired\":true"));
+            } else { assert!(report.contains("\"scopedInput\":{\"enabled\":false}")); }
+        }
+    }
+    let mut evaluator = evaluator::<true>(&root, 2, true);
+    evaluator.set_threads_with_affinity(3, || Ok(3)).unwrap();
+    evaluator.set_borrowed_inputs(false).unwrap();
+    evaluator.set_borrowed_inputs(true).unwrap();
+    let mut node = Node::root(root, &evaluator.root);
+    evaluator.full(&mut node, &Influence::build(&root), false);
+    assert!(evaluator.finish_colors_report().unwrap().contains("\"mode\":\"borrowed\""));
+}
