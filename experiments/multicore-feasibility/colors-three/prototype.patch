+        assert!(waiter.join().unwrap());
+        assert_eq!(worker.shared.readers[0].state.load(Ordering::Acquire), STOPPED);
+        release(&worker.shared, 1, false);
+        assert!(scope.finish().is_err());
+        worker.shutdown().unwrap();
+        assert!(all_terminal(&worker.shared));
+        assert!(worker.shared.slots.lock().unwrap().packet.is_none());
+    }
+
+    #[test]
+    fn colors_scope_unwind_drains_and_parks_both() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let unwound = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _scope = worker.start_active_scope().unwrap();
+            dispatch(&mut worker, &packet());
+            panic!("intentional colors scope unwind");
+        }));
+        assert!(unwound.is_err());
+        assert!(worker.is_parked());
+        assert!(worker.shared.slots.lock().unwrap().packet.is_none());
+        worker.shutdown().unwrap();
+    }
+
+    #[test]
+    fn colors_startup_failure_or_early_stop_joins_both() {
+        fn fail(_shared: &Shared, _side: usize) -> Result<(), String> { Err("controlled colors startup failure".into()) }
+        fn stop(_shared: &Shared, _side: usize) -> Result<(), String> { Ok(()) }
+        assert_eq!(ColorsWorker::start_with(fail).err().unwrap(), "controlled colors startup failure");
+        assert!(ColorsWorker::start_with(stop).is_err());
+    }
+
+    #[test]
+    fn colors_sparse_counts_partition_completed_discarded_and_failed_samples() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let packet = packet();
+        let scope = worker.start_active_scope().unwrap();
+        for generation in 1..=SAMPLE_STRIDE {
+            let token = dispatch(&mut worker, &packet);
+            assert_eq!(token.sampled, generation == SAMPLE_STRIDE);
+            worker.owner_ready(token).unwrap();
+            assert_output(worker.complete().unwrap(), &packet);
+        }
+        worker.generation = 2 * SAMPLE_STRIDE - 1;
+        dispatch(&mut worker, &packet);
+        scope.finish().unwrap();
+        let scope = worker.start_active_scope().unwrap();
+        worker.generation = 3 * SAMPLE_STRIDE - 1;
+        block(&worker.shared, 0);
+        dispatch(&mut worker, &packet);
+        entered(&worker.shared, 0);
+        release(&worker.shared, 0, true);
+        assert!(worker.complete().is_err());
+        assert!(scope.finish().is_err());
+        assert!(worker.shutdown().is_err());
+        let slots = worker.shared.slots.lock().unwrap();
+        let stats = &slots.readiness;
+        assert_eq!(stats.dispatches, SAMPLE_STRIDE + 2);
+        assert_eq!(stats.sampled_dispatches, 3);
+        assert_eq!(stats.completed_samples, 1);
+        assert_eq!(stats.discarded_samples, 1);
+        assert_eq!(stats.failed_samples, 1);
+        assert_eq!(stats.paired_samples, 1);
+        assert_eq!(stats.owner_missing_samples, 0);
+        assert_eq!(stats.white_ready.log2_ns.iter().sum::<u64>(), 1);
+        assert_eq!(stats.join_elapsed.count, 1);
+    }
+
+    #[test]
+    fn colors_histogram_zero_and_positive_bucket_boundaries() {
+        let mut metric = Metric::default();
+        for ns in [0, 1, 2, 3, 4, u64::MAX] { metric.record(ns); }
+        assert_eq!(metric.count, 6);
+        assert_eq!(metric.min_ns, 0);
+        assert_eq!(metric.max_ns, u64::MAX);
+        assert_eq!(metric.log2_ns[0], 1);
+        assert_eq!(metric.log2_ns[1], 1);
+        assert_eq!(metric.log2_ns[2], 2);
+        assert_eq!(metric.log2_ns[3], 1);
+        assert_eq!(metric.log2_ns[63], 1);
+    }
+}
