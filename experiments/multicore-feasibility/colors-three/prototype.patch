@@ -0,0 +1,1044 @@
+//! Two color-owned Activity -> opposite-Shelter readers for confirmed FULL calls.
+//!
+//! One reusable owned packet is immutable until both readers finish or exit.
+//! Each reader copies it under Slots, releases the shared read, and runs its
+//! kernels on that local copy without a mutex. Successful FULL calls allocate
+//! neither storage nor threads. The two copies and all publication/join costs
+//! are part of this transport. Affinity is inherited from the creating thread.
+//! Lexical active scopes permit spinning; their final close drains both readers
+//! and acknowledges parking. Scheduling delay never implies a wall-time abort.
+
+use crate::activity::{self, SideActivity};
+use crate::evaluator_worker::ActivityShelter;
+use crate::influence::Influence;
+use crate::position::Position;
+use crate::shelter;
+use crate::types::Color;
+use std::fmt::Write;
+use std::hint::spin_loop;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicU8, AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard};
+use std::thread::{self, JoinHandle};
+use std::time::Instant;
+
+const STARTING: u8 = 0;
+const IDLE: u8 = 1;
+const REQUESTED: u8 = 2;
+const COMPLETE: u8 = 3;
+const FAILED: u8 = 4;
+const STOPPED: u8 = 5;
+const PARKED: u8 = 6;
+const COMPLETION_SPINS: usize = 4096;
+const SAMPLE_STRIDE: u64 = 512;
+
+/// A token is valid only for its dispatch. Unsampled owner-ready calls need no
+/// clock or lock. Sampling starts at dispatch 512, then 1024, and so on.
+#[derive(Clone, Copy)]
+pub(crate) struct DispatchToken {
+    generation: u64,
+    sampled: bool,
+}
+
+#[derive(Clone, Copy)]
+struct Packet {
+    generation: u64,
+    position: Position,
+    influence: Influence,
+    material: i32,
+    mobility_weights: [i32; 2],
+    shelter_weights: [i32; 2],
+    published: Option<Instant>,
+}
+
+#[derive(Clone, Copy)]
+struct SideOutput {
+    generation: u64,
+    activity: SideActivity,
+    opposite_shelter: i32,
+    ready_ns: u64,
+    kernel_ns: u64,
+    copy_ns: u64,
+}
+
+struct Reader {
+    state: AtomicU8,
+    requested_generation: AtomicU64,
+    released_generation: AtomicU64,
+    completed_generation: AtomicU64,
+    failed_generation: AtomicU64,
+}
+
+impl Reader {
+    fn new() -> Self {
+        Self {
+            state: AtomicU8::new(STARTING),
+            requested_generation: AtomicU64::new(0),
+            released_generation: AtomicU64::new(0),
+            completed_generation: AtomicU64::new(0),
+            failed_generation: AtomicU64::new(0),
+        }
+    }
+}
+
+#[derive(Default)]
+struct Slots {
+    packet: Option<Packet>,
+    outputs: [Option<SideOutput>; 2],
+    failures: [Option<String>; 2],
+    owner_ready_ns: Option<u64>,
+    completion_waiting: bool,
+    readiness: Readiness,
+}
+
+struct Shared {
+    readers: [Reader; 2],
+    stop: AtomicBool,
+    active_scopes: AtomicUsize,
+    control: Mutex<Control>,
+    wake: Condvar,
+    slots: Mutex<Slots>,
+    completed: Condvar,
+    #[cfg(test)]
+    test_gates: [Mutex<TestGate>; 2],
+    #[cfg(test)]
+    test_wake: Condvar,
+}
+
+#[derive(Default)]
+struct Control {
+    scopes: usize,
+    parking: bool,
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestGate {
+    blocked: bool,
+    entered: bool,
+    fail: bool,
+}
+
+/// No caller stack borrow survives activation. The last guard waits until both
+/// readers have stopped touching this lifetime's packet and local computations.
+pub(crate) struct ColorsActiveScope {
+    shared: Arc<Shared>,
+    armed: bool,
+}
+
+impl ColorsActiveScope {
+    pub(crate) fn finish(mut self) -> Result<(), String> {
+        self.armed = false;
+        release_scope(&self.shared)
+    }
+}
+
+impl Drop for ColorsActiveScope {
+    fn drop(&mut self) {
+        if self.armed {
+            if let Err(error) = release_scope(&self.shared) {
+                if thread::panicking() {
+                    eprintln!("colors worker scope close failed during unwind: {error}");
+                } else {
+                    panic!("colors worker scope close failed: {error}");
+                }
+            }
+        }
+    }
+}
+
+pub(crate) struct ColorsWorker {
+    shared: Arc<Shared>,
+    threads: [Option<JoinHandle<()>>; 2],
+    generation: u64,
+    close_error_reported: bool,
+}
+
+impl ColorsWorker {
+    pub(crate) fn start() -> Result<Self, String> {
+        Self::start_with(run_active)
+    }
+
+    fn start_with(entry: fn(&Shared, usize) -> Result<(), String>) -> Result<Self, String> {
+        let shared = Arc::new(Shared {
+            readers: [Reader::new(), Reader::new()],
+            stop: AtomicBool::new(false),
+            active_scopes: AtomicUsize::new(0),
+            control: Mutex::new(Control::default()),
+            wake: Condvar::new(),
+            slots: Mutex::new(Slots::default()),
+            completed: Condvar::new(),
+            #[cfg(test)]
+            test_gates: [Mutex::new(TestGate::default()), Mutex::new(TestGate::default())],
+            #[cfg(test)]
+            test_wake: Condvar::new(),
+        });
+        let mut worker = Self {
+            shared,
+            threads: [None, None],
+            generation: 0,
+            close_error_reported: false,
+        };
+        for side in 0..2 {
+            let worker_shared = Arc::clone(&worker.shared);
+            let handle = thread::Builder::new()
+                .name(if side == 0 { "rook2-eval-white" } else { "rook2-eval-black" }.into())
+                .spawn(move || {
+                    let result = std::panic::catch_unwind(|| entry(&worker_shared, side));
+                    let failure = match result {
+                        Ok(Ok(())) => None,
+                        Ok(Err(error)) => Some(error),
+                        Err(_) => Some(format!("{} colors reader panicked", side_name(side))),
+                    };
+                    publish_terminal(&worker_shared, side, failure);
+                });
+            match handle {
+                Ok(handle) => worker.threads[side] = Some(handle),
+                Err(error) => {
+                    // A reader not started has no outstanding access. Mark it
+                    // terminal before joining any reader already created.
+                    publish_terminal(&worker.shared, side, Some(format!(
+                        "cannot start {} colors reader: {error}", side_name(side),
+                    )));
+                    let failure = worker.failure();
+                    let _ = worker.shutdown();
+                    return Err(failure);
+                }
+            }
+        }
+        let mut control = control_lock(&worker.shared);
+        while !all_state(&worker.shared, PARKED) && !terminal(&worker.shared) {
+            control = wait_control(&worker.shared, control);
+        }
+        let parked = all_state(&worker.shared, PARKED) && !terminal(&worker.shared);
+        drop(control);
+        if parked {
+            Ok(worker)
+        } else {
+            let failure = worker.failure();
+            let _ = worker.shutdown();
+            Err(failure)
+        }
+    }
+
+    pub(crate) fn start_active_scope(&self) -> Result<ColorsActiveScope, String> {
+        let mut control = control_lock(&self.shared);
+        while control.parking && !terminal(&self.shared) {
+            control = wait_control(&self.shared, control);
+        }
+        if terminal(&self.shared) { return Err(self.failure()); }
+        let first = control.scopes == 0;
+        control.scopes = control.scopes.checked_add(1).expect("colors scope count exhausted");
+        self.shared.active_scopes.store(control.scopes, Ordering::Release);
+        if first {
+            self.shared.wake.notify_all();
+            while !all_state(&self.shared, IDLE) && !terminal(&self.shared) {
+                control = wait_control(&self.shared, control);
+            }
+            if terminal(&self.shared) {
+                control.scopes -= 1;
+                self.shared.active_scopes.store(control.scopes, Ordering::Release);
+                drop(control);
+                return Err(self.failure());
+            }
+        }
+        drop(control);
+        Ok(ColorsActiveScope { shared: Arc::clone(&self.shared), armed: true })
+    }
+
+    /// The owning coordinator encloses this fast path in an existing outer
+    /// scope. Standalone direct evaluator calls get an owned wake/park guard.
+    pub(crate) fn start_call_scope(&self) -> Result<Option<ColorsActiveScope>, String> {
+        if self.shared.active_scopes.load(Ordering::Acquire) != 0 {
+            self.check_running()?;
+            Ok(None)
+        } else {
+            self.start_active_scope().map(Some)
+        }
+    }
+
+    pub(crate) fn dispatch(
+        &mut self,
+        position: &Position,
+        influence: &Influence,
+        material: i32,
+        mobility_weights: [i32; 2],
+        shelter_weights: [i32; 2],
+    ) -> Result<DispatchToken, String> {
+        if self.shared.active_scopes.load(Ordering::Acquire) == 0
+            || !all_state(&self.shared, IDLE) || terminal(&self.shared)
+        {
+            return Err(self.failure());
+        }
+        let generation = self.generation.checked_add(1).expect("colors generation exhausted");
+        let sampled = generation % SAMPLE_STRIDE == 0;
+        let mut slots = self.shared.slots.lock().map_err(|_| "colors slots poisoned")?;
+        if slots.packet.is_some() || slots.outputs.iter().any(Option::is_some) {
+            return Err("colors idle transport still owns a packet or output".into());
+        }
+        slots.owner_ready_ns = None;
+        slots.readiness.dispatches += 1;
+        if sampled { slots.readiness.sampled_dispatches += 1; }
+        slots.packet = Some(Packet {
+            generation, position: *position, influence: *influence, material,
+            mobility_weights, shelter_weights,
+            // Taken after the coordinator packet copy and immediately before
+            // the two REQUESTED stores, while Slots still excludes readers.
+            published: if sampled { Some(Instant::now()) } else { None },
+        });
+        for reader in &self.shared.readers {
+            reader.requested_generation.store(generation, Ordering::Relaxed);
+            reader.state.store(REQUESTED, Ordering::Release);
+        }
+        self.generation = generation;
+        Ok(DispatchToken { generation, sampled })
+    }
+
+    /// Capture the coordinator's arrival after its local terms and immediately
+    /// before complete. The timestamp precedes acquiring the observation lock.
+    pub(crate) fn owner_ready(&self, token: DispatchToken) -> Result<(), String> {
+        if !token.sampled { return Ok(()); }
+        let ready = Instant::now();
+        let mut slots = self.shared.slots.lock().map_err(|_| "colors slots poisoned")?;
+        let packet = slots.packet.as_ref().ok_or("colors owner-ready has no packet")?;
+        if packet.generation != token.generation {
+            return Err("colors owner-ready generation mismatch".into());
+        }
+        let published = packet.published.ok_or("colors sampled packet lacks publication time")?;
+        if slots.owner_ready_ns.is_some() {
+            return Err("colors owner-ready recorded twice".into());
+        }
+        slots.owner_ready_ns = Some(elapsed_ns(published, ready));
+        Ok(())
+    }
+
+    pub(crate) fn complete(&mut self) -> Result<ActivityShelter, String> {
+        let join_started = if self.generation != 0 && self.generation % SAMPLE_STRIDE == 0 {
+            Some(Instant::now())
+        } else { None };
+        let mut slots = completion_slots(&self.shared)?;
+        let packet = slots.packet.as_ref().copied().ok_or("colors completed without a packet")?;
+        let white = slots.outputs[0].as_ref().copied().ok_or("white colors reader has no output")?;
+        let black = slots.outputs[1].as_ref().copied().ok_or("black colors reader has no output")?;
+        if packet.generation != white.generation || packet.generation != black.generation {
+            return Err("colors completion generation mismatch".into());
+        }
+        for reader in &self.shared.readers {
+            if reader.completed_generation.load(Ordering::Acquire) != packet.generation
+                || reader.released_generation.load(Ordering::Acquire) != packet.generation
+            {
+                return Err("colors completion before both reader releases".into());
+            }
+        }
+        if packet.published.is_some() {
+            let join_ns = join_started.map(|start| duration_ns(start.elapsed())).unwrap_or(0);
+            let owner = slots.owner_ready_ns;
+            slots.readiness.record_complete(white, black, owner, join_ns);
+        }
+        slots.packet = None;
+        slots.outputs = [None, None];
+        slots.owner_ready_ns = None;
+        for reader in &self.shared.readers { reader.state.store(IDLE, Ordering::Release); }
+        drop(slots);
+        // Only the coordinator performs the original cross-color composition.
+        Ok(ActivityShelter {
+            activity: activity::combine_sides(
+                [white.activity, black.activity], packet.material,
+                packet.mobility_weights, packet.position.phase(),
+            ),
+            shelter: shelter::combine_sides(
+                [black.opposite_shelter, white.opposite_shelter],
+                packet.material, packet.shelter_weights,
+            ),
+        })
+    }
+
+    pub(crate) fn check_running(&self) -> Result<(), String> {
+        if terminal(&self.shared) { Err(self.failure()) } else { Ok(()) }
+    }
+
+    fn failure(&self) -> String {
+        failure_in(&self.shared.slots.lock().unwrap_or_else(|error| error.into_inner()))
+    }
+
+    /// Report only after shutdown for a complete partition of sampled calls.
+    /// Histograms retain every completed observation in fixed-size storage.
+    pub(crate) fn readiness_report(&self) -> String {
+        self.shared.slots.lock().unwrap_or_else(|error| error.into_inner())
+            .readiness.json()
+    }
+
+    pub(crate) fn shutdown(&mut self) -> Result<(), String> {
+        if self.threads.iter().all(Option::is_none) {
+            if has_failure(&self.shared) {
+                self.close_error_reported = true;
+                return Err(self.failure());
+            }
+            return Ok(());
+        }
+        {
+            let mut control = control_lock(&self.shared);
+            self.shared.stop.store(true, Ordering::Release);
+            self.shared.active_scopes.store(0, Ordering::Release);
+            control.scopes = 0;
+            control.parking = false;
+            self.shared.wake.notify_all();
+        }
+        // Hold neither mutex while joining. Even a delayed reader owns its
+        // packet/local computation until it actually exits, without a timeout.
+        for side in 0..2 {
+            if let Some(handle) = self.threads[side].take() {
+                if handle.join().is_err() {
+                    publish_terminal(&self.shared, side, Some(format!(
+                        "{} colors reader exited with an uncaught panic", side_name(side),
+                    )));
+                }
+            }
+        }
+        {
+            let mut slots = self.shared.slots.lock().unwrap_or_else(|error| error.into_inner());
+            discard_packet(&mut slots);
+        }
+        if has_failure(&self.shared) {
+            self.close_error_reported = true;
+            return Err(self.failure());
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn is_parked(&self) -> bool {
+        all_state(&self.shared, PARKED)
+            && self.shared.active_scopes.load(Ordering::Acquire) == 0
+    }
+}
+
+impl Drop for ColorsWorker {
+    fn drop(&mut self) {
+        let reported = self.close_error_reported;
+        if let Err(error) = self.shutdown() {
+            if reported { return; }
+            if thread::panicking() {
+                eprintln!("colors worker shutdown failed during unwind: {error}");
+            } else {
+                panic!("colors worker shutdown failed: {error}");
+            }
+        }
+    }
+}
+
+fn run_active(shared: &Shared, side: usize) -> Result<(), String> {
+    park(shared, side)?;
+    let reader = &shared.readers[side];
+    while !terminal(shared) {
+        if reader.state.load(Ordering::Acquire) != REQUESTED {
+            if shared.active_scopes.load(Ordering::Acquire) == 0 {
+                park(shared, side)?;
+                continue;
+            }
+            spin_loop();
+            continue;
+        }
+        let generation = reader.requested_generation.load(Ordering::Acquire);
+        let copy_started = if generation % SAMPLE_STRIDE == 0 { Some(Instant::now()) } else { None };
+        #[cfg(test)]
+        test_gate(shared, side)?;
+        let packet = {
+            let slots = shared.slots.lock().map_err(|_| "colors slots poisoned")?;
+            let packet = slots.packet.as_ref().copied().ok_or("colors request has no packet")?;
+            if packet.generation != generation { return Err("colors request generation mismatch".into()); }
+            packet
+        };
+        // No shared packet reference escapes its lock. The coordinator retains
+        // the immutable owned packet until both completions or terminal joins.
+        reader.released_generation.store(generation, Ordering::Release);
+        let kernel_started = packet.published.map(|_| Instant::now());
+        let copy_ns = match (copy_started, kernel_started) {
+            (Some(start), Some(end)) => elapsed_ns(start, end),
+            _ => 0,
+        };
+        let color = if side == 0 { Color::White } else { Color::Black };
+        let activity = activity::compute_side(&packet.position, &packet.influence, color);
+        let opposite_shelter = shelter::compute_side(
+            &packet.position, &packet.influence, color.opponent(), activity.pressure,
+        );
+        let kernel_ns = kernel_started.map(|start| duration_ns(start.elapsed())).unwrap_or(0);
+        let notify = {
+            let mut slots = shared.slots.lock().map_err(|_| "colors slots poisoned")?;
+            if slots.packet.as_ref().map(|packet| packet.generation) != Some(generation) {
+                return Err("colors packet reused before reader completion".into());
+            }
+            // This readiness boundary includes input-lock/copy and output-lock
+            // delays, and sits immediately before COMPLETE release publication.
+            let ready_ns = packet.published.map(|start| duration_ns(start.elapsed())).unwrap_or(0);
+            slots.outputs[side] = Some(SideOutput {
+                generation, activity, opposite_shelter, ready_ns, kernel_ns, copy_ns,
+            });
+            reader.completed_generation.store(generation, Ordering::Relaxed);
+            reader.state.store(COMPLETE, Ordering::Release);
+            slots.completion_waiting
+        };
+        if notify { shared.completed.notify_all(); }
+    }
+    Ok(())
+}
+
+fn side_name(side: usize) -> &'static str { if side == 0 { "white" } else { "black" } }
+
+fn all_state(shared: &Shared, state: u8) -> bool {
+    shared.readers.iter().all(|reader| reader.state.load(Ordering::Acquire) == state)
+}
+
+fn all_terminal(shared: &Shared) -> bool {
+    shared.readers.iter().all(|reader| matches!(reader.state.load(Ordering::Acquire), FAILED | STOPPED))
+}
+
+fn has_failure(shared: &Shared) -> bool {
+    shared.readers.iter().any(|reader| reader.state.load(Ordering::Acquire) == FAILED)
+}
+
+fn terminal(shared: &Shared) -> bool {
+    shared.stop.load(Ordering::Acquire)
+        || shared.readers.iter().any(|reader| matches!(reader.state.load(Ordering::Acquire), FAILED | STOPPED))
+}
+
+fn failure_in(slots: &Slots) -> String {
+    slots.failures.iter().find_map(Clone::clone)
+        .unwrap_or_else(|| "colors worker entered an invalid or stopped state".into())
+}
+
+fn control_lock(shared: &Shared) -> MutexGuard<'_, Control> {
+    shared.control.lock().unwrap_or_else(|error| error.into_inner())
+}
+
+/// No Slots holder may acquire Control. All terminal/lifecycle transitions use
+/// Control -> Slots, matching the proven single-reader transport's lock order.
+fn completion_slots(shared: &Shared) -> Result<MutexGuard<'_, Slots>, String> {
+    for _ in 0..COMPLETION_SPINS {
+        if all_state(shared, COMPLETE) || terminal(shared) { break; }
+        // An idle/parked transport has no future completion to wait for.
+        if !shared.readers.iter().any(|reader| reader.state.load(Ordering::Acquire) == REQUESTED) {
+            break;
+        }
+        spin_loop();
+    }
+    let mut slots = shared.slots.lock().map_err(|_| "colors slots poisoned")?;
+    while !all_state(shared, COMPLETE) && !terminal(shared)
+        && shared.readers.iter().any(|reader| reader.state.load(Ordering::Acquire) == REQUESTED)
+    {
+        slots.completion_waiting = true;
+        slots = shared.completed.wait(slots).map_err(|_| "colors slots poisoned")?;
+    }
+    slots.completion_waiting = false;
+    if !all_state(shared, COMPLETE) || terminal(shared) { return Err(failure_in(&slots)); }
+    Ok(slots)
+}
+
+fn publish_terminal(shared: &Shared, side: usize, failure: Option<String>) {
+    let mut control = control_lock(shared);
+    let mut slots = shared.slots.lock().unwrap_or_else(|error| error.into_inner());
+    let reader = &shared.readers[side];
+    if let Some(error) = failure {
+        slots.failures[side] = Some(error);
+        reader.failed_generation.store(reader.requested_generation.load(Ordering::Acquire), Ordering::Relaxed);
+        reader.state.store(FAILED, Ordering::Release);
+    } else if reader.state.load(Ordering::Acquire) != FAILED {
+        reader.state.store(STOPPED, Ordering::Release);
+    }
+    // A normal unexpected exit also stops its sibling. Neither outcome frees
+    // packet storage; only both parked acknowledgments or shutdown's joins do.
+    shared.stop.store(true, Ordering::Release);
+    if all_terminal(shared) { control.parking = false; }
+    shared.completed.notify_all();
+    shared.wake.notify_all();
+}
+
+fn release_scope(shared: &Shared) -> Result<(), String> {
+    let mut control = control_lock(shared);
+    // Shutdown has already assumed ownership and joined, or is joining, both
+    // readers. A guard outliving that owner must not underflow the scope count.
+    if shared.stop.load(Ordering::Acquire) && control.scopes == 0 { return Ok(()); }
+    assert!(control.scopes != 0, "colors scope released twice");
+    control.scopes -= 1;
+    shared.active_scopes.store(control.scopes, Ordering::Release);
+    if control.scopes != 0 { return Ok(()); }
+    control.parking = true;
+    while !all_state(shared, PARKED) && !all_terminal(shared) {
+        control = wait_control(shared, control);
+    }
+    control.parking = false;
+    if all_terminal(shared) {
+        return Err(failure_in(&shared.slots.lock().unwrap_or_else(|error| error.into_inner())));
+    }
+    Ok(())
+}
+
+fn discard_packet(slots: &mut Slots) {
+    if slots.packet.as_ref().is_some_and(|packet| packet.published.is_some()) {
+        if slots.failures.iter().any(Option::is_some) {
+            slots.readiness.failed_samples += 1;
+        } else {
+            slots.readiness.discarded_samples += 1;
+        }
+    }
+    slots.packet = None;
+    slots.outputs = [None, None];
+    slots.owner_ready_ns = None;
+}
+
+/// The second parked acknowledgment clears a discarded packet. Activation
+/// cannot pass the parking predicate until both local kernels have ended.
+fn park(shared: &Shared, side: usize) -> Result<(), String> {
+    let mut control = control_lock(shared);
+    if control.scopes != 0 { return Ok(()); }
+    shared.readers[side].state.store(PARKED, Ordering::Release);
+    if all_state(shared, PARKED) {
+        let mut slots = shared.slots.lock().map_err(|_| "colors slots poisoned while parking")?;
+        discard_packet(&mut slots);
+        control.parking = false;
+    }
+    shared.wake.notify_all();
+    while control.scopes == 0 && !terminal(shared) {
+        control = wait_control(shared, control);
+    }
+    if !terminal(shared) {
+        shared.readers[side].state.store(IDLE, Ordering::Release);
+        shared.wake.notify_all();
+    }
+    Ok(())
+}
+
+fn wait_control<'a>(shared: &'a Shared, control: MutexGuard<'a, Control>) -> MutexGuard<'a, Control> {
+    shared.wake.wait(control).unwrap_or_else(|error| error.into_inner())
+}
+
+fn duration_ns(duration: std::time::Duration) -> u64 {
+    duration.as_nanos().min(u64::MAX as u128) as u64
+}
+
+fn elapsed_ns(start: Instant, end: Instant) -> u64 { duration_ns(end.duration_since(start)) }
+
+/// Fixed-size sparse observations. Each bucket is zero for duration 0, or the
+/// positive duration's bit length capped at 63 (1ns -> 1, 2..3ns -> 2, ...).
+struct Metric {
+    count: u64,
+    sum_ns: u128,
+    min_ns: u64,
+    max_ns: u64,
+    log2_ns: [u64; 64],
+}
+
+impl Default for Metric {
+    fn default() -> Self {
+        Self { count: 0, sum_ns: 0, min_ns: 0, max_ns: 0, log2_ns: [0; 64] }
+    }
+}
+
+impl Metric {
+    fn record(&mut self, ns: u64) {
+        if self.count == 0 { self.min_ns = ns; } else { self.min_ns = self.min_ns.min(ns); }
+        self.max_ns = self.max_ns.max(ns);
+        self.count += 1;
+        self.sum_ns += ns as u128;
+        let bucket = if ns == 0 { 0 } else { (64 - ns.leading_zeros() as usize).min(63) };
+        self.log2_ns[bucket] += 1;
+    }
+
+    fn write_json(&self, output: &mut String) {
+        write!(output, "{{\"count\":{},\"sum_ns\":{},\"min_ns\":{},\"max_ns\":{},\"log2_ns\":[",
+            self.count, self.sum_ns, self.min_ns, self.max_ns).unwrap();
+        for (index, count) in self.log2_ns.iter().enumerate() {
+            if index != 0 { output.push(','); }
+            write!(output, "{count}").unwrap();
+        }
+        output.push_str("]}");
+    }
+}
+
+#[derive(Default)]
+struct Readiness {
+    dispatches: u64,
+    sampled_dispatches: u64,
+    completed_samples: u64,
+    discarded_samples: u64,
+    failed_samples: u64,
+    owner_missing_samples: u64,
+    paired_samples: u64,
+    owner_ready_at_or_after_both: u64,
+    sides_after_owner: u64,
+    white_last: u64,
+    black_last: u64,
+    sides_tied: u64,
+    white_ready: Metric,
+    black_ready: Metric,
+    owner_ready: Metric,
+    white_kernel: Metric,
+    black_kernel: Metric,
+    white_copy: Metric,
+    black_copy: Metric,
+    join_wait: Metric,
+    owner_after_sides: Metric,
+    reader_imbalance: Metric,
+    join_elapsed: Metric,
+}
+
+impl Readiness {
+    fn record_complete(&mut self, white: SideOutput, black: SideOutput, owner: Option<u64>, join_ns: u64) {
+        self.completed_samples += 1;
+        self.white_ready.record(white.ready_ns);
+        self.black_ready.record(black.ready_ns);
+        self.white_kernel.record(white.kernel_ns);
+        self.black_kernel.record(black.kernel_ns);
+        self.white_copy.record(white.copy_ns);
+        self.black_copy.record(black.copy_ns);
+        self.reader_imbalance.record(white.ready_ns.abs_diff(black.ready_ns));
+        self.join_elapsed.record(join_ns);
+        if let Some(owner) = owner {
+            self.paired_samples += 1;
+            self.owner_ready.record(owner);
+            let latest = white.ready_ns.max(black.ready_ns);
+            if owner >= latest { self.owner_ready_at_or_after_both += 1; } else { self.sides_after_owner += 1; }
+            if white.ready_ns > black.ready_ns { self.white_last += 1; }
+            else if black.ready_ns > white.ready_ns { self.black_last += 1; }
+            else { self.sides_tied += 1; }
+            self.join_wait.record(latest.saturating_sub(owner));
+            self.owner_after_sides.record(owner.saturating_sub(latest));
+        } else { self.owner_missing_samples += 1; }
+    }
+
+    fn json(&self) -> String {
+        let mut output = String::new();
+        write!(output, "{{\"schema\":\"rook2-colors-readiness-v1\",\"enabled\":true,\"sample_stride\":{SAMPLE_STRIDE},\"storage\":\"fixed_log2_histograms\",\"histogram_bucket_rule\":\"zero_else_bit_length_capped_63\",\"samples_capped\":0,\"dispatches\":{},\"sampled_dispatches\":{},\"completed_samples\":{},\"discarded_samples\":{},\"failed_samples\":{},\"owner_missing_samples\":{},\"paired_samples\":{},\"owner_ready_at_or_after_both\":{},\"sides_after_owner\":{},\"white_last\":{},\"black_last\":{},\"sides_tied\":{},\"metrics\":{{",
+            self.dispatches, self.sampled_dispatches, self.completed_samples, self.discarded_samples,
+            self.failed_samples, self.owner_missing_samples, self.paired_samples,
+            self.owner_ready_at_or_after_both, self.sides_after_owner, self.white_last,
+            self.black_last, self.sides_tied).unwrap();
+        let metrics = [
+            ("white_ready", &self.white_ready), ("black_ready", &self.black_ready),
+            ("owner_ready", &self.owner_ready), ("white_kernel", &self.white_kernel),
+            ("black_kernel", &self.black_kernel), ("white_copy", &self.white_copy),
+            ("black_copy", &self.black_copy), ("join_wait", &self.join_wait),
+            ("owner_after_sides", &self.owner_after_sides), ("reader_imbalance", &self.reader_imbalance),
+            ("join_elapsed", &self.join_elapsed),
+        ];
+        for (index, (name, metric)) in metrics.iter().enumerate() {
+            if index != 0 { output.push(','); }
+            write!(output, "\"{name}\":").unwrap();
+            metric.write_json(&mut output);
+        }
+        output.push_str("}}");
+        output
+    }
+}
+
+#[cfg(test)]
+fn test_gate(shared: &Shared, side: usize) -> Result<(), String> {
+    let mut gate = shared.test_gates[side].lock().unwrap();
+    gate.entered = true;
+    shared.test_wake.notify_all();
+    while gate.blocked { gate = shared.test_wake.wait(gate).unwrap(); }
+    if gate.fail { Err(format!("controlled {} colors reader failure", side_name(side))) } else { Ok(()) }
+}
