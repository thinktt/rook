+/// The original color traversal, with fresh private marks. Only this attacker's
+/// mark row is written or read, so the opposite side needs no intermediate data.
+pub(crate) fn compute_side(
+    position: &Position,
+    influence: &Influence,
+    attacker: Color,
+) -> SideActivity {
+    let phase = position.phase();
+    let values = &DESTINATION_VALUES[attacker.index()];
+    let mut marks = [[0u8; 64]; 2];
+    let mut raw_score = 0i64;
+    let mut relation_queries = 0;
+    accumulate_kind::<1>(
+        position, influence, attacker, values, &mut marks, phase.endgame,
+        &mut raw_score, &mut relation_queries,
+    );
+    accumulate_kind::<2>(
+        position, influence, attacker, values, &mut marks, phase.endgame,
+        &mut raw_score, &mut relation_queries,
+    );
+    accumulate_kind::<3>(
+        position, influence, attacker, values, &mut marks, phase.endgame,
+        &mut raw_score, &mut relation_queries,
+    );
+    accumulate_kind::<4>(
+        position, influence, attacker, values, &mut marks, phase.endgame,
+        &mut raw_score, &mut relation_queries,
+    );
+    SideActivity {
+        piece: (276 * raw_score + 128).div_euclid(256) as i32,
+        pressure: king_pressure(position, attacker.opponent(), &marks),
+        relation_queries,
+    }
+}
+
+/// Inputs are indexed by attacker; the public pressure array is by defender.
+pub(crate) fn combine_sides(
+    sides: [SideActivity; 2],
+    material_score: i32,
+    weights: [i32; 2],
+    phase: Phase,
+) -> Activity {
+    debug_assert!(weights.iter().all(|w| (0..=10_240).contains(w)));
+    let pieces = [sides[0].piece, sides[1].piece];
+    Activity {
+        pieces,
+        pressure: [sides[1].pressure, sides[0].pressure],
+        weighted: weighted(pieces, material_score, weights, phase),
+        relation_queries: sides[0].relation_queries + sides[1].relation_queries,
+    }
+}
