+            sent.send(wait_completion(&shared, token.generation)).unwrap();
+        });
+        registered(&worker.shared, 1);
+        assert_eq!(latch_values(&worker.shared), [true, true]);
+        // A notification with no changed completion predicate clears both
+        // registrations. The next cold loop must reinstall BOTH flags.
+        signal_all(&worker.shared);
+        registered(&worker.shared, 2);
+        assert_eq!(latch_values(&worker.shared), [true, true]);
