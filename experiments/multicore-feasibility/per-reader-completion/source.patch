+    #[test]
+    fn colors_two_true_reader_notifiers_pending_on_sleep() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = activate(&mut worker);
+        let packet = packet();
+        for side in 0..2 { block(&worker.shared, side); }
+        block_at(&worker.shared.tests.after_registration);
+        let token = dispatch(&mut worker, &packet);
+        for side in 0..2 { entered(&worker.shared, side); }
+        let shared = Arc::clone(&worker.shared);
+        let waiter = thread::spawn(move || wait_completion(&shared, token.generation));
+        entered_at(&worker.shared, &worker.shared.tests.after_registration);
+        for side in 0..2 { release(&worker.shared, side, false); }
+        for side in 0..2 {
+            entered_at(&worker.shared, &worker.shared.tests.before_notify[side]);
+            wait_done(&worker.shared, side, token.generation);
+        }
+        // Each independently consumed true and owes Sleep/notification. The
+        // waiter still owns Sleep, so neither notification can have finished.
+        assert_eq!(latch_values(&worker.shared), [false, false]);
+        release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+        waiter.join().unwrap().unwrap();
+        assert_eq!(latch_values(&worker.shared), [false, false]);
+        assert_output(worker.complete().unwrap(), &packet);
+        // Real parking also waits for both pending notifier calls to return.
+        worker.restore_activation(scope).unwrap();
+        assert!(worker.is_parked());
+        worker.shutdown().unwrap();
+    }
