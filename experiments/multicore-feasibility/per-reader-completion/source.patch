+    #[test]
+    fn colors_stale_true_notifier_remains_owed_across_generations() {
+        for delayed in 0..2 {
+            let mut worker = ColorsWorker::start().unwrap();
+            let scope = activate(&mut worker);
+            let packet = packet();
+            for side in 0..2 { block(&worker.shared, side); }
+            block_at(&worker.shared.tests.after_registration);
+            block_at(&worker.shared.tests.before_notify[delayed]);
+            let first = dispatch(&mut worker, &packet);
+            for side in 0..2 { entered(&worker.shared, side); }
+            let shared = Arc::clone(&worker.shared);
+            let first_waiter = thread::spawn(move || wait_completion(&shared, first.generation));
+            entered_at(&worker.shared, &worker.shared.tests.after_registration);
+            for side in 0..2 { release(&worker.shared, side, false); }
+            for side in 0..2 { wait_done(&worker.shared, side, first.generation); }
+            entered_at(&worker.shared, &worker.shared.tests.before_notify[delayed]);
+            release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+            first_waiter.join().unwrap().unwrap();
+            assert_eq!(latch_values(&worker.shared), [false, false]);
+            assert_output(worker.complete().unwrap(), &packet);
+
+            // The old true consumer remains paused after its exchange while
+            // both actual done epochs let the sole owner publish a new input.
+            for side in 0..2 { block(&worker.shared, side); }
+            block_at(&worker.shared.tests.after_registration);
+            let second = dispatch(&mut worker, &packet);
+            assert_eq!(second.generation, first.generation + 1);
+            // This peer's entry also proves its old notification has finished,
+            // excluding an unrelated old wake from the assertion below.
+            entered(&worker.shared, 1 - delayed);
+            let shared = Arc::clone(&worker.shared);
+            let (sent, received) = mpsc::channel();
+            let second_waiter = thread::spawn(move || {
+                sent.send(wait_completion(&shared, second.generation)).unwrap();
+            });
+            entered_at(&worker.shared, &worker.shared.tests.after_registration);
+            assert_eq!(latch_values(&worker.shared), [true, true]);
+            release_at(&worker.shared, &worker.shared.tests.after_registration, false);
+            release_at(&worker.shared, &worker.shared.tests.before_notify[delayed], false);
+            // The delayed old true consumer must notify even though its flag
+            // has since been cleared and registered again for another epoch.
+            registered(&worker.shared, 3);
+            entered(&worker.shared, delayed);
+            assert_eq!(latch_values(&worker.shared), [true, true]);
+            assert!(received.try_recv().is_err());
+            for side in 0..2 {
+                assert_eq!(worker.shared.cells.sides[side].done.load(Ordering::Acquire), first.generation);
+                release(&worker.shared, side, false);
+            }
+            second_waiter.join().unwrap();
+            received.recv().unwrap().unwrap();
+            assert_eq!(latch_values(&worker.shared), [false, false]);
+            assert_output(worker.complete().unwrap(), &packet);
+            worker.restore_activation(scope).unwrap();
+            worker.shutdown().unwrap();
+        }
+    }
