+                let shared = Arc::clone(&worker.shared);
+                let waiter = thread::spawn(move || wait_completion(&shared, token.generation));
+                entered_at(&worker.shared, registration_gate(&worker.shared, boundary));
+                release(&worker.shared, failing, true);
+                wait_state(&worker.shared, failing, FAILED);
+                assert!(worker.failure().contains("controlled"));
+                if boundary > failing {
+                    entered_at(&worker.shared, &worker.shared.tests.before_notify[failing]);
+                }
+                let mut expected = [boundary > 0, boundary > 1];
+                expected[failing] = false;
+                assert_eq!(latch_values(&worker.shared), expected);
+                // Reader terminal signaling consumes only its own registration.
+                // No failure observation acknowledges the blocked peer's input.
+                assert_eq!(worker.shared.cells.sides[1 - failing].done.load(Ordering::Acquire), 0);
+                release_at(&worker.shared, registration_gate(&worker.shared, boundary), false);
+                assert!(waiter.join().unwrap().is_err());
+                assert_eq!(latch_values(&worker.shared), [false, false]);
+                release(&worker.shared, 1 - failing, false);
+                assert!(worker.restore_activation(scope).is_err());
+                assert!(worker.shutdown().is_err());
+                no_flight(&worker);
+            }
+        }
+    }
