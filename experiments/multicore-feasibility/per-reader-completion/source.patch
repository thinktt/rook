+    #[test]
+    fn colors_each_reader_publication_before_between_after_both_registrations() {
+        for side in 0..2 {
+            for boundary in 0..3 {
+                let mut worker = ColorsWorker::start().unwrap();
+                let scope = activate(&mut worker);
+                let packet = packet();
+                for reader in 0..2 { block(&worker.shared, reader); }
+                block_at(registration_gate(&worker.shared, boundary));
+                let token = dispatch(&mut worker, &packet);
+                for reader in 0..2 { entered(&worker.shared, reader); }
+                let shared = Arc::clone(&worker.shared);
+                let (sent, received) = mpsc::channel();
+                let waiter = thread::spawn(move || {
+                    sent.send(wait_completion(&shared, token.generation)).unwrap();
+                });
+                entered_at(&worker.shared, registration_gate(&worker.shared, boundary));
+                assert_eq!(latch_values(&worker.shared), [boundary > 0, boundary > 1]);
+                // Force this reader's real done publication at each boundary.
+                // A registered reader also demonstrably consumes its own flag;
+                // Sleep prevents its owed notification from crossing this gap.
+                release(&worker.shared, side, false);
+                wait_done(&worker.shared, side, token.generation);
+                if boundary > side {
+                    entered_at(&worker.shared, &worker.shared.tests.before_notify[side]);
+                    assert!(!worker.shared.latches[side].waiting.load(Ordering::SeqCst));
+                }
+                assert_eq!(worker.shared.cells.sides[1 - side].done.load(Ordering::Acquire), 0);
+                assert!(received.try_recv().is_err());
+                release_at(&worker.shared, registration_gate(&worker.shared, boundary), false);
+                registered(&worker.shared, 1);
+                assert!(received.try_recv().is_err());
+                release(&worker.shared, 1 - side, false);
+                waiter.join().unwrap();
+                received.recv().unwrap().unwrap();
+                assert_eq!(latch_values(&worker.shared), [false, false]);
+                assert_output(worker.complete().unwrap(), &packet);
+                worker.restore_activation(scope).unwrap();
+                worker.shutdown().unwrap();
+            }
+        }
+    }
