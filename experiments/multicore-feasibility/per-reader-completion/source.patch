+    #[test]
+    fn colors_owner_terminal_before_between_after_both_registrations() {
+        for boundary in 0..3 {
+            let mut worker = ColorsWorker::start().unwrap();
+            let scope = activate(&mut worker);
+            for side in 0..2 { block(&worker.shared, side); }
+            block_at(registration_gate(&worker.shared, boundary));
+            let token = dispatch(&mut worker, &packet());
+            for side in 0..2 { entered(&worker.shared, side); }
+            let shared = Arc::clone(&worker.shared);
+            let waiter_shared = Arc::clone(&shared);
+            let waiter = thread::spawn(move || wait_completion(&waiter_shared, token.generation));
+            entered_at(&shared, registration_gate(&shared, boundary));
+            let (sent, received) = mpsc::channel();
+            let shutdown = thread::spawn(move || {
+                sent.send(worker.shutdown()).unwrap();
+                worker
+            });
+            while !terminal(&shared) { thread::yield_now(); }
+            while latch_values(&shared) != [false, false] { thread::yield_now(); }
+            // Owner signaling released Control before waiting for Sleep, which
+            // this paused completion waiter still holds at every boundary.
+            assert!(control_lock(&shared).shutdown);
+            for side in 0..2 {
+                assert_eq!(shared.cells.sides[side].done.load(Ordering::Acquire), 0);
+            }
+            assert!(received.try_recv().is_err());
+            release_at(&shared, registration_gate(&shared, boundary), false);
+            assert!(waiter.join().unwrap().is_err());
+            assert_eq!(latch_values(&shared), [false, false]);
+            release(&shared, 0, false);
+            wait_state(&shared, 0, STOPPED);
+            assert!(received.try_recv().is_err());
+            assert_eq!(shared.cells.sides[1].done.load(Ordering::Acquire), 0);
+            release(&shared, 1, false);
+            let mut worker = shutdown.join().unwrap();
+            received.recv().unwrap().unwrap();
+            assert!(worker.owner.drained);
+            assert!(worker.threads.iter().all(Option::is_none));
+            no_flight(&worker);
+            worker.restore_activation(scope).unwrap();
+            worker.shutdown().unwrap();
+        }
+    }
