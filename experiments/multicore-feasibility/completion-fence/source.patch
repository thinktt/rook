+    #[test]
+    fn colors_two_delayed_true_notifiers_survive_exit_and_reregistration() {
+        let mut worker = ColorsWorker::start().unwrap();
+        let scope = worker.start_active_scope().unwrap();
+        let packet = packet();
+        for side in 0..2 { block(&worker.shared, side); }
+        block_at(&worker.shared.tests.before_notify);
+        let first = dispatch(&mut worker, &packet);
+        for side in 0..2 { entered(&worker.shared, side); }
+        let shared = Arc::clone(&worker.shared);
+        let first_waiter = thread::spawn(move || wait_completion(&shared, first.generation));
+        registered(&worker.shared, 1);
+        for side in 0..2 { release(&worker.shared, side, false); }
+        // Both actual publishers read true and owe notification, but neither
+        // has yet acquired Sleep. Neither publisher may consume registration.
+        while worker.shared.tests.notification_loads.load(Ordering::SeqCst) < 2 {
+            thread::yield_now();
+        }
+        assert!(worker.shared.waiting.load(Ordering::SeqCst));
+        for side in 0..2 { wait_done(&worker.shared, side, first.generation); }
+        // An explicit spurious wake lets the sole waiter recheck matching done,
+        // clear registration and exit while both notification obligations wait.
+        {
+            let _sleep = worker.shared.sleep.lock().unwrap();
+            worker.shared.completed.notify_all();
+        }
+        first_waiter.join().unwrap().unwrap();
+        assert!(!worker.shared.waiting.load(Ordering::SeqCst));
+        assert_output(worker.complete().unwrap(), &packet);
+        let before = worker.shared.tests.registrations.load(Ordering::SeqCst);
+        for side in 0..2 { block(&worker.shared, side); }
+        let second = dispatch(&mut worker, &packet);
+        assert_eq!(second.generation, first.generation + 1);
+        let shared = Arc::clone(&worker.shared);
+        let (sent, received) = mpsc::channel();
+        let second_waiter = thread::spawn(move || {
+            let outcome = wait_completion(&shared, second.generation);
+            sent.send(outcome).unwrap();
+        });
+        registered(&worker.shared, before + 1);
+        // Old true-load obligations cross exit/registration and may notify the
+        // new waiter; they must never fabricate new done or clear its flag.
+        release_at(&worker.shared, &worker.shared.tests.before_notify, false);
+        for side in 0..2 { entered(&worker.shared, side); }
+        assert!(received.try_recv().is_err());
+        assert!(worker.shared.waiting.load(Ordering::SeqCst));
+        for side in 0..2 {
+            assert_eq!(worker.shared.readers[side].done.load(Ordering::Acquire), first.generation);
+            release(&worker.shared, side, false);
+        }
+        second_waiter.join().unwrap();
+        received.recv().unwrap().unwrap();
+        assert!(!worker.shared.waiting.load(Ordering::SeqCst));
+        assert_output(worker.complete().unwrap(), &packet);
