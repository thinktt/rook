+// Preserve inventory65 concrete storage and alignment, including Metric's
+// u128 field. These fields remain inert; no observation collection methods exist.
+struct Metric {
+    count: u64,
+    sum_ns: u128,
+    min_ns: u64,
+    max_ns: u64,
+    log2_ns: [u64; 64],
+}
+
+impl Default for Metric {
+    fn default() -> Self {
+        Self { count: 0, sum_ns: 0, min_ns: 0, max_ns: 0, log2_ns: [0; 64] }
+    }
+}
