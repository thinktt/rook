+    }
+    pub(crate) fn estimated_bytes(&self)->usize {std::mem::size_of::<Self>()+self.maps.bytes()+self.chains.bytes()}
+    pub(crate) fn json(&self)->String {format!("{{\"failed\":false,\"influence\":{},\"chain\":{},\"retained_bytes\":{},\"combine_ns\":{}}}",pool_kind_json(&self.maps),pool_kind_json(&self.chains),self.estimated_bytes(),self.combine_ns)}
+}
+fn merge<K:Key,V:Copy+PartialEq>(catalog:&mut Catalog<K,V,Produced>,record:Record<K,V,Produced>,caps:Caps,other_bytes:usize,other_keys:usize,calls:u64)->Result<(),String> {
+    if calls>caps.max_calls{return Err("pure-pool-call-cap".into());}
+    if let Some(id)=catalog.find(&record.key) {let old=&mut catalog.records[id];if old.value!=record.value{return Err("pure-duplicate-payload-mismatch".into());}
