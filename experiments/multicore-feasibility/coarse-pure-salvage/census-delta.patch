+enum Mode {
+    Producer {id:usize,maps:Catalog<InfluenceKey,Influence,Produced>,chains:Catalog<ChainKey,ChainValue,Produced>},
+    Canonical {pool:Rc<Pool>,maps:Catalog<InfluenceKey,Influence,Demanded>,chains:Catalog<ChainKey,ChainValue,Demanded>},
+    Prefix {pool:Rc<Pool>,maps:Vec<Tally>,chains:Vec<Tally>,calls:[Tally;2],matched:[Tally;2]},Finished,
