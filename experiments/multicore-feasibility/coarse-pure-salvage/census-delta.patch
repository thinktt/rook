+fn finish_observation(state:&mut State,started:Instant,error:Option<&'static str>) {
+    if let Some(error)=error{state.fatal.get_or_insert(error);}
+    let bytes=state.bytes();if bytes>state.caps.max_bytes {state.fatal.get_or_insert("pure-observer-byte-cap");}
+    state.costs.observer_ns+=started.elapsed().as_nanos();state.peak_bytes=state.peak_bytes.max(bytes);
+}
+fn call(state:&mut State)->Result<(),&'static str> {if let Some(fatal)=state.fatal{return Err(fatal);}state.calls+=1;if state.calls>state.caps.max_calls{return Err("pure-observer-call-cap");}Ok(())}
+fn observe_map(state:&mut State,key:InfluenceKey,value:Influence,kernel_ns:u128)->Option<&'static str> {
+    if let Err(error)=call(state){return Some(error);}let bytes=state.bytes();let caps=state.caps;let scope=state.scope;
+    match &mut state.mode {
+        Mode::Producer {id,maps,chains}=>produce(maps,key,value,kernel_ns,*id,caps,bytes,chains.records.len(),&mut state.costs),
+        Mode::Canonical {pool,maps,chains}=>demand(maps,&pool.maps,key,value,kernel_ns,scope,caps,bytes,chains.records.len(),&mut state.costs),
+        Mode::Prefix {pool,maps,calls,matched,..}=>prefix(&pool.maps,maps,&mut calls[0],&mut matched[0],key,value,kernel_ns,&mut state.costs),Mode::Finished=>Some("pure-observer-already-finished"),
+    }
+}
+fn observe_chain(state:&mut State,key:ChainKey,value:ChainValue,kernel_ns:u128)->Option<&'static str> {
+    if let Err(error)=call(state){return Some(error);}let bytes=state.bytes();let caps=state.caps;let scope=state.scope;
+    match &mut state.mode {
+        Mode::Producer {id,maps,chains}=>produce(chains,key,value,kernel_ns,*id,caps,bytes,maps.records.len(),&mut state.costs),
+        Mode::Canonical {pool,maps,chains}=>demand(chains,&pool.chains,key,value,kernel_ns,scope,caps,bytes,maps.records.len(),&mut state.costs),
+        Mode::Prefix {pool,chains,calls,matched,..}=>prefix(&pool.chains,chains,&mut calls[1],&mut matched[1],key,value,kernel_ns,&mut state.costs),Mode::Finished=>Some("pure-observer-already-finished"),
+    }
+}
+fn produce<K:Key,V:Copy+PartialEq>(catalog:&mut Catalog<K,V,Produced>,key:K,value:V,kernel_ns:u128,id:usize,caps:Caps,bytes:usize,other_keys:usize,costs:&mut Costs)->Option<&'static str> {
+    let lookup=Instant::now();let found=catalog.find(&key);costs.lookup_ns+=lookup.elapsed().as_nanos();
+    if let Some(found)=found {let record=&mut catalog.records[found];if !materialize(&record.value,value,costs){return Some("pure-duplicate-payload-mismatch");}record.meta.calls+=1;record.meta.kernel_ns+=kernel_ns;record.meta.child_calls[id]+=1;record.meta.child_kernel_ns[id]+=kernel_ns;}
+    else {if catalog.records.len()+other_keys>=caps.max_keys{return Some("pure-observer-key-cap");}
+        if bytes.saturating_add(catalog.growth(&key))>caps.max_bytes{return Some("pure-observer-byte-cap");}
+        let mut child_calls=[0;7];child_calls[id]=1;
+        let mut child_kernel_ns=[0;7];child_kernel_ns[id]=kernel_ns;
+        catalog.insert(key,value,Produced {mask:1<<id,calls:1,kernel_ns,first_kernel_ns:kernel_ns,child_calls,child_kernel_ns,child_first_kernel_ns:child_kernel_ns});}None
+}
+fn demand<K:Key,V:Copy+PartialEq>(catalog:&mut Catalog<K,V,Demanded>,pool:&Catalog<K,V,Produced>,key:K,value:V,kernel_ns:u128,scope:Scope,caps:Caps,bytes:usize,other_keys:usize,costs:&mut Costs)->Option<&'static str> {
+    let Some(scope)=scope.index() else{return Some("pure-demand-outside-scope");};
+    let lookup=Instant::now();let found=catalog.find(&key);let supplied=pool.find(&key);costs.lookup_ns+=lookup.elapsed().as_nanos();
+    if let Some(id)=supplied {if !materialize(&pool.records[id].value,value,costs){return Some("pure-pool-demand-payload-mismatch");}}
+    if let Some(found)=found {let record=&mut catalog.records[found];if !materialize(&record.value,value,costs){return Some("pure-duplicate-payload-mismatch");}record.meta.scopes[scope].add(kernel_ns);}
+    else {if catalog.records.len()+other_keys>=caps.max_keys{return Some("pure-observer-key-cap");}
+        if (catalog.records.len()+other_keys+1).saturating_mul(DEMAND_ROW_BYTES)>DEMAND_JSON_BUDGET{return Some("pure-demand-json-cap");}
+        if bytes.saturating_add(catalog.growth(&key))>caps.max_bytes{return Some("pure-observer-byte-cap");}
