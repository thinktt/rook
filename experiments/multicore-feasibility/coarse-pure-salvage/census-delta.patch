+    if keys.saturating_mul(POOL_ROW_BYTES+PREFIX_ROW_BYTES)>POOL_PREFIX_JSON_BUDGET{return Err("pure-pool-prefix-json-cap".into());}
+    if keys>caps.max_keys||catalog.bytes()+other_bytes+catalog.growth(&record.key)+std::mem::size_of::<Pool>()>caps.max_bytes{return Err("pure-pool-key-or-byte-cap".into());}
