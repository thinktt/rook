+pub(crate) struct DemandReport {pool:Rc<Pool>,maps:Catalog<InfluenceKey,Influence,Demanded>,chains:Catalog<ChainKey,ChainValue,Demanded>,costs:Costs,peak_bytes:usize}
+#[derive(Default)]
+struct Coverage {calls:u64,unique:usize,kernel_ns:u128,first_kernel_ns:u128}
+impl Coverage {fn json(&self)->String {format!("{{\"calls\":{},\"unique_keys\":{},\"repeated_calls\":{},\"kernel_ns\":{},\"first_target_kernel_ns\":{}}}",self.calls,self.unique,self.calls-self.unique as u64,self.kernel_ns,self.first_kernel_ns)}}
+fn coverage<K:Key,V>(catalog:&Catalog<K,V,Demanded>,accept:impl Fn(&Demanded,usize)->bool)->Coverage {
+    let mut result=Coverage::default();
+    for record in &catalog.records {let mut any=false;
+        for (scope,tally) in record.meta.scopes.iter().enumerate(){if tally.calls!=0&&accept(&record.meta,scope){result.calls+=tally.calls;result.kernel_ns+=tally.kernel_ns;any=true;}}
+        if any {result.unique+=1;if accept(&record.meta,record.meta.first_scope){result.first_kernel_ns+=record.meta.first_kernel_ns;}}
+    }result
+}
+// First-only/repeat-only classifications retain one fact per exact key, then
+// subtract its global first target query in its actual scope. Prefix presence
+// and earlier target production are separate serial-memo opportunities.
+fn classified<K:Key,V>(catalog:&Catalog<K,V,Demanded>,prefix:&[Tally],scope:Option<usize>,class:u8)->Coverage {
+    let mut result=Coverage::default();
+    for record in &catalog.records {
+        let meta=&record.meta;let Some(pool_id)=meta.pool_id else{continue;};let prior=prefix[pool_id].calls!=0;
+        let first_in_scope=scope.is_none_or(|scope|scope==meta.first_scope);
+        let mut calls=0;let mut kernel_ns=0;
+        for (index,tally) in meta.scopes.iter().enumerate(){if scope.is_none_or(|scope|scope==index){calls+=tally.calls;kernel_ns+=tally.kernel_ns;}}
+        if class==0 { // Producer-first: exactly one prefix-absent first query.
+            if prior||!first_in_scope {continue;}calls=1;kernel_ns=meta.first_kernel_ns;
+        } else if class==1||(!prior&&class==2) { // Canonical-earlier repeats.
+            if first_in_scope {calls-=1;kernel_ns-=meta.first_kernel_ns;}
+        } // class2 with prefix-present includes all matching calls.
+        if calls!=0 {result.calls+=calls;result.kernel_ns+=kernel_ns;result.unique+=1;
+            if class==0||(class==2&&prior&&first_in_scope){result.first_kernel_ns+=meta.first_kernel_ns;}}
+    }result
+}
+fn demand_record_json<K,V>(id:usize,record:&Record<K,V,Demanded>)->String {
+    let rows=record.meta.scopes.iter().enumerate().filter(|(_,tally)|tally.calls!=0).map(|(index,tally)|
+        format!("{{\"index\":{},\"scope\":\"{}\",\"calls\":{},\"kernel_ns\":{}}}",index,scope_name(index),tally.calls,tally.kernel_ns)).collect::<Vec<_>>().join(",");
+    format!("{{\"demand_id\":{},\"pool_id\":{},\"producer_mask\":{},\"first_scope\":{},\"first_kernel_ns\":{},\"scopes\":[{}]}}",
+        id,record.meta.pool_id.map_or("null".into(),|id|id.to_string()),record.meta.mask,record.meta.first_scope,record.meta.first_kernel_ns,rows)
+}
+fn demand_summary<K:Key,V>(catalog:&Catalog<K,V,Demanded>,prefix:&[Tally],scope:Option<usize>)->String {
+    let in_scope=|index|scope.is_none_or(|scope|scope==index);
+    format!("\"total\":{},\"pooled\":{},\"same_intended_child\":{},\"matched_prior_prefix\":{},\"matched_prefix_absent\":{},\"producer_first\":{},\"canonical_earlier\":{},\"serial_cache_prior\":{}",
+        coverage(catalog,|_,index|in_scope(index)).json(),
+        coverage(catalog,|meta,index|in_scope(index)&&meta.pool_id.is_some()).json(),
+        coverage(catalog,|meta,index|in_scope(index)&&(1..8).contains(&index)&&meta.mask&(1<<(index-1))!=0).json(),
+        coverage(catalog,|meta,index|in_scope(index)&&meta.pool_id.is_some_and(|id|prefix[id].calls!=0)).json(),
+        coverage(catalog,|meta,index|in_scope(index)&&meta.pool_id.is_some_and(|id|prefix[id].calls==0)).json(),
+        classified(catalog,prefix,scope,0).json(),classified(catalog,prefix,scope,1).json(),classified(catalog,prefix,scope,2).json())
+}
+fn demand_json<K:Key,V>(catalog:&Catalog<K,V,Demanded>,prefix:&[Tally])->String {
+    let scopes=(0..9).map(|index|format!("{{\"scope\":\"{}\",{}}}",scope_name(index),demand_summary(catalog,prefix,Some(index)))).collect::<Vec<_>>().join(",");
+    let rows=catalog.records.iter().enumerate().map(|(id,record)|demand_record_json(id,record)).collect::<Vec<_>>().join(",");
