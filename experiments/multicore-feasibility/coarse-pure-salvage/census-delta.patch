+}
+fn prefix<K:Key,V:Copy+PartialEq>(pool:&Catalog<K,V,Produced>,seen:&mut [Tally],calls:&mut Tally,matched:&mut Tally,key:K,value:V,kernel_ns:u128,costs:&mut Costs)->Option<&'static str> {
+    calls.add(kernel_ns);let lookup=Instant::now();let supplied=pool.find(&key);costs.lookup_ns+=lookup.elapsed().as_nanos();
+    if let Some(id)=supplied {if !materialize(&pool.records[id].value,value,costs){return Some("pure-pool-prefix-payload-mismatch");}seen[id].add(kernel_ns);matched.add(kernel_ns);}None
+}
