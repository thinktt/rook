+            reconstructed.ensure_influence_for_search(&position,&mut restored_scratch,true);
+            // Neither detached reconstruction may append to the source's local
+            // Rc observer; its single map/chain call counts below prove this.
+            observed.research_attach_pure_observer(None).unwrap();let store=context.finish_producer().unwrap();
+            assert_eq!(store.maps.records.iter().map(|r|r.meta.calls).sum::<u64>(),1);
+            assert_eq!(store.chains.records.iter().map(|r|r.meta.calls).sum::<u64>(),1);
+            assert_eq!(store.chains.records[0].key.map,custom);
+        }
+    }
+    #[test]
+    fn prefix_and_earlier_target_repeats_partition_previously_unavailable_values() {
+        let position=position();let map=Influence::build(&position);let pool=pool_with_maps(&position,&[map,map]);
+        let canonical=Context::canonical(epoch(),pool.clone(),Caps::canonical()).unwrap();
+        {let _scope=canonical.set_scope(Scope::Coordinator);canonical.influence(&position,Route::Scalar,map,11);}
+        {let _scope=canonical.set_scope(Scope::Queued(0));canonical.influence(&position,Route::Scalar,map,17);canonical.influence(&position,Route::Scalar,map,19);}
+        let report=canonical.finish_canonical().unwrap();let prefix=Context::prefix(epoch(),pool,Caps::canonical()).unwrap().finish_prefix().unwrap();
+        let first=classified(&report.maps,&prefix.maps,None,0);let repeated=classified(&report.maps,&prefix.maps,None,1);
+        assert_eq!((first.calls,first.unique,first.kernel_ns),(1,1,11));assert_eq!((repeated.calls,repeated.unique,repeated.kernel_ns),(2,1,36));
+        assert_eq!(coverage(&report.maps,|meta,index|(1..8).contains(&index)&&meta.mask&(1<<(index-1))!=0).calls,2);
+        let mut prior=prefix.maps;prior[0].add(5);
+        assert_eq!(classified(&report.maps,&prior,None,0).calls,0);
+        assert_eq!(classified(&report.maps,&prior,None,2).calls,3);
+        assert_eq!(coverage(&report.maps,|_,index|index==1).first_kernel_ns,0,"first cost belongs only to actual first scope");
+    }
