+    fn index_accounting_covers_physical_buckets_controls_and_growth() {
+        for (usable,physical) in [(0,0),(3,4),(7,8),(14,16),(28,32),(56,64)] {
+            assert_eq!(physical_index_buckets(usable),physical);
+            if usable!=0 {assert!(index_allocation_bytes(usable)>usable*(std::mem::size_of::<(u64,Vec<usize>)>()+1));}
+        }
+        let position=position();let mut catalog=Catalog::<InfluenceKey,Influence,Produced>::new();
+        let value=Influence::build(&position);
+        for nonce in 0..80 {let mut key=InfluenceKey::new(&position,Route::Scalar);key.placement.board[0]=Piece(nonce);
+            let admission=catalog.bytes()+catalog.growth(&key);catalog.insert(key,value,Produced::default());
+            assert!(catalog.bytes()<=admission,"growth admission must cover the actual rounded allocation");
+            assert_eq!(catalog.bucket_slots,catalog.buckets.values().map(|ids|ids.capacity()).sum::<usize>());
+        }
+        let mut too_many=position;too_many.counts[0][0]=17;
+        assert!(std::panic::catch_unwind(||Placement::new(&too_many,false)).is_err(),"private16-slot domain is explicit");
