+pub(crate) struct PrefixReport {epoch:RootEpoch,pool:Rc<Pool>,maps:Vec<Tally>,chains:Vec<Tally>,calls:[Tally;2],matched:[Tally;2],costs:Costs}
+impl PrefixReport {pub(crate) fn failed(&self)->bool {false}
+    pub(crate) fn json(&self)->String {format!("{{\"failed\":false,\"influence\":{},\"chain\":{},\"membership_bytes\":{},\"timings\":{}}}",
+        prefix_json(self.calls[0],self.matched[0],&self.maps),prefix_json(self.calls[1],self.matched[1],&self.chains),
