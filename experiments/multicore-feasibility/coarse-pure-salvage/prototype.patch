+/// Explicit little-endian field encoding keeps native padding, hash-map order
+/// and platform hash seeds out of the boundary provenance fingerprint.
+#[cfg(feature = "branch-transactions")]
+fn research_native_digest(generation: u8, count: usize, groups: impl Iterator<Item = Group>) -> u64 {
+    fn feed(hash: &mut u64, bytes: &[u8]) {
+        for byte in bytes {
+            *hash ^= *byte as u64;
+            *hash = hash.wrapping_mul(0x100000001b3);
+        }
+    }
+    let mut hash = 0xcbf29ce484222325;
+    feed(&mut hash, &[generation]);
+    feed(&mut hash, &(count as u64).to_le_bytes());
+    for group in groups {
+        for record in group.records {
+            feed(&mut hash, &record.identity.to_le_bytes());
+            feed(&mut hash, &record.score.to_le_bytes());
+            feed(&mut hash, &record.depth.to_le_bytes());
+            feed(&mut hash, &record.endpoints.to_le_bytes());
+            feed(&mut hash, &[record.flags, record.generation]);
+        }
+    }
+    hash
