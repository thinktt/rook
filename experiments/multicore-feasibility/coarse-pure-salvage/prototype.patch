+                let output=returned.ok().map(|score|Output::capture(search,node,token.ply,score,token.stats,token.evaluations));
+                if output.as_ref().is_some_and(|o|o.stats.nodes>s.caps.max_recorded_nodes){mark_censored(s,"recorded-node-cap");}
+                let segment=&mut s.forest.segments[id];segment.end=end;segment.end_cursor=cursor;segment.gross_ns=gross;segment.descendant_hooks_ns=descendant_hooks;
