+#[cfg(feature = "branch-transactions")]
+fn research_group_map_bytes(capacity: usize) -> usize {
+    let buckets = if capacity == 0 { 0 } else { (capacity + 1).next_power_of_two() };
+    buckets * (std::mem::size_of::<(usize, Group)>() + 1)
