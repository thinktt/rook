+    #[test]
+    fn completed_log_is_send_and_detached_from_live_thread_local_sink() {
+        fn assert_send<T: Send>() {}
+        assert_send::<Event>();
+        assert_send::<Log>();
+        let log = std::thread::spawn(|| {
+            let sink = Sink::bounded(2, std::mem::size_of::<Log>() + 2 * std::mem::size_of::<Event>());
+            let retained_sink = sink.clone();
+            sink.record(Event::LearningClearNext { ply: 1 });
+            let completed = sink.finish();
+            retained_sink.record(Event::LearningClearNext { ply: 2 });
+            retained_sink.record(Event::LearningClearNext { ply: 3 });
+            retained_sink.record(Event::LearningClearNext { ply: 4 });
+            let remaining = retained_sink.finish();
+            assert!(remaining.overflowed && remaining.event_overflowed);
+            assert_eq!(remaining.events.len(), 2);
+            assert_eq!(completed.events.len(), 1, "later writes cannot change completed storage");
+            completed
