+        assert_eq!(canonical_sink.cursor().attempted, 0, "replay must not record recursively");
+        base.probe(query(0));
+        assert_eq!(canonical_sink.cursor().attempted, 1, "canonical sink must stay attached");
+        stage.begin(&base);
