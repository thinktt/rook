+/// Reusable research-only overlay. Only touched 48-byte groups are copied.
+/// The coordinator must keep `base` unchanged between begin and commit/discard;
+/// generation/count checks catch reset/reallocation, not concurrent group writes.
+#[cfg(feature = "branch-transactions")]
+pub(crate) struct SparseStage {
+    groups: std::collections::HashMap<usize, Group>,
+    max_groups: usize,
+    base_generation: u8,
+    base_count: usize,
+    active: bool,
+    failed: bool,
+}
+
+#[cfg(feature = "branch-transactions")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SparseStageError {
+    GroupLimit,
+    BaseChanged,
+    Inactive,
+}
+
+#[cfg(feature = "branch-transactions")]
+impl SparseStage {
+    pub(crate) fn new(max_groups: usize) -> Self {
+        Self { groups: std::collections::HashMap::new(), max_groups,
+            base_generation: 0, base_count: 0, active: false, failed: false }
+    }
+
+    /// Reuses allocation. Hash-map clearing cost is included in attempt setup.
+    pub(crate) fn begin(&mut self, base: &RememberedTable) {
+        self.groups.clear();
+        self.base_generation = base.generation;
+        self.base_count = base.group_count();
+        self.active = true;
+        self.failed = false;
+    }
+
+    fn check(&mut self, base: &RememberedTable) -> Result<(), SparseStageError> {
+        let error = if !self.active || self.failed { Some(SparseStageError::Inactive) }
+            else if base.generation != self.base_generation || base.group_count() != self.base_count {
+                Some(SparseStageError::BaseChanged)
+            } else { None };
+        if let Some(error) = error { self.failed = true; Err(error) } else { Ok(()) }
+    }
+
+    fn group(&mut self, base: &RememberedTable, index: usize) -> Result<&mut Group, SparseStageError> {
+        self.check(base)?;
+        if !self.groups.contains_key(&index) {
+            if self.groups.len() == self.max_groups {
+                self.failed = true;
+                return Err(SparseStageError::GroupLimit);
+            }
+            self.groups.insert(index, base.research_group(index));
+        }
+        Ok(self.groups.get_mut(&index).unwrap())
+    }
+
+    pub(crate) fn probe(&mut self, base: &RememberedTable, query: Query)
+        -> Result<ProbeResult, SparseStageError> {
+        let required = query.remaining_depth();
+        let generation = self.base_generation;
+        Ok(self.group(base, query.group)?.probe(query, required, generation))
+    }
+
+    pub(crate) fn store(&mut self, base: &RememberedTable, store: Store)
+        -> Result<(), SparseStageError> {
+        let generation = self.base_generation;
+        self.group(base, store.query.group)?.store(store, generation);
+        Ok(())
+    }
+
+    /// Publishes all touched groups only after the caller validates the range.
+    /// No journal hook runs here: replay effects are not new native demands.
+    pub(crate) fn commit(&mut self, base: &mut RememberedTable) -> Result<usize, SparseStageError> {
+        self.check(base)?;
+        let touched = self.groups.len();
+        for (index, group) in self.groups.drain() { base.research_set_group(index, group); }
+        self.active = false;
+        Ok(touched)
+    }
+
+    pub(crate) fn discard(&mut self) {
+        self.groups.clear();
+        self.active = false;
+        self.failed = false;
+    }
+
+    pub(crate) fn invalidate(&mut self) { self.failed = true; }
+
+    pub(crate) fn touched_groups(&self) -> usize { self.groups.len() }
+
+    pub(crate) fn touched_bytes(&self) -> usize { self.groups.len() * std::mem::size_of::<Group>() }
+
+    /// Conservative capacity rounding for buckets + control bytes; excludes
+    /// allocator bookkeeping and makes no claim of an exact allocator census.
+    pub(crate) fn estimated_bytes(&self) -> usize {
+        std::mem::size_of::<Self>() + research_group_map_bytes(self.groups.capacity())
+    }
+}
