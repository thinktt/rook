+//! Research-only pure-kernel production/demand census. No observed payload is
+//! installed in an evaluator, map scratch, score, retained node or work counter.
+//! Each lookup uses an exact typed key within one immutable, exactly checked
+//! root epoch. Hashes only locate buckets; equality never trusts a fingerprint.
+use std::{cell::RefCell,collections::HashMap,fmt::Write,hint::black_box,rc::Rc,time::Instant};
+use crate::{activity::Activity,evaluation::RootContext,evaluator::Parameters,influence::Influence,
+    position::Position,shelter::Shelter,types::{Color,Piece,PieceKind,Square}};
+
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub(crate) struct RootEpoch {
+    side:Color,phase:[u16;3],counts:[[u8;6];2],values:[[i32;5];2],squares:[[[i16;64];5];2],average:i32,
+    own:[i32;11],opponent:[i32;11],parameter_average:i32,draw:i32,opponent_selectivity:i32,
+    draw_preference:i32,variation:u32,weights:[[i32;2];5],
+}
+impl RootEpoch {
+    pub(crate) fn new(root:&RootContext,parameters:&Parameters,draw_preference:i32,variation:u32,weights:[[i32;2];5])->Self {
+        Self {side:root.side,phase:[root.phase.opening,root.phase.middlegame,root.phase.endgame],counts:root.counts,
+            values:root.values,squares:root.squares,average:root.average_depth,own:parameters.own,opponent:parameters.opponent,
+            parameter_average:parameters.average_depth,draw:parameters.draw,opponent_selectivity:parameters.opponent_selectivity,
+            draw_preference,variation,weights}
+    }
+}
+// Prospective256MiB report partition: pool incidence plus bounded prefix
+// incidence128MiB; canonical demand incidence96MiB; fixed summaries, seven
+// producer summaries, fixture and dispatcher fields reserve32MiB. Pool row
+// (seven u64 call counts, fourteen u128 kernel/first costs, IDs/mask) fits1024B;
+// prefix row fits160B; demand row with all nine scope rows fits1536B. Controls
+// below exercise maximum integer widths through the actual serializers.
+const POOL_PREFIX_JSON_BUDGET:usize=128*1024*1024;
+const DEMAND_JSON_BUDGET:usize=96*1024*1024;
+const POOL_ROW_BYTES:usize=1024;
+const PREFIX_ROW_BYTES:usize=160;
+const DEMAND_ROW_BYTES:usize=1536;
+
+#[derive(Clone,Copy,Debug)]
+pub(crate) struct Caps {pub(crate) max_keys:usize,pub(crate) max_calls:u64,pub(crate) max_bytes:usize}
+impl Caps {pub(crate) fn producer()->Self {Self {max_keys:262144,max_calls:4194304,max_bytes:64*1024*1024}}
+    pub(crate) fn pool()->Self {Self {max_keys:1835008,max_calls:29360128,max_bytes:512*1024*1024}}
+    pub(crate) fn canonical()->Self {Self {max_keys:262144,max_calls:4194304,max_bytes:128*1024*1024}}}
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub(crate) enum Route {Scalar,Coherent}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub(crate) enum Scope {Inactive,Prefix,Coordinator,Queued(usize),Suffix}
+impl Scope {fn index(self)->Option<usize> {match self {Self::Coordinator=>Some(0),Self::Queued(id) if id<7=>Some(id+1),Self::Suffix=>Some(8),_=>None}}}
+fn scope_name(index:usize)->String {match index {0=>"coordinator".into(),8=>"suffix".into(),id=>format!("queued-{}",id-1)}}
+
+/// Actual placement owners are copied without inferring board/list/plane
+/// coherence. Unused source slots are removed; active multiplicity is retained.
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct Placement {board:[Piece;64],counts:[[u8;6];2],sources:[[Square;16];2]}
+impl Placement {
+    fn new(position:&Position,sort:bool)->Self {
+        let mut sources=[[Square(64);16];2];
+        for color in [Color::White,Color::Black] {
+            // The frozen private native domain shares Position's16 source
+            // slots per color; successful kernel calls already require this.
+            let population=position.counts[color.index()].iter().map(|&count|count as usize).sum::<usize>();
+            assert!(population<=16,"pure census native source population exceeds16");
+            let mut offset=0;
+            for kind in PieceKind::ALL {let actual=position.piece_squares(color,kind);let end=offset+actual.len();
+                sources[color.index()][offset..end].copy_from_slice(actual);
+                if sort {sources[color.index()][offset..end].sort_unstable_by_key(|square|square.0);}
+                offset=end;
+            }
+        }
+        Self {board:position.board,counts:position.counts,sources}
+    }
+    fn hash(&self)->u64 {
+        // Congruent with projected key equality, including malformed public
+        // fingerprints. Policy hashes/rights/side/EP never select a bucket.
+        let mut hash=1469598103934665603u64;
+        for piece in self.board {hash=(hash^piece.0 as u64).wrapping_mul(1099511628211);}
+        hash
+    }
+}
+trait Key:PartialEq {fn bucket(&self)->u64;}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct InfluenceKey {placement:Placement,planes:[u64;4],route:Route}
+impl InfluenceKey {fn new(position:&Position,route:Route)->Self {
+    // Each source contributes independent wrapping sums, including the coherent
+    // bit-sliced sums. Per-kind sorting preserves duplicates/multiplicity.
+    Self {placement:Placement::new(position,true),planes:*position.attack_planes(),route}
+}}
+impl Key for InfluenceKey {fn bucket(&self)->u64 {self.placement.hash()}}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct ChainKey {placement:Placement,starting_units:u8,map:Influence,material:i32,mobility:[i32;2],shelter:[i32;2]}
+impl ChainKey {fn new(position:&Position,map:&Influence,material:i32,mobility:[i32;2],shelter:[i32;2])->Self {
+    // Chain source chronology is kept conservatively. Phase reads starting_units
+    // and counts; Activity/Shelter read this supplied map, never a rebuilt map.
+    Self {placement:Placement::new(position,false),starting_units:position.starting_units,map:*map,material,mobility,shelter}
+}}
+impl Key for ChainKey {fn bucket(&self)->u64 {self.placement.hash()}}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct ChainValue {activity:Activity,shelter:Shelter}
+#[derive(Clone,Copy,Default)]
+struct Produced {mask:u8,calls:u64,kernel_ns:u128,first_kernel_ns:u128,child_calls:[u64;7],child_kernel_ns:[u128;7],child_first_kernel_ns:[u128;7]}
+#[derive(Clone,Copy,Default)]
+struct Tally {calls:u64,kernel_ns:u128}
+impl Tally {fn add(&mut self,kernel_ns:u128) {self.calls+=1;self.kernel_ns+=kernel_ns;}}
+struct Demanded {pool_id:Option<usize>,mask:u8,first_scope:usize,first_kernel_ns:u128,scopes:[Tally;9]}
+struct Record<K,V,M> {key:K,value:V,meta:M}
+// std HashMap::capacity reports usable entries, excluding load-factor slack.
+// For this frozen64-bit Rust/hashbrown representation, round(capacity+1) to
+// physical power-of-two buckets. Charge each data bucket and control byte,
+// plus64 bytes covering the control tail and allocation-alignment padding.
+// Allocator bookkeeping outside the allocation remains explicitly excluded.
+fn physical_index_buckets(usable:usize)->usize {
+    if usable==0 {0}else{usable.saturating_add(1).checked_next_power_of_two().unwrap_or(usize::MAX)}
+}
+fn index_bytes_for_buckets(buckets:usize)->usize {
+    if buckets==0 {0}else{buckets.saturating_mul(std::mem::size_of::<(u64,Vec<usize>)>()+1).saturating_add(64)}
+}
+fn index_allocation_bytes(usable:usize)->usize {index_bytes_for_buckets(physical_index_buckets(usable))}
+struct Catalog<K,V,M> {records:Vec<Record<K,V,M>>,buckets:HashMap<u64,Vec<usize>>,bucket_slots:usize}
+impl<K:Key,V,M> Catalog<K,V,M> {
+    fn new()->Self {Self {records:Vec::new(),buckets:HashMap::new(),bucket_slots:0}}
+    fn find(&self,key:&K)->Option<usize> {self.buckets.get(&key.bucket()).and_then(|ids|ids.iter().copied().find(|&id|self.records[id].key==*key))}
+    fn bytes(&self)->usize {std::mem::size_of::<Self>()+self.records.capacity()*std::mem::size_of::<Record<K,V,M>>()
+        +index_allocation_bytes(self.buckets.capacity())
+        +self.bucket_slots*std::mem::size_of::<usize>()}
+    fn growth(&self,key:&K)->usize {
+        let record=if self.records.len()==self.records.capacity(){
+            let wanted=if self.records.capacity()==0 {8}else{self.records.capacity()*2};
+            (wanted-self.records.capacity())*std::mem::size_of::<Record<K,V,M>>()
+        }else{0};
+        let index=match self.buckets.get(&key.bucket()) {
+            Some(ids) if ids.len()==ids.capacity()=>ids.capacity().max(1)*std::mem::size_of::<usize>(),Some(_)=>0,
+            None=>std::mem::size_of::<usize>()+if self.buckets.len()==self.buckets.capacity() {
+                // First allocation has4 physical buckets; later growth doubles
+                // them. Admission includes load slack, control tail and padding.
+                let before=physical_index_buckets(self.buckets.capacity());
+                let after=if before==0 {4}else{before.saturating_mul(2)};
+                index_bytes_for_buckets(after).saturating_sub(index_bytes_for_buckets(before))
+            }else{0},
+        };record+index
+    }
+    fn insert(&mut self,key:K,value:V,meta:M)->usize {let bucket=key.bucket();let id=self.records.len();
+        if id==self.records.capacity(){let wanted=if id==0 {8}else{id*2};self.records.reserve_exact(wanted-id);}
+        self.records.push(Record {key,value,meta});let ids=self.buckets.entry(bucket).or_default();
+        if ids.len()==ids.capacity(){let before=ids.capacity();ids.reserve_exact(before.max(1));self.bucket_slots+=ids.capacity()-before;}ids.push(id);id
+    }
+}
+#[derive(Clone,Copy,Default)]
+struct Costs {observer_ns:u128,key_ns:u128,lookup_ns:u128,materialize_ns:u128,materialized_bytes:u64,epoch_check_ns:u128}
+impl Costs {fn json(&self)->String {format!("{{\"capture_dedup_observer_ns\":{},\"key_construction_ns\":{},\"lookup_full_equality_ns\":{},\"materialization_ns\":{},\"materialized_bytes\":{},\"epoch_check_ns\":{}}}",
+    self.observer_ns,self.key_ns,self.lookup_ns,self.materialize_ns,self.materialized_bytes,self.epoch_check_ns)}}
+// materialization_ns includes the black_box copy AND full payload equality
+// audit. It must not be interpreted as an isolated pure-copy delivery cost.
+fn materialize<V:Copy+PartialEq>(expected:&V,actual:V,costs:&mut Costs)->bool {
+    let started=Instant::now();let copy=black_box(*expected);let equal=black_box(copy)==black_box(actual);
+    black_box(equal);costs.materialize_ns+=started.elapsed().as_nanos();costs.materialized_bytes+=std::mem::size_of::<V>() as u64;equal
+}
+fn produced_json<K:Key,V>(catalog:&Catalog<K,V,Produced>)->String {
+    let calls=catalog.records.iter().map(|r|r.meta.calls).sum::<u64>();
+    format!("{{\"calls\":{},\"unique_keys\":{},\"repeated_calls\":{},\"payload_bytes\":{},\"retained_bytes\":{},\"kernel_ns\":{},\"first_unique_kernel_ns\":{}}}",calls,catalog.records.len(),calls-catalog.records.len() as u64,
+        catalog.records.len()*std::mem::size_of::<V>(),catalog.bytes(),catalog.records.iter().map(|r|r.meta.kernel_ns).sum::<u128>(),catalog.records.iter().map(|r|r.meta.first_kernel_ns).sum::<u128>())
+}
+fn pool_record_json<K,V>(id:usize,record:&Record<K,V,Produced>)->String {
+    format!("{{\"pool_id\":{},\"producer_mask\":{},\"producer_calls\":{:?},\"producer_kernel_ns\":{:?},\"producer_first_unique_kernel_ns\":{:?},\"first_unique_kernel_ns\":{}}}",
