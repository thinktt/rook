+#[test]
+fn mode2_terminal_shutdown_dominates_nested_checkpoint_depth_restoration() {
+    let position = Position::from_fen(START).unwrap();
+    let mut evaluator = Evaluator::<true>::new(&position);
+    evaluator.set_threads_with_affinity(2, || Ok(3)).unwrap();
+    let mut outer = evaluator.full_activation_checkpoint();
+    evaluator.open_full_activation(&mut outer).unwrap();
+    let mut inner = evaluator.full_activation_checkpoint();
+    evaluator.open_full_activation(&mut inner).unwrap();
+    assert_eq!(evaluator.current_activation_depth, 2);
+    evaluator.full_worker.as_mut().unwrap().shutdown().unwrap();
+    evaluator.restore_full_activation(inner).unwrap();
+    assert_eq!(evaluator.current_activation_depth, 0);
+    evaluator.restore_full_activation(outer).unwrap();
+    assert_eq!(evaluator.current_activation_depth, 0);
+    let mut terminal = evaluator.full_activation_checkpoint();
+    assert!(evaluator.open_full_activation(&mut terminal).is_err());
+    evaluator.restore_full_activation(terminal).unwrap();
+    assert_eq!(evaluator.current_activation_depth, 0);
+    evaluator.set_threads(1).unwrap();
+}
