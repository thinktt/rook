+#[test]
+fn quiescence_observer_unwind_closes_its_enclosing_search_owner() {
+    struct Observe(crate::colors_worker::ColorsWorkerObserver);
+    impl Observer for Observe {
+        const ENABLED: bool = true;
+        type Parent = ();
+        type Frame = ();
+        fn parent(_: &Retained) {}
+        fn enter(&mut self, _: &Position, _: Entry, _: Option<Move>, _: (),
+            _: Retained, _: bool, _: Work) {}
+        fn stage(&mut self, _: EvaluationStage) {
+            assert!(!self.0.is_parked());
+            panic!("quiescence observer unwind");
+        }
+        fn ordered(&mut self) {}
+        fn leave(&mut self, _: (), _: Retained, _: i32, _: &[Move], _: Work) {}
+    }
+    let position = Position::from_fen(START).unwrap();
+    let mut search = Search::<true>::new(&position);
+    search.evaluator.set_threads_with_affinity(3, || Ok(3)).unwrap();
+    let root = search.prepare_root(position);
+    let mut legal = crate::movegen::MoveList::new();
+    crate::movegen::generate_legal(&position, &mut legal);
+    let movement = legal.as_slice()[0];
+    let mut child = root.child(&search.evaluator.root, movement);
+    let mut history = SearchHistory::new(&position);
+    history.push(&child.position, Some(movement));
+    let mut observer = Observe(search.evaluator.colors_worker.as_ref().unwrap().test_observer());
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        search.search_subtree_observed(&mut child, &mut history,
+            Entry { ply: 1, target: 1, iteration_depth: 1, lower: -10000,
+                upper: 10000, analysis: 0, capture_exception: false },
+            Limits::default(), &root.retained, &mut observer).unwrap();
+    }));
+    panic_message(result, "quiescence observer unwind");
+    assert!(observer.0.is_parked());
+    assert_eq!(history.search_ply(), 1);
+}
