+#[test]
+fn standalone_full_fresh_and_stage_observers_run_after_actual_parking() {
+    let (mut evaluator, position, influence) = configured();
+    let parked = evaluator.colors_worker.as_ref().unwrap().test_observer();
+    for kind in 0..5 {
+        let mut node = Node::root(position, &evaluator.root);
+        let mut calls = 0;
+        let (value, trace) = depths(|| match kind {
+            0 => evaluator.full_observed(&mut node, &influence, false,
+                |_| { assert!(parked.is_parked()); calls += 1; }),
+            1 => evaluator.full_detailed_observed(&mut node, &influence, false,
+                |_| { assert!(parked.is_parked()); calls += 1; }),
+            2 => evaluator.fresh_observed(&mut node, &influence, false,
+                |_| { assert!(parked.is_parked()); calls += 1; }),
+            3 => evaluator.fresh_detailed_observed(&mut node, &influence, false,
+                |_| { assert!(parked.is_parked()); calls += 1; }),
+            _ => evaluator.full_stage_observed(&mut node, &influence,
+                |_| { assert!(parked.is_parked()); calls += 1; }),
+        });
+        assert_eq!(calls, 1);
+        assert_eq!(trace, [1, 0]);
+        assert_eq!(node.retained.age, 0);
+        assert!(value.relation_queries > 0);
+    }
+    let mut node = Node::root(position, &evaluator.root);
+    let score = evaluator.fast(&node, false).score;
+    let before = evaluator.stats.full;
+    let (selection, trace) = depths(|| evaluator.select_noncheck(
+        &mut node, score + 250, score + 251, false, &mut None,
+    ));
+    assert!(!selection.initially_full && !selection.refreshed);
+    assert!(trace.is_empty());
+    assert_eq!(evaluator.stats.full, before);
+    assert!(parked.is_parked());
+}
