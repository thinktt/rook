+/// cleanup path itself panics. Both wrappers call this only after attempting to
+/// restore the actual original receiver.
+pub(crate) fn finish_activation<R>(
+    result: std::thread::Result<R>,
+    cleanup: std::thread::Result<Result<(), String>>,
+) -> R {
+    match result {
+        Ok(value) => {
+            match cleanup {
+                Ok(Ok(())) => {}
+                Ok(Err(error)) => panic!("FULL worker scope closure failed: {error}"),
+                Err(panic) => std::panic::resume_unwind(panic),
+            }
+            value
+        }
+        Err(panic) => {
+            match cleanup {
