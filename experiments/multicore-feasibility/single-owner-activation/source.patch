+//! Focused controls for the enclosing owner contract. Worker reader gates and
+//! terminal retirement remain in colors_worker tests; these use real entries.
+use super::*;
+use crate::engine::Search;
+use crate::history::SearchHistory;
+use crate::quiescence::{Entry, Limits, Observer, Work};
+use std::cell::RefCell;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+thread_local! {
+    static DEPTHS: RefCell<Option<Vec<usize>>> = const { RefCell::new(None) };
+}
+
+pub(super) fn record_depth(depth: usize) {
+    DEPTHS.with(|cell| {
+        if let Some(depths) = cell.borrow_mut().as_mut() { depths.push(depth); }
+    });
+}
+
+fn depths<R>(body: impl FnOnce() -> R) -> (R, Vec<usize>) {
+    struct Clear;
+    impl Drop for Clear { fn drop(&mut self) { DEPTHS.with(|cell| { cell.borrow_mut().take(); }); } }
+    DEPTHS.with(|cell| { assert!(cell.borrow().is_none()); *cell.borrow_mut() = Some(Vec::new()); });
+    let _clear = Clear;
+    let result = body();
+    let values = DEPTHS.with(|cell| cell.borrow_mut().take().unwrap());
+    (result, values)
+}
+
+fn configured() -> (Evaluator<true>, Position, Influence) {
+    let position = Position::from_fen(START).unwrap();
+    let mut evaluator = Evaluator::new(&position);
+    evaluator.set_threads_with_affinity(3, || Ok(3)).unwrap();
+    (evaluator, position, Influence::build(&position))
+}
+
+fn panic_message(result: std::thread::Result<()>, expected: &str) {
+    let panic = result.unwrap_err();
+    assert_eq!(panic.downcast_ref::<&str>().copied(), Some(expected));
+}
+
+#[test]
+fn actual_first_iteration_keeps_outer_activation_across_nested_public_entries() {
+    let position = Position::from_fen(START).unwrap();
+    for budget in [2, 3] {
+        let mut search = Search::<true>::new(&position);
+        search.evaluator.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+        let mut history = SearchHistory::new(&position);
+        let (result, trace) = depths(|| crate::first_iteration::run(
+            &mut search, position, &mut history, Limits::default(),
+        ));
+        assert_eq!(result.unwrap().candidates.len(), 20);
+        assert_eq!(trace.first(), Some(&1));
+        assert_eq!(trace.last(), Some(&0));
+        assert_eq!(trace.len(), 44); // outer + root + twenty real child entries
+        for nested in trace[1..trace.len() - 1].chunks_exact(2) { assert_eq!(nested, [2, 1]); }
+        let (result, stopped) = depths(|| crate::first_iteration::run(
+            &mut search, position, &mut history, Limits { nodes: Some(0) },
+        ));
+        assert!(result.is_err());
+        assert_eq!(stopped, [1, 2, 1, 2, 1, 0]);
+        assert_eq!(history.search_ply(), 0);
+        if let Some(worker) = search.evaluator.colors_worker.as_ref() { assert!(worker.is_parked()); }
+        if let Some(worker) = search.evaluator.full_worker.as_ref() { assert!(worker.is_parked()); }
+    }
+}
