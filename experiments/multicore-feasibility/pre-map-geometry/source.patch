+#[test]
+fn budgets_noncoherent_knight_only_and_fast_only_paths_keep_staging_dormant() {
+    for (budget, fen, coherent) in [(1, START, true), (2, START, true),
+        (3, START, false), (3, "7k/8/8/3n4/8/2N5/8/K7 w - - 0 1", true)] {
+        let (mut evaluator, position) = configured(fen, true, budget);
+        let mut node = Node::root(position, &evaluator.root);
+        let mut scratch = None;
+        evaluator.full_root_for_search(&mut node, &mut scratch, false, coherent);
+        assert!(scratch.is_some());
+        assert_eq!(ready(&evaluator), 0);
+    }
+    let (mut evaluator, position) = configured(START, true, 3);
+    let mut node = Node::root(position, &evaluator.root);
+    let score = evaluator.fast(&node, false).score;
+    let mut scratch = None;
+    let mut list = MoveList::new();
+    let (selection, prepared) = evaluator.select_noncheck_q_inventory(&mut node,
+        score + 250, score + 251, false, &mut scratch, true, true, &mut list);
+    assert!(!selection.initially_full && !selection.refreshed && !prepared);
+    assert!(scratch.is_none());
+    assert_eq!(ready(&evaluator), 0);
