+/// Position-only geometry for the same immutable, coherently maintained side.
+/// Records follow the original N/B/R/Q lists, with no source or kind header.
+/// Slider bytes hold the direct prefix in the low nibble and the visited
+/// prefix in the high nibble. Knights use byte zero for ordered admission bits.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(C)]
+pub(crate) struct SideGeometry {
+    records: [[u8; 8]; 15],
+    friendly: u64,
+}
+
+const _: [(); 128] = [(); std::mem::size_of::<SideGeometry>()];
+
+/// This private route requires coherent attack planes and replay against the
+/// same Position/color. Empty squares must not enter the friendly mask.
+pub(crate) fn prepare_side_geometry(position: &Position, color: Color) -> SideGeometry {
+    let planes = position.attack_planes();
+    let occupied = planes[0] | planes[1] | planes[2];
+    let side = if color == Color::White { !planes[3] } else { planes[3] };
+    let mut geometry = SideGeometry {
+        records: [[0; 8]; 15],
+        friendly: occupied & side,
+    };
+    let mut record = 0;
+    for kind in [PieceKind::Knight, PieceKind::Bishop, PieceKind::Rook, PieceKind::Queen] {
+        for &source in position.piece_squares(color, kind) {
+            let entry = &mut geometry.records[record];
+            record += 1;
+            if kind == PieceKind::Knight {
+                let targets = &KNIGHT_SOURCES[source.0 as usize];
+                for (index, &target) in targets.squares[..targets.len as usize].iter().enumerate() {
+                    if geometry.friendly & (1u64 << target) == 0 {
+                        entry[0] |= 1 << index;
+                    }
+                }
+                continue;
+            }
+            for direction in activity_directions(kind) {
+                let step = DIRECTIONS[direction];
+                let ray = &ATTACK_RAYS.0[source.0 as usize][direction];
+                let mut direct = ray.len;
+                let mut visited = ray.len;
+                let mut occupied_seen = false;
+                for (index, &target) in ray.squares[..ray.len as usize].iter().enumerate() {
+                    let victim = position.board[target as usize];
+                    if victim.is_empty() {
+                        continue;
+                    }
+                    // The first occupied target is still direct, even when
+                    // it is friendly or transparent to subsequent targets.
+                    if !occupied_seen {
+                        direct = index as u8 + 1;
+                        occupied_seen = true;
+                    }
+                    if !transparent(color, kind, step, victim) {
+                        visited = index as u8 + 1;
+                        break;
+                    }
+                }
+                entry[direction] = direct | (visited << 4);
+            }
+        }
+    }
+    geometry
