+//! Focused actual-owner controls; worker gates separately cover cell retirement.
+use super::*;
+use crate::engine::Search;
+use crate::history::SearchHistory;
+use crate::movegen::MoveList;
+use crate::quiescence::Limits;
+use std::cell::Cell;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const SPARSE: &str = "7k/7r/8/8/8/8/R7/K7 w - - 0 1";
+thread_local! {
+    static PANIC_PRE_MAP: Cell<bool> = const { Cell::new(false) };
+    static FRESH_DISPATCHES: Cell<usize> = const { Cell::new(0) };
+}
+
+pub(super) fn after_fresh_dispatch<const D: bool>(evaluator: &Evaluator<D>) {
+    FRESH_DISPATCHES.with(|count| count.set(count.get() + 1));
+    if PANIC_PRE_MAP.with(|flag| flag.replace(false)) {
+        assert!(evaluator.full_activation_depth() > 0);
+        panic!("pre-map owner unwind");
+    }
+}
+
+fn configured(fen: &str, enabled: bool, budget: usize) -> (Evaluator<true>, Position) {
+    let position = Position::from_fen(fen).unwrap();
+    let mut evaluator = Evaluator::new(&position);
+    evaluator.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+    evaluator.set_owner_local_inventory(true).unwrap();
+    evaluator.set_q_owner_local_inventory(true).unwrap();
+    evaluator.set_pre_map_geometry(enabled).unwrap();
+    (evaluator, position)
+}
+
+fn ready<const D: bool>(evaluator: &Evaluator<D>) -> u64 {
+    evaluator.colors_worker.as_ref().map_or(0, |worker| {
+        let report = worker.readiness_report();
+        let value = report.split("\"map_ready_epoch\":").nth(1)
+            .expect("missing real map-ready epoch");
+        value.split(|ch: char| !ch.is_ascii_digit()).next().unwrap().parse().unwrap()
+    })
+}
+
+fn assert_panic(result: std::thread::Result<()>) {
+    assert_eq!(result.unwrap_err().downcast_ref::<&str>().copied(), Some("pre-map owner unwind"));
+}
+
+#[test]
+fn private_fresh_root_matches_native_map_retained_cache_and_work() {
+    for fen in [START, SPARSE] {
+        let mut outputs = Vec::new();
+        for enabled in [false, true] {
+            let (mut evaluator, position) = configured(fen, enabled, 3);
+            let mut node = Node::root(position, &evaluator.root);
+            let mut scratch = None;
+            let (value, map) = evaluator.full_root_for_search(&mut node, &mut scratch, false, true);
+            assert_eq!(map.profiles, Influence::build_coherent(&position).profiles);
+            outputs.push((value, node.retained, evaluator.stats));
+            assert_eq!(ready(&evaluator) > 0, enabled);
+            assert!(evaluator.colors_worker.as_ref().unwrap().is_parked());
+        }
+        assert_eq!(outputs[0], outputs[1]);
+    }
+}
+
+#[test]
+fn actual_ordinary_entry_preserves_root_child_outcome_and_logical_work() {
+    let position = Position::from_fen(START).unwrap();
+    let mut outputs = Vec::new();
+    for enabled in [false, true] {
+        let mut search = Search::<true>::new(&position);
+        search.config.tts_bytes = 65536;
+        search.evaluator.set_threads_with_affinity(3, || Ok(3)).unwrap();
+        search.evaluator.set_owner_local_inventory(true).unwrap();
+        search.evaluator.set_q_owner_local_inventory(true).unwrap();
+        search.evaluator.set_pre_map_geometry(enabled).unwrap();
+        let mut history = SearchHistory::new(&position);
+        let outcome = search.run_iterations(position, &mut history, 1, Limits::default()).unwrap();
+        outputs.push((outcome.score, outcome.pv, outcome.work, outcome.evaluations));
+        assert_eq!(ready(&search.evaluator) > 0, enabled);
+        assert_eq!(history.search_ply(), 0);
+        assert!(search.evaluator.colors_worker.as_ref().unwrap().is_parked());
+    }
+    assert_eq!(outputs[0], outputs[1]);
+}
