+#[test]
+fn both_private_q_full_seams_preserve_selection_inventory_and_retained_work() {
+    for (fen, initially_full) in [(SPARSE, true), (START, false)] {
+        let mut outputs = Vec::new();
+        for enabled in [false, true] {
+            let (mut evaluator, position) = configured(fen, enabled, 3);
+            let mut node = Node::root(position, &evaluator.root);
+            if !initially_full { evaluator.full(&mut node, &Influence::build(&position), false); }
+            let score = evaluator.fast(&node, false).score;
+            let mut scratch = None;
+            let mut list = MoveList::new();
+            let (selection, prepared) = crate::colors_worker::with_forced_readiness(false, || {
+                evaluator.select_noncheck_q_inventory(&mut node, score - 1, score + 1,
+                    false, &mut scratch, true, true, &mut list)
+            });
+            assert_eq!(selection.initially_full, initially_full);
+            assert_eq!(selection.refreshed, !initially_full);
+            assert!(prepared);
+            assert_eq!(ready(&evaluator) > 0, enabled);
+            outputs.push((selection.evaluation, node.retained, evaluator.stats, list.as_slice().to_vec()));
+            assert!(evaluator.colors_worker.as_ref().unwrap().is_parked());
+        }
+        assert_eq!(outputs[0], outputs[1]);
+    }
+}
