+/// The single numerical destination consumer for native traversal and replay.
+/// Friendly admission and direct/additional selection are geometry inputs;
+/// final categories, direct marks and semantic R retain their original owners.
+#[inline]
+fn consume_destination<const KIND: usize>(
+    influence: &Influence,
+    color: Color,
+    target: Square,
+    victim: Piece,
+    additional: bool,
+    vertical: bool,
+    values: &[u8; 64],
+    marks: &mut Marks,
+    result: &mut Mobility,
+) {
+    let kind = PieceKind::ALL[KIND];
+    let category = if additional {
+        result.queries += 1;
+        capture_priority(
+            kind,
+            victim,
+            relation(
+                influence.code(color, target),
+                influence.code(color.opponent(), target),
+                kind,
+            ) as i64,
+        )
+    } else {
+        let category = direct_category(influence, color, kind, target, victim);
+        result.categories += category;
+        mark(marks, color, kind, target, category);
+        category
+    };
+    let value = values[target.0 as usize];
+    let multiplier = if kind == PieceKind::Rook && vertical { 2 } else { 1 };
+    result.total += category * value as i64 * multiplier;
+}
