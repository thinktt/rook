+/// Both variants own concrete initialized inputs. The tag and every field are
+/// immutable from request Release until both readers are actually retired.
+enum Packet {
+    Supplied {
+        generation: u64,
+        position: Position,
+        influence: Influence,
+        published: Option<Instant>,
+    },
+    FreshPosition {
+        generation: u64,
+        position: Position,
+        published: Option<Instant>,
+    },
+}
+
+impl Packet {
+    fn generation(&self) -> u64 {
+        match self {
+            Self::Supplied { generation, .. } | Self::FreshPosition { generation, .. } => *generation,
+        }
+    }
+
+    /// Called only while the new packet is unpublished and exclusively owned.
+    fn set_published(&mut self, value: Option<Instant>) {
+        match self {
+            Self::Supplied { published, .. } | Self::FreshPosition { published, .. } => *published = value,
