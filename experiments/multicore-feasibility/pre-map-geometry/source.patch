+#[test]
+fn supplied_custom_public_fresh_and_observed_paths_keep_authority_and_parking() {
+    let custom = Influence { profiles: [[0x91; 64], [0x17; 64]] };
+    let mut outputs = Vec::new();
+    for enabled in [false, true] {
+        let (mut evaluator, position) = configured(START, enabled, 3);
+        let mut node = Node::root(position, &evaluator.root);
+        let mut scratch = Some(custom);
+        let (value, map) = evaluator.full_root_for_search(&mut node, &mut scratch, false, true);
+        assert_eq!(map.profiles, custom.profiles);
+        assert_eq!(evaluator.stats.influence_builds, 0);
+        let parked = evaluator.colors_worker.as_ref().unwrap().test_observer();
+        let fresh = evaluator.fresh_observed(&mut node, &custom, false,
+            |_| assert!(parked.is_parked()));
+        let observed = evaluator.full_observed(&mut node, &custom, false,
+            |_| assert!(parked.is_parked()));
+        assert_eq!(ready(&evaluator), 0);
+        outputs.push((value, fresh, observed, node.retained, evaluator.stats));
+    }
+    assert_eq!(outputs[0], outputs[1]);
+}
