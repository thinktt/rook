+fn destinations_prepared_kind<const KIND: usize>(
+    position: &Position,
+    influence: &Influence,
+    color: Color,
+    source: Square,
+    values: &[u8; 64],
+    marks: &mut Marks,
+    record: &[u8; 8],
+    friendly: u64,
+) -> Mobility {
+    let kind = PieceKind::ALL[KIND];
+    let mut result = Mobility::default();
+    if kind == PieceKind::Knight {
+        let targets = &KNIGHT_SOURCES[source.0 as usize];
+        for (index, &target) in targets.squares[..targets.len as usize].iter().enumerate() {
+            if record[0] & (1 << index) == 0 {
+                continue;
+            }
+            debug_assert!(target < 64);
+            let target = Square(target & 63);
+            consume_destination::<KIND>(
+                influence, color, target, position.board[target.0 as usize],
+                false, false, values, marks, &mut result,
+            );
+        }
+        return result;
+    }
+    for direction in activity_directions(kind) {
+        let direct = (record[direction] & 15) as usize;
+        let visited = (record[direction] >> 4) as usize;
+        let ray = &ATTACK_RAYS.0[source.0 as usize][direction];
+        debug_assert!(direct <= visited && visited <= ray.len as usize);
+        for (index, &target) in ray.squares[..visited].iter().enumerate() {
+            debug_assert!(target < 64);
+            if friendly & (1u64 << target) != 0 {
+                continue;
+            }
+            let target = Square(target & 63);
+            consume_destination::<KIND>(
+                influence, color, target, position.board[target.0 as usize],
+                index >= direct, DIRECTIONS[direction].0 == 0,
+                values, marks, &mut result,
+            );
+        }
+    }
+    result
+}
