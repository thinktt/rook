+#[test]
+fn standalone_pre_map_unwind_retires_real_readers_and_allows_healthy_reuse() {
+    let (mut evaluator, position) = configured(START, true, 3);
+    let mut node = Node::root(position, &evaluator.root);
+    let retained = node.retained;
+    let stats = evaluator.stats;
+    let mut scratch = None;
+    PANIC_PRE_MAP.with(|flag| flag.set(true));
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        evaluator.full_root_for_search(&mut node, &mut scratch, false, true);
+    }));
+    assert_panic(result);
+    assert!(scratch.is_none());
+    assert_eq!(node.retained, retained);
+    assert_eq!(evaluator.stats, stats);
+    assert_eq!(evaluator.full_activation_depth(), 0);
+    assert!(evaluator.colors_worker.as_ref().unwrap().is_parked());
+    assert_eq!(ready(&evaluator), 0);
+    evaluator.full_root_for_search(&mut node, &mut scratch, false, true);
+    assert!(ready(&evaluator) > 0);
+    evaluator.set_threads(1).unwrap();
+}
