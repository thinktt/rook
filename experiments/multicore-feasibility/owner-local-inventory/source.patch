+#[test]
+fn owner_inventory_actual_root_and_q_only_iteration_never_query_or_prepare() {
+    let position = Position::from_fen(START).unwrap();
+    let mut off = Search::<true>::new(&position); off.config.tts_bytes = 65536;
+    let mut on = Search::<true>::new(&position); on.config.tts_bytes = 65536;
+    on.evaluator.set_threads(3).unwrap();
+    on.evaluator.set_owner_local_inventory(true).unwrap();
+    let mut ah = SearchHistory::new(&position); let mut bh = SearchHistory::new(&position);
+    let expected = off.run_iterations(position, &mut ah, 1, Limits::default()).unwrap();
+    let before = readiness_probe_count();
+    let (actual, events) = trace(|| with_forced_readiness(false, ||
+        on.run_iterations(position, &mut bh, 1, Limits::default()).unwrap()));
+    assert_eq!(readiness_probe_count(), before);
+    assert!(events.is_empty()); assert_eq!(actual.stats.ordinary_nodes, 0);
+    assert_eq!((actual.score, actual.pv, actual.work, actual.stats, actual.evaluations),
+        (expected.score, expected.pv, expected.work, expected.stats, expected.evaluations));
+}
