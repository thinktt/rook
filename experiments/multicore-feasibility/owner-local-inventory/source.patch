+#[test]
+fn owner_inventory_full_bound_discards_at_actual_owner_without_consumption() {
+    fn run(enabled: bool) -> (i32, Search<true>, Node, Vec<Event>) {
+        let position = Position::from_fen(START).unwrap();
+        let previous = position.null_child();
+        let mut search = Search::<true>::new(&position); search.config.tts_bytes = 65536;
+        search.evaluator.set_threads(3).unwrap();
+        search.evaluator.set_owner_local_inventory(enabled).unwrap();
+        search.ensure_table().unwrap(); search.bind_geometry_permission(&position);
+        let (mut node, map) = search.prepare_root_with_influence(position);
+        let mut history = SearchHistory::new(&previous); history.push(&position, None);
+        search.begin_owned_sequence(Limits::default());
+        let scope = search.evaluator.full_worker_scope();
+        let (result, events) = trace(|| with_forced_readiness(false, || search.visit_ordinary(
+            &mut node, &mut history,
+            Request { ply: 1, depth: 1, lower: -10000, upper: -10000,
+                previous_extension: 0, iteration: 2, checked: Some(false) },
+            Predecessor { position: &previous, influence: &map, checked: false, movement: None },
+        )));
+        crate::evaluator::Evaluator::<true>::finish_full_worker_scope(scope);
+        (result.unwrap(), search, node, events)
+    }
+    let (a, off, na, _) = run(false); let (b, on, nb, events) = run(true);
+    assert_eq!((a, b), (-10000, -10000)); assert_eq!(na, nb); equal_owner(&on, &off);
+    assert_eq!(on.stats.generated, 0);
+    assert_eq!(events.len(), 1); assert!(events[0].prepared && !events[0].demand);
+}
