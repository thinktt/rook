+//! Finite evaluator controls; readiness overrides are test-only scheduling hints.
+use super::*;
+use crate::colors_worker::{readiness_probe_count, with_forced_readiness};
+use crate::movegen::{self, MoveList};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const MIDDLE: &str = "r3k2r/ppp2ppp/2npbn2/3qp3/3PP3/2N1BN2/PPP2PPP/R2Q1RK1 b kq - 0 10";
+const ENDING: &str = "6k1/5pp1/6p1/3P4/8/2N5/5P2/6K1 w - - 0 40";
+const CASTLE: &str = "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1";
+const PROMOTION: &str = "1r2k3/P7/8/8/8/8/8/4K3 w - - 0 1";
+const JOINED_EP: &str = "1b5k/8/8/2Pn4/5K2/8/8/8 w - d6 0 1";
+const CHECKED: &str = "4k3/8/8/8/8/8/8/r3K2R w K - 0 1";
+
+fn position(fen: &str) -> Position { Position::from_fen(fen).unwrap() }
+
+fn configured<const D: bool>(root: &Position, budget: usize, enabled: bool) -> Evaluator<D> {
+    let mut evaluator = Evaluator::new(root);
+    evaluator.set_owner_local_inventory(enabled).unwrap();
+    evaluator.set_threads_with_affinity(budget, || Ok(3)).unwrap();
+    evaluator
+}
+
+fn asymmetric() -> Parameters {
+    Parameters {
+        own: [133, 73, 151, 87, 200, 121, 19, 313, 207, 251, 49],
+        opponent: [91, 128, 67, 142, 80, 57, 183, 47, 333, 107, 229],
+        average_depth: 13, draw: -173, opponent_selectivity: 31,
+    }
+}
+
+fn sentinel() -> MoveList {
+    let mut list = MoveList::new();
+    list.push(Move::NONE);
+    list
+}
+
+#[test]
+fn pending_inventory_matches_ordered_special_checked_lists_and_native_full_details() {
+    fn verify<const D: bool>() {
+        let root = position(START);
+        let mut serial = configured::<D>(&root, 1, false);
+        let mut worker = configured::<D>(&root, 3, true);
+        for root in [position(START), position(MIDDLE)] {
+            for parameters in [Parameters::default(), asymmetric()] {
+                for evaluator in [&mut serial, &mut worker] {
+                    evaluator.parameters = parameters.clone();
+                    evaluator.begin_search(&root);
+                }
+                for fen in [CASTLE, PROMOTION, JOINED_EP, CHECKED, ENDING] {
+                    let current = position(fen);
+                    let checked = movegen::in_check(&current, current.side);
+                    let mut expected_list = MoveList::new();
+                    movegen::generate_legal(&current, &mut expected_list);
+                    for map in [Influence::build(&current), Influence { profiles: [[255; 64], [0; 64]] }] {
+                        let before = (current, map);
+                        let mut a = Node::root(current, &serial.root);
+                        a.retained.positional = 731;
+                        a.retained.pawn_progress = -193;
+                        a.retained.age = 17;
+                        let mut b = a;
+                        let mut expected_details = None;
+                        let expected = serial.full_detailed_observed(&mut a, &map, checked, |value| expected_details = Some(value));
+                        let mut actual_details = None;
+                        let mut list = sentinel();
+                        let mut prepared = false;
+                        let probes = readiness_probe_count();
+                        let actual = with_forced_readiness(false, || worker.full_impl_hook::<false, true, _, _, _>(
+                            &mut b, &map, checked, |_| {}, |value| actual_details = Some(value), true,
+                            |position| { movegen::generate_legal(position, &mut list); prepared = true; },
+                        ));
+                        assert_eq!(readiness_probe_count(), probes + 1);
+                        assert!(prepared);
+                        assert_eq!(list.as_slice(), expected_list.as_slice(), "{fen}");
+                        assert_eq!((actual, b, actual_details), (expected, a, expected_details));
+                        assert_eq!(worker.stats, serial.stats);
+                        assert_eq!((current, map), before);
+                    }
+                }
+            }
+        }
+    }
+    verify::<true>();
+    verify::<false>();
+}
+
+#[test]
+fn ready_inventory_keeps_destination_untouched_and_returns_native_full() {
+    let root = position(START);
+    let map = Influence::build(&root);
+    let mut serial = configured::<true>(&root, 1, false);
+    let mut worker = configured::<true>(&root, 3, true);
+    let mut a = Node::root(root, &serial.root);
+    let mut b = a;
+    let expected = serial.full(&mut a, &map, false);
+    let mut list = sentinel();
+    let probes = readiness_probe_count();
+    let (actual, prepared) = with_forced_readiness(true, || worker.full_ordinary_inventory(&mut b, &map, false, true, &mut list));
+    assert_eq!(readiness_probe_count(), probes + 1);
+    assert!(!prepared);
+    assert_eq!(list.as_slice(), &[Move::NONE]);
+    assert_eq!((actual, b, worker.stats), (expected, a, serial.stats));
+    assert!(worker.colors_worker.as_ref().unwrap().is_parked());
+}
+
+#[test]
+fn owner_inventory_admission_and_budget_fallback_do_not_query_or_generate() {
+    let root = position(START);
+    let map = Influence::build(&root);
+    for (requested, available, enabled, coherent) in [
+        (1, 3, true, true), (2, 3, true, true), (3, 1, true, true),
+        (3, 2, true, true), (3, 3, false, true), (3, 3, true, false),
+    ] {
+        let mut worker = Evaluator::<true>::new(&root);
+        worker.set_owner_local_inventory(enabled).unwrap();
+        worker.set_threads_with_affinity(requested, || Ok(available)).unwrap();
+        let mut serial = configured::<true>(&root, 1, false);
+        let mut a = Node::root(root, &serial.root);
+        let mut b = a;
+        let expected = serial.full(&mut a, &map, false);
+        let mut list = sentinel();
+        let probes = readiness_probe_count();
+        let (actual, prepared) = with_forced_readiness(false, || worker.full_ordinary_inventory(&mut b, &map, false, coherent, &mut list));
+        assert_eq!(readiness_probe_count(), probes);
+        assert!(!prepared);
+        assert_eq!(list.as_slice(), &[Move::NONE]);
+        assert_eq!((actual, b, worker.stats), (expected, a, serial.stats));
+        assert_eq!(worker.requested_threads(), requested);
+        assert_eq!(worker.configured_threads(), requested.min(available).min(3));
+    }
+}
+
+#[test]
+fn public_fresh_and_observer_full_paths_have_zero_readiness_probes() {
+    let root = position(START);
+    let map = Influence { profiles: [[255; 64], [0; 64]] };
+    let mut serial = configured::<true>(&root, 1, false);
+    let mut worker = configured::<true>(&root, 3, true);
+    let probes = readiness_probe_count();
+    with_forced_readiness(false, || {
+        for kind in 0..5 {
+            let mut a = Node::root(root, &serial.root);
+            let mut b = a;
+            let (mut ad, mut bd) = (None, None);
+            let (mut ac, mut bc) = (None, None);
+            let expected = match kind {
+                0 => serial.full(&mut a, &map, false),
+                1 => serial.full_observed(&mut a, &map, false, |value| ac = Some(value)),
+                2 => serial.full_detailed_observed(&mut a, &map, false, |value| ad = Some(value)),
+                3 => serial.fresh_observed(&mut a, &map, false, |value| ac = Some(value)),
+                _ => serial.fresh_detailed_observed(&mut a, &map, false, |value| ad = Some(value)),
+            };
+            let actual = match kind {
+                0 => worker.full(&mut b, &map, false),
+                1 => worker.full_observed(&mut b, &map, false, |value| bc = Some(value)),
+                2 => worker.full_detailed_observed(&mut b, &map, false, |value| bd = Some(value)),
+                3 => worker.fresh_observed(&mut b, &map, false, |value| bc = Some(value)),
+                _ => worker.fresh_detailed_observed(&mut b, &map, false, |value| bd = Some(value)),
+            };
+            assert_eq!((actual, b, bd, bc, worker.stats), (expected, a, ad, ac, serial.stats));
+        }
+    });
+    assert_eq!(readiness_probe_count(), probes);
+}
+
+#[test]
+fn inventory_prepared_flag_is_per_call_and_outer_activation_retains_native_reuse() {
+    let root = position(START);
+    let mut worker = configured::<true>(&root, 3, true);
+    let mut serial = configured::<true>(&root, 1, false);
+    let outer = worker.full_worker_scope();
+    let mut list = sentinel();
+    for (index, fen) in [START, START, ENDING].into_iter().enumerate() {
+        let current = position(fen);
+        let map = Influence::build(&current);
+        let mut a = Node::root(current, &serial.root);
+        let mut b = a;
+        let expected = serial.full(&mut a, &map, false);
+        let saved = list.as_slice().to_vec();
+        let ready = index == 1;
+        let (actual, prepared) = with_forced_readiness(ready, || worker.full_ordinary_inventory(&mut b, &map, false, true, &mut list));
+        assert_eq!(prepared, !ready);
+        if ready { assert_eq!(list.as_slice(), saved.as_slice()); }
+        else {
+            let mut expected_list = MoveList::new();
+            movegen::generate_legal(&current, &mut expected_list);
+            assert_eq!(list.as_slice(), expected_list.as_slice());
+        }
+        assert_eq!((actual, b, worker.stats), (expected, a, serial.stats));
+    }
+    Evaluator::<true>::finish_full_worker_scope(outer);
+    assert!(worker.colors_worker.as_ref().unwrap().is_parked());
+}
+
+#[test]
+fn coherent_inventory_admits_opposite_king_pressure_and_distinguishes_prepared_empty_lists() {
+    for fen in [
+        "7k/8/8/8/8/8/8/K6R w - - 0 1",
+        "8/8/8/8/8/2k5/1q6/K7 w - - 0 1",
+        "8/8/8/8/8/2k5/2q5/K7 w - - 0 1",
+    ] {
+        let current = position(fen);
+        let checked = movegen::in_check(&current, current.side);
+        let mut worker = configured::<true>(&current, 3, true);
+        let mut node = Node::root(current, &worker.root);
+        let mut expected = MoveList::new();
+        movegen::generate_legal(&current, &mut expected);
+        let mut actual = sentinel();
+        let (_, prepared) = with_forced_readiness(false, || worker.full_ordinary_inventory(
+            &mut node, &Influence::build(&current), checked, true, &mut actual,
+        ));
+        assert!(prepared);
+        assert_eq!(actual.as_slice(), expected.as_slice());
+        if fen.starts_with("7k") {
+            assert!(movegen::in_check(&current, current.side.opponent()));
+            assert!(!actual.as_slice().is_empty());
+        } else { assert_eq!(actual.len, 0); }
+    }
+}
