+//! Test-only actual-owner preparation/demand probes; absent from production.
+use super::*;
+use crate::colors_worker::{readiness_probe_count, with_forced_readiness};
+use std::cell::RefCell;
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+#[derive(Debug, Clone)]
+struct Event { demand: bool, prepared: bool, moves: Vec<Move>, full: u64 }
+thread_local! { static TRACE: RefCell<Option<Vec<Event>>> = const { RefCell::new(None) }; }
+
+pub(super) fn record(ply: usize, demand: bool, prepared: bool, list: &MoveList, full: u64) {
+    if ply != 1 { return; }
+    TRACE.with(|cell| {
+        if let Some(events) = cell.borrow_mut().as_mut() {
+            events.push(Event { demand, prepared, moves: if demand || prepared {
+                list.as_slice().to_vec()
+            } else { Vec::new() }, full });
+        }
+    });
+}
+
+fn trace<R>(f: impl FnOnce() -> R) -> (R, Vec<Event>) {
+    struct Clear;
+    impl Drop for Clear { fn drop(&mut self) { TRACE.with(|c| { c.borrow_mut().take(); }); } }
+    TRACE.with(|c| { assert!(c.borrow().is_none()); *c.borrow_mut() = Some(Vec::new()); });
+    let _clear = Clear;
+    let value = f();
+    let events = TRACE.with(|c| c.borrow_mut().take().unwrap());
+    (value, events)
+}
+
+fn null_call(enabled: bool, cutoff: bool, limit: u64)
+    -> (Result<i32, Stopped>, Search<true>, Node, Vec<Event>)
+{
+    let root = Position::from_fen(START).unwrap();
+    let previous = root.null_child();
+    let position = previous.null_child();
+    let mut search = Search::<true>::new(&position);
+    search.config.tts_bytes = 65536;
+    search.evaluator.set_threads(3).unwrap();
+    search.evaluator.set_owner_local_inventory(enabled).unwrap();
+    let scope = search.evaluator.full_worker_scope();
+    search.ensure_table().unwrap();
+    search.bind_geometry_permission(&position);
+    let (mut node, map) = search.prepare_root_with_influence(position);
+    let score = search.evaluator.full(&mut node, &map, false).score;
+    if !cutoff { assert!(score > 0); }
+    let upper = if cutoff { -100 } else { score };
+    let mut history = SearchHistory::new(&previous);
+    history.push(&position, None);
+    search.begin_owned_sequence(Limits { nodes: Some(limit) });
+    let (result, events) = trace(|| with_forced_readiness(false, || search.visit_ordinary(
+        &mut node, &mut history,
+        Request { ply: 1, depth: 3, lower: upper - 1, upper, previous_extension: 0,
+            iteration: 4, checked: Some(false) },
+        Predecessor { position: &previous, influence: &map, checked: false, movement: None },
+    )));
+    assert!(search.stats.null_trials > 0);
+    assert_eq!(history.search_ply(), 1);
+    history.pop();
+    crate::evaluator::Evaluator::<true>::finish_full_worker_scope(scope);
+    (result, search, node, events)
+}
+
+fn equal_owner(a: &Search<true>, b: &Search<true>) {
+    assert_eq!(a.work(), b.work());
+    assert_eq!(a.stats, b.stats);
+    assert_eq!(a.evaluator.stats, b.evaluator.stats);
+    assert_eq!(a.learning.history, b.learning.history);
+    assert_eq!(a.learning.killers, b.learning.killers);
+    assert_eq!(a.learning.total, b.learning.total);
+    assert_eq!(&a.pv[1][..a.pv_len[1]], &b.pv[1][..b.pv_len[1]]);
+}
+
+#[test]
+fn owner_inventory_null_continue_keeps_exact_parent_row_across_descendant_full_and_current_order() {
+    let (expected, off, a, off_events) = null_call(false, false, 200000);
+    let (actual, on, b, events) = null_call(true, false, 200000);
+    assert!(actual.is_ok()); assert_eq!(actual, expected); assert_eq!(a, b);
+    equal_owner(&on, &off);
+    assert_eq!(on.candidates[1].as_slice(), off.candidates[1].as_slice());
+    assert_eq!(events.len(), 2); assert_eq!(off_events.len(), 2);
+    assert!(!events[0].demand && events[0].prepared);
+    assert!(events[1].demand && events[1].prepared);
+    assert!(events[1].full > events[0].full, "actual descendant FULL must interpose");
+    assert_eq!(events[0].moves, events[1].moves);
+    assert_eq!(events[1].moves, off_events[1].moves);
+    assert!(!off_events[0].prepared && !off_events[1].prepared);
+    let mut native = MoveList::new(); movegen::generate_legal(&a.position, &mut native);
+    assert_eq!(events[1].moves, native.as_slice());
+}
+
+#[test]
+fn owner_inventory_null_cutoff_discards_prepared_row_without_generated_charge() {
+    let (expected, off, a, _) = null_call(false, true, 200000);
+    let (actual, on, b, events) = null_call(true, true, 200000);
+    assert!(actual.is_ok()); assert_eq!(actual, expected); assert_eq!(a, b);
+    equal_owner(&on, &off);
+    assert_eq!(on.stats.generated, 0);
+    assert_eq!(events.len(), 1); assert!(!events[0].demand && events[0].prepared);
+    assert!(on.evaluator.stats.full > events[0].full, "cutoff must follow real descendant FULL");
+    assert!(!events[0].moves.is_empty());
+}
+
+#[test]
+fn owner_inventory_null_stop_preserves_work_and_allows_fresh_worker_reuse() {
+    let (expected, mut off, a, _) = null_call(false, true, 1);
+    let (actual, mut on, b, events) = null_call(true, true, 1);
+    assert_eq!(expected, Err(Stopped::NodeLimit(1)));
+    assert_eq!(actual, expected); assert_eq!(a, b); equal_owner(&on, &off);
+    assert_eq!(on.stats.generated, 0);
+    assert_eq!(events.len(), 1); assert!(events[0].prepared && !events[0].demand);
+    let position = Position::from_fen(START).unwrap();
+    let mut ah = SearchHistory::new(&position); let mut bh = SearchHistory::new(&position);
+    let a = off.run_iterations(position, &mut ah, 2, Limits::default()).unwrap();
+    let b = on.run_iterations(position, &mut bh, 2, Limits::default()).unwrap();
+    assert_eq!((a.score, a.pv, a.work, a.stats, a.evaluations),
+               (b.score, b.pv, b.work, b.stats, b.evaluations));
+}
