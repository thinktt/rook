+//! Isolated aggregate observer. No results, keys, child work or helper access.
+use crate::timed::{Outcome, Point};
+use crate::types::{MoveKind, Piece, PieceKind};
+use std::cell::RefCell;
+use std::fmt::Write as _;
+use std::io::{self, Write as _};
+use std::path::Path;
+use std::time::Instant;
+
+#[derive(Clone, Copy, Default)]
+struct Boundary {
+    entered: bool,
+    complete: bool,
+    start_ns: Option<u128>,
+    end_ns: Option<u128>,
+}
+#[derive(Clone, Copy)]
+struct StopMeta {
+    point: &'static str,
+    depth: u8,
+    root_index: Option<usize>,
+    reason: &'static str,
+    n: u64,
+    r: u64,
+    completed_mask: u64,
+    last_iteration: u8,
+    selected_depth: Option<u8>,
+    selected_n: Option<u64>,
+}
+#[derive(Clone, Copy, Default)]
+struct Scale {
+    active: bool,
+    phase: u8,
+    search_starts: u64,
+    e6: u64,
+    s6: u64,
+    m7: u64,
+    f7: u64,
+    origin: Option<Instant>,
+    boundaries: [Boundary; 2],
+    outcome: Option<StopMeta>,
+    error: Option<&'static str>,
+}
+thread_local! {static SCALE: RefCell<Scale> = RefCell::new(Scale::default());}
+
+impl Scale {
+    fn begin_search(&mut self) {
+        let starts = self.search_starts.checked_add(1);
+        *self = Self::default();
+        self.active = true;
+        match starts {
+            Some(value) => self.search_starts = value,
+            None => self.error = Some("search_counter_overflow"),
+        }
+    }
+    fn begin(&mut self, depth: u8, now: Option<Instant>) {
+        if !self.active || self.error.is_some() { return; }
+        self.phase = depth;
+        if depth != 6 && depth != 7 { return; }
+        let index = usize::from(depth - 6);
+        if self.boundaries[index].entered {
+            self.error = Some("duplicate_iteration_entry");
+            return;
+        }
+        let Some(now) = now else { self.error = Some("missing_boundary_clock"); return; };
+        if depth == 6 { self.origin = Some(now); }
+        let Some(origin) = self.origin else { self.error = Some("missing_iteration6_entry"); return; };
+        self.boundaries[index] = Boundary {
+            entered: true, complete: false,
+            start_ns: Some(now.duration_since(origin).as_nanos()), end_ns: None,
+        };
+    }
+    fn end(&mut self, depth: u8, now: Option<Instant>) {
+        if !self.active || self.error.is_some() { return; }
+        if depth == 6 || depth == 7 {
+            let index = usize::from(depth - 6);
+            let row = &mut self.boundaries[index];
+            if self.phase != depth || !row.entered || row.complete {
+                self.error = Some("invalid_iteration_completion");
+                return;
+            }
+            let (Some(now), Some(origin)) = (now, self.origin) else {
+                self.error = Some("missing_boundary_clock"); return;
+            };
+            row.end_ns = Some(now.duration_since(origin).as_nanos());
+            row.complete = true;
+        }
+        self.phase = 0;
+    }
+    fn skip(&mut self, counted: &mut bool, iteration: i32, depth: i32,
+        fresh: u8, kind: MoveKind, coherent: bool, victim: Piece,
+    ) {
+        if !self.active || self.error.is_some() || self.phase != 6 || iteration != 6
+            || depth != 0 || fresh != 0 || kind != MoveKind::Ordinary || !coherent
+            || (!victim.is_empty() && victim.kind() == PieceKind::King) { return; }
+        let e = if *counted { Some(self.e6) } else { self.e6.checked_add(1) };
+        let s = self.s6.checked_add(1);
+        match (e, s) {
+            (Some(e), Some(s)) => { self.e6 = e; self.s6 = s; *counted = true; }
+            _ => self.error = Some("skip_counter_overflow"),
+        }
+    }
+    fn demand(&mut self, coherent: bool, full: bool) {
+        if !self.active || self.error.is_some() || self.phase != 7 || !coherent { return; }
+        let value = if full { &mut self.f7 } else { &mut self.m7 };
+        match value.checked_add(1) {
+            Some(next) => *value = next,
+            None => self.error = Some("demand_counter_overflow"),
+        }
+    }
+    fn finish(&mut self, stop: StopMeta) {
+        self.outcome = Some(stop);
+        self.active = false;
+        self.phase = 0;
+    }
+    fn pair_complete(&self) -> bool {
+        self.error.is_none() && self.boundaries.iter().all(|b| b.entered && b.complete)
+            && self.outcome.is_some_and(|s| s.completed_mask & 192 == 192)
+    }
+    fn json(&self) -> String {
+        fn number<T: std::fmt::Display>(value: Option<T>) -> String {
+            value.map_or_else(|| "null".into(), |value| value.to_string())
+        }
+        let mut out = String::new();
+        write!(out, "{{\"schema\":\"rook2-frontier-scale-v1\",\"clockBasis\":\"relative-to-iteration6-entry\",\"searchStarts\":{},\"error\":{},\"pairComplete\":{},\"E6\":{},\"S6\":{},\"M7\":{},\"F7\":{},\"stateBytes\":{},\"boundaries\":[",
+            self.search_starts, self.error.map_or_else(|| "null".into(), |s| format!("{s:?}")),
+            self.pair_complete(), self.e6, self.s6, self.m7, self.f7, std::mem::size_of::<Self>()).unwrap();
+        for (index, b) in self.boundaries.iter().enumerate() {
+            if index != 0 { out.push(','); }
+            write!(out, "{{\"iteration\":{},\"entered\":{},\"complete\":{},\"startNs\":{},\"endNs\":{}}}",
+                index + 6, b.entered, b.complete, number(b.start_ns), number(b.end_ns)).unwrap();
+        }
+        out.push_str("],\"outcome\":");
+        if let Some(s) = self.outcome {
+            write!(out, "{{\"stopPoint\":{:?},\"stopDepth\":{},\"stopRootIndex\":{},\"stopReason\":{:?},\"N\":{},\"R\":{},\"completedIterationsMask\":{},\"lastIterationDepth\":{},\"selectedDepth\":{},\"selectedSearchUnits\":{}}}",
+                s.point, s.depth, number(s.root_index), s.reason, s.n, s.r,
+                s.completed_mask, s.last_iteration, number(s.selected_depth), number(s.selected_n)).unwrap();
+        } else { out.push_str("null"); }
+        out.push('}');
+        out
+    }
+}
+
+pub(crate) fn begin_search() { SCALE.with(|s| s.borrow_mut().begin_search()); }
+pub(crate) fn begin_iteration(depth: u8) {
+    let now = if depth == 6 || depth == 7 { Some(Instant::now()) } else { None };
+    SCALE.with(|s| s.borrow_mut().begin(depth, now));
+}
+pub(crate) fn complete_iteration(depth: u8) {
+    let now = if depth == 6 || depth == 7 { Some(Instant::now()) } else { None };
+    SCALE.with(|s| s.borrow_mut().end(depth, now));
+}
+pub(crate) fn estimate_skip(counted: &mut bool, iteration: i32, depth: i32,
+    fresh: u8, kind: MoveKind, coherent: bool, victim: Piece,
+) {
+    SCALE.with(|s| s.borrow_mut().skip(counted, iteration, depth, fresh, kind, coherent, victim));
+}
+pub(crate) fn map_demand(coherent: bool) { SCALE.with(|s| s.borrow_mut().demand(coherent, false)); }
+pub(crate) fn full_demand(coherent: bool) { SCALE.with(|s| s.borrow_mut().demand(coherent, true)); }
+pub(crate) fn finish_search(outcome: &Outcome) {
+    let stop = &outcome.stop;
+    let completed_mask = outcome.iterations.iter().filter(|i| i.complete)
+        .fold(0u64, |mask, i| mask | (1u64 << i.depth));
+    let meta = StopMeta {
+        point: match stop.point { Point::Root => "root", Point::Iteration => "iteration", Point::Poll => "poll" },
+        depth: stop.depth, root_index: stop.root_index, reason: stop.reason,
+        n: stop.work.charged_search_units, r: stop.work.charged_relation_queries,
+        completed_mask, last_iteration: outcome.iterations.last().map_or(0, |i| i.depth),
+        selected_depth: outcome.result.as_ref().map(|c| c.depth),
+        selected_n: outcome.result.as_ref().map(|c| c.search_id),
+    };
+    SCALE.with(|s| s.borrow_mut().finish(meta));
+}
+/// Cold terminal report only; never called by a numerical or polling path.
+pub fn write_report(path: &Path) -> io::Result<()> {
+    let value = SCALE.with(|s| s.borrow().json());
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    writeln!(file, "{value}")
+}
+
+#[cfg(test)]
+mod tests {
