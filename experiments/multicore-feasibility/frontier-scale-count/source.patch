+    fn selected(depth: u8) -> Scale {
+        let mut s = Scale::default(); s.begin_search();
+        let t = Instant::now(); s.begin(6, Some(t));
+        if depth == 7 {s.end(6, Some(t + Duration::from_nanos(10))); s.begin(7, Some(t + Duration::from_nanos(20)));}
+        s
+    }
+    fn good_skip(s: &mut Scale, counted: &mut bool) {
+        s.skip(counted, 6, 0, 0, MoveKind::Ordinary, true, Piece::EMPTY);
+    }
