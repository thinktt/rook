+            (6,1,0,MoveKind::Ordinary,true,Piece::EMPTY),
+            (6,0,1,MoveKind::Ordinary,true,Piece::EMPTY),
+            (6,0,0,MoveKind::Promotion(PieceKind::Queen),true,Piece::EMPTY),
+            (6,0,0,MoveKind::EnPassant,true,Piece::EMPTY),
+            (6,0,0,MoveKind::Castle,true,Piece::EMPTY),
+            (6,0,0,MoveKind::Ordinary,false,Piece::EMPTY),
+            (6,0,0,MoveKind::Ordinary,true,Piece::new(Color::Black,PieceKind::King)),
+        ] {
+            let mut s=selected(6); let mut counted=false;
+            s.skip(&mut counted,iteration,depth,fresh,kind,coherent,victim);
+            assert_eq!((s.e6,s.s6,counted),(0,0,false));
+        }
+        let mut s=selected(6); let mut counted=false;
+        s.skip(&mut counted,6,0,0,MoveKind::Ordinary,true,Piece::new(Color::Black,PieceKind::Pawn));
+        assert_eq!((s.e6,s.s6),(1,1));
+    }
