+    let mut opponent = [0; 11]; for value in &mut opponent {*value = i32r(r)?;}
+    let parameter_average = i32r(r)?; let draw = i32r(r)?; let opponent_selectivity = i32r(r)?;
+    let draw_preference = i32r(r)?; let variation = u32r(r)?;
+    let mut weights = [[0; 2]; 5]; for pair in &mut weights {for value in pair {*value = i32r(r)?;}}
+    Ok(Epoch {side, phase, counts, values, squares, average, own, opponent, parameter_average,
+        draw, opponent_selectivity, draw_preference, variation, weights})
