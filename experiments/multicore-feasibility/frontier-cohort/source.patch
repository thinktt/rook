+    evaluator.fresh_observed(&mut node, &map, false, |_| {});
+    STATE.with(|slot| assert!(!slot.borrow().pool.as_ref().unwrap().chains[0].history.first_production.present()));
+    let mut scratch = None; evaluator.ensure_influence_for_search(&p, &mut scratch, true);
+    with_root_full(true, || evaluator.full(&mut node, &map, false));
+    STATE.with(|slot| {let s = slot.borrow(); let pool = s.pool.as_ref().unwrap();
+        assert!(pool.maps[0].history.first_production.present());
+        assert!(pool.chains[0].history.first_production.present());
+        assert_eq!(pool.chains[0].history.first_phase, 0);
+    });
+    let t = Instant::now(); begin_iteration(6, Some(t)); complete_iteration(6, Some(t + Duration::from_nanos(1)));
+    begin_iteration(7, Some(Instant::now()));
+    let mut custom = Some(Influence {profiles: [[0; 64]; 2]});
+    evaluator.ensure_influence_for_search(&p, &mut custom, true);
+    with_root_full(true, || evaluator.full(&mut node, custom.as_ref().unwrap(), false));
+    STATE.with(|slot| {let s = slot.borrow(); assert_eq!(s.footer.counts[2..], [0, 1]);
+        assert_eq!(s.pool.as_ref().unwrap().chains[0].history.calls[4], 0);
+    });
+    // Exercise both real private caller seams through the common native prefix.
+    let mut list = crate::movegen::MoveList::new();
+    evaluator.full_ordinary_inventory(&mut node, &map, false, true, &mut list);
+    evaluator.full_ordinary_inventory(&mut node, &map, false, false, &mut list);
+    let mut supplied = Some(map);
+    let (selection, _) = evaluator.select_noncheck_q_inventory(
+        &mut node, -1, 1, true, &mut supplied, true, false, &mut list,
+    );
+    assert!(selection.refreshed); assert_eq!(supplied, Some(map));
+    let custom_map = *custom.as_ref().unwrap();
+    evaluator.select_noncheck_q_inventory(&mut node, -1, 1, true, &mut custom, true, false, &mut list);
+    assert_eq!(custom, Some(custom_map));
+    STATE.with(|slot| {let s = slot.borrow(); assert_eq!(s.footer.counts[2..], [0, 4]);
+        let history = &s.pool.as_ref().unwrap().chains[0].history;
+        assert_eq!(history.calls[4], 2); assert!(!history.new7);
+        assert_eq!(s.costs[1].hits, 2);
+    });
+    assert!(!is_root_full());
+    let panic = std::panic::catch_unwind(|| with_root_full(true, || panic!("root scope unwind")));
+    assert!(panic.is_err()); assert!(!is_root_full());
+}
