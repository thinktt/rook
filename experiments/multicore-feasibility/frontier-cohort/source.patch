+fn root_before_prefix_and_actual_private_demand_hooks_keep_supplied_map_authority() {
+    let p = position(); let mut evaluator = Evaluator::<true>::new(&p);
+    let e = evaluator.frontier_cohort_epoch(); let context = e.root(); let _reset = observed(&p, e);
+    let mut node = Node::root(p, &context); let map = Influence::build_coherent(&p);
