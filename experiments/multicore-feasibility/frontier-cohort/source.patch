+fn position_root_binary_roundtrip_preserves_chronology_and_rejects_derived_disagreement() {
+    let mut p = position(); p.squares[0].swap(2, 3); p.validate().unwrap();
+    let mut raw = Vec::new(); io::write_position(&mut raw, &p).unwrap(); assert_eq!(raw.len(), 125);
+    assert_eq!(io::read_position(&mut raw.as_slice()).unwrap(), p);
+    raw[108] ^= 1; assert!(io::read_position(&mut raw.as_slice()).is_err());
+    let e = epoch(&p); let mut header = Vec::new();
+    io::header(&mut header, b"R2FCOH01", &p, &e, 3, 5, 0, 0).unwrap();
+    assert_eq!(header.len() as u64, io::HEADER_BYTES);
+    let (restored, rebound, counts) = io::read_header(&mut header.as_slice(), b"R2FCOH01").unwrap();
+    assert_eq!(restored, p); assert_eq!(rebound, e); assert_eq!(counts, [3, 5, 0, 0]);
+    // Bound headers and records are serialized field-by-field, not size_of.
+    let mut history = Vec::new(); io::write_history(&mut history, 0, &History::default()).unwrap();
+    assert_eq!(history.len(), 150);
+    let f = Footer {boundaries: [0, 1, 2, 3], mask: 192, ..Footer::default()};
+    let mut footer = Vec::new(); io::write_footer(&mut footer, f).unwrap();
+    assert_eq!(footer.len() as u64, io::FOOTER_BYTES);
+    assert!(io::read_footer(&mut footer.as_slice()).unwrap().pair_complete());
+    footer.push(0); assert!(io::read_footer(&mut footer.as_slice()).is_err());
+}
