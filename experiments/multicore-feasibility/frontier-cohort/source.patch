+pub fn write_report() -> Result<(), String> {
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if s.config.mode == Mode::Off {return Ok(());}
+        if s.reported {return Err("cohort report already written".into());}
+        if !s.finished || !s.bound {s.fail("cohort_search_not_finished");}
+        if let Err(error) = s.check_bytes() {
+            // The full planned ledger has not been created; preserve the cold
+            // rejection report without claiming a complete admitted cohort.
+            io::write_summary(s.config.report.as_ref().unwrap(), &s)?; s.reported = true;
+            return Err(error);
+        }
+        if !s.bound {
+            io::write_summary(s.config.report.as_ref().unwrap(), &s)?; s.reported = true;
+            return Err(s.error.unwrap_or("cohort_root_not_bound").into());
+        }
+        match s.config.mode {
+            Mode::Capture => io::write_capture(s.config.capture.as_ref().unwrap(), &s)?,
+            Mode::Observe => io::write_ledger(s.config.ledger.as_ref().unwrap(), &s)?,
+            _ => return Err("cohort invalid report mode".into()),
+        }
+        io::write_summary(s.config.report.as_ref().unwrap(), &s)?; s.reported = true;
+        if let Some(error) = s.error {return Err(error.into());} Ok(())
+    })
+}
