+pub(crate) struct MapProbe {id: Option<u32>, phase: u8,
+    origin: Option<Instant>, started: Option<Instant>}
+pub(crate) struct FullProbe {id: Option<u32>, first_new: bool, phase: u8,
+    origin: Option<Instant>, started: Option<Instant>, extras: [u64; 5]}
+impl MapProbe {fn empty() -> Self {Self {id: None, phase: 0, origin: None, started: None}}}
+impl FullProbe {
+    fn empty() -> Self {Self {id: None, first_new: false, phase: 0, origin: None, started: None, extras: [UNKNOWN; 5]}}
+    fn mark(&mut self, index: usize) {if self.first_new {
+        self.extras[index] = Instant::now().duration_since(self.origin.unwrap()).as_nanos().min((UNKNOWN - 1) as u128) as u64;
+    }}
+    pub(crate) fn dispatch_start(&mut self) {self.mark(0);}
+    pub(crate) fn dispatch_end(&mut self) {self.mark(1);}
+    pub(crate) fn owner_ready(&mut self) {self.mark(2);}
+    pub(crate) fn inventory_start(&mut self) -> Option<Instant> {
+        if !self.first_new {return None;} let now = Instant::now();
+        self.extras[3] = now.duration_since(self.origin.unwrap()).as_nanos().min((UNKNOWN - 1) as u128) as u64;
+        Some(now)
+    }
+    pub(crate) fn inventory_end(&mut self, started: Option<Instant>) {if started.is_some() {self.mark(4);}}
+}
