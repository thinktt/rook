+pub(crate) fn skip(cookie: &mut Option<u32>, position: &Position, movement: Move,
+    iteration: i32, depth: i32, fresh: u8, coherent: bool) {
+    STATE.with(|slot| {let mut s = slot.borrow_mut();
+        if !s.enabled() || s.phase != 6 || iteration != 6 || depth != 0 || fresh != 0
+            || movement.kind() != MoveKind::Ordinary || !coherent {return;}
+        let victim = position.board[movement.to().0 as usize];
+        if !victim.is_empty() && victim.kind() == PieceKind::King {return;}
+        let is_new = cookie.is_none();
+        let id = cookie.unwrap_or(s.actual.as_ref().unwrap().parents.len() as u32);
+        if s.actual.as_ref().unwrap().jobs.len() == JOB_CAP || (is_new && id as usize == PARENT_CAP) {
+            s.fail("cohort_parent_or_job_cap"); return;
+        }
+        let audit_sample = s.costs[3].start();
+        let job_index = s.actual.as_ref().unwrap().jobs.len();
+        let mut map = NONE; let mut chain = NONE;
+        if let Some(pool) = s.pool.as_ref() {
+            if (id as usize) >= pool.cohort.parents.len() || pool.cohort.parents[id as usize] != *position
+                || job_index >= pool.cohort.jobs.len()
+            {s.fail("cohort_parent_or_order_mismatch"); return;}
+            let expected = pool.cohort.jobs[job_index];
+            if expected.parent != id || expected.movement != movement {s.fail("cohort_move_order_mismatch"); return;}
+            map = expected.map; chain = expected.chain;
+        }
+        if !is_new && ((id as usize) >= s.actual.as_ref().unwrap().parents.len()
+            || s.actual.as_ref().unwrap().parents[id as usize] != *position)
+        {s.fail("cohort_parent_cookie_mismatch"); return;}
+        s.costs[3].comparisons += 1;
+        s.costs[3].key_bytes += (size_of::<Position>() + size_of::<Job>()) as u64;
+        s.costs[3].finish(audit_sample);
+        let publication_sample = s.costs[2].start();
+        let rows = s.actual.as_mut().unwrap();
+        if is_new {rows.parents.push(*position); *cookie = Some(id);}
+        rows.jobs.push(Job {parent: id, movement, map, chain, release: Stamp::ABSENT});
+        // Both this replay's parent copy and descriptor publication precede the
+        // timestamp. Capture timestamps are not serialized or imported here.
+        let stamp = if s.config.mode == Mode::Observe {s.stamp_at(Instant::now())} else {Stamp::ABSENT};
+        s.actual.as_mut().unwrap().jobs[job_index].release = stamp;
+        s.costs[2].copy_bytes += size_of::<Job>() as u64 + if is_new {size_of::<Position>() as u64} else {0};
+        s.costs[2].finish(publication_sample);
+        if let Some(pool) = s.pool.as_mut() {
+            for history in [&mut pool.maps[map as usize].history, &mut pool.chains[chain as usize].history] {
+                if !history.release.present() {history.release = stamp;}
+            }
+        }
+        s.footer.counts[0] += u64::from(is_new); s.footer.counts[1] += 1;
+    });
+}
