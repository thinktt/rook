+pub(crate) fn begin_iteration(depth: u8, now: Option<Instant>) {
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if !s.enabled() {return;}
+        s.phase = depth;
+        if depth == 6 || depth == 7 {
+            let index = (depth as usize - 6) * 2;
+            if s.footer.boundaries[index] != UNKNOWN {s.fail("duplicate_iteration_entry"); return;}
+            let Some(now) = now else {s.fail("missing_boundary_clock"); return;};
+            if depth == 7 && s.footer.boundaries[1] == UNKNOWN {s.fail("missing_iteration6_completion"); return;}
+            s.footer.boundaries[index] = s.stamp_at(now).ns;
+        }
+    });
+}
+pub(crate) fn complete_iteration(depth: u8, now: Option<Instant>) {
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if !s.enabled() {return;}
+        if depth == 6 || depth == 7 {
+            let index = (depth as usize - 6) * 2;
+            if s.phase != depth || s.footer.boundaries[index] == UNKNOWN || s.footer.boundaries[index + 1] != UNKNOWN {
+                s.fail("invalid_iteration_completion"); return;
+            }
+            let Some(now) = now else {s.fail("missing_boundary_clock"); return;};
+            s.footer.boundaries[index + 1] = s.stamp_at(now).ns;
+            if depth == 7 {s.closed = true;}
+        }
+        s.phase = 0;
+    });
+}
