+fn write_placement(w: &mut impl Write, p: &Placement) -> Result<(), String> {
+    for piece in p.board {u8w(w, piece.0)?;} for side in p.counts {put(w, &side)?;}
+    for side in p.sources {for square in side {u8w(w, square.0)?;}} Ok(())
+}
+fn read_placement(r: &mut impl Read) -> Result<Placement, String> {
+    let board = bytes::<64>(r)?.map(Piece); let mut counts = [[0; 6]; 2];
+    for side in &mut counts {*side = bytes(r)?;}
+    let mut sources = [[Square(64); 16]; 2]; for side in &mut sources {for square in side {*square = Square(u8r(r)?);}}
+    // Verify every active source and every tail without normalizing chronology.
+    let mut restored = [Piece::EMPTY; 64];
+    for c in 0..2 {
+        let population = counts[c].iter().map(|&n| n as usize).sum::<usize>();
+        if population > 16 || counts[c][5] != 1 {return Err("cohort key population".into());}
+        let mut offset = 0;
+        for (k, &count) in counts[c].iter().enumerate() {for _ in 0..count {
+            let square = sources[c][offset].0 as usize; offset += 1;
+            if square >= 64 || !restored[square].is_empty() {return Err("cohort key source square".into());}
+            restored[square] = Piece::new(if c == 0 {Color::White} else {Color::Black}, PieceKind::ALL[k]);
+        }}
+        if sources[c][population..].iter().any(|s| s.0 != 64) {return Err("cohort key source tail".into());}
+    }
+    if board != restored {return Err("cohort key mailbox/source disagreement".into());}
+    Ok(Placement {board, counts, sources})
+}
+fn write_map(w: &mut impl Write, map: &Influence) -> Result<(), String> {
+    for side in map.profiles {put(w, &side)?;} Ok(())
+}
+fn read_map(r: &mut impl Read) -> Result<Influence, String> {Ok(Influence {profiles: [bytes(r)?, bytes(r)?]})}
+fn write_map_key(w: &mut impl Write, key: &MapKey) -> Result<(), String> {
+    write_placement(w, &key.placement)?; for plane in key.planes {u64w(w, plane)?;} u8w(w, u8::from(key.coherent))
+}
+fn read_map_key(r: &mut impl Read) -> Result<MapKey, String> {
+    let placement = read_placement(r)?; let planes = [u64r(r)?, u64r(r)?, u64r(r)?, u64r(r)?];
+    if u8r(r)? != 1 || planes != *crate::attacks::AttackBits::from_board(&placement.board).planes() {
+        return Err("cohort coherent map route/planes".into());
+    }
+    let mut offset;
+    for c in 0..2 {offset = 0; for &count in &placement.counts[c] {
+        let end = offset + count as usize;
+        if placement.sources[c][offset..end].windows(2).any(|p| p[0].0 > p[1].0) {return Err("cohort map sources not normalized".into());}
+        offset = end;
+    }}
+    Ok(MapKey {placement, planes, coherent: true})
+}
+fn write_chain_key(w: &mut impl Write, key: &ChainKey) -> Result<(), String> {
+    write_placement(w, &key.placement)?; u8w(w, key.starting_units)?; write_map(w, &key.map)?;
+    i32w(w, key.material)?; for value in key.mobility {i32w(w, value)?;} for value in key.shelter {i32w(w, value)?;} Ok(())
+}
+fn read_chain_key(r: &mut impl Read) -> Result<ChainKey, String> {
+    let placement = read_placement(r)?; let starting_units = u8r(r)?; let map = read_map(r)?;
+    let material = i32r(r)?; let mobility = [i32r(r)?, i32r(r)?]; let shelter = [i32r(r)?, i32r(r)?];
+    Ok(ChainKey {placement, starting_units, map, material, mobility, shelter})
+}
+fn write_chain_value(w: &mut impl Write, value: ChainValue) -> Result<(), String> {
+    for v in value.activity.pieces {i32w(w, v)?;} for v in value.activity.pressure {i32w(w, v)?;}
+    i32w(w, value.activity.weighted)?; u64w(w, value.activity.relation_queries)?;
+    for v in value.shelter.terms {i32w(w, v)?;} i32w(w, value.shelter.weighted)
+}
+fn write_stamp(w: &mut impl Write, stamp: Stamp) -> Result<(), String> {u64w(w, stamp.ns)?; u64w(w, stamp.ordinal)}
+pub(super) fn write_history(w: &mut impl Write, id: u32, h: &History) -> Result<(), String> {
+    u32w(w, id)?; write_stamp(w, h.release)?; write_stamp(w, h.first_production)?; write_stamp(w, h.first7)?;
+    u8w(w, h.first_phase)?; u8w(w, u8::from(h.new7))?;
+    for calls in h.calls {u64w(w, calls)?;} for time in h.kernel {u64w(w, time)?;}
+    for time in h.extras {u64w(w, time)?;} Ok(())
+}
+pub(super) fn write_footer(w: &mut impl Write, f: Footer) -> Result<(), String> {
+    for value in f.boundaries {u64w(w, value)?;} for value in f.counts {u64w(w, value)?;}
+    for value in [f.n, f.r, f.mask] {u64w(w, value)?;}
+    put(w, &[f.last, f.stop_depth, f.selected, f.point])?; u64w(w, f.selected_n)?;
+    u32w(w, f.publications)?; u32w(w, f.flags)
+}
+pub(super) fn read_footer(r: &mut impl Read) -> Result<Footer, String> {
+    let mut f = Footer::default(); for value in &mut f.boundaries {*value = u64r(r)?;}
+    for value in &mut f.counts {*value = u64r(r)?;}
+    f.n = u64r(r)?; f.r = u64r(r)?; f.mask = u64r(r)?; f.last = u8r(r)?;
+    f.stop_depth = u8r(r)?; f.selected = u8r(r)?; f.point = u8r(r)?;
+    f.selected_n = u64r(r)?; f.publications = u32r(r)?; f.flags = u32r(r)?;
+    let mut extra = [0]; if r.read(&mut extra).map_err(error)? != 0 {return Err("cohort raw trailing bytes".into());}
+    if !f.pair_complete() {return Err("cohort raw incomplete pair".into());} Ok(f)
+}
+fn writer(path: &Path) -> Result<BufWriter<File>, String> {
+    Ok(BufWriter::with_capacity(BUFFER_BYTES,
+        OpenOptions::new().create_new(true).write(true).open(path).map_err(error)?))
+}
+fn reader(path: &Path, maximum: u64) -> Result<BufReader<File>, String> {
+    let file = File::open(path).map_err(error)?; let length = file.metadata().map_err(error)?.len();
+    if !(HEADER_BYTES + FOOTER_BYTES..=maximum).contains(&length) {return Err("cohort raw file length outside fixed bounds".into());}
+    Ok(BufReader::with_capacity(BUFFER_BYTES, file))
+}
+pub(super) fn header(w: &mut impl Write, magic: &[u8; 8], root: &Position, epoch: &Epoch,
+    parents: usize, jobs: usize, maps: usize, chains: usize) -> Result<(), String> {
+    put(w, magic)?; for value in [1, PARENT_CAP as u32, JOB_CAP as u32] {u32w(w, value)?;}
+    u64w(w, BYTE_CAP as u64)?; for value in [parents, jobs, maps, chains] {u32w(w, value as u32)?;}
+    write_position(w, root)?; write_epoch(w, epoch)
+}
+pub(super) fn read_header(r: &mut impl Read, magic: &[u8; 8]) -> Result<(Position, Epoch, [usize; 4]), String> {
+    if &bytes::<8>(r)? != magic || u32r(r)? != 1 || u32r(r)? != PARENT_CAP as u32
+        || u32r(r)? != JOB_CAP as u32 || u64r(r)? != BYTE_CAP as u64 {return Err("cohort raw header/version/caps".into());}
+    let counts = [u32r(r)? as usize, u32r(r)? as usize, u32r(r)? as usize, u32r(r)? as usize];
+    if counts[0] > PARENT_CAP || counts[1..].iter().any(|&n| n > JOB_CAP) {return Err("cohort raw row cap".into());}
+    let root = read_position(r)?; let epoch = read_epoch(r)?; epoch.validate(&root)?;
+    Ok((root, epoch, counts))
+}
+pub(super) fn validate_move(position: &Position, movement: Move) -> Result<(), String> {
+    if movement.0 >> 12 != 0 || movement.from() == movement.to() {return Err("cohort nonordinary descriptor".into());}
+    let from = position.board[movement.from().0 as usize]; let to = position.board[movement.to().0 as usize];
+    if from.is_empty() || from.color() != position.side || (!to.is_empty()
+        && (to.color() == position.side || to.kind() == PieceKind::King)) {return Err("cohort invalid native move descriptor".into());}
+    if from.kind() == PieceKind::Pawn && matches!(movement.to().rank(), 0 | 7) {return Err("cohort ordinary promotion descriptor".into());}
+    Ok(())
+}
+fn read_cohort(r: &mut impl Read, counts: [usize; 4], with_ids: bool) -> Result<Cohort, String> {
+    let mut cohort = Cohort::new()?;
+    for _ in 0..counts[0] {cohort.parents.push(read_position(r)?);}
+    // First use of each cookie must follow parent creation order. Duplicates
+    // within or across invocations remain distinct descriptors.
+    let mut created = 0u32;
+    for _ in 0..counts[1] {
+        let parent = u32r(r)?; let movement = Move(u16r(r)?);
+        if parent as usize >= counts[0] || parent > created {return Err("cohort parent occurrence order".into());}
+        if parent == created {created += 1;}
+        validate_move(&cohort.parents[parent as usize], movement)?;
+        let (map, chain) = if with_ids {(u32r(r)?, u32r(r)?)} else {(NONE, NONE)};
+        if with_ids && (map as usize >= counts[2] || chain as usize >= counts[3]) {return Err("cohort occurrence key ID".into());}
+        cohort.jobs.push(Job {parent, movement, map, chain, release: Stamp::ABSENT});
+    }
+    if created as usize != counts[0] {return Err("cohort unused parent row".into());} Ok(cohort)
+}
+fn write_cohort(w: &mut impl Write, cohort: &Cohort, with_ids: bool, with_release: bool) -> Result<(), String> {
+    for position in &cohort.parents {write_position(w, position)?;}
+    for job in &cohort.jobs {u32w(w, job.parent)?; u16w(w, job.movement.0)?;
+        if with_ids {u32w(w, job.map)?; u32w(w, job.chain)?;}
+        if with_release {write_stamp(w, job.release)?;}
+    } Ok(())
+}
+pub(super) fn write_capture(path: &Path, state: &State) -> Result<(), String> {
+    let rows = state.actual.as_ref().ok_or("cohort missing captured rows")?; let mut w = writer(path)?;
+    header(&mut w, CAPTURE_MAGIC, state.root.as_ref().unwrap(), state.epoch.as_ref().unwrap(), rows.parents.len(), rows.jobs.len(), 0, 0)?;
+    write_cohort(&mut w, rows, false, false)?; write_footer(&mut w, state.footer)?; w.flush().map_err(error)
+}
+pub(super) fn read_capture(path: &Path) -> Result<(Position, Epoch, Cohort, Footer), String> {
+    let mut r = reader(path, CAPTURE_MAX)?; let (root, epoch, counts) = read_header(&mut r, CAPTURE_MAGIC)?;
+    if counts[2] != 0 || counts[3] != 0 {return Err("cohort capture contains key rows".into());}
+    if planned_memory(1) + planned_files(Mode::Expand, counts[0], counts[1], counts[1], counts[1]) > BYTE_CAP {
+        return Err("cohort combined cap before expansion reservation".into());
+    }
+    let rows = read_cohort(&mut r, counts, false)?; let footer = read_footer(&mut r)?;
+    if footer.counts[..2] != [rows.parents.len() as u64, rows.jobs.len() as u64] {return Err("cohort capture count disagreement".into());}
+    Ok((root, epoch, rows, footer))
+}
+pub(super) fn write_pool(path: &Path, pool: &Pool) -> Result<(), String> {
+    let mut w = writer(path)?;
+    header(&mut w, POOL_MAGIC, &pool.root, &pool.epoch, pool.cohort.parents.len(), pool.cohort.jobs.len(), pool.maps.len(), pool.chains.len())?;
+    write_cohort(&mut w, &pool.cohort, true, false)?;
+    for row in &pool.maps {write_map_key(&mut w, &row.key)?; write_map(&mut w, &row.value)?;}
+    for row in &pool.chains {write_chain_key(&mut w, &row.key)?;}
+    write_footer(&mut w, pool.captured)?; w.flush().map_err(error)
+}
+pub(super) fn read_pool(path: &Path) -> Result<Pool, String> {
+    let mut r = reader(path, POOL_MAX)?; let (root, epoch, counts) = read_header(&mut r, POOL_MAGIC)?;
+    if counts[2] > counts[1] || counts[3] > counts[1] {
+        return Err("cohort selected key count exceeds occurrences".into());
+    }
+    if planned_memory(2) + planned_files(Mode::Observe, counts[0], counts[1], counts[2], counts[3]) > BYTE_CAP {
+        return Err("cohort combined cap before observation reservation".into());
+    }
+    let rows = read_cohort(&mut r, counts, true)?; let mut pool = Pool::new(root, epoch, rows, Footer::default())?;
+    for expected in 0..counts[2] {let key = read_map_key(&mut r)?; let value = read_map(&mut r)?;
+        let bucket = filter(&key.planes); let id = pool.insert_map(key, value, bucket)?;
+        if id as usize != expected {return Err("cohort duplicate serialized map key".into());}
+    }
+    for expected in 0..counts[3] {let key = read_chain_key(&mut r)?;
+        let bucket = filter(crate::attacks::AttackBits::from_board(&key.placement.board).planes());
+        let id = pool.insert_chain(key, bucket)?;
+        if id as usize != expected {return Err("cohort duplicate serialized chain key".into());}
+    }
+    pool.captured = read_footer(&mut r)?;
+    if pool.captured.counts[..2] != [counts[0] as u64, counts[1] as u64] {return Err("cohort pool count disagreement".into());}
