+pub(crate) fn before_map(position: &Position, coherent: bool) -> MapProbe {
+    STATE.with(|slot| {let mut s = slot.borrow_mut();
+        if !s.enabled() || !coherent {return MapProbe::empty();}
+        if s.phase == 7 {s.footer.counts[2] += 1;}
+        if s.config.mode != Mode::Observe {return MapProbe::empty();}
+        let cost_index = usize::from(s.phase == 7); let sampled = s.costs[cost_index].start();
+        let bucket = filter(position.attack_planes());
+        if s.pool.as_ref().unwrap().map_heads[bucket as usize & (INDEX_SLOTS - 1)] == NONE {
+            s.costs[cost_index].misses += 1; s.costs[cost_index].finish(sampled); return MapProbe::empty();
+        }
+        // Matching-demand site: after nonempty congruent-filter admission,
+        // before constructing/comparing the complete typed key.
+        let stamp = s.stamp_at(Instant::now());
+        let key = MapKey::new(position); let mut comparisons = 0;
+        let id = s.pool.as_ref().unwrap().find_map(&key, bucket, &mut comparisons);
+        s.costs[cost_index].comparisons += comparisons; s.costs[cost_index].key_bytes += size_of::<MapKey>() as u64;
+        s.costs[cost_index].copy_bytes += size_of::<MapKey>() as u64;
+        let Some(id) = id else {s.costs[cost_index].misses += 1; s.costs[cost_index].finish(sampled); return MapProbe::empty();};
+        s.costs[cost_index].hits += 1;
+        s.costs[cost_index].finish(sampled);
+        // Novelty/history mutation is audit work, outside prospective query samples.
+        let phase = s.phase; let entered6 = s.footer.boundaries[0] != UNKNOWN;
+        let first_new = s.pool.as_mut().unwrap().maps[id as usize].history.demand(phase, entered6, stamp);
+        MapProbe {id: Some(id), phase, origin: s.origin,
+            started: first_new.then(Instant::now)}
+    })
+}
+pub(crate) fn after_map(probe: MapProbe, value: &Influence) {
+    let end = probe.started.map(|_| Instant::now());
+    let Some(id) = probe.id else {return;};
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if s.error.is_some() {return;}
+        let stamp = s.stamp_at(end.unwrap_or_else(Instant::now));
+        let audit_sample = s.costs[4].start();
+        s.payload_comparisons += 1; s.payload_bytes += size_of::<Influence>() as u64;
+        let row = &mut s.pool.as_mut().unwrap().maps[id as usize];
+        if row.value != *value {s.fail("cohort_canonical_map_payload_mismatch"); return;}
+        row.history.produce(probe.phase, stamp);
+        if let (Some(start), Some(end)) = (probe.started, end) {
+            row.history.kernel = [start.duration_since(probe.origin.unwrap()).as_nanos() as u64,
+                end.duration_since(probe.origin.unwrap()).as_nanos() as u64];
+        }
+        s.costs[4].comparisons += 1; s.costs[4].finish(audit_sample);
+    });
+}
+
+pub(crate) fn before_full(position: &Position, map: &Influence, material: i32,
+    mobility: [i32; 2], shelter: [i32; 2], native_admitted: bool) -> FullProbe {
+    STATE.with(|slot| {let mut s = slot.borrow_mut();
+        if !s.enabled() || !native_admitted {return FullProbe::empty();}
+        if s.phase == 7 {s.footer.counts[3] += 1;}
+        if s.config.mode != Mode::Observe {return FullProbe::empty();}
+        let cost_index = usize::from(s.phase == 7); let sampled = s.costs[cost_index].start();
+        let bucket = filter(position.attack_planes());
+        if s.pool.as_ref().unwrap().chain_heads[bucket as usize & (INDEX_SLOTS - 1)] == NONE {
+            s.costs[cost_index].misses += 1; s.costs[cost_index].finish(sampled); return FullProbe::empty();
+        }
+        let stamp = s.stamp_at(Instant::now());
+        let key = ChainKey::new(position, map, material, mobility, shelter); let mut comparisons = 0;
+        let id = s.pool.as_ref().unwrap().find_chain(&key, bucket, &mut comparisons);
+        s.costs[cost_index].comparisons += comparisons; s.costs[cost_index].key_bytes += size_of::<ChainKey>() as u64;
+        s.costs[cost_index].copy_bytes += size_of::<ChainKey>() as u64;
+        let Some(id) = id else {s.costs[cost_index].misses += 1; s.costs[cost_index].finish(sampled); return FullProbe::empty();};
+        s.costs[cost_index].hits += 1;
+        s.costs[cost_index].finish(sampled);
+        // Novelty/history mutation is audit work, outside prospective query samples.
+        let phase = s.phase; let entered6 = s.footer.boundaries[0] != UNKNOWN;
+        let first_new = s.pool.as_mut().unwrap().chains[id as usize].history.demand(phase, entered6, stamp);
+        FullProbe {id: Some(id), first_new, phase, origin: s.origin,
+            started: first_new.then(Instant::now), extras: [UNKNOWN; 5]}
+    })
+}
+pub(crate) fn after_full(probe: FullProbe, value: &ActivityShelter) {
+    let end = probe.started.map(|_| Instant::now());
+    let Some(id) = probe.id else {return;};
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if s.error.is_some() {return;}
+        let stamp = s.stamp_at(end.unwrap_or_else(Instant::now)); let value = ChainValue::from(value);
+        let audit_sample = s.costs[4].start();
+        let repeated_payload = s.pool.as_ref().unwrap().chains[id as usize].has_value;
+        s.payload_comparisons += u64::from(repeated_payload); s.payload_bytes += size_of::<ChainValue>() as u64;
+        let row = &mut s.pool.as_mut().unwrap().chains[id as usize];
+        if row.has_value && row.value != value {s.fail("cohort_canonical_chain_payload_mismatch"); return;}
+        row.value = value; row.has_value = true; row.history.produce(probe.phase, stamp);
+        if let (Some(start), Some(end)) = (probe.started, end) {
+            row.history.kernel = [start.duration_since(probe.origin.unwrap()).as_nanos() as u64,
+                end.duration_since(probe.origin.unwrap()).as_nanos() as u64];
+            row.history.extras = probe.extras;
+        }
+        s.costs[4].comparisons += u64::from(repeated_payload); s.costs[4].finish(audit_sample);
+    });
+}
