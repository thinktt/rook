+pub(super) fn write_ledger(path: &Path, state: &State) -> Result<(), String> {
+    let pool = state.pool.as_ref().ok_or("cohort missing observed pool")?;
+    let rows = state.actual.as_ref().ok_or("cohort missing actual rows")?; let mut w = writer(path)?;
