+    assert_ne!(key, ChainKey::new(&a, &map, 8, [1024; 2], [1024; 2]));
+    assert_ne!(key, ChainKey::new(&a, &map, 7, [1023, 1024], [1024; 2]));
+    let mut changed_phase = a; changed_phase.starting_units ^= 1;
+    assert_ne!(key, ChainKey::new(&changed_phase, &map, 7, [1024; 2], [1024; 2]));
+    let mut projected = MapKey::new(&a); projected.planes[0] ^= 1;
+    assert_ne!(MapKey::new(&a), projected);
+    let mut changed_epoch = epoch(&a); changed_epoch.weights[3][0] += 1;
+    assert_ne!(epoch(&a), changed_epoch); assert!(changed_epoch.validate(&a).is_err());
+}
