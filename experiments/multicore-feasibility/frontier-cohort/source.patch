+fn history_summary<'a>(histories: impl Iterator<Item = &'a History>) -> String {
+    let mut counts = [0u64; 9]; let mut sum_kernel = 0u128; let mut sum_lead = 0u128;
+    for h in histories {
+        counts[0] += 1; counts[1] += u64::from(h.first_production.present());
+        counts[2] += u64::from(h.first7.present()); counts[3] += u64::from(h.new7);
+        counts[4] += h.calls[4].saturating_sub(1); counts[5] += u64::from(!h.first7.present());
+        if h.first7.present() && h.release.present()
+            && (h.release.ns, h.release.ordinal) < (h.first7.ns, h.first7.ordinal) {
+            counts[6] += 1; sum_lead += (h.first7.ns - h.release.ns) as u128;
+        }
+        if h.new7 && h.kernel[0] != UNKNOWN && h.kernel[1] != UNKNOWN {
+            counts[7] += 1; sum_kernel += (h.kernel[1] - h.kernel[0]) as u128;
+        }
+        counts[8] += h.calls[4];
+    }
+    format!("{{\"unique\":{},\"canonicalProduced\":{},\"demanded7\":{},\"new7\":{},\"repeat7\":{},\"no7\":{},\"releaseBeforeFirst7\":{},\"measuredFirstNew7\":{},\"calls7\":{},\"availableLeadNs\":{},\"firstNewKernelNs\":{}}}",
+        counts[0], counts[1], counts[2], counts[3], counts[4], counts[5], counts[6], counts[7], counts[8], sum_lead, sum_kernel)
+}
