+pub(super) fn read_position(r: &mut impl Read) -> Result<Position, String> {
+    // A valid initialized template owns private planes; restore public fields,
+    // rebuild private derived state, then reject any captured disagreement.
+    let mut position = Position::from_fen("4k3/8/8/8/8/8/8/4K3 w - - 0 1")?;
