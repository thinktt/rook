+pub(crate) fn finish_search(outcome: &Outcome) {
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); if s.config.mode == Mode::Off {return;}
+        s.active = false; s.phase = 0; s.finished = true;
+        s.footer.n = outcome.stop.work.charged_search_units; s.footer.r = outcome.stop.work.charged_relation_queries;
+        s.footer.mask = outcome.iterations.iter().filter(|i| i.complete).fold(0u64, |m, i| m | (1u64 << i.depth));
+        s.footer.last = outcome.iterations.last().map_or(0, |i| i.depth);
+        s.footer.stop_depth = outcome.stop.depth;
+        s.footer.point = match outcome.stop.point {crate::timed::Point::Root => 0, crate::timed::Point::Iteration => 1, crate::timed::Point::Poll => 2};
+        s.footer.selected = outcome.result.as_ref().map_or(0, |c| c.depth);
+        s.footer.selected_n = outcome.result.as_ref().map_or(0, |c| c.search_id);
+        s.footer.publications = outcome.publications.len() as u32;
+        if !s.footer.pair_complete() {s.fail("incomplete_iteration_pair");}
+        if let Some(pool) = s.pool.as_ref() {
+            let rows = s.actual.as_ref().unwrap();
+            if rows.parents.len() != pool.cohort.parents.len() || rows.jobs.len() != pool.cohort.jobs.len()
+                || !s.footer.same_work(&pool.captured) {s.fail("cohort_or_count_boundary_mismatch");}
+        }
+    });
+}
