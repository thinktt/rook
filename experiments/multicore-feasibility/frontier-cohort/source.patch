+        if value != 0 && !matches!(value, 1..=6 | 9..=14) {return Err("cohort invalid piece byte".into());}
+        *piece = Piece(value);
+    }
+    for side in &mut position.squares {for square in side {let value = u8r(r)?;
+        if value > 64 {return Err("cohort invalid square byte".into());} *square = Square(value);
+    }}
+    for side in &mut position.counts {*side = bytes(r)?;}
+    let hashes = [u32r(r)?, u32r(r)?, u32r(r)?];
+    position.side = color(u8r(r)?)?; position.rights = u8r(r)?; position.ep = u8r(r)?;
+    position.halfmove = u8r(r)?; let starting = u8r(r)?;
+    if position.counts.iter().any(|side| side.iter().map(|&n| n as usize).sum::<usize>() > 16) {
