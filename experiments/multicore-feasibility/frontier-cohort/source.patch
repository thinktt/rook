+#[test]
+fn component_histories_distinguish_prior_first_repeat_no_demand_and_disjoint_intervals() {
+    let stamp = |n| Stamp {ns: n, ordinal: n};
+    let mut map = History::default(); let mut chain = History::default();
+    assert!(!map.demand(0, false, stamp(1))); map.produce(0, stamp(2));
+    map.release = stamp(4); chain.release = stamp(4);
+    assert!(!map.demand(6, true, stamp(5))); map.produce(6, stamp(6));
+    assert!(!map.demand(7, true, stamp(8))); assert!(chain.demand(7, true, stamp(8)));
+    chain.produce(7, stamp(10)); chain.kernel = [8, 10];
+    assert!(!chain.demand(7, true, stamp(11))); chain.produce(7, stamp(12));
+    assert_eq!(map.calls, [1, 0, 1, 0, 1]); assert!(!map.new7);
+    assert_eq!(chain.calls[4], 2); assert!(chain.new7); assert_eq!(chain.first_production, stamp(10));
+    assert_eq!(chain.first7, stamp(8)); assert_eq!(chain.calls[4] - 1, 1);
+    assert!(!History::default().first7.present());
+    let p = position(); let _reset = observed(&p, epoch(&p));
+    STATE.with(|slot| {let mut s = slot.borrow_mut(); s.phase = 7; s.footer.boundaries[0] = 0;});
+    let probe = before_map(&p, true); let map = Influence::build_coherent(&p); after_map(probe, &map);
+    let context = epoch(&p).root();
+    let mut probe = before_full(&p, &map, context.material(&p), [1024; 2], [1024; 2], true);
+    probe.dispatch_start(); probe.dispatch_end(); probe.owner_ready();
+    let inventory = probe.inventory_start(); probe.inventory_end(inventory);
+    let value = crate::evaluator_worker::compute(&p, &map, context.material(&p), [1024; 2], [1024; 2]);
+    after_full(probe, &value);
+    STATE.with(|slot| {let s = slot.borrow(); let pool = s.pool.as_ref().unwrap();
+        let m = &pool.maps[0].history; let c = &pool.chains[0].history;
+        assert!(m.new7 && c.new7); assert!(m.kernel[0] <= m.kernel[1]);
+        assert!(m.kernel[1] <= c.kernel[0] && c.kernel[0] <= c.kernel[1]);
+        assert!(c.extras.windows(2).all(|p| p[0] <= p[1]));
+        assert_eq!(s.footer.counts[2..], [1, 1]);
+    });
+}
