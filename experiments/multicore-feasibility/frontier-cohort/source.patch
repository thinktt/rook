+//! Bounded owner-thread frontier observation. Never supplies an engine result.
+//!
+//! Selected keys come ONLY from the captured iteration-six cohort. Root binding
+//! precedes root production; lookup ends at iteration-seven completion. Every
+//! query drops its TLS borrow before entering a kernel or callback. A release is
+//! owner-local descriptor publication, not producer completion: actual readiness
+//! is unknown. Map and post-material FULL-prefix intervals are disjoint observed
+//! path costs, not removable wall time or hardware bounds.
+use crate::{activity::Activity, evaluation::RootContext, evaluator::Parameters,
+    evaluator_worker::ActivityShelter, influence::Influence, position::{Phase, Position},
+    shelter::Shelter, timed::Outcome, types::{Color, Move, MoveKind, Piece, PieceKind, Square}};
+use std::{cell::{Cell, RefCell}, mem::size_of, path::PathBuf, time::Instant};
+
+mod io;
+#[cfg(test)]
+mod tests;
+
+pub(crate) const PARENT_CAP: usize = 16_384;
+pub(crate) const JOB_CAP: usize = 262_144;
+pub(crate) const BYTE_CAP: usize = 512 * 1024 * 1024;
+const INDEX_SLOTS: usize = 524_288;
+const NONE: u32 = u32::MAX;
+const UNKNOWN: u64 = u64::MAX;
+const SAMPLE_STRIDE: u64 = 512;
+// Includes two simultaneous I/O buffers, bounded report/path strings, cold
+// key/root/Position temporaries, and 64B per allocation for allocation overhead.
+const FIXED_RESERVE: usize = 512 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Epoch {
+    side: Color, phase: [u16; 3], counts: [[u8; 6]; 2], values: [[i32; 5]; 2],
+    squares: [[[i16; 64]; 5]; 2], average: i32, own: [i32; 11], opponent: [i32; 11],
+    parameter_average: i32, draw: i32, opponent_selectivity: i32,
+    draw_preference: i32, variation: u32, weights: [[i32; 2]; 5],
+}
+impl Epoch {
+    pub(crate) fn new(root: &RootContext, parameters: &Parameters, draw: i32,
+        variation: u32, weights: [[i32; 2]; 5]) -> Self {
+        Self {side: root.side, phase: [root.phase.opening, root.phase.middlegame, root.phase.endgame],
+            counts: root.counts, values: root.values, squares: root.squares, average: root.average_depth,
+            own: parameters.own, opponent: parameters.opponent, parameter_average: parameters.average_depth,
+            draw: parameters.draw, opponent_selectivity: parameters.opponent_selectivity,
+            draw_preference: draw, variation, weights}
+    }
+    fn root(&self) -> RootContext {
+        RootContext {side: self.side, phase: Phase {opening: self.phase[0], middlegame: self.phase[1],
+            endgame: self.phase[2]}, counts: self.counts, values: self.values,
+            squares: self.squares, average_depth: self.average}
+    }
+    fn validate(&self, position: &Position) -> Result<(), String> {
+        if !self.own.iter().all(|v| (0..=1000).contains(v))
+            || !self.opponent.iter().enumerate().filter(|(i, _)| *i != 5).all(|(_, v)| (0..=1000).contains(v))
+            || !(-100..=100).contains(&self.parameter_average)
+            || !(-10000..=10000).contains(&self.draw) || !(0..=100).contains(&self.opponent_selectivity)
+        { return Err("cohort invalid captured parameters".into()); }
+        let percentages = if position.side == Color::White {[self.own, self.opponent]} else {[self.opponent, self.own]};
+        let root = RootContext::new(position,
+            std::array::from_fn(|c| std::array::from_fn(|k| percentages[c][k] as u16)), self.parameter_average);
+        let parameters = Parameters {own: self.own, opponent: self.opponent,
+            average_depth: self.parameter_average, draw: self.draw, opponent_selectivity: self.opponent_selectivity};
+        let weights = [10usize, 9, 6, 7, 8].map(|k| percentages.map(|p| crate::evaluator::coefficient(p[k])));
+        let expected = Self::new(&root, &parameters,
+            crate::evaluation::draw_preference(root.phase, self.draw),
+            crate::evaluation::variation_range(self.opponent_selectivity), weights);
+        if *self != expected { return Err("cohort captured root epoch disagrees with root/parameters".into()); }
+        Ok(())
+    }
+}
+
+// These are the reviewed pure_observer projections. Map source order is
+// normalized within each kind, retaining multiplicity; chain order is exact.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Placement {board: [Piece; 64], counts: [[u8; 6]; 2], sources: [[Square; 16]; 2]}
+impl Placement {
+    fn new(position: &Position, sorted: bool) -> Self {
+        let mut sources = [[Square(64); 16]; 2];
+        for color in [Color::White, Color::Black] {
+            let population = position.counts[color.index()].iter().map(|&n| n as usize).sum::<usize>();
+            assert!(population <= 16, "cohort private source population exceeds16");
+            let mut offset = 0;
+            for kind in PieceKind::ALL {
+                let active = position.piece_squares(color, kind);
+                let end = offset + active.len();
+                sources[color.index()][offset..end].copy_from_slice(active);
+                if sorted {sources[color.index()][offset..end].sort_unstable_by_key(|s| s.0);}
+                offset = end;
+            }
+        }
+        Self {board: position.board, counts: position.counts, sources}
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct MapKey {placement: Placement, planes: [u64; 4], coherent: bool}
+impl MapKey {
+    fn new(position: &Position) -> Self {Self {placement: Placement::new(position, true),
+        planes: *position.attack_planes(), coherent: true}}
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ChainKey {placement: Placement, starting_units: u8, map: Influence,
+    material: i32, mobility: [i32; 2], shelter: [i32; 2]}
+impl ChainKey {
+    fn new(position: &Position, map: &Influence, material: i32, mobility: [i32; 2], shelter: [i32; 2]) -> Self {
+        Self {placement: Placement::new(position, false), starting_units: position.starting_units,
+            map: *map, material, mobility, shelter}
+    }
+}
+fn filter(planes: &[u64; 4]) -> u64 {
+    // Map equality includes these planes. Chain equality includes the board,
+    // which determines them on this fixed trusted-coherent caller domain.
+    // Public/stale-plane inputs are not admitted. No policy hash is consulted;
+    // a bucket hit always requires complete typed equality below.
+    let mut value = 0x9e3779b97f4a7c15u64;
+    for &plane in planes {value = (value ^ plane).rotate_left(17).wrapping_mul(0x9ddfea08eb382d69);}
+    value
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Stamp {ns: u64, ordinal: u64}
+impl Stamp {const ABSENT: Self = Self {ns: UNKNOWN, ordinal: UNKNOWN}; fn present(self) -> bool {self.ns != UNKNOWN}}
+#[derive(Clone, Copy)]
+struct History {
+    release: Stamp, first_production: Stamp, first7: Stamp, first_phase: u8, new7: bool,
+    // before6, in6 before release, in6 after release, intervening, all7.
+    calls: [u64; 5], kernel: [u64; 2], extras: [u64; 5],
+}
+impl Default for History {
+    fn default() -> Self {Self {release: Stamp::ABSENT, first_production: Stamp::ABSENT,
+        first7: Stamp::ABSENT, first_phase: 0, new7: false, calls: [0; 5],
+        kernel: [UNKNOWN; 2], extras: [UNKNOWN; 5]}}
+}
+impl History {
+    fn demand(&mut self, phase: u8, entered6: bool, stamp: Stamp) -> bool {
+        if phase == 7 {
+            self.calls[4] += 1;
+            if !self.first7.present() {self.first7 = stamp; self.new7 = !self.first_production.present();}
+            return self.calls[4] == 1 && self.new7;
+        }
+        let index = if !entered6 {0} else if phase == 6 {if self.release.present() {2} else {1}} else {3};
+        self.calls[index] += 1;
+        false
+    }
+    fn produce(&mut self, phase: u8, stamp: Stamp) {
+        if !self.first_production.present() {self.first_production = stamp; self.first_phase = phase;}
+    }
+}
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+struct ChainValue {activity: Activity, shelter: Shelter}
+impl From<&ActivityShelter> for ChainValue {
+    fn from(value: &ActivityShelter) -> Self {Self {activity: value.activity, shelter: value.shelter}}
+}
+struct MapRow {key: MapKey, value: Influence, history: History, bucket: u64, next: u32}
+struct ChainRow {key: ChainKey, value: ChainValue, has_value: bool, history: History, bucket: u64, next: u32}
+
+#[derive(Clone, Copy)]
+struct Job {parent: u32, movement: Move, map: u32, chain: u32, release: Stamp}
+struct Cohort {parents: Vec<Position>, jobs: Vec<Job>}
+fn reserved<T>(count: usize) -> Result<Vec<T>, String> {
+    let mut rows = Vec::new(); rows.try_reserve_exact(count).map_err(|e| format!("cohort allocation: {e}"))?; Ok(rows)
+}
+impl Cohort {
+    fn new() -> Result<Self, String> {Ok(Self {parents: reserved(PARENT_CAP)?, jobs: reserved(JOB_CAP)?})}
+    fn bytes(&self) -> usize {self.parents.capacity() * size_of::<Position>() + self.jobs.capacity() * size_of::<Job>()}
+}
+struct Pool {root: Position, epoch: Epoch, cohort: Cohort, maps: Vec<MapRow>, chains: Vec<ChainRow>,
+    map_heads: Vec<u32>, chain_heads: Vec<u32>, captured: Footer}
+impl Pool {
+    fn new(root: Position, epoch: Epoch, cohort: Cohort, captured: Footer) -> Result<Self, String> {
+        let mut map_heads = reserved(INDEX_SLOTS)?; map_heads.resize(INDEX_SLOTS, NONE);
+        let mut chain_heads = reserved(INDEX_SLOTS)?; chain_heads.resize(INDEX_SLOTS, NONE);
+        Ok(Self {root, epoch, cohort, maps: reserved(JOB_CAP)?, chains: reserved(JOB_CAP)?, map_heads, chain_heads, captured})
+    }
+    fn bytes(&self) -> usize {self.cohort.bytes() + self.maps.capacity() * size_of::<MapRow>()
+        + self.chains.capacity() * size_of::<ChainRow>() + (self.map_heads.capacity() + self.chain_heads.capacity()) * 4}
+    fn find_map(&self, key: &MapKey, bucket: u64, comparisons: &mut u64) -> Option<u32> {
+        let mut id = self.map_heads[bucket as usize & (INDEX_SLOTS - 1)];
+        while id != NONE {let row = &self.maps[id as usize];
+            if row.bucket == bucket {*comparisons += 1; if row.key == *key {return Some(id);}}
+            id = row.next;
+        } None
+    }
+    fn find_chain(&self, key: &ChainKey, bucket: u64, comparisons: &mut u64) -> Option<u32> {
+        let mut id = self.chain_heads[bucket as usize & (INDEX_SLOTS - 1)];
+        while id != NONE {let row = &self.chains[id as usize];
+            if row.bucket == bucket {*comparisons += 1; if row.key == *key {return Some(id);}}
+            id = row.next;
+        } None
+    }
+    fn insert_map(&mut self, key: MapKey, value: Influence, bucket: u64) -> Result<u32, String> {
+        if let Some(id) = self.find_map(&key, bucket, &mut 0) {
+            if self.maps[id as usize].value != value {return Err("cohort duplicate map payload mismatch".into());} return Ok(id);
+        }
+        if self.maps.len() == JOB_CAP {return Err("cohort map cap".into());}
+        let slot = bucket as usize & (INDEX_SLOTS - 1); let id = self.maps.len() as u32;
+        self.maps.push(MapRow {key, value, history: History::default(), bucket, next: self.map_heads[slot]});
+        self.map_heads[slot] = id; Ok(id)
+    }
+    fn insert_chain(&mut self, key: ChainKey, bucket: u64) -> Result<u32, String> {
+        if let Some(id) = self.find_chain(&key, bucket, &mut 0) {return Ok(id);}
+        if self.chains.len() == JOB_CAP {return Err("cohort chain cap".into());}
+        let slot = bucket as usize & (INDEX_SLOTS - 1); let id = self.chains.len() as u32;
+        self.chains.push(ChainRow {key, value: ChainValue::default(), has_value: false,
+            history: History::default(), bucket, next: self.chain_heads[slot]});
+        self.chain_heads[slot] = id; Ok(id)
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Footer {boundaries: [u64; 4], counts: [u64; 4], n: u64, r: u64, mask: u64,
+    last: u8, stop_depth: u8, selected: u8, point: u8, selected_n: u64, publications: u32, flags: u32}
+impl Default for Footer {
+    fn default() -> Self {Self {boundaries: [UNKNOWN; 4], counts: [0; 4], n: 0, r: 0, mask: 0,
+        last: 0, stop_depth: 0, selected: 0, point: 0, selected_n: 0, publications: 0, flags: 0}}
+}
+impl Footer {
+    fn pair_complete(&self) -> bool {self.flags == 0 && self.mask & 192 == 192
+        && self.boundaries.iter().all(|&n| n != UNKNOWN)
+        && self.boundaries.windows(2).all(|p| p[0] <= p[1])}
+    fn same_work(&self, other: &Self) -> bool {self.counts == other.counts && self.n == other.n && self.r == other.r
+        && self.mask == other.mask && self.last == other.last && self.stop_depth == other.stop_depth
+        && self.selected == other.selected && self.point == other.point && self.selected_n == other.selected_n
+        && self.publications == other.publications}
+}
+#[derive(Clone, Copy, Default)]
+struct Cost {queries: u64, misses: u64, hits: u64, comparisons: u64, key_bytes: u64,
+    copy_bytes: u64, samples: u64, sampled_ns: u128}
+impl Cost {
+    fn start(&mut self) -> Option<Instant> {self.queries += 1;
+        (self.queries % SAMPLE_STRIDE == 0).then(Instant::now)}
+    fn finish(&mut self, start: Option<Instant>) {if let Some(start) = start {
+        self.samples += 1; self.sampled_ns += start.elapsed().as_nanos();}}
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Mode {Off, Capture, Expand, Observe}
+struct Config {mode: Mode, capture: Option<PathBuf>, pool: Option<PathBuf>, ledger: Option<PathBuf>, report: Option<PathBuf>}
+impl Default for Config {fn default() -> Self {Self {mode: Mode::Off, capture: None, pool: None, ledger: None, report: None}}}
+fn planned_memory(cohorts: usize) -> usize {
+    size_of::<State>() + FIXED_RESERVE
+        + cohorts * (PARENT_CAP * size_of::<Position>() + JOB_CAP * size_of::<Job>())
+        + JOB_CAP * (size_of::<MapRow>() + size_of::<ChainRow>()) + 2 * INDEX_SLOTS * size_of::<u32>()
+}
+fn planned_files(mode: Mode, parents: usize, jobs: usize, maps: usize, chains: usize) -> usize {
+    let capture = 1768 + 125 * parents + 6 * jobs;
+    let pool = 1768 + 125 * parents + 14 * jobs + 269 * maps + 257 * chains;
+    let ledger = 1768 + 125 * parents + 30 * jobs + 150 * maps + 191 * chains;
+    match mode {Mode::Capture => capture + 65536, Mode::Expand => capture + pool + 2 * 65536,
+        Mode::Observe => capture + pool + ledger + 3 * 65536, Mode::Off => 0}
+}
+struct State {
+    config: Config, bound: bool, active: bool, closed: bool, phase: u8, origin: Option<Instant>,
+    ordinal: u64, root: Option<Position>, epoch: Option<Epoch>, actual: Option<Cohort>, pool: Option<Pool>,
+    footer: Footer, error: Option<&'static str>, finished: bool, reported: bool,
+    costs: [Cost; 5], payload_comparisons: u64, payload_bytes: u64, peak_bytes: usize,
+}
+impl Default for State {
+    fn default() -> Self {Self {config: Config::default(), bound: false, active: false, closed: false,
+        phase: 0, origin: None, ordinal: 0, root: None, epoch: None, actual: None, pool: None,
+        footer: Footer::default(), error: None, finished: false, reported: false, costs: [Cost::default(); 5],
+        payload_comparisons: 0, payload_bytes: 0, peak_bytes: 0}}
+}
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+    static ROOT_SCOPE: Cell<bool> = const {Cell::new(false)};
+}
+impl State {
+    fn fail(&mut self, error: &'static str) {self.error.get_or_insert(error); self.footer.flags = 1;}
+    fn enabled(&self) -> bool {self.active && !self.closed && self.error.is_none()}
+    fn stamp_at(&mut self, now: Instant) -> Stamp {
+        self.ordinal = self.ordinal.checked_add(1).expect("cohort event ordinal exhausted");
+        let ns = now.duration_since(self.origin.expect("bound cohort origin")).as_nanos();
+        if ns >= UNKNOWN as u128 {self.fail("cohort_clock_overflow"); return Stamp::ABSENT;}
+        Stamp {ns: ns as u64, ordinal: self.ordinal}
+    }
+    fn memory_bytes(&self) -> usize {size_of::<Self>() + FIXED_RESERVE
+        + self.actual.as_ref().map_or(0, Cohort::bytes) + self.pool.as_ref().map_or(0, Pool::bytes)}
+    fn disk_bytes(&self) -> usize {
+        // Retained capture/pool/ledger records AND up to64KiB per stage's
+        // retained JSON. The observation ledger is admitted at its complete
+        // expected size before root production, including every occurrence.
+        match self.config.mode {
+            Mode::Capture => self.actual.as_ref().map_or(65536, |r| {
+                planned_files(Mode::Capture, r.parents.len(), r.jobs.len(), 0, 0)}),
+            Mode::Expand | Mode::Observe => self.pool.as_ref().map_or(0, |p| {
+                planned_files(self.config.mode, p.cohort.parents.len(), p.cohort.jobs.len(), p.maps.len(), p.chains.len())
+            }),
+            Mode::Off => 0,
+        }
+    }
+    fn bytes(&self) -> usize {self.memory_bytes() + self.disk_bytes()}
+    fn check_bytes(&mut self) -> Result<(), String> {let bytes = self.bytes(); self.peak_bytes = self.peak_bytes.max(bytes);
+        if bytes > BYTE_CAP {self.fail("cohort_storage_cap"); return Err("cohort combined RAM plus retained/planned files exceeds512MiB".into());} Ok(())}
+}
+
+pub fn configure_from_env() -> Result<(), String> {
+    fn path(suffix: &str, required: bool) -> Result<Option<PathBuf>, String> {
+        let value = std::env::var_os(format!("ROOK2_FRONTIER_COHORT_{suffix}"));
+        if required && value.is_none() {return Err(format!("missing ROOK2_FRONTIER_COHORT_{suffix}"));}
+        if value.as_ref().is_some_and(|s| s.len() > 4096) {return Err("cohort path exceeds4096bytes".into());}
+        Ok(value.map(PathBuf::from))
+    }
+    let mode = match std::env::var("ROOK2_FRONTIER_COHORT_MODE").as_deref() {
+        Err(std::env::VarError::NotPresent) | Ok("off") => Mode::Off,
+        Ok("capture") => Mode::Capture, Ok("expand") => Mode::Expand, Ok("observe") => Mode::Observe,
+        _ => return Err("ROOK2_FRONTIER_COHORT_MODE must be off/capture/expand/observe".into()),
+    };
+    // Preflight the complete simultaneous reservation BEFORE allocating it.
+    let maximum = planned_memory(2);
+    if maximum > BYTE_CAP {return Err("cohort fixed reservation exceeds512MiB".into());}
+    let config = Config {mode, capture: path("CAPTURE", mode == Mode::Capture || mode == Mode::Expand)?,
+        pool: path("POOL", mode == Mode::Expand || mode == Mode::Observe)?,
+        ledger: path("LEDGER", mode == Mode::Observe)?, report: path("REPORT", mode != Mode::Off)?};
+    STATE.with(|slot| {let mut state = slot.borrow_mut();
+        if state.bound || state.reported {return Err("cohort cannot be reconfigured after binding".into());}
+        state.config = config; Ok(())})
+}
+
+pub fn maybe_expand_from_env() -> Result<bool, String> {
+    STATE.with(|slot| {let mut state = slot.borrow_mut();
+        if state.config.mode != Mode::Expand {return Ok(false);}
+        let (root, epoch, cohort, footer) = io::read_capture(state.config.capture.as_ref().unwrap())?;
+        let context = epoch.root();
+        let mut pool = Pool::new(root, epoch, cohort, footer)?;
+        for id in 0..pool.cohort.jobs.len() {
+            let job = pool.cohort.jobs[id];
+            let parent = &pool.cohort.parents[job.parent as usize];
+            io::validate_move(parent, job.movement)?;
+            let child = parent.played_unchecked(job.movement);
+            child.validate()?;
+            let map = Influence::build_coherent(&child);
+            let bucket = filter(child.attack_planes());
+            let map_id = pool.insert_map(MapKey::new(&child), map, bucket)?;
+            let chain_id = pool.insert_chain(ChainKey::new(&child, &map, context.material(&child),
+                pool.epoch.weights[3], pool.epoch.weights[4]), bucket)?;
+            pool.cohort.jobs[id].map = map_id; pool.cohort.jobs[id].chain = chain_id;
+        }
+        state.footer = footer; state.root = Some(root); state.epoch = Some(pool.epoch.clone()); state.pool = Some(pool);
+        state.finished = true; state.check_bytes()?;
+        io::write_pool(state.config.pool.as_ref().unwrap(), state.pool.as_ref().unwrap())?;
+        io::write_summary(state.config.report.as_ref().unwrap(), &state)?;
+        state.reported = true; Ok(true)
+    })
+}
+
+fn bind_root_checked(position: &Position, epoch: Epoch, private_coherent: bool) -> Result<(), String> {
+    STATE.with(|slot| {let mut state = slot.borrow_mut();
+        if state.config.mode == Mode::Off {return Ok(());}
+        if state.bound || state.config.mode == Mode::Expand {return Err("cohort requires one bound native search".into());}
+        if !private_coherent {return Err("cohort requires private coherent root ancestry".into());}
+        position.validate()?; epoch.validate(position)?;
+        if state.config.mode == Mode::Observe {
+            let pool = io::read_pool(state.config.pool.as_ref().unwrap())?;
+            if pool.root != *position || pool.epoch != epoch {return Err("cohort observed root/epoch mismatch".into());}
+            state.pool = Some(pool);
+        }
+        let planned_actual = PARENT_CAP * size_of::<Position>() + JOB_CAP * size_of::<Job>();
+        let disk = if let Some(pool) = &state.pool {planned_files(Mode::Observe,
+            pool.cohort.parents.len(), pool.cohort.jobs.len(), pool.maps.len(), pool.chains.len())}
+            else {planned_files(Mode::Capture, PARENT_CAP, JOB_CAP, 0, 0)};
+        if state.memory_bytes() + planned_actual + disk > BYTE_CAP {
+            return Err("cohort combined cap before actual cohort reservation".into());
+        }
+        state.actual = Some(Cohort::new()?); state.root = Some(*position); state.epoch = Some(epoch);
+        state.check_bytes()?;
+        // Cold loading/binding is outside the replay timeline. This origin is
+        // before the native root map and FULL production, including iteration1.
+        state.origin = Some(Instant::now()); state.bound = true; state.active = true; Ok(())
+    })
+}
+pub(crate) fn bind_root(position: &Position, epoch: Epoch, private_coherent: bool) {
+    if let Err(error) = bind_root_checked(position, epoch, private_coherent) {
+        STATE.with(|slot| slot.borrow_mut().fail("cohort_root_bind_failed"));
+        eprintln!("frontier cohort root binding failed: {error}");
+    }
+}
+
+pub(crate) fn is_root_full() -> bool {ROOT_SCOPE.with(Cell::get)}
+pub(crate) fn with_root_full<R>(coherent: bool, f: impl FnOnce() -> R) -> R {
+    struct Restore(bool);
+    impl Drop for Restore {fn drop(&mut self) {ROOT_SCOPE.with(|cell| cell.set(self.0));}}
+    let saved = ROOT_SCOPE.with(|cell| {let saved = cell.get(); cell.set(saved || coherent); saved});
+    let _restore = Restore(saved); f()
+}
