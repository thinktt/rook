+
+impl InventoryStats {
+    fn record_settle(&mut self, available: bool, ready: u64, generation: u64, full: u64, acquire: u64) {
+        self.sampled_settled += 1;
+        if available { self.sampled_installed += 1; } else { self.sampled_unavailable += 1; }
+        self.ready.record(ready);
+        self.generation.record(generation);
+        self.numerical_full_complete.record(full);
+        self.acquire.record(acquire);
+        self.acquire_wait.record(acquire.saturating_sub(full));
+        self.ready_after_full.record(ready.saturating_sub(full));
+        self.full_after_ready.record(full.saturating_sub(ready));
+    }
+
+    fn json(&self, production: &InventoryProduction, dispatches: u64) -> String {
+        let mut output = String::new();
+        let pending = self.installed-self.demanded-self.discarded;
