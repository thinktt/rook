+//! Actual ordinary producer/consumption ownership, including null descendants.
+use super::*;
+use crate::{engine::Search, history::SearchHistory, movegen::{self, MoveList}, ordinary};
+use crate::quiescence::{Limits, Stopped};
+
+const START: &str = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+
+fn inventory_counter<const D: bool>(evaluator: &Evaluator<D>, key: &str) -> u64 {
+    let report=evaluator.colors_worker.as_ref().unwrap().readiness_report();
+    let inventory=report.split("\"inventory\":").nth(1).unwrap();
+    let rest=inventory.split(&format!("\"{key}\":")).nth(1).unwrap();
+    rest.chars().take_while(|c|c.is_ascii_digit()).collect::<String>().parse().unwrap()
+}
+
+fn mode4<const D:bool>(position:&Position)->Evaluator<D> {
+    let mut evaluator=Evaluator::new(position);
+    evaluator.set_threads_with_affinity(4,||Ok(4)).unwrap();
+    assert_eq!(evaluator.configured_threads(),4);
+    evaluator
+}
+
+#[test]
+fn private_ordinary_full_installs_exact_native_unsorted_special_inventories() {
+    let initial=Position::from_fen(START).unwrap();
+    let mut worker=mode4::<true>(&initial);
+    let mut serial=Evaluator::<true>::new(&initial);
+    let scope=worker.full_worker_scope();
+    for fen in [START,
+        "4k3/8/8/8/8/8/4r3/4K3 w - - 0 1",
+        "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+        "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+        "7k/P7/8/8/8/8/8/K7 w - - 0 1"]
+    {
+        let position=Position::from_fen(fen).unwrap();position.validate().unwrap();
+        serial.begin_search(&position);worker.begin_search(&position);
+        let map=Influence::build(&position);let checked=movegen::in_check(&position,position.side);
+        let mut a=Node::root(position,&serial.root);let mut b=a;
+        let mut expected=MoveList::new();movegen::generate_legal(&position,&mut expected);
+        let mut installed=MoveList::new();
+        let actual=worker.full_ordinary(&mut b,&map,checked,true,&mut installed);
+        assert_eq!(actual.0,serial.full(&mut a,&map,checked));assert_eq!(a,b);
+        assert_eq!(worker.stats,serial.stats);assert_eq!(installed.as_slice(),expected.as_slice());
+        assert!(actual.1.is_some());worker.inventory_demand(actual.1);
+    }
+    Evaluator::<true>::finish_full_worker_scope(scope);
+    assert!(worker.colors_worker.as_ref().unwrap().is_parked());
+    assert_eq!(inventory_counter(&worker,"requested"),5);
+    assert_eq!(inventory_counter(&worker,"demanded"),5);
+    assert_eq!(inventory_counter(&worker,"pendingReceipts"),0);
+}
+
+#[test]
+fn receipt_survives_later_epochs_without_retaining_packet_or_latest_epoch_authority() {
+    let position=Position::from_fen(START).unwrap();let mut worker=mode4::<false>(&position);
+    let map=Influence::build(&position);let mut node=Node::root(position,&worker.root);
+    let scope=worker.full_worker_scope();let mut row=MoveList::new();
+    let (_,receipt)=worker.full_ordinary(&mut node,&map,false,true,&mut row);
+    let expected=row.as_slice().to_vec();assert!(receipt.is_some());
+    for _ in 0..33 {worker.full(&mut node,&map,false);}
+    assert_eq!(row.as_slice(),expected);worker.inventory_demand(receipt);
+    Evaluator::<false>::finish_full_worker_scope(scope);
+    assert_eq!(inventory_counter(&worker,"requested"),1);
+    assert_eq!(inventory_counter(&worker,"interposedDemanded"),1);
+    assert_eq!(inventory_counter(&worker,"pendingReceipts"),0);
+}
+
+fn null_call(inventory:bool,cutoff:bool,node_limit:u64)->(Result<i32,Stopped>,Search<true>,Node) {
+    let initial=Position::from_fen(START).unwrap();
+    let previous=initial.null_child();let position=previous.null_child();
+    let mut search=Search::<true>::new(&position);search.config.tts_bytes=65536;
+    if inventory {search.evaluator.set_threads_with_affinity(4,||Ok(4)).unwrap();}
+    let scope=search.evaluator.full_worker_scope();
+    search.ensure_table().unwrap();search.bind_geometry_permission(&position);
+    let (mut node,map)=search.prepare_root_with_influence(position);
+    let score=search.evaluator.full(&mut node,&map,false).score;
+    if !cutoff {assert!(score>0);}
+    // Keep the null child within the native FAST refresh band so even the
+    // cutoff witness interposes a real descendant FULL epoch.
+    let upper=if cutoff {-100} else {score};
+    let mut history=SearchHistory::new(&previous);history.push(&position,None);
+    search.begin_owned_sequence(Limits{nodes:Some(node_limit)});
+    let result=search.visit_ordinary(&mut node,&mut history,
+        ordinary::Request{ply:1,depth:3,lower:upper-1,upper,previous_extension:0,iteration:4,checked:Some(false)},
+        ordinary::Predecessor{position:&previous,influence:&map,checked:false,movement:None});
+    assert!(search.stats.null_trials>0);assert_eq!(history.search_ply(),1);history.pop();
+    Evaluator::<true>::finish_full_worker_scope(scope);
+    (result,search,node)
+}
+
+fn equal_owner(actual:&Search<true>,expected:&Search<true>) {
+    assert_eq!(actual.work(),expected.work());assert_eq!(actual.stats,expected.stats);
+    assert_eq!(actual.evaluator.stats,expected.evaluator.stats);
+    assert_eq!(actual.learning.history,expected.learning.history);
+    assert_eq!(actual.learning.killers,expected.learning.killers);
+    assert_eq!(actual.learning.total,expected.learning.total);
+    // Unobserved deeper scratch may differ; live parent row must match.
+    assert_eq!(actual.candidates[1].as_slice(),expected.candidates[1].as_slice());
+}
+
+#[test]
+fn actual_null_continue_retains_parent_list_and_receipt_across_descendant_full_epochs() {
+    let (expected,serial,a)=null_call(false,false,200000);
+    let (actual,worker,b)=null_call(true,false,200000);
+    assert_eq!(actual,expected);assert!(actual.is_ok());assert_eq!(a,b);equal_owner(&worker,&serial);
+    assert!(inventory_counter(&worker.evaluator,"interposedDemanded")>0);
+    assert_eq!(inventory_counter(&worker.evaluator,"pendingReceipts"),0);
+    assert!(worker.evaluator.colors_worker.as_ref().unwrap().is_parked());
+}
+
+#[test]
+fn actual_null_cutoff_discards_parent_receipt_after_descendants_without_charging_generation() {
+    let (expected,serial,a)=null_call(false,true,200000);
+    let (actual,worker,b)=null_call(true,true,200000);
+    assert_eq!(actual,expected);assert!(actual.is_ok());assert_eq!(a,b);
+    assert_eq!(worker.work(),serial.work());assert_eq!(worker.stats,serial.stats);
+    assert_eq!(worker.evaluator.stats,serial.evaluator.stats);
+    assert_eq!(worker.stats.generated,0);
+    assert_eq!(inventory_counter(&worker.evaluator,"demanded"),0);
+    assert!(inventory_counter(&worker.evaluator,"discarded")>0);
+    assert!(inventory_counter(&worker.evaluator,"interposedDiscarded")>0);
+    assert_eq!(inventory_counter(&worker.evaluator,"pendingReceipts"),0);
+}
+
+#[test]
+fn actual_null_stop_discards_parent_receipt_and_next_search_can_reuse_worker() {
+    let (expected,mut serial,a)=null_call(false,true,1);
+    let (actual,mut worker,b)=null_call(true,true,1);
+    assert_eq!(expected,Err(Stopped::NodeLimit(1)));assert_eq!(actual,expected);assert_eq!(a,b);
+    assert_eq!(worker.work(),serial.work());assert_eq!(worker.stats,serial.stats);
+    assert_eq!(worker.evaluator.stats,serial.evaluator.stats);
+    assert_eq!(inventory_counter(&worker.evaluator,"pendingReceipts"),0);
+    assert_eq!(inventory_counter(&worker.evaluator,"discarded"),1);
+    let position=Position::from_fen(START).unwrap();
+    let mut ah=SearchHistory::new(&position);let mut bh=SearchHistory::new(&position);
+    let a=serial.run_iterations(position,&mut ah,2,Limits::default()).unwrap();
+    let b=worker.run_iterations(position,&mut bh,2,Limits::default()).unwrap();
+    assert_eq!((a.score,a.pv,a.work,a.stats,a.evaluations),(b.score,b.pv,b.work,b.stats,b.evaluations));
+    assert_eq!(inventory_counter(&worker.evaluator,"pendingReceipts"),0);
+}
+
+#[test]
+fn full_bound_return_discards_eager_result_at_actual_ordinary_owner() {
+    let position=Position::from_fen(START).unwrap();let previous=position.null_child();
+    let mut search=Search::<true>::new(&position);search.config.tts_bytes=65536;
+    search.evaluator.set_threads_with_affinity(4,||Ok(4)).unwrap();
+    search.ensure_table().unwrap();search.bind_geometry_permission(&position);
+    let (mut node,map)=search.prepare_root_with_influence(position);
+    let mut history=SearchHistory::new(&previous);history.push(&position,None);
+    search.begin_owned_sequence(Limits::default());
+    let scope=search.evaluator.full_worker_scope();
+    let result=search.visit_ordinary(&mut node,&mut history,
+        ordinary::Request{ply:1,depth:1,lower:-10000,upper:-10000,previous_extension:0,iteration:2,checked:Some(false)},
+        ordinary::Predecessor{position:&previous,influence:&map,checked:false,movement:None});
+    Evaluator::<true>::finish_full_worker_scope(scope);
+    assert_eq!(result,Ok(-10000));assert_eq!(search.stats.generated,0);
+    assert_eq!(inventory_counter(&search.evaluator,"requested"),1);
+    assert_eq!(inventory_counter(&search.evaluator,"discarded"),1);
+    assert_eq!(inventory_counter(&search.evaluator,"pendingReceipts"),0);
+}
+
+#[test]
+fn public_full_fresh_fast_and_actual_q_search_do_not_request_inventory() {
+    let position=Position::from_fen(START).unwrap();let mut worker=Search::<true>::new(&position);
+    worker.config.tts_bytes=65536;worker.evaluator.set_threads_with_affinity(4,||Ok(4)).unwrap();
+    let map=Influence::build(&position);let mut node=Node::root(position,&worker.evaluator.root);
+    let parked=worker.evaluator.colors_worker.as_ref().unwrap().parked_probe_for_test();
+    worker.evaluator.full_observed(&mut node,&map,false,|_|assert!(parked(),"public observer kept helpers active"));
+    worker.evaluator.fresh_observed(&mut node,&map,false,|_|assert!(parked(),"FRESH observer kept helpers active"));
+    worker.evaluator.fast(&node,false);
+    let mut history=SearchHistory::new(&position);
+    worker.run_iterations(position,&mut history,1,Limits::default()).unwrap();
+    assert_eq!(inventory_counter(&worker.evaluator,"requested"),0);
+    assert!(worker.evaluator.colors_worker.as_ref().unwrap().is_parked());
+}
+
+#[test]
+fn mode4_cap_and_reconfiguration_preserve_cache_and_query_failure_state() {
+    let position=Position::from_fen(START).unwrap();let mut worker=mode4::<true>(&position);
+    let map=Influence::build(&position);let mut node=Node::root(position,&worker.root);
+    worker.full(&mut node,&map,false);
+    for (requested,permitted,expected) in [(9,4,4),(4,3,3),(4,2,2),(4,1,1),(3,4,3),(4,8,4)] {
+        let before=worker.stats;
+        worker.set_threads_with_affinity(requested,||Ok(permitted)).unwrap();
+        assert_eq!((worker.requested_threads(),worker.configured_threads()),(requested,expected));
+        assert_eq!(worker.stats,before);
+        worker.full(&mut node,&map,false);
+        assert_eq!(worker.stats.pawn_reuses,before.pawn_reuses+1);
+        let before=worker.stats;
+        assert!(worker.set_threads_with_affinity(4,||Err("controlled affinity failure".into())).is_err());
+        assert_eq!(worker.configured_threads(),expected);assert_eq!(worker.stats,before);
+    }
+    worker.set_threads_with_affinity(1,||panic!("default1 queried affinity")).unwrap();
+    assert_eq!(worker.configured_threads(),1);
+}
