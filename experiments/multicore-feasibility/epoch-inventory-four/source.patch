+struct ProductionRecord {
+    available: bool,
+    moves: usize,
+    sampled: bool,
+}
+
+/// Caller acquired the private sparse request. Only inventory reader owns this
+/// output; no whole Cells mutable borrow or stack MoveList copy is constructed.
+unsafe fn compute_inventory(shared: &Shared, generation: u64) -> Result<ProductionRecord, String> {
+    let result = {
+        let packet = unsafe { &*shared.cells.input.get() };
+        if packet.generation != generation { return Err("inventory input generation mismatch".into()); }
+        // SAFETY: The previous inventory slice reads ended before this acquired
+        // inventory request Release; only this reader mutates this concrete cell.
+        let output = unsafe { &mut *shared.cells.inventory_output.get() };
+        output.generation = generation;
+        output.available = false;
+        output.list.clear();
+        let started = packet.published.map(|_| Instant::now());
+        let available = inventory_domain(&packet.position);
+        #[cfg(test)]
+        let available = !shared.tests.force_inventory_unavailable.swap(false, Ordering::SeqCst) && available;
+        if available {
+            movegen::generate_legal(&packet.position, &mut output.list);
+            output.available = true;
+        }
+        #[cfg(test)]
+        test_reader_gate(shared, &shared.tests.in_input[2], 2)?;
+        output.generation_ns = started.map(|start| duration_ns(start.elapsed())).unwrap_or(0);
+        let sampled = packet.published.is_some();
+        // Final Packet/timing access. Both this Packet ref and the mutable
+        // output reference end before the caller publishes inventory done.
+        output.ready_ns = packet.published.map(|start| duration_ns(start.elapsed())).unwrap_or(0);
+        ProductionRecord {
+            available: output.available, moves: output.list.len,
+            sampled,
+        }
+    };
+    Ok(result)
+}
+
+fn side_name(side: usize) -> &'static str {
+    match side { 0 => "white", 1 => "black", _ => "inventory" }
+}
