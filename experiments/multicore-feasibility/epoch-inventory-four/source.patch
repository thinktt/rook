+    pub(crate) fn settle_inventory(
+        &mut self, token: DispatchToken, destination: &mut MoveList,
+    ) -> Result<Option<InventoryReceipt>, String> {
+        if !token.inventory { return Ok(None); }
+        let numerical_complete = if token.sampled { Some(Instant::now()) } else { None };
+        if wait_inventory(&self.shared, token.generation).is_err() { return Err(self.failure()); }
+        let mut control = control_lock(&self.shared);
+        let metadata = match control.flight {
+            Flight::Joined(metadata) if metadata.generation == token.generation
+                && metadata.inventory && !control.closing && !terminal(&self.shared) => metadata,
+            _ => return Err("inventory settlement lost its Joined flight".into()),
+        };
+        if !inventory_done(&self.shared, token.generation) {
+            return Err("inventory settlement before its matching done epoch".into());
+        }
+        #[cfg(test)]
+        test_pause(&self.shared, &self.shared.tests.inventory_consuming);
+        let acquired = metadata.published.map(|_| Instant::now());
+        // SAFETY: This actual participant's done Acquire retires its Packet and
+        // output borrows. Joined under Control excludes close and publication.
+        // Copy only the used slice and scalar length. Every output reference
+        // ends before Flight::None, hence before a later inventory request
+        // Release/Acquire permits its sole writer's next mutation.
+        let (available, moves, ready_ns, generation_ns) = {
+            let output = unsafe { &*self.shared.cells.inventory_output.get() };
+            if output.generation != token.generation {
+                return Err("inventory output generation mismatch".into());
+            }
+            if output.available {
+                let len = output.list.len;
+                destination.moves[..len].copy_from_slice(output.list.as_slice());
+                destination.len = len;
+            }
+            (output.available, output.list.len, output.ready_ns, output.generation_ns)
+        };
+        let installed = if available { metadata.published.map(|_| Instant::now()) } else { None };
+        control.inventory.settled += 1;
+        if available { control.inventory.installed += 1; }
+        else { control.inventory.settled_unavailable += 1; }
+        let sample = if let Some(published) = metadata.published {
+            let full_ns = elapsed_ns(published, numerical_complete.expect("sampled FULL boundary"));
+            let acquired_ns = elapsed_ns(published, acquired.expect("sampled acquisition"));
+            control.inventory.record_settle(available, ready_ns, generation_ns, full_ns, acquired_ns);
+            installed.map(|end| {
+                let installed_ns = elapsed_ns(published, end);
+                control.inventory.install.record(installed_ns);
+                control.inventory.install_duration.record(installed_ns.saturating_sub(acquired_ns));
+                InventorySample { published, installed_ns }
+            })
+        } else { None };
+        control.flight = Flight::None;
+        drop(control);
+        Ok(if available { Some(InventoryReceipt { generation: token.generation, moves, sample }) } else { None })
+    }
