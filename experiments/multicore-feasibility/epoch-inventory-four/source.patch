+/// One actual inventory producer writes these bounded observations. Atomics
+/// permit a report snapshot; they grant no packet or output ownership.
+struct InventoryProduction {
+    completed: AtomicU64,
+    generated: AtomicU64,
+    domain_unavailable: AtomicU64,
+    generated_moves: AtomicU64,
+    sampled_completed: AtomicU64,
+}
+
+impl InventoryProduction {
+    fn new() -> Self {
+        Self {
+            completed: AtomicU64::new(0), generated: AtomicU64::new(0),
+            domain_unavailable: AtomicU64::new(0), generated_moves: AtomicU64::new(0),
+            sampled_completed: AtomicU64::new(0),
+        }
+    }
+
+    fn record(&self, record: ProductionRecord) {
+        self.completed.fetch_add(1, Ordering::Relaxed);
+        if record.available {
+            self.generated.fetch_add(1, Ordering::Relaxed);
+            self.generated_moves.fetch_add(record.moves as u64, Ordering::Relaxed);
+        } else { self.domain_unavailable.fetch_add(1, Ordering::Relaxed); }
+        if record.sampled { self.sampled_completed.fetch_add(1, Ordering::Relaxed); }
+    }
+}
