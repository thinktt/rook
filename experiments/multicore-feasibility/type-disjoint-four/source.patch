+/// Mask bits 0..3 select knight, bishop, rook and queen jobs for each color.
+/// Every piece of a selected color/kind shares these fresh private marks, so
+/// same-kind duplicate presence remains an OR even for promoted inventory.
+pub(crate) fn compute_partition(
+    position: &Position,
+    influence: &Influence,
+    masks: [u8; 2],
+) -> RawActivity {
+    debug_assert!(masks.iter().all(|mask| *mask & !15 == 0));
+    let phase = position.phase();
+    let mut marks = [[0u8; 64]; 2];
+    let mut raw_scores = [0i64; 2];
+    let mut relation_queries = 0;
+    for color in [Color::White, Color::Black] {
+        let mask = masks[color.index()];
+        let values = &DESTINATION_VALUES[color.index()];
+        if mask & 1 != 0 {
+            accumulate_kind::<1>(
+                position, influence, color, values, &mut marks, phase.endgame,
+                &mut raw_scores[color.index()], &mut relation_queries,
+            );
+        }
+        if mask & 2 != 0 {
+            accumulate_kind::<2>(
+                position, influence, color, values, &mut marks, phase.endgame,
+                &mut raw_scores[color.index()], &mut relation_queries,
+            );
+        }
+        if mask & 4 != 0 {
+            accumulate_kind::<3>(
+                position, influence, color, values, &mut marks, phase.endgame,
+                &mut raw_scores[color.index()], &mut relation_queries,
+            );
+        }
+        if mask & 8 != 0 {
+            accumulate_kind::<4>(
+                position, influence, color, values, &mut marks, phase.endgame,
+                &mut raw_scores[color.index()], &mut relation_queries,
+            );
+        }
+    }
+    RawActivity {
+        raw_scores,
+        pressure_sums: [
+            raw_king_pressure(position, Color::White, &marks, masks[Color::Black.index()]),
+            raw_king_pressure(position, Color::Black, &marks, masks[Color::White.index()]),
+        ],
+        relation_queries,
+    }
+}
