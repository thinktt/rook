+#[cfg(test)]
+struct TestHooks {
+    startup: Startup,
+    input: [Mutex<TestGate>; 3],
+    in_input: [Mutex<TestGate>; 3],
+    before_done: [Mutex<TestGate>; 3],
+    before_latch: [Mutex<TestGate>; 3],
+    before_registration: Mutex<TestGate>,
+    after_registration: Mutex<TestGate>,
+    consuming: Mutex<TestGate>,
+    before_dispatch: Mutex<TestGate>,
+    wake: Condvar,
+    registrations: AtomicUsize,
+    fail_before_publish: AtomicBool,
+}
