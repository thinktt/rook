+    #[test]
+    fn type_disjoint_partitions_match_serial_with_supplied_maps_and_weights() {
+        let mut saw_relation_work = false;
+        for placement in [
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR",
+            "r3k2r/pp1n1p2/2b1q1p1/3pP3/2BN1P2/1Q3N2/PP4PP/R3K2R",
+            "7k/8/8/3B4/2RRQ3/3B4/8/K7",
+            "7k/8/3n4/2B5/3R4/8/8/K7",
+            "7k/8/8/8/8/8/8/K6R",
+            "7k/8/8/8/8/8/8/K7",
+        ] {
+            let pos = position(placement);
+            for map in [
+                Influence::build(&pos), empty_influence(),
+                Influence { profiles: [[255; 64], [0; 64]] },
+                Influence { profiles: [[0; 64], [255; 64]] },
+            ] {
+                let before = (pos, map);
+                let parts = raw_roles(&pos, &map);
+                let full = compute_partition(&pos, &map, [15, 15]);
+                let mut raw_sum = RawActivity::default();
+                for part in parts {
+                    for side in 0..2 {
+                        raw_sum.raw_scores[side] += part.raw_scores[side];
+                        raw_sum.pressure_sums[side] += part.pressure_sums[side];
+                    }
+                    raw_sum.relation_queries += part.relation_queries;
+                }
+                assert_eq!(raw_sum, full, "raw {placement}");
+                assert_eq!(compute_partition(&pos, &map, [0, 0]), RawActivity::default());
+                saw_relation_work |= full.relation_queries != 0;
+                for material in [-100_000, -256, -1, 0, 217, 100_000] {
+                    for weights in [
