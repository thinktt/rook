+#[cfg(test)]
+fn test_pause(shared: &Shared, mutex: &Mutex<TestGate>) {
+    let mut gate = mutex.lock().unwrap();
+    gate.entered = true;
+    shared.tests.wake.notify_all();
+    while gate.blocked { gate = shared.tests.wake.wait(gate).unwrap(); }
+}
