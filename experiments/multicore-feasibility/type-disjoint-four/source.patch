+//! Adapt the retained exact owner matrix to the new budget4 path.
+//! Numerical, cache, retained and logical-work assertions are inherited unchanged.
+
+use super::*;
+use crate::engine::Search;
+use crate::history::SearchHistory;
+use crate::movegen::{generate_legal, MoveList};
+use crate::ordinary;
+use crate::quiescence::{Limits, Stopped};
