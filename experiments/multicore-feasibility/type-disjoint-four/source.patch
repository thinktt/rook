+//! Fixed epoch input and independently owned raw-reduction outputs for FULL calls.
+//!
+//! One initialized input is written by the single coordinator and read directly
+//! by all three helpers. Matching done epochs retire every input access. Control
+//! linearizes dispatch, output consumption and final close; scope guards and
+//! parking touch metadata only. Successful calls allocate no storage or threads.
+//! The 4096-spin policy and inherited affinity remain unchanged. No hot observers.
+//! Scheduling delays never constitute an engine wall-time abort.
+
+use crate::activity::{self, RawActivity};
+use crate::evaluator_worker::ActivityShelter;
+use crate::influence::Influence;
+use crate::position::{Phase, Position};
+use crate::shelter;
+use crate::types::Color;
+use std::cell::UnsafeCell;
+use std::hint::spin_loop;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicU8, AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard};
+use std::thread::{self, JoinHandle};
+
+const STARTING: u8 = 0;
+const IDLE: u8 = 1;
+const FAILED: u8 = 4;
+const STOPPED: u8 = 5;
+const PARKED: u8 = 6;
+const COMPLETION_SPINS: usize = 4096;
+
+/// Concrete initialized storage, never a fabricated or zeroed Position.
+struct Packet {
+    generation: u64,
+    position: Position,
+    influence: Influence,
+}
+
+#[derive(Clone, Copy)]
+struct RawOutput {
+    generation: u64,
+    activity: RawActivity,
+    geometry: Option<shelter::Components>,
+}
+
+impl RawOutput {
+    fn initial() -> Self {
+        Self { generation: 0, activity: RawActivity::default(), geometry: None }
+    }
+}
+
+// Whole color/kind ownership keeps same-kind presence OR local. The masks are
+// fixed before measurement: role0 WN/WB+BQ, role1 WQ+BN/BB, role2 WR+BR.
+const ROLE_MASKS: [[u8; 2]; 3] = [[3, 8], [8, 3], [4, 4]];
+const ROLE_NAMES: [&str; 3] = ["rook2-raw-0", "rook2-raw-1", "rook2-raw-2"];
+
+struct Cells {
+    input: UnsafeCell<Packet>,
+    role0_output: UnsafeCell<RawOutput>,
+    role1_output: UnsafeCell<RawOutput>,
+    role2_output: UnsafeCell<RawOutput>,
+}
+
+// SAFETY: Only these four concrete initialized cells are shared. One &mut
+// coordinator writes Packet under Control/Flight::None. None follows matching
+// done Acquires from ALL THREE actual readers and ended output reads, or all
+// actual parked/exited acknowledgments. request Release/Acquire publishes one
+// immutable Packet; every reader's entire Packet borrow ends before its own
+// output write and done Release. Empty arithmetic jobs still publish actual done.
+//
+// Only role i writes output_i. Complete requires all exact done epochs and
+// Published(g) under Control before scalar Copy reads. Those reads end before
+// Flight::None; the next request Release/Acquire carries their reverse edge to
+// the next output writer. Control serializes final close against publication and
+// consumption. Close retains Discarding until all real readers are quiet; stop
+// alone never retires a peer. Guards and parking never touch cells. No mutable
+// reference to Shared, Cells or the group of outputs is ever formed.
+unsafe impl Sync for Cells {}
+
+impl Cells {
+    fn output(&self, role: usize) -> &UnsafeCell<RawOutput> {
+        match role {
+            0 => &self.role0_output,
+            1 => &self.role1_output,
+            2 => &self.role2_output,
+            _ => unreachable!("invalid raw role"),
+        }
+    }
+}
+
+struct Reader {
+    state: AtomicU8,
+    done: AtomicU64,
+    failed_generation: AtomicU64,
+}
+
+impl Reader {
+    fn new() -> Self {
+        Self {
+            state: AtomicU8::new(STARTING), done: AtomicU64::new(0),
+            failed_generation: AtomicU64::new(0),
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Metadata {
+    generation: u64,
+    material: i32,
+    mobility_weights: [i32; 2],
+    shelter_weights: [i32; 2],
+    phase: Phase,
+}
+
+#[derive(Clone, Copy, Default)]
+enum Flight {
+    #[default]
+    None,
+    Published(Metadata),
+    Discarding(Metadata),
+}
+
+#[derive(Default)]
+struct Control {
+    scopes: usize,
+    closing: bool,
+    shutdown: bool,
+    flight: Flight,
+    failures: [Option<String>; 3],
+    owner_failure: Option<String>,
+}
+
+struct Shared {
+    cells: Cells,
+    request: AtomicU64,
+    readers: [Reader; 3],
+    stop: AtomicBool,
+    active_scopes: AtomicUsize,
+    control: Mutex<Control>,
+    wake: Condvar,
+    // Exactly one coordinator completion waiter. Never held with Control.
+    sleep: Mutex<()>,
+    completed: Condvar,
+    waiting: AtomicBool,
+    #[cfg(test)]
+    tests: TestHooks,
+}
+
+#[derive(Clone, Copy, Default)]
+struct Startup {
+    #[cfg(test)]
+    fail_spawn: Option<usize>,
+    #[cfg(test)]
+    fail_entry: Option<usize>,
+    #[cfg(test)]
+    stop_entry: Option<usize>,
+    #[cfg(test)]
+    panic_entry: Option<usize>,
+    #[cfg(test)]
+    stop_after_request: Option<usize>,
+}
+
+/// Send guards may alter lifecycle metadata but never touch any cell.
+pub(crate) struct RawActiveScope {
+    shared: Arc<Shared>,
+    armed: bool,
+}
+
+impl RawActiveScope {
+    pub(crate) fn finish(mut self) -> Result<(), String> {
+        self.armed = false;
+        release_scope(&self.shared)
+    }
+}
+
+impl Drop for RawActiveScope {
+    fn drop(&mut self) {
+        if self.armed {
+            if let Err(error) = release_scope(&self.shared) {
+                if thread::panicking() {
+                    eprintln!("raw worker scope close failed during unwind: {error}");
+                } else {
+                    panic!("raw worker scope close failed: {error}");
+                }
+            }
+        }
+    }
+}
+
+pub(crate) struct RawWorker {
+    shared: Arc<Shared>,
+    threads: [Option<JoinHandle<()>>; 3],
+    generation: u64,
+    close_error_reported: bool,
+}
+
+impl RawWorker {
+    pub(crate) fn start() -> Result<Self, String> {
+        Self::start_with(Startup::default())
+    }
+
+    fn start_with(startup: Startup) -> Result<Self, String> {
+        let position = Position::from_fen(
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+        ).map_err(|error| format!("cannot initialize raw input: {error}"))?;
+        let influence = Influence::build(&position);
+        let shared = Arc::new(Shared {
+            cells: Cells {
+                input: UnsafeCell::new(Packet { generation: 0, position, influence }),
+                role0_output: UnsafeCell::new(RawOutput::initial()),
+                role1_output: UnsafeCell::new(RawOutput::initial()),
+                role2_output: UnsafeCell::new(RawOutput::initial()),
+            },
+            request: AtomicU64::new(0),
+            readers: [Reader::new(), Reader::new(), Reader::new()],
+            stop: AtomicBool::new(false),
+            active_scopes: AtomicUsize::new(0),
+            control: Mutex::new(Control::default()),
+            wake: Condvar::new(),
+            sleep: Mutex::new(()),
+            completed: Condvar::new(),
+            waiting: AtomicBool::new(false),
+            #[cfg(test)]
+            tests: TestHooks::new(startup),
+        });
+        #[cfg(not(test))]
+        let _ = startup;
+        let mut worker = Self {
+            shared, threads: [None, None, None], generation: 0, close_error_reported: false,
+        };
+        for side in 0..3 {
+            #[cfg(test)]
+            if startup.fail_spawn == Some(side) {
+                worker.failed_spawn(side, "controlled raw spawn failure".into());
+                let failure = worker.failure();
+                let _ = worker.shutdown();
+                return Err(failure);
+            }
+            let worker_shared = Arc::clone(&worker.shared);
+            let handle = thread::Builder::new()
+                .name(ROLE_NAMES[side].into())
+                .spawn(move || {
+                    // The assertion applies only to this concrete loop. Its
+                    // Packet reference is confined to compute_input's lexical
+                    // block; unwinding drops it before this terminal handler.
+                    // Partial output never gets a successful done publication.
+                    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                        || run_active(&worker_shared, side),
+                    ));
+                    let failure = match result {
+                        Ok(Ok(())) => None,
+                        Ok(Err(error)) => Some(error),
+                        Err(_) => Some(format!("{} raw reader panicked", side_name(side))),
+                    };
+                    publish_terminal(&worker_shared, side, failure);
+                });
+            match handle {
+                Ok(handle) => worker.threads[side] = Some(handle),
+                Err(error) => {
+                    worker.failed_spawn(side, format!("cannot start {} raw reader: {error}", side_name(side)));
+                    let failure = worker.failure();
+                    let _ = worker.shutdown();
+                    return Err(failure);
+                }
+            }
+        }
+        let mut control = control_lock(&worker.shared);
+        while !all_state(&worker.shared, PARKED) && !terminal(&worker.shared) {
+            control = wait_control(&worker.shared, control);
+        }
+        let parked = all_state(&worker.shared, PARKED) && !terminal(&worker.shared);
+        drop(control);
+        if parked { Ok(worker) } else {
+            let failure = worker.failure();
+            let _ = worker.shutdown();
+            Err(failure)
+        }
+    }
+
+    fn failed_spawn(&self, side: usize, failure: String) {
+        // Only genuinely unstarted readers may be declared retired here.
+        publish_terminal(&self.shared, side, Some(failure));
+        for unstarted in side + 1..3 {
+            publish_terminal(&self.shared, unstarted, None);
+        }
+    }
+
+    pub(crate) fn start_active_scope(&self) -> Result<RawActiveScope, String> {
+        let mut control = control_lock(&self.shared);
+        while control.closing && !terminal(&self.shared) {
+            control = wait_control(&self.shared, control);
+        }
+        if terminal(&self.shared) { return Err(failure_in(&control)); }
+        let first = control.scopes == 0;
+        control.scopes = control.scopes.checked_add(1).expect("raw scope count exhausted");
+        self.shared.active_scopes.store(control.scopes, Ordering::Release);
+        if first {
+            self.shared.wake.notify_all();
+            while !all_state(&self.shared, IDLE) && !terminal(&self.shared) {
+                control = wait_control(&self.shared, control);
+            }
+            if terminal(&self.shared) {
+                control.scopes -= 1;
+                self.shared.active_scopes.store(control.scopes, Ordering::Release);
+                return Err(failure_in(&control));
+            }
+        }
+        drop(control);
+        Ok(RawActiveScope { shared: Arc::clone(&self.shared), armed: true })
+    }
+
+    pub(crate) fn start_call_scope(&self) -> Result<Option<RawActiveScope>, String> {
+        if self.shared.active_scopes.load(Ordering::Acquire) != 0 {
+            self.check_running()?;
+            Ok(None)
+        } else {
+            self.start_active_scope().map(Some)
+        }
+    }
+
+    pub(crate) fn dispatch(
+        &mut self,
+        position: &Position,
+        influence: &Influence,
+        material: i32,
+        mobility_weights: [i32; 2],
+        shelter_weights: [i32; 2],
+    ) -> Result<(), String> {
+        #[cfg(test)]
+        test_pause(&self.shared, &self.shared.tests.before_dispatch);
+        // This mutex is the lease. The active-scope atomic alone never grants
+        // permission to publish against a concurrent final guard close.
+        let mut control = control_lock(&self.shared);
+        if control.scopes == 0 || control.closing || terminal(&self.shared) {
+            return Err(failure_in(&control));
+        }
+        if !matches!(control.flight, Flight::None) {
+            return Err("raw dispatch while a flight is still owned".into());
+        }
+        let Some(generation) = self.generation.checked_add(1) else {
+            let error = "raw epoch exhausted".to_string();
+            control.owner_failure = Some(error.clone());
+            self.shared.stop.store(true, Ordering::Release);
+            control.closing = true;
+            self.shared.wake.notify_all();
+            drop(control);
+            signal_completion(&self.shared);
+            // Exhaustion is terminal, never a reset or fabricated completion.
+            let _ = self.shutdown();
+            return Err(error);
+        };
+        let phase = position.phase();
+        // SAFETY: Control serializes this writer with close and consumption.
+        // Flight::None proves all three old input readers and output reads ended.
+        unsafe {
+            self.shared.cells.input.get().write(Packet {
+                generation, position: *position, influence: *influence,
+            });
+        }
+        #[cfg(test)]
+        if self.shared.tests.fail_before_publish.swap(false, Ordering::SeqCst) {
+            // The initialized input is private and no new request was released.
+            // Flight stays None and the epoch does not advance.
+            return Err("controlled raw failure before publication".into());
+        }
+        control.flight = Flight::Published(Metadata {
+            generation, material, mobility_weights, shelter_weights, phase,
+        });
+        // Nothing fallible lies between installing Published and this release.
+        self.shared.request.store(generation, Ordering::Release);
+        self.generation = generation;
+        Ok(())
+    }
+
+    pub(crate) fn complete(&mut self) -> Result<ActivityShelter, String> {
+        let generation = self.generation;
+        if generation == 0 { return Err("raw complete without a dispatch".into()); }
+        // No Control mutex may span spinning or the Sleep wait.
+        if wait_completion(&self.shared, generation).is_err() {
+            return Err(self.failure());
+        }
+        let mut control = control_lock(&self.shared);
+        let metadata = match control.flight {
+            Flight::Published(metadata) if metadata.generation == generation
+                && !control.closing && !terminal(&self.shared) => metadata,
+            _ => return Err("raw completion lost ownership of its flight".into()),
+        };
+        // Recheck inside the ownership critical section. A close that won
+        // Control first owns Discarding; complete must never read its cells.
+        if !all_done(&self.shared, generation) {
+            return Err("raw completion before all three matching done epochs".into());
+        }
+        #[cfg(test)]
+        test_pause(&self.shared, &self.shared.tests.consuming);
+        // SAFETY: All exact done Acquires retire all Packet references and
+        // publish the separate initialized scalar outputs. Published/Control
+        // excludes close. Copy reads end here before None and the next request.
+        let [role0, role1, role2] = unsafe {
+            [self.shared.cells.role0_output.get().read(),
+             self.shared.cells.role1_output.get().read(),
+             self.shared.cells.role2_output.get().read()]
+        };
+        if [role0, role1, role2].iter().any(|output| output.generation != generation) {
+            return Err("raw completion generation mismatch".into());
+        }
+        let (Some(white_geometry), Some(black_geometry), None) =
+            (role0.geometry, role1.geometry, role2.geometry) else {
+                return Err("raw completion geometry ownership mismatch".into());
+            };
+        control.flight = Flight::None;
+        drop(control);
+        // Composition reads coordinator metadata and scalar locals, not input.
+        let activity = activity::combine_partitions(
+            [role0.activity, role1.activity, role2.activity], metadata.material,
+            metadata.mobility_weights, metadata.phase,
+        );
+        let shelter = shelter::compose_components(
+            [white_geometry, black_geometry], activity.pressure, metadata.material,
+            metadata.shelter_weights, metadata.phase,
+        );
+        Ok(ActivityShelter { activity, shelter })
+    }
+
+    pub(crate) fn check_running(&self) -> Result<(), String> {
+        if terminal(&self.shared) { Err(self.failure()) } else { Ok(()) }
+    }
+
+    fn failure(&self) -> String { failure_in(&control_lock(&self.shared)) }
+
+    /// Cold evidence only, after all actual helpers have been joined. These are
+    /// the necessary publication/retirement epochs, never an observation census.
+    pub(crate) fn cold_report(&self) -> String {
+        debug_assert!(self.threads.iter().all(Option::is_none));
+        let request = self.shared.request.load(Ordering::Acquire);
+        let done = self.shared.readers.each_ref().map(|reader| reader.done.load(Ordering::Acquire));
+        format!("{{\"enabled\":true,\"request\":{request},\"done\":[{},{},{}],\"roles\":[0,1,2]}}",
+            done[0], done[1], done[2])
+    }
+
+    pub(crate) fn shutdown(&mut self) -> Result<(), String> {
+        {
+            let mut control = control_lock(&self.shared);
+            control.shutdown = true;
+            control.closing = true;
+            claim_discard(&mut control);
+            control.scopes = 0;
+            self.shared.active_scopes.store(0, Ordering::Release);
+            self.shared.stop.store(true, Ordering::Release);
+            self.shared.wake.notify_all();
+        }
+        // Terminal publication always participates in the SC latch chain, even
+        // if no waiter appears registered. Control has already been released.
+        signal_completion(&self.shared);
+        for side in 0..3 {
+            if let Some(handle) = self.threads[side].take() {
+                if handle.join().is_err() {
+                    publish_terminal(&self.shared, side, Some(format!(
+                        "{} raw reader exited with an uncaught panic", side_name(side),
+                    )));
+                }
+            }
+        }
+        let mut control = control_lock(&self.shared);
+        // All started readers have actually exited; unstarted readers were
+        // marked retired by failed_spawn. No guard or shutdown mutates cells.
+        debug_assert!(quiescent(&self.shared));
+        retire_flight(&mut control);
+        control.closing = false;
+        self.shared.wake.notify_all();
+        if has_failure(&control) {
+            self.close_error_reported = true;
+            return Err(failure_in(&control));
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn is_parked(&self) -> bool {
+        let control = control_lock(&self.shared);
+        all_state(&self.shared, PARKED) && control.scopes == 0
+            && !control.closing && matches!(control.flight, Flight::None)
+    }
+}
+
+impl Drop for RawWorker {
+    fn drop(&mut self) {
+        let reported = self.close_error_reported;
+        if let Err(error) = self.shutdown() {
+            if reported { return; }
+            if thread::panicking() {
+                eprintln!("raw worker shutdown failed during unwind: {error}");
+            } else {
+                panic!("raw worker shutdown failed: {error}");
+            }
+        }
+    }
+}
+
+fn run_active(shared: &Shared, side: usize) -> Result<(), String> {
+    #[cfg(test)]
+    {
+        if shared.tests.startup.fail_entry == Some(side) {
+            return Err("controlled raw startup failure".into());
+        }
+        if shared.tests.startup.stop_entry == Some(side) { return Ok(()); }
+        if shared.tests.startup.panic_entry == Some(side) { panic!("controlled raw startup panic"); }
+    }
+    let mut seen = 0;
+    park(shared, side, seen);
+    let reader = &shared.readers[side];
+    loop {
+        if terminal(shared) { return Ok(()); }
+        let generation = shared.request.load(Ordering::Acquire);
+        if generation != seen {
+            if generation == 0 || generation < seen {
+                return Err("raw reader observed a nonincreasing epoch".into());
+            }
+            #[cfg(test)]
+            {
+                test_reader_gate(shared, &shared.tests.input[side], side)?;
+                if shared.tests.startup.stop_after_request == Some(side) { return Ok(()); }
+            }
+            // SAFETY: This exact request Acquire publishes the initialized input.
+            // No next input write is possible before our done or actual exit.
+            let output = unsafe { compute_input(shared, side, generation)? };
+            // compute_input has returned scalar values; ALL input references,
+            // including every numerical access, have ended before this write.
+            // SAFETY: Only this reader writes its concrete output. The acquired
+            // new request also orders the coordinator's prior output reads
+            // before this overwrite; no whole-array mutable borrow is formed.
+            unsafe { shared.cells.output(side).get().write(output); }
+            #[cfg(test)]
+            test_reader_gate(shared, &shared.tests.before_done[side], side)?;
+            reader.done.store(generation, Ordering::Release);
+            seen = generation;
+            #[cfg(test)]
+            test_pause(shared, &shared.tests.before_latch[side]);
+            // Every normal publisher exchanges, unconditionally. Descheduling
+            // after done but before this exchange can delay a cold waiter.
+            signal_completion(shared);
+            continue;
+        }
+        if shared.active_scopes.load(Ordering::Acquire) == 0 {
+            park(shared, side, seen);
+        } else {
+            spin_loop();
+        }
+    }
+}
+
+/// Caller must have acquired request(g) and own this role. The only borrowed
+/// Packet lives in this lexical block; the return type contains scalar Copies.
+unsafe fn compute_input(shared: &Shared, role: usize, generation: u64) -> Result<RawOutput, String> {
+    let output = {
+        // SAFETY: The exact request Acquire and actual done/exit protocol
+        // exclude input mutation throughout this lexical borrow.
+        let packet = unsafe { &*shared.cells.input.get() };
+        if packet.generation != generation { return Err("raw input generation mismatch".into()); }
+        let activity = activity::compute_partition(&packet.position, &packet.influence, ROLE_MASKS[role]);
+        let geometry = match role {
+            0 => Some(shelter::components(&packet.position, &packet.influence, Color::White)),
+            1 => Some(shelter::components(&packet.position, &packet.influence, Color::Black)),
+            2 => None,
+            _ => unreachable!("invalid raw role"),
+        };
+        #[cfg(test)]
+        test_reader_gate(shared, &shared.tests.in_input[role], role)?;
+        RawOutput { generation, activity, geometry }
+    };
+    Ok(output)
+}
+
+fn side_name(role: usize) -> &'static str { ROLE_NAMES[role] }
+
+fn all_state(shared: &Shared, state: u8) -> bool {
+    shared.readers.iter().all(|reader| reader.state.load(Ordering::Acquire) == state)
+}
+
+fn quiescent(shared: &Shared) -> bool {
+    shared.readers.iter().all(|reader| matches!(reader.state.load(Ordering::Acquire), PARKED | FAILED | STOPPED))
+}
+
+fn all_terminal(shared: &Shared) -> bool {
+    shared.readers.iter().all(|reader| matches!(reader.state.load(Ordering::Acquire), FAILED | STOPPED))
+}
+
+fn terminal(shared: &Shared) -> bool { shared.stop.load(Ordering::Acquire) }
+
+fn all_done(shared: &Shared, generation: u64) -> bool {
+    shared.readers.iter().all(|reader| reader.done.load(Ordering::Acquire) == generation)
+}
+
+fn has_failure(control: &Control) -> bool {
+    control.owner_failure.is_some() || control.failures.iter().any(Option::is_some)
+}
+
+fn failure_in(control: &Control) -> String {
+    control.owner_failure.clone().or_else(|| control.failures.iter().find_map(Clone::clone))
+        .unwrap_or_else(|| "raw worker entered an invalid or stopped state".into())
+}
+
+fn control_lock(shared: &Shared) -> MutexGuard<'_, Control> {
+    shared.control.lock().unwrap_or_else(|error| error.into_inner())
+}
+
+/// All normal and terminal publishers participate in the SAME SC RMW chain.
+/// If this consumes registration, Sleep makes notification follow the waiter's
+/// predicate recheck and atomic unlock/sleep. Never called while holding Control.
+fn signal_completion(shared: &Shared) {
+    if shared.waiting.swap(false, Ordering::SeqCst) {
+        let _sleep = shared.sleep.lock().unwrap_or_else(|error| error.into_inner());
+        shared.completed.notify_all();
+    }
+}
+
+fn wait_completion(shared: &Shared, generation: u64) -> Result<(), String> {
+    for _ in 0..COMPLETION_SPINS {
+        if terminal(shared) { return Err("raw completion stopped".into()); }
+        if all_done(shared, generation) { return Ok(()); }
+        spin_loop();
+    }
+    let mut sleep = shared.sleep.lock().unwrap_or_else(|error| error.into_inner());
+    loop {
+        #[cfg(test)]
+        test_pause(shared, &shared.tests.before_registration);
+        // A prior publisher's SC exchange precedes this one and carries its
+        // done publication to our Acquire recheck. A later publisher either
+        // consumes true and owes a Sleep-coordinated wake, or another does.
+        shared.waiting.swap(true, Ordering::SeqCst);
+        #[cfg(test)]
+        {
+            shared.tests.registrations.fetch_add(1, Ordering::SeqCst);
+            test_pause(shared, &shared.tests.after_registration);
+        }
+        let stopped = terminal(shared);
+        let done = all_done(shared, generation);
+        if stopped || done {
+            shared.waiting.swap(false, Ordering::SeqCst);
+            drop(sleep);
+            return if stopped { Err("raw completion stopped".into()) } else { Ok(()) };
+        }
+        sleep = shared.completed.wait(sleep).unwrap_or_else(|error| error.into_inner());
+        // Re-register on EVERY spurious/early wake before checking/sleeping.
+    }
+}
+
+fn publish_terminal(shared: &Shared, side: usize, failure: Option<String>) {
+    {
+        let mut control = control_lock(shared);
+        let reader = &shared.readers[side];
+        if let Some(error) = failure {
+            control.failures[side] = Some(error);
+            reader.failed_generation.store(shared.request.load(Ordering::Acquire), Ordering::Relaxed);
+            reader.state.store(FAILED, Ordering::Release);
+        } else if reader.state.load(Ordering::Acquire) != FAILED {
+            reader.state.store(STOPPED, Ordering::Release);
+        }
+        // This handler runs only after that reader's concrete loop has exited,
+        // including unwind. It never acknowledges or mutates its peer's cells.
+        shared.stop.store(true, Ordering::Release);
+        shared.wake.notify_all();
+    }
+    signal_completion(shared);
+}
+
+fn claim_discard(control: &mut Control) {
+    if let Flight::Published(metadata) = control.flight {
+        control.flight = Flight::Discarding(metadata);
+    }
+}
+
+fn retire_flight(control: &mut Control) {
+    control.flight = Flight::None;
+}
+
+fn release_scope(shared: &Shared) -> Result<(), String> {
+    let mut control = control_lock(shared);
+    if control.shutdown && control.scopes == 0 {
+        // Even when shutdown owns the joins, the guard itself acknowledges
+        // ALL THREE real quiet readers rather than assuming its owner has drained.
+        while !quiescent(shared) { control = wait_control(shared, control); }
+        return Ok(());
+    }
+    assert!(control.scopes != 0, "raw scope released twice");
+    control.scopes -= 1;
+    shared.active_scopes.store(control.scopes, Ordering::Release);
+    if control.scopes != 0 { return Ok(()); }
+    control.closing = true;
+    claim_discard(&mut control);
+    // Keep Discarding until ALL THREE real parked/exited acknowledgments. Seeing
+    // stop/failure on one reader is never input or output retirement of its peer.
+    while !quiescent(shared) { control = wait_control(shared, control); }
+    retire_flight(&mut control);
+    control.closing = false;
+    shared.wake.notify_all();
+    if terminal(shared) { Err(failure_in(&control)) } else { Ok(()) }
+}
+
+/// No cell access here. Under Control an unseen published epoch must be handled
+/// by the reader loop before PARKED, unless the reader actually exits instead.
+fn park(shared: &Shared, side: usize, seen: u64) {
+    let mut control = control_lock(shared);
+    if terminal(shared) || shared.request.load(Ordering::Acquire) != seen { return; }
+    if control.scopes != 0 { return; }
+    shared.readers[side].state.store(PARKED, Ordering::Release);
+    shared.wake.notify_all();
+    while control.scopes == 0 && !terminal(shared) {
+        control = wait_control(shared, control);
+    }
+    if !terminal(shared) {
+        shared.readers[side].state.store(IDLE, Ordering::Release);
+        shared.wake.notify_all();
+    }
+}
+
+fn wait_control<'a>(shared: &'a Shared, control: MutexGuard<'a, Control>) -> MutexGuard<'a, Control> {
+    shared.wake.wait(control).unwrap_or_else(|error| error.into_inner())
+}
