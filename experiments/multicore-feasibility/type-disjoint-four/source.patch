+        let phase = Phase { opening: 0, middlegame: 256, endgame: 0 };
+        let parts = [
+            RawActivity { raw_scores: [4, -4], pressure_sums: [8, 4], relation_queries: 7 },
+            RawActivity { raw_scores: [4, -4], pressure_sums: [8, 8], relation_queries: 11 },
+            RawActivity { relation_queries: 13, ..RawActivity::default() },
