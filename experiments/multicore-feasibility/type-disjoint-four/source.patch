+                        let expected = compute(&pos, &map, material, weights);
+                        assert_eq!(
+                            combine_partitions(parts, material, weights, pos.phase()), expected,
+                            "{placement}, material={material}, weights={weights:?}",
+                        );
+                        assert_eq!(
+                            combine_partitions([parts[2], parts[0], parts[1]], material, weights, pos.phase()),
+                            expected,
