+#[cfg(test)]
+fn test_reader_gate(shared: &Shared, mutex: &Mutex<TestGate>, side: usize) -> Result<(), String> {
+    test_pause(shared, mutex);
+    let gate = mutex.lock().unwrap();
+    if gate.panic { panic!("controlled {} raw reader panic", side_name(side)); }
+    if gate.fail { Err(format!("controlled {} raw reader failure", side_name(side))) } else { Ok(()) }
+}
