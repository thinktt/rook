+// Checked sliders alone pay the immutable ray-mask load and intersection.
+// Every skipped destination already fails GenerationSafety's destination test.
+fn checked_sliders<const LIMIT: usize>(
+    position: &Position,
+    list: &mut MoveList,
+    safety: &GenerationSafety,
+    kind: PieceKind,
+) {
+    let (start, end) = match kind {
+        PieceKind::Bishop => (0, 4),
+        PieceKind::Rook => (4, 8),
+        PieceKind::Queen => (0, 8),
+        _ => unreachable!(),
+    };
+    let sliding = true;
+    for &from in position.piece_squares(position.side, kind) {
+        let (rays, _) = crate::attacks::influence_rays(from);
+        for direction in start..end {
+            if rays[direction] & safety.evasion_destinations == 0 {
+                continue;
+            }
+            let (df, dr) = DIRECTIONS[direction];
