+//! Independent old-table differential controls. No compact layout helper is an oracle.
+use super::*;
+use crate::types::{MoveKind, Square};
+#[path = "compact_old.rs"]
+mod old;
+
+type Slot = (u32, i16, i16, u16, u8, u8);
+fn old_query(q: Query) -> old::Query {
+    old::Query { group: q.group, identity: q.identity, ply: q.ply,
+        target: q.target, lower: q.lower, upper: q.upper }
+}
+fn result(value: ProbeResult) -> (Option<i32>, u8, Option<Move>, Option<i32>, bool) {
+    let bound = match value.bound { Bound::None => 0, Bound::Upper => 1,
+        Bound::Exact => 2, Bound::Lower => 3 };
+    (value.score, bound, value.move_hint, value.marked_depth, value.quiet_mate_checked)
+}
+fn old_result(value: old::ProbeResult) -> (Option<i32>, u8, Option<Move>, Option<i32>, bool) {
+    let bound = match value.bound { old::Bound::None => 0, old::Bound::Upper => 1,
+        old::Bound::Exact => 2, old::Bound::Lower => 3 };
+    (value.score, bound, value.move_hint, value.marked_depth, value.quiet_mate_checked)
+}
+struct Pair { native: RememberedTable, old: old::RememberedTable }
+impl Pair {
+    fn new(groups: usize) -> Self {
+        Self { native: RememberedTable::with_groups(groups), old: old::RememberedTable::with_groups(groups) }
+    }
+    fn same(&self) {
+        let slots: Vec<[Slot;4]> = self.native.groups.iter().map(|g|
+            std::array::from_fn(|i| {
+                let r = g.payloads[i];
+                (g.identities[i],r.score,r.depth,r.endpoints,r.flags,r.generation)
+            })).collect();
+        assert_eq!((self.native.generation, slots), self.old.snapshot());
+        assert_eq!(self.native.group_count(), self.old.group_count());
+    }
+    fn store(&mut self, s: Store) {
+        self.native.store(s);
+        self.old.store(old::Store { query: old_query(s.query), score: s.score,
+            move_hint: s.move_hint, quiet_mate_checked: s.quiet_mate_checked, mark_depth: s.mark_depth });
+        self.same();
+    }
+    fn probe(&mut self, q: Query) -> ProbeResult {
+        let actual = self.native.probe(q);
+        assert_eq!(result(actual), old_result(self.old.probe(old_query(q))));
+        self.same(); // Includes pre-observation vs post-query mate-depth mutation.
+        actual
+    }
+    fn clear(&mut self) { self.native.clear(); self.old.clear(); self.same(); }
+}
+fn entry(identity: u32, depth: i32, score: i32) -> Store {
+    Store { query: Query { group: 0, identity, ply: 0, target: depth, lower: -200, upper: 200 },
+        score, move_hint: None, quiet_mate_checked: false, mark_depth: true }
+}
+fn query(identity: u32, depth: i32, lower: i32, upper: i32) -> Query {
+    Query { group: 0, identity, ply: 0, target: depth, lower, upper }
+}
+
+#[test]
+fn compact48_old_table_collisions_all_branches_and_metadata_precedence() {
+    let mut p = Pair::new(2);
+    // Fill all retained priorities; same-identity shallow/equal writes; full
+    // equal-depth displacement and strictly shallower recent-only insertion.
+    for (id,depth) in [(1,10),(2,20),(3,30),(1,9),(1,10),(4,10),(5,-1)] {
+        p.store(entry(id,depth,42));
+    }
+    assert_eq!(p.native.groups[0].identities, [4,2,3,5]);
+    for id in 0..=6 { p.probe(query(id,11,-100,0)); }
+    // Recent identity is not a retained match: it displaces by priority.
+    p.store(entry(5,11,43));
+    assert_eq!(p.native.groups[0].identities, [5,2,3,4]);
+    let mut retained = entry(5,40,-100);
+    retained.query.lower = -50; retained.query.upper = 50;
+    p.store(retained);
+    let mut recent = entry(5,2,100);
+    recent.query.lower = -50; recent.query.upper = 50;
+    recent.move_hint = Some(Move::new(Square::parse("e1").unwrap(), Square::parse("g1").unwrap(), MoveKind::Castle));
+    recent.quiet_mate_checked = true; recent.mark_depth = false;
+    p.store(recent);
+    let metadata = p.probe(query(5,41,-200,200));
+    assert_eq!((metadata.score,metadata.bound,metadata.marked_depth), (None,Bound::Upper,Some(40)));
+    assert!(metadata.quiet_mate_checked && metadata.move_hint.is_some());
+    assert_eq!(p.probe(query(5,2,-100,100)).score,Some(100));
+    // Numeric secondary identity zero is ordinary; group selection is separate.
+    let mut zero = entry(0,-63,17); zero.query.group = 1;
+    p.store(zero);
+    assert_eq!(p.probe(Query { group:1,..query(0,-63,-100,0) }).score,Some(17));
+    p.probe(query(0,-63,-100,0));
+    p.clear();
+    assert_eq!(p.probe(Query { group:1,..query(0,-63,-100,0) }).score,None);
+}
+
+#[test]
+fn compact48_old_table_signed_scores_mates_windows_and_depth_mutations() {
+    for score in [-10063,-9001,-9000,-8999,-1,0,1,8999,9000,9001,10063] {
+        for depth in [-63,0,1,10,366] {
+            for ply in [0,1,62] {
+                let mut p = Pair::new(1);
+                let mut s = entry(0,depth,score);
+                s.query.ply=ply; s.query.target=ply+depth;
+                s.query.lower=-10000; s.query.upper=10000;
+                s.quiet_mate_checked=true;
+                s.move_hint=Some(Move(0xffff));
+                p.store(s);
+                for (lower,upper) in [(-10000,10000),(-50,50),(0,0),(50,-50),(-10000,-9000),(9000,10000)] {
+                    for required in [-63,0,1,11,428] {
+                        for current_ply in [0,62] {
+                            let q = Query { group:0,identity:0,ply:current_ply,target:current_ply+required,lower,upper };
+                            p.probe(q); p.probe(q); // Second metadata sees any actual mate-depth upgrade.
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn compact48_old_table_deterministic_sequences_stale_zero_wrap_and_capacity() {
+    for groups in [1,2,17] {
+        let mut p = Pair::new(groups);
+        let mut state = 0x4a6f_696e_6564_5454u64;
+        for step in 0..4096 {
+            state=state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let group=(state as usize)%groups;
+            let identity=match step%4 { 0=>0,1=>u32::MAX,_=>(state>>32) as u32%7 };
+            let ply=((state>>8)%63) as i32;
+            let depth=[-63,-1,0,1,2,5,62,366][((state>>16)&7) as usize];
+            let score=[-10063,-9000,-8999,-50,0,50,8999,9000][((state>>24)&7) as usize];
+            let q=Query { group,identity,ply,target:ply+depth,lower:-50,upper:50 };
+            if step%11==0 { p.clear(); }
+            else if step%3!=0 {
+                p.store(Store { query:q,score,move_hint:Some(Move(state as u16)),
+                    quiet_mate_checked:state&1!=0,mark_depth:state&2!=0 });
+            } else { p.probe(q); }
+        }
+        // Force a complete byte-generation cycle with occupied and zero-ID data.
+        p.store(entry(0,1,17));
+        for _ in 0..255 { p.clear(); }
+        assert_eq!(p.probe(query(0,1,-100,0)).score,None);
+        p.store(entry(0,1,18));
+        assert_eq!(p.probe(query(0,1,-100,0)).score,Some(18));
+    }
+    for tts in [95,96,97,48*100,48*101] {
+        let native=RememberedTable::from_tts(tts);
+        let old=old::RememberedTable::from_tts(tts);
+        assert_eq!(native.is_ok(),old.is_ok());
+        if let (Ok(native),Ok(old))=(native,old) {
+            let p=Pair {native,old}; p.same();
+            assert_eq!(p.native.groups.capacity(),p.old.capacity());
+        }
+    }
+}
